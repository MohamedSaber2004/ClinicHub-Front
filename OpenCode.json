{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask"
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "semgrep": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.12",
        "semgrep-mcp",
        "--semgrep-path",
        "C:\\Users\\ALQasem\\.local\\bin\\semgrep.exe"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": false
    }
  }
}