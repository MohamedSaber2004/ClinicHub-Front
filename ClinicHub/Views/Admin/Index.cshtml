@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "لوحة تحكم المدير";
    Layout = "_AdminLayout";
    var stats = ViewBag.Stats as List<StatCardDto> ?? new();
    var days = ViewBag.Days is int d ? d : 30;
    string[] rangeLabels = { "آخر 7 أيام", "آخر 30 يوماً", "آخر 90 يوماً" };
    int[] rangeValues = { 7, 30, 90 };

    string StatAccent(string? color) => color switch
    {
        "amber" => " stat-card--warning",
        "blue" => " stat-card--info",
        "brass" => " stat-card--brass",
        "danger" => " stat-card--danger",
        _ => ""
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-directory.css?v=20261027_redesign_v2" />
}

<div class="ad-page">

<div class="page-header">
    <h2 class="page-title">
        <span class="page-title-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2" fill="none"/>
                <rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2" fill="none"/>
                <rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2" fill="none"/>
                <rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2" fill="none"/>
            </svg>
        </span>
        لوحة التحكم - نظرة عامة
    </h2>
</div>

@if (ViewBag.HasError == true)
{
    <div class="table-card">
        <div class="table-card-header">
            <h3 class="table-card-title">تعذّر تحميل البيانات</h3>
        </div>
        <p class="mb-0">@ViewBag.ErrorMessage</p>
    </div>
}

<!-- KPI Stat Cards -->
<div class="stats-grid ad-dash-grid stagger">
    @foreach (var stat in stats)
    {
        <div class="stat-card@(StatAccent(stat.IconColor))">
            <div class="stat-info">
                <span class="stat-value">@stat.Value</span>
                <span class="stat-label">@stat.Label</span>
            </div>
            <div class="icon-wrapper icon-wrapper--@stat.IconColor">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="@stat.SvgPath"/>
                </svg>
            </div>
        </div>
    }
</div>

<!-- Graphs -->
<div class="table-card" id="dashboard-graphs">
    <div class="table-card-header">
        <h3 class="table-card-title">
            <span class="subtitle-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z" fill="currentColor"/>
                </svg>
            </span>
            إحصائيات الأداء والرسوم البيانية
        </h3>
        <div class="range-tabs" role="group" aria-label="نطاق زمني">
            @for (int i = 0; i < rangeValues.Length; i++)
            {
                <a class="range-tab @(days == rangeValues[i] ? "active" : "")"
                   href="@Url.Action("Index", new { days = rangeValues[i] })">@rangeLabels[i]</a>
            }
        </div>
    </div>

    <div class="charts-grid">
        <div class="chart-card chart-card--wide">
            <h4 class="chart-title">إجمالي الإيرادات</h4>
            <div class="chart-canvas-wrap">
                <canvas id="revenueTrendChart"></canvas>
                <div class="chart-empty" data-for="revenueTrendChart">
                    <span class="empty-state-icon">📈</span>
                    <p class="empty-desc">لا توجد بيانات إيرادات لهذه الفترة بعد</p>
                </div>
            </div>
        </div>

        <div class="chart-card">
            <h4 class="chart-title">نمو العيادات</h4>
            <div class="chart-canvas-wrap">
                <canvas id="clinicsGrowthChart"></canvas>
                <div class="chart-empty" data-for="clinicsGrowthChart">
                    <span class="empty-state-icon">🏥</span>
                    <p class="empty-desc">لا توجد بيانات نمو عيادات لهذه الفترة بعد</p>
                </div>
            </div>
        </div>

        <div class="chart-card">
            <h4 class="chart-title">الاشتراكات حسب الباقة</h4>
            <div class="chart-canvas-wrap">
                <canvas id="subscriptionsByPlanChart"></canvas>
                <div class="chart-empty" data-for="subscriptionsByPlanChart">
                    <span class="empty-state-icon">💳</span>
                    <p class="empty-desc">لا توجد اشتراكات في هذه الفترة بعد</p>
                </div>
            </div>
        </div>

        <div class="chart-card">
            <h4 class="chart-title">نمو المستخدمين</h4>
            <div class="chart-canvas-wrap">
                <canvas id="usersGrowthChart"></canvas>
                <div class="chart-empty" data-for="usersGrowthChart">
                    <span class="empty-state-icon">👥</span>
                    <p class="empty-desc">لا توجد بيانات نمو مستخدمين لهذه الفترة بعد</p>
                </div>
            </div>
        </div>

        <div class="chart-card">
            <h4 class="chart-title">ملخص المواعيد</h4>
            <div class="chart-canvas-wrap">
                <canvas id="appointmentsSummaryChart"></canvas>
                <div class="chart-empty" data-for="appointmentsSummaryChart">
                    <span class="empty-state-icon">📅</span>
                    <p class="empty-desc">لا توجد مواعيد في هذه الفترة بعد</p>
                </div>
            </div>
        </div>
    </div>
</div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            // Chart colours are read from the design-system tokens.
            // The literals below are only fallbacks for the very same tokens.
            var tokenStyles = getComputedStyle(document.documentElement);

            function readToken(name, fallback) {
                var value = tokenStyles.getPropertyValue(name);
                return value && value.trim() ? value.trim() : fallback;
            }

            function withAlpha(color, alphaValue) {
                var hex = (color || '').trim().replace('#', '');
                if (hex.length === 3) { hex = hex.split('').map(function (c) { return c + c; }).join(''); }
                if (!/^[0-9a-f]{6}$/i.test(hex)) { return color; }
                var num = parseInt(hex, 16);
                return 'rgba(' + ((num >> 16) & 255) + ', ' + ((num >> 8) & 255) + ', ' + (num & 255) + ', ' + alphaValue + ')';
            }

            var primaryColor = readToken('--chart-1', '#0D5F4E');
            var greenColor = readToken('--chart-2', '#1E8A5A');
            var blueColor = readToken('--chart-3', '#2F6FB2');
            var amberColor = readToken('--chart-5', '#D08A1E');
            var dangerColor = readToken('--chart-6', '#B13B32');
            var palettes = {
                primary: primaryColor,
                primarySoft: withAlpha(primaryColor, 0.14),
                blue: blueColor,
                blueSoft: withAlpha(blueColor, 0.14),
                amber: amberColor,
                amberSoft: withAlpha(amberColor, 0.16),
                green: greenColor,
                greenSoft: withAlpha(greenColor, 0.16),
                danger: dangerColor,
                dangerSoft: withAlpha(dangerColor, 0.16),
                brass: readToken('--chart-4', '#B78A3C'),
                grid: readToken('--chart-grid', 'rgba(22, 36, 31, 0.08)'),
                axis: readToken('--chart-axis', '#5A6B64'),
                surface: readToken('--clr-surface', '#FFFFFF')
            };

            Chart.defaults.font.family = "'Cairo', sans-serif";
            Chart.defaults.font.size = 12;
            Chart.defaults.color = palettes.axis;
            Chart.defaults.plugins.legend.rtl = true;
            Chart.defaults.plugins.legend.textDirection = 'rtl';
            Chart.defaults.plugins.tooltip.rtl = true;
            Chart.defaults.plugins.tooltip.textDirection = 'rtl';

            function baseOptions(extra) {
                var options = {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { intersect: false, mode: 'index' },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: 'rgba(90,107,102,0.10)' } }
                    },
                    plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8 } } }
                };
                if (extra) { Object.assign(options, extra); }
                return options;
            }

            function makeChart(canvasId, config) {
                var el = document.getElementById(canvasId);
                if (!el) return null;
                return new Chart(el.getContext('2d'), config);
            }

            function toggleEmpty(canvasId, hasData) {
                document.querySelectorAll('.chart-empty[data-for="' + canvasId + '"]').forEach(function (n) {
                    n.classList.toggle('visible', !hasData);
                });
            }

            function periodLabels(rows) {
                return (rows || []).map(function (r) { return r.period; });
            }

            var revenue = @(Html.Raw(string.IsNullOrWhiteSpace(ViewBag.RevenueTrendJson as string) ? "[]" : ViewBag.RevenueTrendJson));
            var clinics = @(Html.Raw(string.IsNullOrWhiteSpace(ViewBag.ClinicsGrowthJson as string) ? "[]" : ViewBag.ClinicsGrowthJson));
            var plans = @(Html.Raw(string.IsNullOrWhiteSpace(ViewBag.SubscriptionsByPlanJson as string) ? "[]" : ViewBag.SubscriptionsByPlanJson));
            var users = @(Html.Raw(string.IsNullOrWhiteSpace(ViewBag.UsersGrowthJson as string) ? "[]" : ViewBag.UsersGrowthJson));
            var appts = @(Html.Raw(string.IsNullOrWhiteSpace(ViewBag.AppointmentsSummaryJson as string) ? "[]" : ViewBag.AppointmentsSummaryJson));

            var revenueChart = makeChart('revenueTrendChart', {
                type: 'line',
                data: {
                    labels: periodLabels(revenue),
                    datasets: [{
                        label: 'الإيرادات (ج.م)',
                        data: revenue.map(function (r) { return r.revenue; }),
                        borderColor: palettes.primary,
                        backgroundColor: palettes.primarySoft,
                        fill: true,
                        tension: 0.35,
                        pointRadius: 2,
                        borderWidth: 2
                    },
                    {
                        label: 'رسوم المنصة (ج.م)',
                        data: revenue.map(function (r) { return r.platformFees; }),
                        borderColor: palettes.amber,
                        backgroundColor: 'transparent',
                        fill: false,
                        tension: 0.35,
                        pointRadius: 2,
                        borderWidth: 2,
                        borderDash: [6, 4]
                    },
                    {
                        label: 'صافي العيادات (ج.م)',
                        data: revenue.map(function (r) { return r.netRevenue; }),
                        borderColor: palettes.green,
                        backgroundColor: 'transparent',
                        fill: false,
                        tension: 0.35,
                        pointRadius: 2,
                        borderWidth: 2
                    }]
                },
                options: baseOptions()
            });
            toggleEmpty('revenueTrendChart', revenue.length > 0);

            var clinicsChart = makeChart('clinicsGrowthChart', {
                type: 'bar',
                data: {
                    labels: periodLabels(clinics),
                    datasets: [
                        { label: 'عيادات جديدة', data: clinics.map(function (r) { return r.newClinics; }), backgroundColor: palettes.blue, borderRadius: 4 },
                        { label: 'إجمالي العيادات', data: clinics.map(function (r) { return r.totalClinics; }), backgroundColor: palettes.blueSoft, borderRadius: 4 }
                    ]
                },
                options: baseOptions({ scales: { x: { grid: { display: false } }, y: { stacked: false, beginAtZero: true, ticks: { precision: 0 }, grid: { color: 'rgba(90,107,102,0.10)' } } } })
            });
            toggleEmpty('clinicsGrowthChart', clinics.length > 0);

            var planColors = [palettes.primary, palettes.blue, palettes.amber, palettes.green, palettes.danger];
            var subsByPlanChart = makeChart('subscriptionsByPlanChart', {
                type: 'doughnut',
                data: {
                    labels: plans.map(function (p) { return p.planName; }),
                    datasets: [{
                        data: plans.map(function (p) { return p.subscriptionsCount; }),
                        backgroundColor: planColors,
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: baseOptions({ cutout: '62%' })
            });
            toggleEmpty('subscriptionsByPlanChart', plans.length > 0);

            var usersChart = makeChart('usersGrowthChart', {
                type: 'line',
                data: {
                    labels: periodLabels(users),
                    datasets: [{
                        label: 'مستخدمون جدد',
                        data: users.map(function (u) { return u.newUsers; }),
                        borderColor: palettes.green,
                        backgroundColor: palettes.greenSoft,
                        fill: true,
                        tension: 0.35,
                        pointRadius: 2,
                        borderWidth: 2
                    }, {
                        label: 'إجمالي المستخدمين',
                        data: users.map(function (u) { return u.totalUsers; }),
                        borderColor: palettes.blue,
                        borderDash: [6, 4],
                        fill: false,
                        tension: 0.35,
                        pointRadius: 0,
                        borderWidth: 2
                    }]
                },
                options: baseOptions()
            });
            toggleEmpty('usersGrowthChart', users.length > 0);

            var apptsChart = makeChart('appointmentsSummaryChart', {
                type: 'bar',
                data: {
                    labels: periodLabels(appts),
                    datasets: [
                        { label: 'مكتملة', data: appts.map(function (a) { return a.completedCount; }), backgroundColor: palettes.green, borderRadius: 4 },
                        { label: 'ملغاة', data: appts.map(function (a) { return a.cancelledCount; }), backgroundColor: palettes.danger, borderRadius: 4 },
                        { label: 'قيد الانتظار', data: appts.map(function (a) { return a.pendingCount; }), backgroundColor: palettes.amber, borderRadius: 4 }
                    ]
                },
                options: baseOptions({
                    scales: {
                        x: { stacked: true, grid: { display: false } },
                        y: { stacked: true, beginAtZero: true, ticks: { precision: 0 }, grid: { color: 'rgba(90,107,102,0.10)' } }
                    }
                })
            });
            toggleEmpty('appointmentsSummaryChart', appts.length > 0);
        })();
    </script>
}
