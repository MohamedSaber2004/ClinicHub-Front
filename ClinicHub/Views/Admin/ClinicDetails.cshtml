@{
    ViewData["Title"] = "تفاصيل العيادة";
    Layout = "_AdminLayout";
    var clinicDetails = ViewBag.Clinic as ClinicDetailsDto;
    var clinic = clinicDetails ?? (ViewBag.Clinic as ClinicManagmentDto);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-directory.css?v=20261027_redesign_v2" />
}

@if (clinic == null)
{
    <div class="empty-state">
        <h3>العيادة غير موجودة</h3>
        <a href="@AdminRoutes.Pages.Clinics()" class="btn btn-primary">العودة</a>
    </div>
    return;
}

@{
    var clinicName = clinic.NameAr ?? clinic.Name;
    var clinicSpec = clinic.SpecializationNameAr ?? clinic.SpecializationName;
    var clinicDesc = clinic.ArDescription ?? clinic.Description;
    var avgRating = clinicDetails?.AverageRating ?? clinic.Rating ?? 0;
    var totalRatings = clinicDetails?.TotalRatings ?? 0;
    var hasRating = avgRating > 0;
    var fullStars = (int)Math.Floor(avgRating);
    var hasHalf = hasRating && avgRating - fullStars >= 0.5;
    var emptyStars = 5 - fullStars - (hasHalf ? 1 : 0);

    var doctors = clinicDetails?.Doctors ?? new List<DoctorBriefDto>();
    var staffList = clinicDetails?.Staff ?? new List<StaffBriefDto>();
    var recentRatings = clinicDetails?.RecentRatings ?? new List<RatingDto>();
}

<div class="ad-page">
    <!-- Clinic Header -->
    <div class="clinic-detail-header ad-hero">
        <div class="cdh-image">
            @if (!string.IsNullOrEmpty(clinic.Logo))
            {
                <img src="@clinic.Logo" alt="@clinicName" />
            }
            else
            {
                <div class="cdh-image-placeholder">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-7-2h2v-4h4v-2h-4V7h-2v4H8v2h4z"/>
                    </svg>
                </div>
            }
        </div>
        <div class="cdh-info">
            <h2 class="cdh-name">@clinicName</h2>
            @if (!string.IsNullOrEmpty(clinicSpec))
            {
                <div class="cdh-specs">
                    <span class="spec-pill">@clinicSpec</span>
                </div>
            }
            <div class="cdh-meta">
                <div class="cdh-rating">
                    <div class="stars-inline">
                        @for (int i = 0; i < fullStars; i++) { <svg class="ad-star ad-star--on" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg> }
                        @if (hasHalf) { <svg class="ad-star" width="14" height="14" viewBox="0 0 24 24"><defs><clipPath id="h"><rect x="0" y="0" width="7" height="24"/></clipPath></defs><path class="ad-star--on" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor" clip-path="url(#h)"/><path class="ad-star--off" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor" clip-path="url(#h)"/></svg> }
                        @for (int i = 0; i < emptyStars; i++) { <svg class="ad-star ad-star--off" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg> }
                    </div>
                    <span dir="ltr">@avgRating.ToString("F1")</span>
                </div>
                <span class="cdh-status">
                    @if (clinic.IsActive) { <span class="badge badge--dot badge-success">نشط</span> }
                    else { <span class="badge badge--dot badge-danger">غير نشط</span> }
                </span>
            </div>
            @if (!string.IsNullOrEmpty(clinicDesc))
            {
                <p class="cdh-desc">@clinicDesc</p>
            }
            <div class="cdh-contact">
                <span>@(clinic.AddressAr ?? clinic.Address)</span>
                <span dir="ltr">@clinic.Phone</span>
                <span dir="ltr">@clinic.Email</span>
                <span>المدير: @clinic.OwnerName</span>
                <span>البريد: <span dir="ltr">@clinic.OwnerEmail</span></span>
            </div>
        </div>
        <div class="cdh-actions">
            <a href="@AdminRoutes.Pages.Clinics()" class="btn btn-outline-secondary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
                العودة
            </a>
            <button id="editClinicBtn" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                تعديل
            </button>
            <button id="cancelEditBtn" class="btn btn-outline-secondary form-group-hidden">
                إلغاء
            </button>
            <button id="saveClinicBtn" class="btn btn-success form-group-hidden">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                حفظ التغييرات
            </button>
            <button id="toggleClinicStatusBtn" class="btn @(clinic.IsActive ? "btn-outline-danger" : "btn-outline-success")" data-clinic-id="@clinic.Id" data-is-active="@clinic.IsActive.ToString().ToLower()">
                @if (clinic.IsActive)
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                    <span>إلغاء التفعيل</span>
                }
                else
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                    <span>تفعيل</span>
                }
            </button>
        </div>
    </div>

    <!-- Tabs -->
    <div class="detail-tabs">
        <ul class="nav nav-tabs ad-tabs" id="clinicTabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" id="ov-tab" data-bs-toggle="tab" data-bs-target="#ov" type="button" role="tab">نظرة عامة</button></li>
            <li class="nav-item"><button class="nav-link" id="docs-tab" data-bs-toggle="tab" data-bs-target="#docs" type="button" role="tab">الأطباء</button></li>
            <li class="nav-item"><button class="nav-link" id="stf-tab" data-bs-toggle="tab" data-bs-target="#stf" type="button" role="tab">الموظفين</button></li>
            <li class="nav-item"><button class="nav-link" id="ratings-tab" data-bs-toggle="tab" data-bs-target="#ratings" type="button" role="tab">التقييمات</button></li>
        </ul>
        <div class="tab-content ad-tabs-panel" id="clinicTabContent">

            <!-- ======== OVERVIEW TAB ======== -->
            <div class="tab-pane fade show active" id="ov" role="tabpanel">
                <div class="ad-tabs-panel">
                    <div class="stats-grid stagger">
                        <div class="stat-card stat-card--brass">
                            <div class="stat-info">
                                <span class="stat-value" dir="ltr">@avgRating.ToString("F1")</span>
                                <span class="stat-label">متوسط التقييم</span>
                            </div>
                            <div class="icon-wrapper icon-wrapper--brass">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                            </div>
                        </div>
                        <div class="stat-card stat-card--info">
                            <div class="stat-info">
                                <span class="stat-value" dir="ltr">@totalRatings</span>
                                <span class="stat-label">إجمالي التقييمات</span>
                            </div>
                            <div class="icon-wrapper icon-wrapper--blue">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.6 2.4l9.1 9.1c.8.8.8 2 0 2.8l-6.4 6.4c-.8.8-2 .8-2.8 0l-9.1-9.1c-.8-.8-.8-2 0-2.8l6.4-6.4c.8-.8 2-.8 2.8 0zM7.5 11.9a1.6 1.6 0 1 0 3.2 0 1.6 1.6 0 0 0-3.2 0z"/></svg>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-info">
                                <span class="stat-value" dir="ltr">@doctors.Count</span>
                                <span class="stat-label">الأطباء</span>
                            </div>
                            <div class="icon-wrapper icon-wrapper--primary">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                            </div>
                        </div>
                        <div class="stat-card stat-card--neutral">
                            <div class="stat-info">
                                <span class="stat-value" dir="ltr">@staffList.Count</span>
                                <span class="stat-label">الموظفين</span>
                            </div>
                            <div class="icon-wrapper icon-wrapper--green">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-4 0-8 2-8 4.5V21h16v-2.5C20 16 16 14 12 14z"/></svg>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(clinicDesc))
                    {
                        <div class="ad-panel">
                            <div class="section-head">
                                <h3 class="section-head-title">الوصف</h3>
                            </div>
                            <p class="ad-panel-body">@clinicDesc</p>
                        </div>
                    }

                    <div class="ad-panel">
                        <div class="section-head">
                            <h3 class="section-head-title">الموقع</h3>
                        </div>
                        <p class="text-muted mb-3">
                            @(clinic.AddressAr ?? clinic.Address)
                        </p>
                        <input type="hidden" id="clinicDetailLat" value="@(clinic.Lat?.ToString("F6", System.Globalization.CultureInfo.InvariantCulture) ?? "31.0409")" />
                        <input type="hidden" id="clinicDetailLng" value="@(clinic.Lng?.ToString("F6", System.Globalization.CultureInfo.InvariantCulture) ?? "31.3785")" />
                        <div class="map-search-row">
                            <label class="sr-only" for="clinicDetailPlaceSearch">ابحث عن مكان أو عنوان لتحديد موقع العيادة</label>
                            <input type="text" id="clinicDetailPlaceSearch" class="form-input register-map-search" placeholder="ابحث عن مكان أو عنوان..." autocomplete="off" aria-describedby="clinicDetailMapHint" />
                            <button type="button" class="btn btn-primary btn-sm map-search-btn" id="clinicDetailPlaceSearchBtn">بحث</button>
                        </div>
                        <div class="form-hint" id="clinicDetailMapHint">اسحب الدبوس أو ابحث لتحديد موقع العيادة بدقة</div>
                        <div id="clinicDetailMap" class="register-map-container" role="application" aria-label="خريطة موقع العيادة" aria-describedby="clinicDetailMapHint"></div>
                        <div class="settings-map-tools">
                            <span class="text-muted settings-coords-display" id="clinicDetailCoordsDisplay" dir="ltr"></span>
                        </div>
                    </div>

                    @if (clinic.WorkingDays != null && clinic.WorkingDays.Any())
                    {
                        <div class="ad-panel ad-panel--flush">
                            <div class="table-card-header">
                                <h3 class="table-card-title">أيام ومواعيد العمل</h3>
                            </div>
                            <div class="table-responsive">
                                <table class="custom-table">
                                    <thead>
                                        <tr>
                                            <th>اليوم</th>
                                            <th>بداية</th>
                                            <th>نهاية</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var wd in clinic.WorkingDays)
                                        {
                                            <tr>
                                                <td>@wd.DayOfWeek</td>
                                                <td dir="ltr">@wd.StartTime.ToString("h:mm tt", new System.Globalization.CultureInfo("ar-SA"))</td>
                                                <td dir="ltr">@wd.EndTime.ToString("h:mm tt", new System.Globalization.CultureInfo("ar-SA"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    <form id="updateClinicForm">
                        <div class="ad-panel">
                            <div class="section-head">
                                <h3 class="section-head-title">معلومات العيادة</h3>
                            </div>
                            <div id="updateClinicErrors" class="validation-summary form-group-hidden"></div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label class="form-label" for="nameAr">اسم العيادة</label>
                                        <input id="nameAr" type="text" name="nameAr" class="form-input" value="@clinic.NameAr" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="specializationId">التخصص الرئيسي</label>
                                        <select id="specializationId" name="specializationId" class="form-select" disabled>
                                            <option value="">اختر التخصص</option>
                                            @if (ViewBag.Specializations != null)
                                            {
                                                foreach (var s in ViewBag.Specializations)
                                                {
                                                    <option value="@s.Id" selected="@(s.Id == clinic.SpecializationId ? true : null)">@(s.ArName ?? s.Name)</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="email">البريد الإلكتروني</label>
                                        <input id="email" type="email" name="email" class="form-input" value="@clinic.Email" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label class="form-label" for="arDescription">الوصف</label>
                                        <textarea id="arDescription" name="arDescription" class="form-input form-textarea" rows="2" disabled>@clinic.ArDescription</textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="addressAr">العنوان</label>
                                        <input id="addressAr" type="text" name="addressAr" class="form-input" value="@clinic.AddressAr" disabled />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="phone">رقم الهاتف</label>
                                        <input id="phone" type="text" name="phone" class="form-input" value="@clinic.Phone" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="website">الموقع الإلكتروني</label>
                                        <input id="website" type="url" name="website" class="form-input" value="@clinic.Website" disabled />
                                    </div>
                                </div>
                                <div class="col-md-6 edit-field">
                                    <div class="form-group">
                                        <label class="form-label" for="workingHours">مواعيد العمل (نص)</label>
                                        <input id="workingHours" type="text" name="workingHours" class="form-input" value="@clinic.WorkingHours" placeholder="مثال: 9:00 ص - 5:00 م" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="row edit-field">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="form-label" for="workingHoursStart">وقت البدء</label>
                                        <input id="workingHoursStart" type="time" name="workingHoursStart" class="form-input" value="@(clinic.WorkingDays?.FirstOrDefault()?.StartTime.ToString("HH:mm"))" disabled />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="form-label" for="workingHoursEnd">وقت الانتهاء</label>
                                        <input id="workingHoursEnd" type="time" name="workingHoursEnd" class="form-input" value="@(clinic.WorkingDays?.FirstOrDefault()?.EndTime.ToString("HH:mm"))" disabled />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="form-label">أيام العمل</label>
                                        <div class="working-days-checkboxes ad-working-days">
                                            @{
                                                var workingDayNames = new Dictionary<DayOfWeek, string>
                                                {
                                                    { DayOfWeek.Saturday, "السبت" },
                                                    { DayOfWeek.Sunday, "الأحد" },
                                                    { DayOfWeek.Monday, "الإثنين" },
                                                    { DayOfWeek.Tuesday, "الثلاثاء" },
                                                    { DayOfWeek.Wednesday, "الأربعاء" },
                                                    { DayOfWeek.Thursday, "الخميس" },
                                                    { DayOfWeek.Friday, "الجمعة" }
                                                };
                                                var existingDays = clinic.WorkingDays?.Select(d => d.DayOfWeek).ToList() ?? new List<string>();
                                            }
                                            @foreach (var day in workingDayNames)
                                            {
                                                <label class="checkbox-inline ad-day-chk">
                                                    <input type="checkbox" name="workingDays" value="@((int)day.Key)" @(existingDays.Contains(day.Key.ToString()) ? "checked" : "") disabled />
                                                    @day.Value
                                                </label>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ======== DOCTORS TAB ======== -->
            <div class="tab-pane fade" id="docs" role="tabpanel">
                @if (doctors.Count == 0)
                {
                    <div class="empty-state"><p>لا يوجد أطباء في هذه العيادة بعد.</p></div>
                }
                else
                {
                    <div class="staff-grid">
                        @foreach (var doc in doctors)
                        {
                            <div class="staff-card">
                                <div class="staff-card-avatar">
                                    @if (!string.IsNullOrEmpty(doc.Image))
                                    {
                                        <img src="@doc.Image" alt="@doc.Name" loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <span class="staff-card-initial">@(doc.Name?.Length > 0 ? doc.Name[0].ToString() : "ط")</span>
                                    }
                                </div>
                                <div class="staff-card-body">
                                    <h4 class="staff-card-name">@doc.Name</h4>
                                    <span class="staff-card-role">@(doc.SpecializationArName ?? doc.SpecializationEnName)</span>
                                    <div class="staff-card-contact">
                                        @if (!string.IsNullOrEmpty(doc.Email))
                                        {
                                            <a href="mailto:@doc.Email" class="staff-contact-link">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                                                <span dir="ltr">@doc.Email</span>
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(doc.Phone))
                                        {
                                            <a href="tel:@doc.Phone" class="staff-contact-link">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                                                <span dir="ltr">@doc.Phone</span>
                                            </a>
                                        }
                                    </div>
                                </div>
                                @if (doc.YearsOfExperience > 0)
                                {
                                    <div class="staff-card-exp">
                                        <span class="staff-exp-badge">@doc.YearsOfExperience+ سنوات</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- ======== STAFF TAB ======== -->
            <div class="tab-pane fade" id="stf" role="tabpanel">
                @if (staffList.Count == 0)
                {
                    <div class="empty-state"><p>لا يوجد موظفين.</p></div>
                }
                else
                {
                    <div class="staff-grid">
                        @foreach (var s in staffList)
                        {
                            <div class="staff-card">
                                <div class="staff-card-avatar">
                                    <span class="staff-card-initial">@(s.FullName?.Length > 0 ? s.FullName[0].ToString() : "م")</span>
                                </div>
                                <div class="staff-card-body">
                                    <h4 class="staff-card-name">@s.FullName</h4>
                                    <div class="staff-card-contact">
                                        @if (!string.IsNullOrEmpty(s.Email))
                                        {
                                            <a href="mailto:@s.Email" class="staff-contact-link">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                                                <span dir="ltr">@s.Email</span>
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(s.PhoneNumber))
                                        {
                                            <a href="tel:@s.PhoneNumber" class="staff-contact-link">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                                                <span dir="ltr">@s.PhoneNumber</span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- ======== RATINGS TAB ======== -->
            <div class="tab-pane fade" id="ratings" role="tabpanel">
                @if (recentRatings.Count == 0)
                {
                    <div class="empty-state"><p>لا توجد تقييمات بعد.</p></div>
                }
                else
                {
                    <div class="ad-score">
                        <span class="ad-score-num" dir="ltr">@avgRating.ToString("F1")</span>
                        <div class="ad-score-meta">
                            <div class="stars-inline">
                                @for (int i = 0; i < fullStars; i++) { <svg class="ad-star ad-star--on" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg> }
                                @if (hasHalf) { <svg class="ad-star" width="16" height="16" viewBox="0 0 24 24"><defs><clipPath id="rhcHalf"><rect x="0" y="0" width="8" height="24"/></clipPath></defs><path class="ad-star--on" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor" clip-path="url(#rhcHalf)"/><path class="ad-star--off" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor" clip-path="url(#rhcHalf)"/></svg> }
                                @for (int i = 0; i < emptyStars; i++) { <svg class="ad-star ad-star--off" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg> }
                            </div>
                            <span>@totalRatings تقييم</span>
                        </div>
                    </div>
                    <div class="timeline ad-timeline">
                        @foreach (var r in recentRatings)
                        {
                            var rFullStars = r.Value;
                            var rEmptyStars = 5 - rFullStars;
                            var initial = r.UserName?.Length > 0 ? r.UserName[0].ToString() : "م";
                            <div class="timeline-item">
                                <div class="timeline-marker"></div>
                                <div class="timeline-content">
                                    <div class="ad-timeline-head">
                                        <span class="ad-timeline-name">@r.UserName</span>
                                        <span class="ad-timeline-date">@r.CreatedAt.ToString("yyyy-MM-dd")</span>
                                    </div>
                                    <div class="stars-inline">
                                        @for (int i = 0; i < rFullStars; i++) { <svg class="ad-star ad-star--on" width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg> }
                                        @for (int i = 0; i < rEmptyStars; i++) { <svg class="ad-star ad-star--off" width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg> }
                                    </div>
                                    @if (!string.IsNullOrEmpty(r.Review))
                                    {
                                        <p class="ad-timeline-text">@r.Review</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&callback=initClinicMap&libraries=places&language=ar" async defer></script>
    <script>
        function initClinicMap() {
            var lat = parseFloat(document.getElementById('clinicDetailLat').value) || 31.0409;
            var lng = parseFloat(document.getElementById('clinicDetailLng').value) || 31.3785;
            var pos = { lat: lat, lng: lng };
            var map = new google.maps.Map(document.getElementById('clinicDetailMap'), {
                center: pos,
                zoom: 15,
                minZoom: 3,
                mapTypeControl: false,
                streetViewControl: false,
                fullscreenControl: false,
                zoomControl: true,
                zoomControlOptions: {
                    position: google.maps.ControlPosition.LEFT_BOTTOM
                }
            });
            var marker = new google.maps.Marker({
                position: pos,
                map: map,
                draggable: true,
                title: '@Html.Raw(clinicName.Replace("'", "\\'"))'
            });
            var info = new google.maps.InfoWindow({
                content: '<strong>@Html.Raw(clinicName.Replace("'", "\\'"))</strong><br/>@Html.Raw((clinic.AddressAr ?? clinic.Address ?? "").Replace("'", "\\'"))'
            });
            marker.addListener('click', function() { info.open(map, marker); });
            info.open(map, marker);

            function updateClinicCoords(latLng) {
                var newLat = latLng.lat().toFixed(6);
                var newLng = latLng.lng().toFixed(6);
                document.getElementById('clinicDetailLat').value = newLat;
                document.getElementById('clinicDetailLng').value = newLng;
                var display = document.getElementById('clinicDetailCoordsDisplay');
                if (display) display.textContent = newLat + ', ' + newLng;
            }
            var display = document.getElementById('clinicDetailCoordsDisplay');
            if (display) display.textContent = lat.toFixed(4) + ', ' + lng.toFixed(4);

            // Pick a new location: click the map, drag the marker, or search.
            map.addListener('click', function(e) {
                marker.setPosition(e.latLng);
                map.panTo(e.latLng);
                updateClinicCoords(e.latLng);
            });
            marker.addListener('dragend', function(e) {
                updateClinicCoords(e.latLng);
            });

            function applyClinicDetailPlace(location, viewport) {
                if (viewport) {
                    map.fitBounds(viewport);
                } else {
                    map.setCenter(location);
                    map.setZoom(16);
                }
                marker.setPosition(location);
                updateClinicCoords(location);
            }

            var searchInput = document.getElementById('clinicDetailPlaceSearch');
            var searchBtn = document.getElementById('clinicDetailPlaceSearchBtn');
            var detailGeocoder = new google.maps.Geocoder();

            function searchClinicDetailPlace() {
                if (!searchInput) return;
                var q = searchInput.value.trim();
                if (!q) {
                    searchInput.focus();
                    return;
                }
                detailGeocoder.geocode({ address: q }, function(results, status) {
                    if (status === 'OK' && results && results[0] && results[0].geometry) {
                        applyClinicDetailPlace(results[0].geometry.location, results[0].geometry.viewport);
                    } else {
                        showErrorModal('لم نعثر على نتائج مطابقة. جرّب صياغة أخرى للعنوان.');
                    }
                });
            }

            if (searchInput && google.maps.places) {
                var autocomplete = new google.maps.places.Autocomplete(searchInput);
                autocomplete.addListener('place_changed', function() {
                    var place = autocomplete.getPlace();
                    if (!place.geometry || !place.geometry.location) {
                        searchClinicDetailPlace();
                        return;
                    }
                    applyClinicDetailPlace(place.geometry.location, place.geometry.viewport);
                });
                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        searchClinicDetailPlace();
                    }
                });
            }

            if (searchBtn) {
                searchBtn.addEventListener('click', searchClinicDetailPlace);
            }
        }

        (function() {
            var csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
            var editMode = false;
            var editBtn = document.getElementById('editClinicBtn');
            var cancelBtn = document.getElementById('cancelEditBtn');
            var saveBtn = document.getElementById('saveClinicBtn');
            var form = document.getElementById('updateClinicForm');
            var detailHeader = document.querySelector('.clinic-detail-header');
            var container = detailHeader ? detailHeader.parentNode : document.body;

            function toggleEditMode(enable) {
                editMode = enable;
                var inputs = form.querySelectorAll('input:not([type="hidden"]):not([name="email"]), select, textarea');
                if (enable) {
                    container.classList.add('edit-mode');
                    editBtn.style.display = 'none';
                    cancelBtn.style.display = 'inline-flex';
                    saveBtn.style.display = 'inline-flex';
                    inputs.forEach(function(el) { el.removeAttribute('disabled'); });
                } else {
                    container.classList.remove('edit-mode');
                    editBtn.style.display = 'inline-flex';
                    cancelBtn.style.display = 'none';
                    saveBtn.style.display = 'none';
                    inputs.forEach(function(el) { el.setAttribute('disabled', 'disabled'); });
                }
            }

            function clearErrors() {
                var summary = document.getElementById('updateClinicErrors');
                if (summary) { summary.style.display = 'none'; summary.innerHTML = ''; }
            }

            function showErrors(msg) {
                var summary = document.getElementById('updateClinicErrors');
                if (summary) { summary.innerHTML = msg; summary.style.display = 'block'; }
            }

            editBtn.addEventListener('click', function() { toggleEditMode(true); });

            function cancelEdit() {
                toggleEditMode(false);
                clearErrors();
                location.reload();
            }

            cancelBtn.addEventListener('click', cancelEdit);

            function formatTime(val) {
                if (!val) return null;
                return val.indexOf(':') >= 0 && val.split(':').length === 2 ? val + ':00' : val;
            }

            function buildPayload() {
                var specId = form.querySelector('[name="specializationId"]').value;
                var whStart = formatTime(form.querySelector('[name="workingHoursStart"]').value);
                var whEnd = formatTime(form.querySelector('[name="workingHoursEnd"]').value);
                var data = {
                    nameAr: form.querySelector('[name="nameAr"]').value,
                    arDescription: form.querySelector('[name="arDescription"]').value,
                    addressAr: form.querySelector('[name="addressAr"]').value,
                    phone: form.querySelector('[name="phone"]').value,
                    email: form.querySelector('[name="email"]').value,
                    website: form.querySelector('[name="website"]').value,
                    specializationId: specId || '00000000-0000-0000-0000-000000000000',
                    workingHours: form.querySelector('[name="workingHours"]').value,
                    workingDays: []
                };
                var latVal = parseFloat(document.getElementById('clinicDetailLat').value);
                var lngVal = parseFloat(document.getElementById('clinicDetailLng').value);
                if (!isNaN(latVal) && !isNaN(lngVal)) {
                    data.latitude = latVal;
                    data.longitude = lngVal;
                }
                if (whStart) data.workingHoursStart = whStart;
                if (whEnd) data.workingHoursEnd = whEnd;
                return data;
            }

            function sendUpdateRequest(data) {
                var clinicId = '@clinic.Id';
                fetch('@Url.Action("UpdateClinic", "Admin")/' + clinicId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
                    body: JSON.stringify(data)
                })
                .then(function(r) { return r.json(); })
                .then(function(result) {
                    saveBtn.disabled = false;
                    saveBtn.textContent = 'حفظ التغييرات';
                    if (result.success) {
                        showSuccessModal(result.message);
                        setTimeout(function() { location.reload(); }, 1000);
                    } else {
                        showErrors(result.error || result.message || 'حدث خطأ');
                        showErrorModal(result.error || 'حدث خطأ');
                    }
                })
                .catch(function() {
                    saveBtn.disabled = false;
                    saveBtn.textContent = 'حفظ التغييرات';
                    showErrors('عذراً، حدث خطأ أثناء تحديث العيادة.');
                    showErrorModal('عذراً، حدث خطأ أثناء تحديث العيادة.');
                });
            }

            function submitUpdate() {
                clearErrors();

                var dayChecks = form.querySelectorAll('[name="workingDays"]:checked');

                saveBtn.disabled = true;
                saveBtn.textContent = 'جاري الحفظ...';

                var data = buildPayload();
                data.workingDays = [];
                dayChecks.forEach(function(c) { data.workingDays.push(parseInt(c.value)); });
                if (data.workingDays.length === 0) delete data.workingDays;
                sendUpdateRequest(data);
            }

            saveBtn.addEventListener('click', submitUpdate);

            // Toggle clinic active status
            var toggleBtn = document.getElementById('toggleClinicStatusBtn');
            toggleBtn.addEventListener('click', function() {
                var clinicId = this.getAttribute('data-clinic-id');
                var isActive = this.getAttribute('data-is-active') === 'true';
                var action = isActive ? 'DeactivateClinic' : 'ActivateClinic';
                var confirmMsg = isActive ? 'هل أنت متأكد من إلغاء تفعيل هذه العيادة؟' : 'هل أنت متأكد من تفعيل هذه العيادة؟';

                showConfirmModal(confirmMsg, function(confirmed) {
                    if (!confirmed) return;

                    var btn = toggleBtn;
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';

                    fetch('@Url.Action("ActivateClinic", "Admin")'.replace('ActivateClinic', action) + '/' + clinicId, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken }
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(result) {
                        if (result.success) {
                            showSuccessModal(result.message);
                            setTimeout(function() { location.reload(); }, 1000);
                        } else {
                            btn.disabled = false;
                            showErrorModal(result.error || 'حدث خطأ');
                        }
                    })
                    .catch(function() {
                        btn.disabled = false;
                        showErrorModal('عذراً، حدث خطأ أثناء تحديث حالة العيادة.');
                    });
                });
            });
        })();
    </script>
}
