@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "الطلبات";
    Layout = "_AdminLayout";
    ViewBag.SubSidebarSection = "requests";
    ViewBag.UserId = ViewBag.UserId is Guid g ? g : (Guid?)null;
    var requests = ViewBag.Requests as List<AdminUserRequestDto> ?? new();

    string RoleLabel(int r) => r switch
    {
        16 => "مدير عيادة",
        4 => "طبيب",
        8 => "موظف عيادة",
        _ => "غير معروف"
    };

    string StatusLabel(int s) => s switch
    {
        0 => "قيد الانتظار",
        1 => "مقبول",
        2 => "مرفوض",
        _ => "-"
    };

    string StatusClass(int s) => s switch
    {
        0 => "badge-warning",
        1 => "badge-success",
        2 => "badge-danger",
        _ => "badge-subtle"
    };
}

<div class="user-detail-layout">
    <partial name="_UserSubSidebar" />

    <div class="user-detail-content">
        <div class="page-header">
            <h2 class="page-title">طلبات المستخدم</h2>
        </div>

        <div class="table-card">
            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>نوع الطلب</th>
                            <th>الحالة</th>
                            <th>تاريخ الطلب</th>
                            <th>تاريخ المراجعة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in requests)
                        {
                            <tr>
                                <td><span class="badge badge-info">@RoleLabel(r.RequestedRole)</span></td>
                                <td><span class="badge @StatusClass(r.Status)">@StatusLabel(r.Status)</span></td>
                                <td class="text-md">@r.RequestedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-md">@(r.ReviewedAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                            </tr>
                        }
                        @if (requests.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted">لا توجد طلبات لهذا المستخدم.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
