@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "نظرة عامة على المستخدم";
    Layout = "_AdminLayout";
    ViewBag.SubSidebarSection = "overview";
    var u = ViewBag.User as AdminUserOverviewDto ?? new AdminUserOverviewDto();
    ViewBag.UserId = u.Id;

    string RoleLabel(string r) => r switch
    {
        "SuperAdmin" or "SystemAdmin" => "مدير النظام",
        "ClinicOwner" or "ClinicManager" => "مدير عيادة",
        "Doctor" => "طبيب",
        "ClinicStaff" => "موظف عيادة",
        _ => "مريض"
    };

    string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "؟";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}" : parts[0].Substring(0, 1);
    }
}

<div class="user-detail-layout">
    <partial name="_UserSubSidebar" />

    <div class="user-detail-content">
        <!-- Profile Header -->
        <div class="user-profile-header">
            <div class="user-profile-avatar-lg">
                @if (!string.IsNullOrWhiteSpace(u.ImageUrl))
                {
                    <img src="@u.ImageUrl" alt="@u.FullName" class="header-avatar-img" />
                }
                else
                {
                    <span>@Initials(u.FullName)</span>
                }
            </div>
            <div class="user-profile-info">
                <h2 class="user-profile-name">@u.FullName</h2>
                <p class="user-profile-contact">@u.Email &middot; @(string.IsNullOrWhiteSpace(u.Phone) ? "—" : u.Phone)</p>
                <div class="role-list">
                    @foreach (var role in u.Roles)
                    {
                        <span class="badge badge-info">@RoleLabel(role)</span>
                    }
                    @if (u.Roles.Count == 0)
                    {
                        <span class="badge badge-subtle">مريض</span>
                    }
                </div>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="user-stats-row">
            <div class="user-stat-card">
                <span class="user-stat-value">@u.TotalAppointments</span>
                <span class="user-stat-label">إجمالي المواعيد</span>
            </div>
            <div class="user-stat-card">
                <span class="user-stat-value">@u.TotalVisits</span>
                <span class="user-stat-label">الزيارات المكتملة</span>
            </div>
            <div class="user-stat-card">
                <span class="user-stat-value">@(u.ReviewCount > 0 ? u.AvgRating?.ToString("F1") : "—")</span>
                <span class="user-stat-label">متوسط التقييم @(u.ReviewCount > 0 ? $"({u.ReviewCount} تقييم)" : "")</span>
            </div>
            <div class="user-stat-card">
                <span class="user-stat-value">@u.TotalSpent.ToString("N0")</span>
                <span class="user-stat-label">إجمالي المدفوعات (ج.م)</span>
            </div>
        </div>

        <!-- Information Card -->
        <div class="detail-card">
            <h3 class="detail-card-title">معلومات المستخدم</h3>
            <div class="detail-info-list">
                <div class="detail-info-row">
                    <span class="detail-info-label">الاسم الكامل</span>
                    <span class="detail-info-value">@u.FullName</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">البريد الإلكتروني</span>
                    <span class="detail-info-value">@u.Email</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">رقم الهاتف</span>
                    <span class="detail-info-value">@(string.IsNullOrWhiteSpace(u.Phone) ? "—" : u.Phone)</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">تاريخ التسجيل</span>
                    <span class="detail-info-value">@u.CreatedAt.ToString("yyyy-MM-dd")</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">الحالة</span>
                    <span class="detail-info-value">
                        @if (u.IsActive)
                        {
                            <span class="badge badge-success">نشط</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">غير نشط</span>
                        }
                    </span>
                </div>
            </div>
        </div>

        <!-- Change Password -->
        <div class="detail-card">
            <h3 class="detail-card-title">تغيير كلمة المرور</h3>
            <form method="post" action="/Admin/Users/ChangePassword" id="overviewChangePasswordForm">
                <input type="hidden" name="id" value="@u.Id" />
                <div class="form-group">
                    <label class="form-label" for="overviewNewPassword">كلمة المرور الجديدة</label>
                    <input type="password" id="overviewNewPassword" name="newPassword" class="form-input" placeholder="********" required minlength="6" autocomplete="new-password" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="overviewConfirmPassword">تأكيد كلمة المرور</label>
                    <input type="password" id="overviewConfirmPassword" name="confirmPassword" class="form-input" placeholder="********" required minlength="6" autocomplete="new-password" />
                </div>
                <button type="submit" class="btn btn-primary">تحديث كلمة المرور</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var pwdForm = document.getElementById('overviewChangePasswordForm');
            if (pwdForm) {
                pwdForm.addEventListener('submit', function (e) {
                    var pwd = document.getElementById('overviewNewPassword');
                    var confirm = document.getElementById('overviewConfirmPassword');
                    if (pwd && confirm && pwd.value !== confirm.value) {
                        e.preventDefault();
                        if (typeof showErrorModal === 'function') showErrorModal('كلمة المرور غير متطابقة');
                    }
                });
            }
        })();
    </script>
}
