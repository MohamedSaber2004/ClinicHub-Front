@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "الزيارات والتقييمات";
    Layout = "_AdminLayout";
    ViewBag.SubSidebarSection = "visits";
    ViewBag.UserId = ViewBag.UserId is Guid g ? g : (Guid?)null;
    var visits = ViewBag.Visits as List<AdminUserVisitDto> ?? new();

    string StatusLabel(int s) => s switch
    {
        0 => "معلق",
        1 => "مؤكد",
        2 => "ملغي",
        3 => "مكتمل",
        4 => "محجوز",
        5 => "لم يحضر",
        6 => "مقبول",
        7 => "مرفوض",
        _ => "-"
    };

    string StatusClass(int s) => s switch
    {
        3 => "badge-success",
        2 or 7 or 5 => "badge-danger",
        0 or 1 or 4 or 6 => "badge-info",
        _ => "badge-subtle"
    };
}

<div class="user-detail-layout">
    <partial name="_UserSubSidebar" />

    <div class="user-detail-content">
        <div class="page-header">
            <h2 class="page-title">سجل الزيارات</h2>
        </div>

        <div class="table-card">
            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>الطبيب</th>
                            <th>التخصص</th>
                            <th>التاريخ</th>
                            <th>الوقت</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var i = 0; }
                        @foreach (var v in visits)
                        {
                            i++;
                            <tr>
                                <td class="text-md">@i</td>
                                <td class="text-md-medium">@v.DoctorName</td>
                                <td class="text-md">@v.Specialty</td>
                                <td class="text-md">@v.AppointmentDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-md">@v.StartTime.ToString(@"hh\:mm")</td>
                                <td><span class="badge @StatusClass(v.Status)">@StatusLabel(v.Status)</span></td>
                            </tr>
                        }
                        @if (visits.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted">لا توجد زيارات مسجلة لهذا المستخدم.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
