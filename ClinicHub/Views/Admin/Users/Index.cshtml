@using ClinicHub.Services.ReponseModels
@using ClinicHub.Routes
@{
    ViewData["Title"] = "المستخدمين";
    Layout = "_AdminLayout";
    var users = ViewBag.Users as List<UserListItemDto> ?? new();
    var statusFilter = ViewBag.StatusFilter as string;
    var userTypesFilter = ViewBag.UserTypesFilter as string;
    var searchTerm = ViewBag.SearchTerm as string;
    var hasFilters = !string.IsNullOrWhiteSpace(searchTerm) || !string.IsNullOrWhiteSpace(statusFilter) || !string.IsNullOrWhiteSpace(userTypesFilter);
}

<div class="page-header">
    <h2 class="page-title">
        <span class="page-title-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 2 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="currentColor"/>
            </svg>
        </span>
        إدارة المستخدمين والمرضى
    </h2>
    <button type="button" class="btn btn-primary" id="addUserBtn" title="إضافة مستخدم">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
        </svg>
        إضافة مستخدم
    </button>
</div>

<!-- Filter Bar -->
<form method="get" action="/Admin/Users" class="filter-bar">
    <input type="text" id="filterSearch" name="searchTerm" class="form-input" placeholder="بحث بالاسم أو البريد أو الهاتف..." value="@searchTerm" />
    <select id="filterUserTypes" name="userTypes" class="form-select" onchange="this.form.submit()">
        <option value="">جميع الأدوار</option>
        <option value="2" selected="@(userTypesFilter == "2" ? true : null)">مدير النظام</option>
        <option value="16" selected="@(userTypesFilter == "16" ? true : null)">مدير عيادة</option>
        <option value="4" selected="@(userTypesFilter == "4" ? true : null)">طبيب</option>
        <option value="8" selected="@(userTypesFilter == "8" ? true : null)">موظف</option>
        <option value="1" selected="@(userTypesFilter == "1" ? true : null)">مريض</option>
    </select>
    <select id="filterStatus" name="status" class="form-select" onchange="this.form.submit()">
        <option value="">جميع الحالات</option>
        <option value="نشط" selected="@(statusFilter == "نشط" ? true : null)">نشط</option>
        <option value="غير نشط" selected="@(statusFilter == "غير نشط" ? true : null)">غير نشط</option>
    </select>
    <button type="submit" class="btn btn-secondary btn-sm">بحث</button>
    @if (hasFilters)
    {
        <a href="/Admin/Users" class="btn btn-secondary btn-sm">مسح الفلاتر</a>
    }
</form>

<!-- Users Table -->
<div class="table-card">
    <div class="table-responsive">
        <table class="custom-table users-table">
            <thead>
                <tr>
                    <th>المستخدم</th>
                    <th>البريد الإلكتروني</th>
                    <th>الهاتف</th>
                    <th>الدور</th>
                    <th>تاريخ التسجيل</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in users)
                {
                    <tr>
                        <td>
                            <div class="table-user">
                                <div class="table-avatar table-avatar--md">
                                    @if (!string.IsNullOrWhiteSpace(u.Image))
                                    {
                                        <img src="@u.Image" alt="@u.Name" loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <span>@u.Initials</span>
                                    }
                                </div>
                                <span class="table-user-name">@u.Name</span>
                            </div>
                        </td>
                        <td class="text-md">@u.Email</td>
                        <td class="text-md">@u.Phone</td>
                        <td>
                            <div class="role-list">
                            @{
                                var roleNames = u.Roles.Count > 0 ? u.Roles : new List<string> { u.Role };
                                foreach (var r in roleNames)
                                {
                                    var roleName = r switch
                                    {
                                        "SystemAdmin" => "مدير النظام",
                                        "ClinicOwner" => "مدير عيادة",
                                        "ClinicManager" => "مدير عيادة",
                                        "Doctor" => "طبيب",
                                        "ClinicStaff" => "موظف",
                                        _ => "مريض"
                                    };
                                    <span class="badge badge-info">@roleName</span>
                                }
                            }
                            </div>
                        </td>
                        <td class="text-md">@u.RegistrationDate</td>
                        <td><span class="badge @u.StatusClass">@u.Status</span></td>
                        <td>
                            <div class="table-actions">
                                <a class="btn-icon" title="عرض التفاصيل" aria-label="عرض تفاصيل المستخدم @u.Name"
                                   href="@AdminRoutes.Pages.UsersOverview(u.Id)">
                                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                    </svg>
                                </a>
                                <button type="button" class="btn-icon btn-edit-user" title="تعديل" aria-label="تعديل المستخدم @u.Name"
                                        data-id="@u.Id"
                                        data-name="@u.Name"
                                        data-email="@u.Email"
                                        data-phone="@u.Phone"
                                        data-active="@(u.StatusClass == "badge-success" ? "true" : "false")">
                                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                    </svg>
                                </button>
                                <button type="button" class="btn-icon btn-change-password" title="تغيير كلمة المرور" aria-label="تغيير كلمة مرور المستخدم @u.Name"
                                        data-id="@u.Id"
                                        data-name="@u.Name">
                                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2z"/>
                                    </svg>
                                </button>
                                <button type="button" class="btn-icon btn-delete-user" title="حذف" aria-label="حذف المستخدم @u.Name"
                                        data-id="@u.Id"
                                        data-name="@u.Name">
                                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (users.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted table-empty">لا يوجد مستخدمون مطابقون لمعايير البحث.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" />

<form id="createUserForm" method="post" action="/Admin/Users/Create">
    <div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content modal-content-custom">
                <div class="modal-header-custom">
                    <h5 class="modal-title">إضافة مستخدم جديد</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body-custom">
                    <div class="create-user-grid">
                    <div class="form-group">
                        <label class="form-label" for="createFullName">الاسم الكامل</label>
                        <input type="text" id="createFullName" name="FullName" class="form-input" placeholder="مثال: محمد عمر" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createEmail">البريد الإلكتروني</label>
                        <input type="email" id="createEmail" name="Email" class="form-input" placeholder="example@gmail.com" required dir="ltr" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createPhone">رقم الهاتف</label>
                        <input type="text" id="createPhone" name="PhoneNumber" class="form-input" placeholder="010 12345678" required dir="ltr" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createPassword">كلمة المرور</label>
                        <input type="password" id="createPassword" name="Password" class="form-input" placeholder="********" required minlength="6" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createBirthDate">تاريخ الميلاد</label>
                        <input type="date" id="createBirthDate" name="BirthDate" class="form-input" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createGender">الجنس</label>
                        <select id="createGender" name="Gender" class="form-select" required>
                            <option value="1">ذكر</option>
                            <option value="2">أنثى</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createRole">الدور</label>
                            <select id="createRole" name="Role" class="form-select" required>
                                <option value="1">مريض</option>
                                <option value="4">طبيب</option>
                                <option value="8">موظف</option>
                                <option value="16">مدير عيادة</option>
                                <option value="2">مدير النظام</option>
                            </select>
                    </div>
                    </div>
                    <div class="form-group form-group-hidden" id="clinicGroup">
                        <label class="form-label" for="createClinic">العيادة</label>
                        <select id="createClinic" name="ClinicId" class="form-select">
                            <option value="">اختر عيادة</option>
                            @if (ViewBag.Clinics != null)
                            {
                                foreach (var c in ViewBag.Clinics)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group form-group-hidden" id="doctorFields">
                        <label class="form-label" for="createSpecialization">التخصص</label>
                        <select id="createSpecialization" name="SpecializationId" class="form-select">
                            <option value="">اختر تخصص</option>
                            @if (ViewBag.Specializations != null)
                            {
                                foreach (var s in ViewBag.Specializations)
                                {
                                    <option value="@s.Id">@s.ArName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group form-group-hidden" id="bioGroup">
                        <label class="form-label" for="createBio">نبذة تعريفية</label>
                        <textarea id="createBio" name="Bio" class="form-input" rows="3" placeholder="نبذة عن الطبيب"></textarea>
                    </div>
                    <div class="form-group form-group-hidden" id="experienceGroup">
                        <label class="form-label" for="createExperience">سنوات الخبرة</label>
                        <input type="number" id="createExperience" name="YearsOfExperience" class="form-input" placeholder="مثال: 5" min="0" />
                    </div>
                    <div class="form-group form-group-hidden" id="availabilitiesGroup">
                        <label class="form-label">أوقات العمل (اختياري)</label>
                        <div id="adminAvailabilityContainer">
                            <div class="availability-row" data-index="0">
                                <select class="availability-day form-select" aria-label="اليوم">
                                    <option value="">اليوم</option>
                                    <option value="0">الأحد</option>
                                    <option value="1">الإثنين</option>
                                    <option value="2">الثلاثاء</option>
                                    <option value="3">الأربعاء</option>
                                    <option value="4">الخميس</option>
                                    <option value="5">الجمعة</option>
                                    <option value="6">السبت</option>
                                </select>
                                <select class="availability-from-hour form-select" aria-label="ساعة البدء">
                                    <option value="">—</option>
                                    @for (var i = 1; i <= 12; i++)
                                    {
                                        <option value="@i" selected="@(i == 9 ? true : null)">@i</option>
                                    }
                                </select>
                                <select class="availability-from-minute form-select" aria-label="دقيقة البدء">
                                    @for (var i = 0; i <= 59; i++)
                                    {
                                        var mm = i.ToString("00");
                                        <option value="@mm" selected="@(i == 0 ? true : null)">@mm</option>
                                    }
                                </select>
                                <select class="availability-from-period form-select" aria-label="فترة البدء">
                                    <option value="AM" selected>صباحاً</option>
                                    <option value="PM">مساءً</option>
                                </select>
                                <span class="availability-sep">إلى</span>
                                <select class="availability-to-hour form-select" aria-label="ساعة الانتهاء">
                                    <option value="">—</option>
                                    @for (var i = 1; i <= 12; i++)
                                    {
                                        <option value="@i" selected="@(i == 5 ? true : null)">@i</option>
                                    }
                                </select>
                                <select class="availability-to-minute form-select" aria-label="دقيقة الانتهاء">
                                    @for (var i = 0; i <= 59; i++)
                                    {
                                        var mm = i.ToString("00");
                                        <option value="@mm" selected="@(i == 0 ? true : null)">@mm</option>
                                    }
                                </select>
                                <select class="availability-to-period form-select" aria-label="فترة الانتهاء">
                                    <option value="AM">صباحاً</option>
                                    <option value="PM" selected>مساءً</option>
                                </select>
                                <button type="button" class="availability-remove-btn" title="حذف" aria-label="حذف اليوم"><i class="bi bi-x-circle" aria-hidden="true"></i></button>
                            </div>
                        </div>
                        <button type="button" id="addAdminAvailabilityBtn" class="btn btn-sm add-availability-btn">
                            <i class="bi bi-plus-circle"></i> إضافة يوم
                        </button>
                        <input type="hidden" id="createAvailabilitiesJson" name="availabilitiesJson" value="" />
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </div>
        </div>
    </div>
</form>

