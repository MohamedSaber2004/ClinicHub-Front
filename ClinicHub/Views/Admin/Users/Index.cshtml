@section Scripts {
    <script>
        (function() {
            var ADMIN_DAY_NAMES = ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];
            var FIXED_SLOT_MINUTES = 30;

            function parse12(timeStr) {
                if (!timeStr) return null;
                var parts = String(timeStr).split(':');
                var h = parseInt(parts[0], 10);
                var m = parts[1] ? ('00' + parts[1]).slice(-2) : '00';
                if (isNaN(h) || h < 0 || h > 23) return null;
                var period = h >= 12 ? 'PM' : 'AM';
                var hour12 = h % 12;
                if (hour12 === 0) hour12 = 12;
                return { hour: hour12, minute: m, period: period };
            }

            function timeSelectsHtml(prefix, timeStr, prefixLabel) {
                var t = parse12(timeStr);
                var hourOptions = '<option value="">—</option>';
                for (var i = 1; i <= 12; i++) {
                    hourOptions += '<option value="' + i + '"' + (t && t.hour === i ? ' selected' : '') + '>' + i + '</option>';
                }
                var minuteOptions = '';
                for (var j = 0; j <= 59; j++) {
                    var mm = (j < 10 ? '0' : '') + j;
                    minuteOptions += '<option value="' + mm + '"' + (t && t.minute === mm ? ' selected' : '') + '>' + mm + '</option>';
                }
                return '<select class="availability-' + prefix + '-hour form-select" aria-label="' + prefixLabel + ' الساعة">' + hourOptions + '</select>' +
                    '<select class="availability-' + prefix + '-minute form-select" aria-label="' + prefixLabel + ' الدقيقة">' + minuteOptions + '</select>' +
                    '<select class="availability-' + prefix + '-period form-select" aria-label="' + prefixLabel + ' الفترة">' +
                        '<option value="AM"' + (!t || t.period === 'AM' ? ' selected' : '') + '>صباحاً</option>' +
                        '<option value="PM"' + (t && t.period === 'PM' ? ' selected' : '') + '>مساءً</option>' +
                    '</select>';
            }

            function readTime(row, prefix) {
                var hourEl = row.querySelector('.availability-' + prefix + '-hour');
                var minEl = row.querySelector('.availability-' + prefix + '-minute');
                var perEl = row.querySelector('.availability-' + prefix + '-period');
                if (!hourEl || !minEl || !perEl || !hourEl.value) return null;
                var h = parseInt(hourEl.value, 10);
                var m = minEl.value || '00';
                var p = perEl.value || 'AM';
                if (isNaN(h)) return null;
                var h24 = h % 12;
                if (p === 'PM') h24 += 12;
                if (p === 'AM' && h === 12) h24 = 0;
                return (h24 < 10 ? '0' + h24 : h24) + ':' + m;
            }

            function bindRemoveButton(row) {
                var btn = row.querySelector('.availability-remove-btn');
                if (btn) btn.addEventListener('click', function () { row.remove(); });
            }

            function addAdminAvailabilityRow(day, fromTime, toTime) {
                var container = document.getElementById('adminAvailabilityContainer');
                if (!container) return;
                var index = container.children.length;
                var dayOpts = '<option value="">اليوم</option>' + ADMIN_DAY_NAMES.map(function (n, i) {
                    return '<option value="' + i + '"' + (day === i ? ' selected' : '') + '>' + n + '</option>';
                }).join('');
                var row = document.createElement('div');
                row.className = 'availability-row';
                row.setAttribute('data-index', index);
                row.innerHTML =
                    '<select class="availability-day form-select" aria-label="اليوم">' + dayOpts + '</select>' +
                    timeSelectsHtml('from', fromTime || '09:00', 'وقت البدء') +
                    '<span class="availability-sep">إلى</span>' +
                    timeSelectsHtml('to', toTime || '17:00', 'وقت الانتهاء') +
                    '<button type="button" class="availability-remove-btn" title="حذف" aria-label="حذف اليوم"><i class="bi bi-x-circle" aria-hidden="true"></i></button>';
                bindRemoveButton(row);
                container.appendChild(row);
            }

            function serializeAdminAvailabilities() {
                var hidden = document.getElementById('createAvailabilitiesJson');
                if (!hidden) return;
                var rows = document.querySelectorAll('#adminAvailabilityContainer .availability-row');
                var availabilities = [];
                rows.forEach(function (row) {
                    var dayEl = row.querySelector('.availability-day');
                    if (!dayEl || dayEl.value === '') return;
                    var day = parseInt(dayEl.value, 10);
                    var fromTime = readTime(row, 'from');
                    var toTime = readTime(row, 'to');
                    if (!isNaN(day) && day >= 0 && fromTime && toTime) {
                        availabilities.push({
                            dayOfWeek: day,
                            startTime: fromTime + ':00',
                            endTime: toTime + ':00',
                            slotDurationMinutes: FIXED_SLOT_MINUTES
                        });
                    }
                });
                hidden.value = JSON.stringify(availabilities);
            }

            function toggleRoleGroups() {
                var roleEl = document.getElementById('createRole');
                if (!roleEl) return;
                var val = parseInt(roleEl.value, 10);
                var showClinic = val === 4 || val === 8 || val === 16;
                var showDoctorFields = val === 4 || val === 16;
                var groups = {
                    clinicGroup: showClinic,
                    doctorFields: showDoctorFields,
                    bioGroup: showDoctorFields,
                    experienceGroup: showDoctorFields,
                    availabilitiesGroup: showDoctorFields
                };
                Object.keys(groups).forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) el.classList.toggle('form-group-hidden', !groups[id]);
                });
            }

            var createModalEl = document.getElementById('createUserModal');
            var createModal = createModalEl ? new bootstrap.Modal(createModalEl) : null;
            var addUserBtn = document.getElementById('addUserBtn');
            if (addUserBtn && createModal) {
                addUserBtn.addEventListener('click', function() {
                    var form = document.getElementById('createUserForm');
                    if (form) form.reset();
                    var container = document.getElementById('adminAvailabilityContainer');
                    if (container) {
                        container.innerHTML = '';
                        addAdminAvailabilityRow();
                    }
                    var hidden = document.getElementById('createAvailabilitiesJson');
                    if (hidden) hidden.value = '';
                    toggleRoleGroups();
                    createModal.show();
                });
            }

            var deleteForm = document.getElementById('deleteUserForm');
            var deleteIdInput = document.getElementById('deleteUserId');
            var deleteNameEl = document.getElementById('deleteUserName');
            var deleteModalEl = document.getElementById('deleteConfirmModal');
            var deleteModal = deleteModalEl ? new bootstrap.Modal(deleteModalEl) : null;

            document.querySelectorAll('.btn-delete-user').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    if (deleteIdInput) deleteIdInput.value = btn.getAttribute('data-id') || '';
                    if (deleteNameEl) deleteNameEl.textContent = btn.getAttribute('data-name') || '';
                    if (deleteModal) deleteModal.show();
                });
            });

            var confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
            if (confirmDeleteBtn) {
                confirmDeleteBtn.addEventListener('click', function() {
                    if (deleteForm) deleteForm.submit();
                });
            }

            var changePasswordModalEl = document.getElementById('changePasswordModal');
            var changePasswordModal = changePasswordModalEl ? new bootstrap.Modal(changePasswordModalEl) : null;
            var changePasswordUserId = document.getElementById('changePasswordUserId');
            var changePasswordUserName = document.getElementById('changePasswordUserName');

            document.querySelectorAll('.btn-change-password').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    if (changePasswordUserId) changePasswordUserId.value = btn.getAttribute('data-id') || '';
                    if (changePasswordUserName) changePasswordUserName.textContent = btn.getAttribute('data-name') || '';
                    var pwdForm = document.getElementById('changePasswordForm');
                    if (pwdForm) pwdForm.reset();
                    if (changePasswordModal) changePasswordModal.show();
                });
            });

            var changePasswordForm = document.getElementById('changePasswordForm');
            if (changePasswordForm) {
                changePasswordForm.addEventListener('submit', function(e) {
                    var pwd = document.getElementById('newPassword');
                    var confirm = document.getElementById('confirmPassword');
                    if (pwd && confirm && pwd.value !== confirm.value) {
                        e.preventDefault();
                        if (typeof showErrorModal === 'function') showErrorModal('كلمة المرور غير متطابقة');
                    }
                });
            }

            var editModalEl = document.getElementById('editUserModal');
            var editUserModal = editModalEl ? new bootstrap.Modal(editModalEl) : null;
            var editUserId = document.getElementById('editUserId');
            var editUserName = document.getElementById('editUserName');
            var editUserPhone = document.getElementById('editUserPhone');
            var editUserStatus = document.getElementById('editUserStatus');

            document.querySelectorAll('.btn-edit-user').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    if (editUserId) editUserId.value = btn.getAttribute('data-id') || '';
                    if (editUserName) editUserName.value = btn.getAttribute('data-name') || '';
                    if (editUserPhone) editUserPhone.value = btn.getAttribute('data-phone') || '';
                    if (editUserStatus) editUserStatus.value = btn.getAttribute('data-active') || 'true';
                    if (editUserModal) editUserModal.show();
                });
            });

            document.querySelectorAll('#adminAvailabilityContainer .availability-remove-btn').forEach(function(btn) {
                btn.addEventListener('click', function () {
                    var row = btn.closest('.availability-row');
                    if (row) row.remove();
                });
            });

            var createRole = document.getElementById('createRole');
            if (createRole) createRole.addEventListener('change', toggleRoleGroups);
            toggleRoleGroups();

            var createForm = document.getElementById('createUserForm');
            if (createForm) {
                createForm.addEventListener('submit', function () {
                    serializeAdminAvailabilities();
                });
            }

            var addAvailabilityBtn = document.getElementById('addAdminAvailabilityBtn');
            if (addAvailabilityBtn) {
                addAvailabilityBtn.addEventListener('click', function () {
                    addAdminAvailabilityRow();
                });
            }
        })();
    </script>
}
