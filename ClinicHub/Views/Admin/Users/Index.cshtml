@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "المستخدمين";
    Layout = "_AdminLayout";
    var users = ViewBag.Users as List<UserListItemDto> ?? new();
    var statusFilter = ViewBag.StatusFilter as string;
    var isActiveSelected = statusFilter == "نشط";
    var isInactiveSelected = statusFilter == "غير نشط";
    var userTypesFilter = ViewBag.UserTypesFilter as string;
}

<div class="page-header">
    <h2 class="page-title">إدارة المستخدمين والمرضى</h2>
    <button type="button" class="btn btn-primary" id="addUserBtn" title="إضافة مستخدم">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
        </svg>
        إضافة مستخدم
    </button>
</div>

<!-- Filter Bar -->
<form method="get" action="/Admin/Users" class="filter-bar">
    <input type="text" id="filterSearch" name="searchTerm" class="form-input" placeholder="بحث عن مستخدم..." value="@ViewBag.SearchTerm" />
    <select id="filterUserTypes" name="userTypes" class="form-select" onchange="this.form.submit()">
        <option value="">جميع الأدوار</option>
        <option value="2" selected="@(userTypesFilter == "2")">مدير النظام</option>
        <option value="16" selected="@(userTypesFilter == "16")">مدير عيادة</option>
        <option value="4" selected="@(userTypesFilter == "4")">طبيب</option>
        <option value="8" selected="@(userTypesFilter == "8")">موظف</option>
        <option value="1" selected="@(userTypesFilter == "1")">مريض</option>
    </select>
    <select id="filterStatus" name="status" class="form-select" onchange="this.form.submit()">
        <option value="">جميع الحالات</option>
        <option value="نشط" selected="@isActiveSelected">نشط</option>
        <option value="غير نشط" selected="@isInactiveSelected">غير نشط</option>
    </select>
</form>

<!-- Users Table -->
<div class="table-card">
    <div class="table-responsive">
        <table class="custom-table users-table">
            <thead>
                <tr>
                    <th>المستخدم</th>
                    <th>البريد الإلكتروني</th>
                    <th>الهاتف</th>
                    <th>الدور</th>
                    <th>تاريخ التسجيل</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in users)
                {
                    <tr>
                        <td>
                            <div class="table-user">
                                <div class="table-avatar table-avatar--md">
                                    @if (!string.IsNullOrWhiteSpace(u.Image))
                                    {
                                        <img src="@u.Image" alt="@u.Name" loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <span>@u.Initials</span>
                                    }
                                </div>
                                <span class="table-user-name">@u.Name</span>
                            </div>
                        </td>
                        <td class="text-md">@u.Email</td>
                        <td class="text-md">@u.Phone</td>
                        <td>
                            <div class="role-list">
                            @{
                                var roleNames = u.Roles.Count > 0 ? u.Roles : new List<string> { u.Role };
                                foreach (var r in roleNames)
                                {
                                    var roleName = r switch
                                    {
                                        "SystemAdmin" => "مدير النظام",
                                        "ClinicOwner" => "مدير عيادة",
                                        "ClinicManager" => "مدير عيادة",
                                        "Doctor" => "طبيب",
                                        "ClinicStaff" => "موظف",
                                        _ => "مريض"
                                    };
                                    <span class="badge badge-info">@roleName</span>
                                }
                            }
                            </div>
                        </td>
                        <td class="text-md">@u.RegistrationDate</td>
                        <td><span class="badge @u.StatusClass">@u.Status</span></td>
                        <td>
                            <div class="table-actions">
                                <button class="btn-icon btn-edit-user" title="تعديل" aria-label="تعديل المستخدم @u.Name">
                                        data-id="@u.Id"
                                        data-name="@u.Name"
                                        data-email="@u.Email"
                                        data-phone="@u.Phone"
                                        data-active="@(u.StatusClass == "badge-success" ? "true" : "false")">
                                    <svg viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                    </svg>
                                </button>
                                <button class="btn-icon btn-change-password" title="تغيير كلمة المرور" aria-label="تغيير كلمة مرور المستخدم @u.Name">
                                        data-id="@u.Id"
                                        data-name="@u.Name">
                                    <svg viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2z"/>
                                    </svg>
                                </button>
                                <button class="btn-icon btn-delete-user" title="حذف" aria-label="حذف المستخدم @u.Name">
                                        data-id="@u.Id"
                                        data-name="@u.Name">
                                    <svg viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" />

<form id="createUserForm" method="post" action="/Admin/Users/Create">
    <div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content modal-content-custom">
                <div class="modal-header-custom">
                    <h5 class="modal-title">إضافة مستخدم جديد</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body-custom">
                    <div class="form-group">
                        <label class="form-label" for="createFullName">الاسم الكامل</label>
                        <input type="text" id="createFullName" name="FullName" class="form-input" placeholder="مثال: محمد عمر" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createEmail">البريد الإلكتروني</label>
                        <input type="email" id="createEmail" name="Email" class="form-input" placeholder="example@gmail.com" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createPhone">رقم الهاتف</label>
                        <input type="text" id="createPhone" name="PhoneNumber" class="form-input" placeholder="010 12345678" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createPassword">كلمة المرور</label>
                        <input type="password" id="createPassword" name="Password" class="form-input" placeholder="********" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createBirthDate">تاريخ الميلاد</label>
                        <input type="date" id="createBirthDate" name="BirthDate" class="form-input" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createGender">الجنس</label>
                        <select id="createGender" name="Gender" class="form-select" required>
                            <option value="1">ذكر</option>
                            <option value="2">أنثى</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createRole">الدور</label>
                            <select id="createRole" name="Role" class="form-select" required>
                                <option value="1">مستخدم</option>
                            </select>
                    </div>
                    <div class="form-group form-group-hidden" id="clinicGroup">
                        <label class="form-label" for="createClinic">العيادة</label>
                        <select id="createClinic" name="ClinicId" class="form-select">
                            <option value="">اختر عيادة</option>
                            @if (ViewBag.Clinics != null)
                            {
                                foreach (var c in ViewBag.Clinics)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group form-group-hidden" id="doctorFields">
                        <label class="form-label" for="createSpecialization">التخصص</label>
                        <select id="createSpecialization" name="SpecializationId" class="form-select">
                            <option value="">اختر تخصص</option>
                            @if (ViewBag.Specializations != null)
                            {
                                foreach (var s in ViewBag.Specializations)
                                {
                                    <option value="@s.Id">@s.ArName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group form-group-hidden" id="bioGroup">
                        <label class="form-label" for="createBio">نبذة تعريفية</label>
                        <textarea id="createBio" name="Bio" class="form-input" rows="3" placeholder="نبذة عن الطبيب"></textarea>
                    </div>
                    <div class="form-group form-group-hidden" id="experienceGroup">
                        <label class="form-label" for="createExperience">سنوات الخبرة</label>
                        <input type="number" id="createExperience" name="YearsOfExperience" class="form-input" placeholder="مثال: 5" min="0" />
                    </div>
                    <div class="form-group form-group-hidden" id="availabilitiesGroup">
                        <label class="form-label">أوقات العمل (اختياري)</label>
                        <div id="adminAvailabilityContainer">
                            <div class="availability-row" data-index="0">
                                <select class="availability-day form-select auth-form-control">
                                    <option value="">اليوم</option>
                                    <option value="0">الأحد</option>
                                    <option value="1">الإثنين</option>
                                    <option value="2">الثلاثاء</option>
                                    <option value="3">الأربعاء</option>
                                    <option value="4">الخميس</option>
                                    <option value="5">الجمعة</option>
                                    <option value="6">السبت</option>
                                </select>
                                <select class="availability-from-hour form-select auth-form-control">
                                    <option value="">—</option>
                                    @for (var i = 1; i <= 12; i++)
                                    {
                                        <option value="@i" selected="@(i == 9)">@i</option>
                                    }
                                </select>
                                <select class="availability-from-minute form-select auth-form-control">
                                    @for (var i = 0; i <= 59; i++)
                                    {
                                        var mm = i.ToString("00");
                                        <option value="@mm" selected="@(i == 0)">@mm</option>
                                    }
                                </select>
                                <select class="availability-from-period form-select auth-form-control">
                                    <option value="AM" selected>صباحاً</option>
                                    <option value="PM">مساءً</option>
                                </select>
                                <span class="availability-sep">إلى</span>
                                <select class="availability-to-hour form-select auth-form-control">
                                    <option value="">—</option>
                                    @for (var i = 1; i <= 12; i++)
                                    {
                                        <option value="@i" selected="@(i == 5)">@i</option>
                                    }
                                </select>
                                <select class="availability-to-minute form-select auth-form-control">
                                    @for (var i = 0; i <= 59; i++)
                                    {
                                        var mm = i.ToString("00");
                                        <option value="@mm" selected="@(i == 0)">@mm</option>
                                    }
                                </select>
                                <select class="availability-to-period form-select auth-form-control">
                                    <option value="AM">صباحاً</option>
                                    <option value="PM" selected>مساءً</option>
                                </select>
                                <button type="button" class="availability-remove-btn" title="حذف"><i class="bi bi-x-circle"></i></button>
                            </div>
                        </div>
                        <button type="button" id="addAdminAvailabilityBtn" class="btn btn-sm add-availability-btn">
                            <i class="bi bi-plus-circle"></i> إضافة يوم
                        </button>
                        <input type="hidden" id="createAvailabilitiesJson" name="availabilitiesJson" value="" />
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </div>
        </div>
    </div>
</form>

<form id="deleteUserForm" method="post" action="/Admin/Users/Delete">
    <input type="hidden" id="deleteUserId" name="id" value="" />
</form>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <div class="modal-body text-center">
                <div class="icon-wrapper icon-wrapper--danger modal-icon-circle">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" fill="currentColor"/>
                    </svg>
                </div>
                <h3 class="modal-heading">تأكيد الحذف</h3>
                <p class="modal-copy">
                    هل أنت متأكد من حذف المستخدم: <strong id="deleteUserName" class="text-body"></strong>؟
                </p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="button" id="confirmDeleteBtn" class="btn btn-danger">حذف</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <form id="changePasswordForm" method="post" action="/Admin/Users/ChangePassword">
                <div class="modal-body text-center">
                    <div class="icon-wrapper icon-wrapper--blue modal-icon-circle">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2z" fill="currentColor"/>
                        </svg>
                    </div>
                    <h3 class="modal-heading text-center">تغيير كلمة المرور</h3>
                    <p class="modal-copy text-center">
                        تغيير كلمة مرور المستخدم: <strong id="changePasswordUserName" class="text-body"></strong>
                    </p>
                    <input type="hidden" id="changePasswordUserId" name="id" value="" />
                    <div class="form-group text-start">
                        <label class="form-label" for="newPassword">كلمة المرور الجديدة</label>
                        <input type="password" id="newPassword" name="newPassword" class="form-input" placeholder="********" required minlength="6" />
                    </div>
                    <div class="form-group text-start">
                        <label class="form-label" for="confirmPassword">تأكيد كلمة المرور</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" placeholder="********" required minlength="6" />
                    </div>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary">حفظ</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <form id="editUserForm" method="post" action="/Admin/Users/Edit">
                <div class="modal-body text-center">
                    <div class="icon-wrapper icon-wrapper--blue modal-icon-circle">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" fill="currentColor"/>
                        </svg>
                    </div>
                    <h3 class="modal-heading text-center">تعديل بيانات المستخدم</h3>
                    <input type="hidden" id="editUserId" name="id" value="" />
                    <div class="form-group text-start">
                        <label class="form-label" for="editUserName">الاسم الكامل</label>
                        <input type="text" id="editUserName" name="fullName" class="form-input" required />
                    </div>
                    <div class="form-group text-start">
                        <label class="form-label" for="editUserPhone">رقم الهاتف</label>
                        <input type="text" id="editUserPhone" name="phoneNumber" class="form-input" />
                    </div>
                    <div class="form-group text-start">
                        <label class="form-label" for="editUserStatus">الحالة</label>
                        <select id="editUserStatus" name="isActive" class="form-select">
                            <option value="true">نشط</option>
                            <option value="false">غير نشط</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var createModal = new bootstrap.Modal(document.getElementById('createUserModal'));

            document.getElementById('addUserBtn').addEventListener('click', function() {
                document.getElementById('createUserForm').reset();
                createModal.show();
            });

            var deleteForm = document.getElementById('deleteUserForm');
            var deleteIdInput = document.getElementById('deleteUserId');
            var deleteNameEl = document.getElementById('deleteUserName');
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));

            document.querySelectorAll('.btn-delete-user').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    deleteIdInput.value = btn.getAttribute('data-id');
                    deleteNameEl.textContent = btn.getAttribute('data-name');
                    deleteModal.show();
                });
            });

            document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
                deleteForm.submit();
            });

            var changePasswordModal = new bootstrap.Modal(document.getElementById('changePasswordModal'));
            var changePasswordUserId = document.getElementById('changePasswordUserId');
            var changePasswordUserName = document.getElementById('changePasswordUserName');

            document.querySelectorAll('.btn-change-password').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    changePasswordUserId.value = btn.getAttribute('data-id');
                    changePasswordUserName.textContent = btn.getAttribute('data-name');
                    document.getElementById('changePasswordForm').reset();
                    changePasswordModal.show();
                });
            });

            document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
                var pwd = document.getElementById('newPassword').value;
                var confirm = document.getElementById('confirmPassword').value;
                if (pwd !== confirm) {
                    e.preventDefault();
                    alert('كلمة المرور غير متطابقة');
                }
            });

            var editUserModal = new bootstrap.Modal(document.getElementById('editUserModal'));
            var editUserId = document.getElementById('editUserId');
            var editUserName = document.getElementById('editUserName');
            var editUserPhone = document.getElementById('editUserPhone');
            var editUserStatus = document.getElementById('editUserStatus');

            document.querySelectorAll('.btn-edit-user').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    editUserId.value = btn.getAttribute('data-id');
                    editUserName.value = btn.getAttribute('data-name');
                    editUserPhone.value = btn.getAttribute('data-phone');
                    editUserStatus.value = btn.getAttribute('data-active');
                    editUserModal.show();
                });
            });

        })();

            var ADMIN_DAY_NAMES = ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];

            function parse12(timeStr) {
                if (!timeStr) return null;
                var parts = String(timeStr).split(':');
                var h = parseInt(parts[0], 10);
                var m = parts[1] ? ('00' + parts[1]).slice(-2) : '00';
                if (isNaN(h) || h < 0 || h > 23) return null;
                var period = h >= 12 ? 'PM' : 'AM';
                var hour12 = h % 12;
                if (hour12 === 0) hour12 = 12;
                return { hour: hour12, minute: m, period: period };
            }

            function timeSelectsHtml(prefix, timeStr) {
                var t = parse12(timeStr);
                var hourOptions = '<option value="">—</option>';
                for (var i = 1; i <= 12; i++) {
                    hourOptions += '<option value="' + i + '"' + (t && t.hour === i ? ' selected' : '') + '>' + i + '</option>';
                }
                var minuteOptions = '';
                for (var i = 0; i <= 59; i++) {
                    var mm = (i < 10 ? '0' : '') + i;
                    minuteOptions += '<option value="' + mm + '"' + (t && t.minute === mm ? ' selected' : '') + '>' + mm + '</option>';
                }
                return '<select class="availability-' + prefix + '-hour form-select auth-form-control">' + hourOptions + '</select>' +
                    '<select class="availability-' + prefix + '-minute form-select auth-form-control">' + minuteOptions + '</select>' +
                    '<select class="availability-' + prefix + '-period form-select auth-form-control">' +
                        '<option value="AM"' + (t && t.period === 'AM' ? ' selected' : '') + '>صباحاً</option>' +
                        '<option value="PM"' + (t && t.period === 'PM' ? ' selected' : '') + '>مساءً</option>' +
                    '</select>';
            }

            function readTime(row, prefix) {
                var h = parseInt(row.querySelector('.availability-' + prefix + '-hour').value, 10);
                var m = row.querySelector('.availability-' + prefix + '-minute').value;
                var p = row.querySelector('.availability-' + prefix + '-period').value;
                if (isNaN(h)) return null;
                var h24 = h % 12;
                if (p === 'PM') h24 += 12;
                if (p === 'AM' && h === 12) h24 = 0;
                return (h24 < 10 ? '0' + h24 : h24) + ':' + m;
            }

            function addAdminAvailabilityRow(day, fromTime, toTime, slotMin) {
                var container = document.getElementById('adminAvailabilityContainer');
                var index = container.children.length;
                var dayOpts = '<option value="">اليوم</option>' + ADMIN_DAY_NAMES.map(function (n, i) {
                    return '<option value="' + i + '"' + (day === i ? ' selected' : '') + '>' + n + '</option>';
                }).join('');
                var row = document.createElement('div');
                row.className = 'availability-row';
                row.setAttribute('data-index', index);
                row.innerHTML =
                    '<select class="availability-day form-select auth-form-control">' + dayOpts + '</select>' +
                    timeSelectsHtml('from', fromTime || '09:00') +
                    '<span class="availability-sep">إلى</span>' +
                    timeSelectsHtml('to', toTime || '17:00') +
                    '<button type="button" class="availability-remove-btn" title="حذف"><i class="bi bi-x-circle"></i></button>';
                row.querySelector('.availability-remove-btn').addEventListener('click', function () { row.remove(); });
                container.appendChild(row);
            }

            function serializeAdminAvailabilities() {
                var rows = document.querySelectorAll('#adminAvailabilityContainer .availability-row');
                var availabilities = [];
                rows.forEach(function (row) {
                    var day = parseInt(row.querySelector('.availability-day').value);
                    var fromTime = readTime(row, 'from');
                    var toTime = readTime(row, 'to');
                    if (!isNaN(day) && day >= 0 && fromTime && toTime) {
                        availabilities.push({
                            dayOfWeek: day,
                            startTime: fromTime + ':00',
                            endTime: toTime + ':00',
                            slotDurationMinutes: 30
                        });
                    }
                });
                document.getElementById('createAvailabilitiesJson').value = JSON.stringify(availabilities);
            }

            document.getElementById('createRole').addEventListener('change', function() {
                var clinicGroup = document.getElementById('clinicGroup');
                var doctorFields = document.getElementById('doctorFields');
                var bioGroup = document.getElementById('bioGroup');
                var experienceGroup = document.getElementById('experienceGroup');
                var availabilitiesGroup = document.getElementById('availabilitiesGroup');
                var val = parseInt(this.value);
                var showClinic = val === 4 || val === 8 || val === 16;
                var showDoctorFields = val === 4 || val === 16;
                clinicGroup.style.display = showClinic ? '' : 'none';
                doctorFields.style.display = showDoctorFields ? '' : 'none';
                bioGroup.style.display = showDoctorFields ? '' : 'none';
                experienceGroup.style.display = showDoctorFields ? '' : 'none';
                availabilitiesGroup.style.display = showDoctorFields ? '' : 'none';
            });

            document.getElementById('createUserForm').addEventListener('submit', function () {
                serializeAdminAvailabilities();
            });

            document.getElementById('addAdminAvailabilityBtn').addEventListener('click', function () {
                addAdminAvailabilityRow();
            });

            document.getElementById('addUserBtn').addEventListener('click', function () {
                var container = document.getElementById('adminAvailabilityContainer');
                container.innerHTML = '';
                addAdminAvailabilityRow();
                document.getElementById('createAvailabilitiesJson').value = '';
            });

        var successMsg = '@(TempData["SuccessMessage"] ?? "")';
        if (successMsg) { showSuccessModal(successMsg); }
        var errorMsg = '@(TempData["ErrorMessage"] ?? "")';
        if (errorMsg) { showErrorModal(errorMsg); }
    </script>
}
