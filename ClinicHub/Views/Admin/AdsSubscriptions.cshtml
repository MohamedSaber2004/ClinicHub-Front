@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "إدارة الإعلانات والاشتراكات";
    Layout = "_AdminLayout";
    var plans = ViewBag.Plans as List<PlanDto> ?? new List<PlanDto>();
    var packages = ViewBag.Packages as List<AdPackageDto> ?? new List<AdPackageDto>();
    var clinicAdSettings = ViewBag.ClinicAdSettings as List<ClinicAdSettingsDto> ?? new List<ClinicAdSettingsDto>();
    var subscriptions = ViewBag.Subscriptions as List<SubscriptionDto> ?? new List<SubscriptionDto>();
    var clinics = ViewBag.Clinics as IReadOnlyCollection<ClinicLookupDto> ?? new List<ClinicLookupDto>();
}
<div class="admin-ads-subs-page">
<div class="page-header">
    <h2 class="page-title">
        <span class="page-title-icon">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
        </span>
        نظرة عامة على الاشتراكات والإعلانات
    </h2>
    <div class="page-header-actions">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#manualAdSubModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/>
            </svg>
            إضافة اشتراك إعلاني يدوي
        </button>
        <a href="@AdminRoutes.Pages.Ads()" class="btn btn-primary btn-sm">إدارة الإعلانات والباقات</a>
    </div>
</div>

<!-- Global quick search -->
<div class="ads-subs-toolbar">
    <div class="ads-search-wrap">
        <svg class="ads-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" id="adsGlobalSearch" class="form-input ads-global-input" placeholder="بحث سريع في كل الجداول — اسم الباقة، العيادة، السعر..." autocomplete="off" />
        <button type="button" id="adsSearchClear" class="ads-search-clear d-none" aria-label="مسح البحث"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="ads-toolbar-meta">
        <span class="badge badge-info" id="adsGlobalCount">@(plans.Count + packages.Count + clinicAdSettings.Count + subscriptions.Count) عنصر</span>
        <span class="text-muted" style="font-size:12px">الضغط <kbd>Ctrl</kbd>+<kbd>K</kbd> للتركيز</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

<!-- Plans -->
<div class="table-card" data-table="plans">
    <div class="table-card-header">
        <h3 class="table-card-title">باقات تشغيل العيادات <span class="badge badge-secondary table-count" data-count-for="plans">@plans.Count</span></h3>
        <div class="table-card-actions" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <div class="ads-table-search">
                <input type="text" class="form-input form-input-sm ads-table-filter" data-target="plans" placeholder="بحث في الباقات..." />
            </div>
            <a href="@AdminRoutes.Pages.Subscriptions()" class="btn btn-sm btn-secondary">إدارة وتعديل الباقات</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>الباقة</th>
                    <th>السعر شهري</th>
                    <th>سنوي</th>
                    <th>الأطباء</th>
                    <th>الموظفين</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody>
            @if (plans.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted">لا توجد باقات</td></tr>
            }
            else
            {
                foreach (var p in plans.OrderBy(x => x.SortOrder))
                {
                    <tr>
                        <td class="text-md-medium">@(p.NameAr ?? p.Name)</td>
                        <td class="text-md">@p.PriceMonthly.ToString("N0") ج.م</td>
                        <td class="text-md">@p.PriceYearly.ToString("N0") ج.م</td>
                        <td class="text-md">@(p.MaxDoctors?.ToString() ?? "غير محدود")</td>
                        <td class="text-md">@(p.MaxStaff?.ToString() ?? "غير محدود")</td>
                        <td><span class="badge @(p.IsActive ? "badge-success" : "badge-secondary")">@(p.IsActive ? "نشطة (في الموقع)" : "معطلة")</span></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<!-- Ad Packages -->
<div class="table-card" data-table="packages">
    <div class="table-card-header">
        <h3 class="table-card-title">باقات الإعلانات والترويج <span class="badge badge-secondary table-count" data-count-for="packages">@packages.Count</span></h3>
        <div class="table-card-actions" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <div class="ads-table-search">
                <input type="text" class="form-input form-input-sm ads-table-filter" data-target="packages" placeholder="بحث في الباقات الإعلانية..." />
            </div>
            <a href="@AdminRoutes.Pages.Ads()" class="btn btn-sm btn-primary">إدارة الإعلانات الكاملة</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>الباقة</th>
                    <th>المدة</th>
                    <th>السعر</th>
                    <th>الحد الأقصى للإعلانات</th>
                    <th>عدد المشاهدات</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody>
            @if (packages.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted">لا توجد باقات إعلانية</td></tr>
            }
            else
            {
                foreach (var pkg in packages)
                {
                    <tr>
                        <td class="text-md-medium">@(pkg.NameAr ?? pkg.Name)</td>
                        <td class="text-md">@pkg.DurationDays يوم</td>
                        <td class="text-md">@pkg.Price.ToString("N2") ج.م</td>
                        <td class="text-md">@(pkg.MaxAds > 0 ? pkg.MaxAds.ToString() : "غير محدود")</td>
                        <td class="text-md">@(pkg.MaxImpressions > 0 ? pkg.MaxImpressions.ToString("N0") : "غير محدود")</td>
                        <td><span class="badge @(pkg.IsActive ? "badge-success" : "badge-secondary")">@(pkg.IsActive ? "نشطة" : "معطلة")</span></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<!-- Clinic Ad Settings -->
<div class="table-card" data-table="clinics">
    <div class="table-card-header">
        <h3 class="table-card-title">حدود وإعدادات الإعلانات لكل عيادة <span class="badge badge-secondary table-count" data-count-for="clinics">@clinicAdSettings.Count</span></h3>
        <div class="table-card-actions" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <div class="ads-table-search">
                <input type="text" class="form-input form-input-sm ads-table-filter" data-target="clinics" placeholder="بحث باسم العيادة..." />
            </div>
            <a href="@AdminRoutes.Pages.Ads()" class="btn btn-sm btn-secondary">تعديل الحدود في صفحة الإعلانات</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>العيادة</th>
                    <th>الحد الأقصى للإعلانات</th>
                    <th>عدد المشاهدات المسموح بها</th>
                    <th>النشطة حالياً</th>
                </tr>
            </thead>
            <tbody>
            @if (clinicAdSettings.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted">لا توجد إعدادات مخصصة — كل العيادات تستخدم الافتراضي</td></tr>
            }
            else
            {
                foreach (var c in clinicAdSettings)
                {
                    <tr>
                        <td class="text-md-medium">@c.ClinicName</td>
                        <td class="text-md">@(c.MaxAds > 0 ? c.MaxAds.ToString() : "غير محدود")</td>
                        <td class="text-md">@(c.MaxImpressions > 0 ? c.MaxImpressions.ToString("N0") : "غير محدود")</td>
                        <td><span class="badge badge-info">@c.ActiveAdsCount إعلان</span></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<!-- Recent Subscriptions -->
<div class="table-card" data-table="subs">
    <div class="table-card-header">
        <h3 class="table-card-title">أحدث الاشتراكات <span class="badge badge-secondary table-count" data-count-for="subs">@subscriptions.Count</span></h3>
        <div class="table-card-actions" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <div class="ads-table-search">
                <input type="text" class="form-input form-input-sm ads-table-filter" data-target="subs" placeholder="بحث باسم العيادة أو الباقة..." />
            </div>
            <a href="@AdminRoutes.Pages.SubscriptionManagement()" class="btn btn-sm btn-secondary">إدارة الاشتراكات</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>العيادة</th>
                    <th>الباقة</th>
                    <th>الفترة</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody>
            @if (subscriptions.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted">لا توجد اشتراكات حديثة</td></tr>
            }
            else
            {
                foreach (var s in subscriptions)
                {
                    <tr>
                        <td class="text-md">@s.ClinicName</td>
                        <td class="text-md">@s.PlanName</td>
                        <td class="text-md">@(s.Period == 1 ? "سنوي" : "شهري")</td>
                        <td><span class="badge @(s.IsActive ? "badge-success" : "badge-secondary")">@(s.IsActive ? "نشط" : "منتهي")</span></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
</div>

<!-- Manual Ad Subscription Modal -->
<div class="modal fade" id="manualAdSubModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-content-custom">
            <div class="modal-header-custom">
                <h5 class="modal-title">إضافة اشتراك إعلاني لعيادة يدوياً</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body-custom">
                <p class="form-hint mb-3">يمكنك منح أو تفعيل اشتراك إعلاني مخصص لأي عيادة بالمدة والسعر والحدود المطلوبة.</p>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">العيادة المستفيدة <span class="text-danger">*</span></label>
                            <select id="quickSubClinic" class="form-select" required>
                                <option value="">اختر العيادة</option>
                                @foreach (var c in clinics)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">قالب الباقة (اختياري)</label>
                            <select id="quickSubPackageSelect" class="form-select" onchange="onQuickPackageTemplateChange()">
                                <option value="">تخصيص يدوي حر</option>
                                @foreach (var p in packages)
                                {
                                    <option value="@p.Id" data-price="@p.Price" data-duration="@p.DurationDays" data-maxads="@p.MaxAds" data-maximpressions="@p.MaxImpressions">@(p.NameAr ?? p.Name) (@p.DurationDays يوم - @p.Price ج.م)</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">المدة (أيام) <span class="text-danger">*</span></label>
                            <input type="number" id="quickSubDuration" class="form-input" min="1" value="30" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">المبلغ المطلوب (ج.م)</label>
                            <input type="number" id="quickSubPrice" class="form-input" min="0" step="0.01" value="0.00" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">الحد الأقصى للإعلانات</label>
                            <input type="number" id="quickSubMaxAds" class="form-input" min="0" value="1" placeholder="0 = غير محدود" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">عدد المشاهدات المسموح بها</label>
                            <input type="number" id="quickSubMaxImpressions" class="form-input" min="0" value="5000" placeholder="0 = غير محدود" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">طريقة السداد</label>
                            <select id="quickSubMethod" class="form-select">
                                <option value="0">سداد نقدي (Cash)</option>
                                <option value="1">محفظة إلكترونية (Paymob)</option>
                                <option value="3">منح إداري مجاني</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">تاريخ البدء</label>
                            <input type="date" id="quickSubStartDate" class="form-input" />
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">ملاحظات <span class="text-muted">(اختياري)</span></label>
                    <textarea id="quickSubNotes" class="form-textarea" rows="2" placeholder="ملاحظات الاشتراك..."></textarea>
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="quickSubSubmitBtn">حفظ وتفعيل الاشتراك</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function onQuickPackageTemplateChange() {
    var select = document.getElementById('quickSubPackageSelect');
    var opt = select.options[select.selectedIndex];
    if (opt && opt.value) {
        document.getElementById('quickSubPrice').value = parseFloat(opt.getAttribute('data-price') || 0).toFixed(2);
        document.getElementById('quickSubDuration').value = opt.getAttribute('data-duration') || '30';
        document.getElementById('quickSubMaxAds').value = opt.getAttribute('data-maxads') || '1';
        document.getElementById('quickSubMaxImpressions').value = opt.getAttribute('data-maximpressions') || '5000';
    }
}

(function(){
    var d = new Date();
    var todayStr = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    var startDateInput = document.getElementById('quickSubStartDate');
    if (startDateInput) startDateInput.value = todayStr;

    var quickSubBtn = document.getElementById('quickSubSubmitBtn');
    if (quickSubBtn) {
        quickSubBtn.addEventListener('click', function () {
            var clinicId = document.getElementById('quickSubClinic').value;
            var packageId = document.getElementById('quickSubPackageSelect').value || null;
            var durationDays = parseInt(document.getElementById('quickSubDuration').value) || 30;
            var price = parseFloat(document.getElementById('quickSubPrice').value) || 0;
            var maxAds = parseInt(document.getElementById('quickSubMaxAds').value) || 0;
            var maxImpressions = parseInt(document.getElementById('quickSubMaxImpressions').value) || 0;
            var method = parseInt(document.getElementById('quickSubMethod').value) || 0;
            var startDate = document.getElementById('quickSubStartDate').value;
            var notes = document.getElementById('quickSubNotes').value.trim();

            if (!clinicId) { showErrorModal('يرجى اختيار العيادة المستفيدة'); return; }
            if (durationDays <= 0) { showErrorModal('يرجى تحديد مدة صحيحة بالأيام'); return; }

            quickSubBtn.disabled = true;
            quickSubBtn.textContent = 'جارٍ الحفظ والتفعيل...';

            fetch('/Admin/CreateManualAdSubscription', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    clinicId: clinicId,
                    adPackageId: packageId,
                    durationDays: durationDays,
                    amount: price,
                    maxAds: maxAds,
                    maxImpressions: maxImpressions,
                    paymentMethod: method,
                    startDate: startDate,
                    notes: notes
                })
            })
            .then(function (r) { return r.json(); })
            .then(function (result) {
                if (result.success) {
                    showSuccessModal(result.message || 'تم إنشاء وتفعيل الاشتراك الإعلاني بنجاح');
                    setTimeout(function () { location.reload(); }, 1200);
                } else {
                    quickSubBtn.disabled = false;
                    quickSubBtn.textContent = 'حفظ وتفعيل الاشتراك';
                    showErrorModal(result.message || 'حدث خطأ أثناء حفظ الاشتراك الإعلاني');
                }
            })
            .catch(function () {
                quickSubBtn.disabled = false;
                quickSubBtn.textContent = 'حفظ وتفعيل الاشتراك';
                showErrorModal('عذراً، حدث خطأ أثناء حفظ الاشتراك الإعلاني');
            });
        });
    }

    var globalInput = document.getElementById('adsGlobalSearch');
    var clearBtn = document.getElementById('adsSearchClear');
    var perTableInputs = document.querySelectorAll('.ads-table-filter');
    function normalize(s){ return (s||'').toString().toLowerCase().trim(); }
    function filterTable(tableKey, query){
        var card = document.querySelector('.table-card[data-table="'+tableKey+'"]');
        if(!card) return;
        var rows = card.querySelectorAll('tbody tr');
        var q = normalize(query);
        var visible = 0;
        rows.forEach(function(tr){
            if(tr.children.length===1 && tr.querySelector('td[colspan]')){ tr.style.display=''; return; }
            var text = normalize(tr.textContent);
            var show = !q || text.indexOf(q) !== -1;
            tr.style.display = show ? '' : 'none';
            if(show) visible++;
        });
        var badge = card.querySelector('.table-count[data-count-for="'+tableKey+'"]');
        if(badge){ badge.textContent = visible + ' / ' + rows.length; badge.classList.toggle('badge-info', !!q && visible>0); badge.classList.toggle('badge-secondary', !q || visible===0); }
        updateGlobalCount();
    }
    function updateGlobalCount(){
        var totalVisible = 0, totalRows=0;
        document.querySelectorAll('.table-card[data-table]').forEach(function(card){
            var rows = card.querySelectorAll('tbody tr:not(.ads-no-results)');
            rows.forEach(function(tr){
                if(tr.style.display !== 'none' && !(tr.children.length===1 && tr.querySelector('td[colspan]'))) totalVisible++;
                if(!(tr.children.length===1 && tr.querySelector('td[colspan]'))) totalRows++;
            });
        });
        var gc = document.getElementById('adsGlobalCount');
        if(gc){ gc.textContent = totalVisible + ' / ' + totalRows + ' عنصر'; }
    }
    perTableInputs.forEach(function(inp){
        inp.addEventListener('input', function(){ filterTable(this.dataset.target, this.value); });
    });
    if(globalInput){
        globalInput.addEventListener('input', function(){
            var q = this.value;
            if(clearBtn) clearBtn.classList.toggle('d-none', !q);
            ['plans','packages','clinics','subs'].forEach(function(k){ filterTable(k,q); var per = document.querySelector('.ads-table-filter[data-target="'+k+'"]'); if(per) per.value = q; });
        });
        if(clearBtn){
            clearBtn.addEventListener('click', function(){ globalInput.value=''; globalInput.dispatchEvent(new Event('input')); globalInput.focus(); });
        }
        document.addEventListener('keydown', function(e){ if((e.ctrlKey||e.metaKey) && e.key.toLowerCase()==='k'){ e.preventDefault(); globalInput.focus(); globalInput.select(); }});
    }
})();
</script>
}
