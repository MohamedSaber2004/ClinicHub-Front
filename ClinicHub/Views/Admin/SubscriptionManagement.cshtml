@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "إدارة الاشتراكات";
    Layout = "_AdminLayout";
    var subscriptions = ViewBag.Subscriptions as IReadOnlyCollection<SubscriptionDto> ?? new List<SubscriptionDto>();
    var plans = ViewBag.Plans as List<PlanDto> ?? new();
    var clinics = ViewBag.Clinics as IReadOnlyCollection<ClinicLookupDto> ?? new List<ClinicLookupDto>();
    var pagination = ViewBag.Pagination as PagginatedResult<SubscriptionDto>;
}

<div class="page-header">
    <h2 class="page-title">
        <span class="page-title-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 2 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="currentColor"/>
            </svg>
        </span>
        إدارة الاشتراكات
    </h2>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createSubscriptionModal">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
        </svg>
        إضافة اشتراك
    </button>
</div>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

<div class="table-card">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>اسم العيادة</th>
                    <th>الباقة</th>
                    <th>المدة</th>
                    <th>المبلغ</th>
                    <th>تاريخ البداية</th>
                    <th>تاريخ النهاية</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (subscriptions.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5">
                            <p class="text-lg mb-0">لا توجد اشتراكات</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var sub in subscriptions)
                    {
                        var statusText = sub.Status switch { 0 => "نشط", 1 => "ملغي", 2 => "منتهي", 3 => "ملغي من الإدارة", _ => "غير معروف" };
                        var statusClass = sub.Status switch { 0 => "badge-success", 1 => "badge-warning", 2 => "badge-danger", 3 => "badge-danger", _ => "badge-info" };
                        var periodText = sub.Period == 0 ? "شهري" : "سنوي";
                        var currentPlan = plans.FirstOrDefault(p => p.Id == sub.PlanId);
                        var planNameText = !string.IsNullOrWhiteSpace(currentPlan?.NameAr) ? currentPlan.NameAr : sub.PlanName;
                        <tr>
                            <td class="text-md-medium">@sub.ClinicName</td>
                            <td><span class="badge badge-info">@planNameText</span></td>
                            <td class="text-md">@periodText</td>
                            <td class="text-md">@sub.Amount.ToString("N0") ج.م</td>
                            <td class="text-md">@sub.StartDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-md">@sub.EndDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge @statusClass">@statusText</span></td>
                            <td>
                                @if (sub.Status == 0)
                                {
                                    <button class="btn btn-sm btn-danger" onclick="revokeSubscription('@sub.Id', '@sub.ClinicName', this)">
                                        إلغاء الاشتراك
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (pagination != null)
    {
        <partial name="_Pagination" model="pagination" />
    }
</div>

<!-- Create Subscription Modal -->
<div class="modal fade" id="createSubscriptionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-content-custom">
            <div class="modal-header-custom">
                <h5 class="modal-title">إضافة اشتراك</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body-custom">
                <p class="text-md text-muted mb-4">سيتم إنشاء اشتراك نشط للعيادة مباشرة، وتفعيل لوحة تحكم صاحب العيادة فورًا.</p>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">العيادة</label>
                            <select id="subClinic" class="form-select">
                                <option value="">اختر العيادة</option>
                                @if (clinics.Count == 0)
                                {
                                    <option value="" disabled>لا توجد عيادات متاحة</option>
                                }
                                else
                                {
                                    foreach (var clinic in clinics)
                                    {
                                        <option value="@clinic.Id">@clinic.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">الباقة</label>
                            <select id="subPlan" class="form-select" onchange="updateSubPrice()">
                                <option value="">اختر الباقة</option>
                                @if (plans.Count == 0)
                                {
                                    <option value="" disabled>لا توجد باقات متاحة</option>
                                }
                                else
                                {
                                    foreach (var plan in plans.Where(p => p.IsActive))
                                    {
                                        <option value="@plan.Id" data-monthly="@plan.PriceMonthly" data-yearly="@plan.PriceYearly">@plan.NameAr</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">المدة</label>
                            <select id="subPeriod" class="form-select" onchange="updateSubPrice()">
                                <option value="0" selected>شهري</option>
                                <option value="1">سنوي</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">تاريخ البدء</label>
                            <input type="date" id="subStartDate" class="form-input" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">السعر</label>
                    <input type="text" id="subPrice" class="form-input" readonly placeholder="0.00 ج.م" />
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="subSubmitBtn">إنشاء الاشتراك</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateSubPrice() {
            var planSelect = document.getElementById('subPlan');
            var opt = planSelect.options[planSelect.selectedIndex];
            var period = document.getElementById('subPeriod').value;
            if (opt && opt.value) {
                var price = period === '0' ? parseFloat(opt.getAttribute('data-monthly')) : parseFloat(opt.getAttribute('data-yearly'));
                document.getElementById('subPrice').value = price.toFixed(2) + ' ج.م';
            } else {
                document.getElementById('subPrice').value = '';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var d = new Date();
            document.getElementById('subStartDate').value =
                d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');

            var subBtn = document.getElementById('subSubmitBtn');
            if (subBtn) {
                subBtn.addEventListener('click', function () {
                    var clinicId = document.getElementById('subClinic').value;
                    var planId = document.getElementById('subPlan').value;
                    var period = document.getElementById('subPeriod').value;
                    var startDate = document.getElementById('subStartDate').value;

                    if (!clinicId) { showErrorModal('يرجى اختيار العيادة'); return; }
                    if (!planId) { showErrorModal('يرجى اختيار الباقة'); return; }
                    if (!startDate) { showErrorModal('يرجى تحديد تاريخ البدء'); return; }

                    subBtn.disabled = true;
                    subBtn.textContent = 'جاري الإنشاء...';

                    fetch('/Admin/SubscriptionManagement/Create', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            clinicId: clinicId,
                            planId: planId,
                            period: parseInt(period),
                            startDate: startDate
                        })
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (result) {
                        if (result.success) {
                            showSuccessModal(result.message || 'تم إنشاء الاشتراك بنجاح');
                            setTimeout(function () { location.reload(); }, 1500);
                        } else {
                            subBtn.disabled = false;
                            subBtn.textContent = 'إنشاء الاشتراك';
                            showErrorModal(result.message || 'حدث خطأ أثناء إنشاء الاشتراك');
                        }
                    })
                    .catch(function () {
                        subBtn.disabled = false;
                        subBtn.textContent = 'إنشاء الاشتراك';
                        showErrorModal('عذراً، حدث خطأ أثناء إنشاء الاشتراك');
                    });
                });
            }
        });

        function revokeSubscription(id, clinicName, btnElement) {
            showConfirmModal('هل أنت متأكد من إلغاء اشتراك "' + clinicName + '"؟', function(confirmed) {
                if (!confirmed) return;

                var btn = btnElement;
                if (!btn) return;
                btn.disabled = true;
                btn.textContent = 'جاري الإلغاء...';

                fetch('/Admin/SubscriptionManagement/Revoke', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ subscriptionId: id })
                })
                .then(function(r) { return r.json(); })
                .then(function(result) {
                    if (result.success) {
                        var row = btn.closest('tr');
                        row.querySelector('td:nth-child(7)').innerHTML = '<span class="badge badge-danger">ملغي من الإدارة</span>';
                        btn.outerHTML = '<span class="text-muted">—</span>';
                        showSuccessModal(result.message || 'تم إلغاء الاشتراك بنجاح');
                    } else {
                        btn.disabled = false;
                        btn.textContent = 'إلغاء الاشتراك';
                        showErrorModal(result.message || 'حدث خطأ');
                    }
                })
                .catch(function() {
                    btn.disabled = false;
                    btn.textContent = 'إلغاء الاشتراك';
                    showErrorModal('عذراً، حدث خطأ أثناء إلغاء الاشتراك.');
                });
            });
        }
    </script>
}
