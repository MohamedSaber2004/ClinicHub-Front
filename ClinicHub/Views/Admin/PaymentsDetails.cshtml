@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "تفاصيل المعاملة";
    Layout = "_AdminLayout";
    var d = ViewBag.Detail as PaymentDetailDto;
}

<div class="detail-page">
    <!-- Back Link -->
    <a href="@AdminRoutes.Pages.Payments()" class="detail-back-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
        العودة إلى القائمة
    </a>

    @if (d == null)
    {
        <div class="alert alert-danger">@(ViewBag.ErrorMessage ?? "المعاملة غير موجودة")</div>
        return;
    }

    @{
        var typeText = d.Type switch { 0 => "موعد مريض", 1 => "اشتراك عيادة", 2 => "خدمة إعلانية", _ => "غير معروف" };
        var typeClass = d.Type switch { 0 => "badge-info", 1 => "badge-primary", 2 => "badge-warning", _ => "badge-info" };
        var statusText = d.Status switch { 0 => "معلق", 1 => "ناجح", 2 => "فاشل", 3 => "مسترد", _ => "غير معروف" };
        var statusClass = d.Status switch { 0 => "badge-warning", 1 => "badge-success", 2 => "badge-danger", 3 => "badge-info", _ => "badge-info" };
        var methodText = d.Method switch { 0 => "نقدي", 1 => "Paymob - محفظة إلكترونية", 2 => "Paymob - بطاقة ائتمانية", _ => "غير معروف" };
        var payerTypeText = d.PayerType == "Clinic" ? "عيادة" : "مريض";
    }

    <!-- Detail Header -->
    <div class="detail-header">
        <div class="detail-header-info">
            <h2 class="detail-title">
                <span class="page-title-icon">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 18H6V4h7v5h5v11z" fill="currentColor"/>
                    </svg>
                </span>
                معاملة @d.Code
            </h2>
            <span class="detail-subtitle">@d.Date.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
        <div class="detail-header-amount">
            <span class="detail-amount">@d.Amount.ToString("N2") ج.م</span>
            <span class="badge @statusClass">@statusText</span>
        </div>
    </div>

    <!-- Two-column Info -->
    <div class="detail-grid">
        <div class="detail-card">
            <h3 class="detail-card-title">
                <span class="subtitle-icon">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="currentColor"/>
                    </svg>
                </span>
                معلومات الدافع
            </h3>
            <div class="detail-info-list">
                <div class="detail-info-row">
                    <span class="detail-info-label">الاسم</span>
                    <span class="detail-info-value">@d.Payer</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">النوع</span>
                    <span class="detail-info-value">@payerTypeText</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">البريد الإلكتروني</span>
                    <span class="detail-info-value">@(string.IsNullOrWhiteSpace(d.PayerEmail) ? "—" : d.PayerEmail)</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">رقم الهاتف</span>
                    <span class="detail-info-value">@(string.IsNullOrWhiteSpace(d.PayerPhone) ? "—" : d.PayerPhone)</span>
                </div>
            </div>
        </div>
        <div class="detail-card">
            <h3 class="detail-card-title">
                <span class="subtitle-icon">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 18H6V4h7v5h5v11z" fill="currentColor"/>
                    </svg>
                </span>
                تفاصيل المعاملة
            </h3>
            <div class="detail-info-list">
                <div class="detail-info-row">
                    <span class="detail-info-label">النوع</span>
                    <span class="detail-info-value"><span class="badge @typeClass">@typeText</span></span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">العنصر</span>
                    <span class="detail-info-value">@d.ItemName</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">طريقة الدفع</span>
                    <span class="detail-info-value">@methodText</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">ID المعاملة</span>
                    <span class="detail-info-value detail-id-value">@(string.IsNullOrWhiteSpace(d.TransactionId) ? "—" : d.TransactionId)</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">رقم المرجع</span>
                    <span class="detail-info-value detail-id-value">@d.RefNumber</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">تاريخ الإنشاء</span>
                    <span class="detail-info-value">@d.Date.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Items -->
    <div class="table-card mb-4">
        <div class="table-card-header">
            <h3 class="table-card-title">
                <span class="subtitle-icon">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" fill="currentColor"/>
                    </svg>
                </span>
                عناصر الدفع
            </h3>
        </div>
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>العنصر</th>
                        <th>العدد</th>
                        <th>السعر</th>
                        <th>المجموع</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-md-medium">@d.ItemName</td>
                        <td class="text-md">1</td>
                        <td class="text-md amount-cell">@d.Amount.ToString("N2") ج.م</td>
                        <td class="text-md-medium amount-cell">@d.Amount.ToString("N2") ج.م</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Status Timeline -->
    <div class="detail-card">
        <h3 class="detail-card-title">
            <span class="subtitle-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z" fill="currentColor"/>
                </svg>
            </span>
            سجل المعاملة
        </h3>
        <div class="timeline">
            @if (d.Timeline.Count == 0)
            {
                <p class="text-md text-muted mb-0">لا يوجد سجل للمعاملة</p>
            }
            else
            {
                foreach (var entry in d.Timeline)
                {
                    <div class="timeline-item">
                        <div class="timeline-marker timeline-marker--@entry.Marker"></div>
                        <div class="timeline-content">
                            <span class="timeline-date">@entry.Date.ToString("yyyy-MM-dd HH:mm")</span>
                            <span class="timeline-text">@entry.Text</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Notes -->
    <div class="detail-card">
        <h3 class="detail-card-title">
            <span class="subtitle-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z" fill="currentColor"/>
                </svg>
            </span>
            ملاحظات
        </h3>
        <div class="detail-notes">
            <p class="text-md text-muted mb-0">@(string.IsNullOrWhiteSpace(d.Notes) ? "لا توجد ملاحظات" : d.Notes)</p>
        </div>
    </div>

    <!-- Refund Action -->
    @if (d.Status == 1)
    {
        <div class="detail-card mt-4">
            <div class="detail-section-header">
                <h3 class="detail-card-title">استرداد المبلغ</h3>
            </div>
            <p class="text-md text-muted mb-4">يمكنك استرداد المبلغ للدافع. سيتم إعادة المبلغ عبر قناة الدفع الأصلية.</p>
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#refundModal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
                </svg>
                استرداد المبلغ
            </button>
        </div>
    }
</div>

<!-- Refund Modal -->
<div class="modal fade" id="refundModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <div class="modal-header-custom">
                <h5 class="modal-title">استرداد المبلغ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body-custom">
                <div class="form-group">
                    <label class="form-label">سبب الاسترداد</label>
                    <textarea id="refundReason" class="form-textarea" maxlength="500" placeholder="أدخل سبب الاسترداد..." rows="3"></textarea>
                </div>
                <p class="text-md text-danger mt-3">سيتم استرداد مبلغ @d.Amount.ToString("N2") ج.م. هذا الإجراء لا يمكن التراجع عنه.</p>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-danger" id="refundSubmitBtn">تأكيد الاسترداد</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var refundBtn = document.getElementById('refundSubmitBtn');
            if (!refundBtn) return;

            refundBtn.addEventListener('click', function () {
                var reason = document.getElementById('refundReason').value.trim();
                if (!reason) { showErrorModal('يرجى إدخال سبب الاسترداد'); return; }

                refundBtn.disabled = true;
                refundBtn.textContent = 'جاري الاسترداد...';

                fetch('/Admin/RefundPayment/@d.Id', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason: reason })
                })
                .then(function (r) { return r.json(); })
                .then(function (result) {
                    if (result.success) {
                        showSuccessModal(result.message || 'تم استرداد المبلغ بنجاح');
                        setTimeout(function () { location.reload(); }, 1500);
                    } else {
                        refundBtn.disabled = false;
                        refundBtn.textContent = 'تأكيد الاسترداد';
                        showErrorModal(result.message || 'حدث خطأ أثناء الاسترداد');
                    }
                })
                .catch(function () {
                    refundBtn.disabled = false;
                    refundBtn.textContent = 'تأكيد الاسترداد';
                    showErrorModal('عذراً، حدث خطأ أثناء الاسترداد');
                });
            });
        });
    </script>
}
