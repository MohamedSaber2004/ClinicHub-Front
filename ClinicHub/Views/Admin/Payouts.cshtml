@section Scripts {
    <script>
        (function () {
            var rejectModalEl = document.getElementById('payoutRejectModal');
            var rejectModal = rejectModalEl ? new bootstrap.Modal(rejectModalEl) : null;
            var createModalEl = document.getElementById('payoutCreateModal');
            var createModal = createModalEl ? new bootstrap.Modal(createModalEl) : null;
            var rejectAccountId = null;

            function postJson(url, body) {
                return fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                }).then(function (res) {
                    return res.json().then(function (data) { return { ok: res.ok, data: data }; });
                });
            }

            document.querySelectorAll('.payout-verify-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = btn.getAttribute('data-account-id');
                    btn.disabled = true;

                    postJson('/Admin/Payouts/Verify', { id: id })
                        .then(function (result) {
                            if (result.ok && result.data && result.data.success) {
                                showSuccessModal(result.data.message || 'تم اعتماد الحساب البنكي.');
                                setTimeout(function () { window.location.reload(); }, 1200);
                            } else {
                                showErrorModal((result.data && result.data.message) || 'تعذر اعتماد الحساب البنكي.');
                                btn.disabled = false;
                            }
                        })
                        .catch(function () {
                            showErrorModal('عذراً، حدث خطأ أثناء اعتماد الحساب البنكي.');
                            btn.disabled = false;
                        });
                });
            });

            document.querySelectorAll('.payout-reject-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    rejectAccountId = btn.getAttribute('data-account-id');
                    document.getElementById('payoutRejectClinicName').textContent =
                        'العيادة: ' + (btn.getAttribute('data-clinic-name') || '');
                    document.getElementById('payoutRejectReason').value = '';
                    if (rejectModal) rejectModal.show();
                });
            });

            document.getElementById('payoutRejectConfirmBtn').addEventListener('click', function () {
                var reason = document.getElementById('payoutRejectReason').value.trim();
                if (!reason) {
                    showErrorModal('يرجى إدخال سبب الرفض.');
                    return;
                }

                var confirmBtn = this;
                confirmBtn.disabled = true;

                postJson('/Admin/Payouts/Reject', { id: rejectAccountId, reason: reason })
                    .then(function (result) {
                        if (result.ok && result.data && result.data.success) {
                            if (rejectModal) rejectModal.hide();
                            showSuccessModal(result.data.message || 'تم رفض الحساب البنكي.');
                            setTimeout(function () { window.location.reload(); }, 1200);
                        } else {
                            showErrorModal((result.data && result.data.message) || 'تعذر رفض الحساب البنكي.');
                        }
                    })
                    .catch(function () {
                        showErrorModal('عذراً، حدث خطأ أثناء رفض الحساب البنكي.');
                    })
                    .finally(function () {
                        confirmBtn.disabled = false;
                    });
            });

            var confirmModalEl = document.getElementById('payoutConfirmModal');
            var confirmModal = confirmModalEl ? new bootstrap.Modal(confirmModalEl) : null;
            var confirmAction = null;

            function askConfirm(message, onYes) {
                document.getElementById('payoutConfirmMessage').textContent = message;
                confirmAction = onYes;
                if (confirmModal) confirmModal.show();
            }

            document.getElementById('payoutConfirmYes').addEventListener('click', function () {
                var action = confirmAction;
                confirmAction = null;
                if (confirmModal) confirmModal.hide();
                if (action) action();
            });

            function runBatchAction(url, id, btn, successMessage) {
                btn.disabled = true;
                postJson(url, { id: id })
                    .then(function (result) {
                        if (result.ok && result.data && result.data.success) {
                            showSuccessModal(result.data.message || successMessage);
                            setTimeout(function () { window.location.reload(); }, 1500);
                        } else {
                            showErrorModal((result.data && result.data.message) || 'تعذر تنفيذ الإجراء على الدفعة.');
                            btn.disabled = false;
                        }
                    })
                    .catch(function () {
                        showErrorModal('عذراً، حدث خطأ أثناء تنفيذ الإجراء على الدفعة.');
                        btn.disabled = false;
                    });
            }

            document.getElementById('payoutCreateBtn').addEventListener('click', function () {
                if (createModal) createModal.show();
            });

            document.getElementById('payoutCreateConfirmBtn').addEventListener('click', function () {
                var raw = document.getElementById('payoutCreateMinimum').value.trim();
                var minimum = raw === '' ? null : Number(raw);
                var btn = this;

                btn.disabled = true;
                postJson('/Admin/Payouts/CreateBatch', { minimumAmount: minimum })
                    .then(function (result) {
                        if (result.ok && result.data && result.data.success) {
                            if (createModal) createModal.hide();
                            showSuccessModal(result.data.message || 'تم إنشاء الدفعة.');
                            setTimeout(function () { window.location.reload(); }, 1500);
                        } else {
                            showErrorModal((result.data && result.data.message) || 'تعذر إنشاء الدفعة.');
                            btn.disabled = false;
                        }
                    })
                    .catch(function () {
                        showErrorModal('عذراً، حدث خطأ أثناء إنشاء الدفعة.');
                        btn.disabled = false;
                    });
            });

            var eligibilityModalEl = document.getElementById('payoutEligibilityModal');
            var eligibilityModal = eligibilityModalEl ? new bootstrap.Modal(eligibilityModalEl) : null;
            var eligibilityClinicId = null;

            function formatPayoutMoney(value) {
                return Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ج.م';
            }

            document.querySelectorAll('.payout-eligibility-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    eligibilityClinicId = btn.getAttribute('data-clinic-id');

                    var confirmBtn = document.getElementById('payoutEligibilityConfirmBtn');
                    var loading = document.getElementById('payoutEligibilityLoading');
                    var result = document.getElementById('payoutEligibilityResult');
                    var decision = document.getElementById('payoutEligibilityDecision');

                    document.getElementById('payoutEligibilityClinicName').textContent =
                        'العيادة: ' + (btn.getAttribute('data-clinic-name') || '');
                    document.getElementById('payoutEligibilityAccount').textContent =
                        btn.getAttribute('data-account-last4') || '—';
                    loading.classList.remove('d-none');
                    result.classList.add('d-none');
                    decision.textContent = '—';
                    confirmBtn.disabled = true;
                    if (eligibilityModal) eligibilityModal.show();

                    fetch('/Admin/Payouts/Eligibility', { headers: { 'Accept': 'application/json' } })
                        .then(function (res) { return res.json(); })
                        .then(function (data) {
                            loading.classList.add('d-none');
                            if (!data || !data.success) {
                                showErrorModal((data && data.message) || 'تعذر فحص أهلية العيادة.');
                                return;
                            }

                            // The preview only lists clinics that have something available,
                            // so a missing row means this clinic has nothing to transfer yet.
                            var items = data.items || [];
                            var item = items.filter(function (i) {
                                return String(i.clinicId).toLowerCase() === String(eligibilityClinicId).toLowerCase();
                            })[0];

                            var eligible = !!item && item.eligible;
                            var reason = item ? item.ineligibilityReason : 'لا يوجد رصيد متاح للتحويل حتى الآن';

                            document.getElementById('payoutEligibilityAvailable').textContent =
                                formatPayoutMoney(item ? item.availableBalance : 0);
                            document.getElementById('payoutEligibilityMinimum').textContent = formatPayoutMoney(data.minimum);

                            if (eligible) {
                                decision.innerHTML = '<span class="badge badge--dot badge-success">مؤهل للتحويل</span>';
                                confirmBtn.disabled = false;
                            } else {
                                decision.innerHTML = '<span class="badge badge--dot badge-warning">غير مؤهل</span>';
                                if (reason) {
                                    var note = document.createElement('div');
                                    note.className = 'text-md text-muted mt-1';
                                    note.textContent = reason;
                                    decision.appendChild(note);
                                }
                            }

                            result.classList.remove('d-none');
                        })
                        .catch(function () {
                            loading.classList.add('d-none');
                            showErrorModal('عذراً، حدث خطأ أثناء فحص أهلية العيادة.');
                        });
                });
            });

            document.getElementById('payoutEligibilityConfirmBtn').addEventListener('click', function () {
                if (!eligibilityClinicId) return;

                var btn = this;
                btn.disabled = true;
                postJson('/Admin/Payouts/CreateBatch', { clinicIds: [eligibilityClinicId] })
                    .then(function (result) {
                        if (result.ok && result.data && result.data.success) {
                            if (eligibilityModal) eligibilityModal.hide();
                            showSuccessModal(result.data.message || 'تم إنشاء الدفعة.');
                            setTimeout(function () { window.location.reload(); }, 1500);
                        } else {
                            showErrorModal((result.data && result.data.message) || 'تعذر إنشاء الدفعة.');
                            btn.disabled = false;
                        }
                    })
                    .catch(function () {
                        showErrorModal('عذراً، حدث خطأ أثناء إنشاء الدفعة.');
                        btn.disabled = false;
                    });
            });

            document.getElementById('payoutBudgetBtn').addEventListener('click', function () {
                var btn = this;
                var target = document.getElementById('payoutBudgetValue');
                btn.disabled = true;
                target.textContent = 'جارٍ الحساب...';

                fetch('/Admin/Payouts/Budget', { headers: { 'Accept': 'application/json' } })
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        target.textContent = data && data.success
                            ? Number(data.balance).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + (data.currency || 'EGP')
                            : 'غير متاح';
                        if (!data || !data.success) showErrorModal((data && data.message) || 'تعذر قراءة رصيد منصة الدفع.');
                    })
                    .catch(function () {
                        target.textContent = 'غير متاح';
                        showErrorModal('عذراً، حدث خطأ أثناء قراءة رصيد منصة الدفع.');
                    })
                    .finally(function () { btn.disabled = false; });
            });

            document.querySelectorAll('.payout-details-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = btn.getAttribute('data-batch-id');
                    var row = document.querySelector('.payout-details-row[data-batch-id="' + id + '"]');
                    if (!row) return;
                    var isOpen = row.getAttribute('data-open') === 'true';
                    row.setAttribute('data-open', isOpen ? 'false' : 'true');
                    btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
                });
            });

            document.querySelectorAll('.payout-approve-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    runBatchAction('/Admin/Payouts/ApproveBatch', btn.getAttribute('data-batch-id'), btn, 'تم اعتماد الدفعة.');
                });
            });

            document.querySelectorAll('.payout-cancel-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    askConfirm('إلغاء هذه الدفعة؟ ستُعاد المبالغ المحجوزة إلى أرصدة العيادات.', function () {
                        runBatchAction('/Admin/Payouts/CancelBatch', btn.getAttribute('data-batch-id'), btn, 'تم إلغاء الدفعة.');
                    });
                });
            });

            document.querySelectorAll('.payout-execute-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    askConfirm('تنفيذ الدفعة يرسل أموالاً حقيقية لحسابات العيادات عبر بايمن. هل تريد المتابعة؟', function () {
                        runBatchAction('/Admin/Payouts/ExecuteBatch', btn.getAttribute('data-batch-id'), btn, 'تم جدولة تنفيذ الدفعة.');
                    });
                });
            });

            document.querySelectorAll('.payout-reconcile-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    runBatchAction('/Admin/Payouts/ReconcileBatch', btn.getAttribute('data-batch-id'), btn, 'تم تحديث حالة الدفعة من بايمن.');
                });
            });

            document.querySelectorAll('.payout-retry-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    askConfirm('إعادة المحاولة تُرسل التحويل نفسه مرة أخرى بعد التحقق من أنه لم يصل إلى بايمن. متابعة؟', function () {
                        runBatchAction('/Admin/Payouts/RetryItem', btn.getAttribute('data-item-id'), btn, 'تمت إعادة المحاولة.');
                    });
                });
            });

            var accountModalEl = document.getElementById('payoutAccountModal');
            var accountModal = accountModalEl ? new bootstrap.Modal(accountModalEl) : null;
            var accountClinicId = null;

            document.querySelectorAll('.payout-account-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    accountClinicId = btn.getAttribute('data-clinic-id');
                    document.getElementById('payoutAccountClinicName').textContent =
                        'العيادة: ' + (btn.getAttribute('data-clinic-name') || '');
                    document.getElementById('payoutAccountHolder').value = btn.getAttribute('data-holder-name') || '';

                    var bank = btn.getAttribute('data-bank-code');
                    if (bank) document.getElementById('payoutAccountBank').value = bank;

                    document.getElementById('payoutAccountNumber').value = '';
                    document.getElementById('payoutAccountNationalId').value = '';

                    var mask = btn.getAttribute('data-account-mask');
                    document.getElementById('payoutAccountMaskHint').textContent = mask
                        ? 'الحساب الحالي: ' + mask + ' — اكتب الرقم كاملًا لحفظه من جديد.'
                        : 'لا يوجد حساب مسجل بعد لهذه العيادة.';

                    if (accountModal) accountModal.show();
                });
            });

            document.getElementById('payoutAccountSaveBtn').addEventListener('click', function () {
                if (!accountClinicId) return;

                var holderName = document.getElementById('payoutAccountHolder').value.trim();
                var accountNumber = document.getElementById('payoutAccountNumber').value.trim();
                var nationalId = document.getElementById('payoutAccountNationalId').value.trim();

                if (!holderName || !accountNumber || !nationalId) {
                    showErrorModal('يرجى استكمال اسم صاحب الحساب ورقم الحساب والرقم القومي.');
                    return;
                }

                var btn = this;
                btn.disabled = true;

                fetch('/Admin/Payouts/UpsertClinicAccount', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        clinicId: accountClinicId,
                        holderName: holderName,
                        bankCode: document.getElementById('payoutAccountBank').value,
                        accountNumber: accountNumber,
                        nationalId: nationalId,
                        bankTransactionType: 'cash_transfer'
                    })
                })
                    .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
                    .then(function (result) {
                        if (result.ok && result.data && result.data.success) {
                            if (accountModal) accountModal.hide();
                            showSuccessModal(result.data.message || 'تم حفظ الحساب البنكي.');
                            setTimeout(function () { window.location.reload(); }, 1500);
                        } else {
                            showErrorModal((result.data && result.data.message) || 'تعذر حفظ بيانات الحساب البنكي.');
                            btn.disabled = false;
                        }
                    })
                    .catch(function () {
                        showErrorModal('عذراً، حدث خطأ أثناء حفظ بيانات الحساب البنكي.');
                        btn.disabled = false;
                    });
            });

            var creditModalEl = document.getElementById('payoutCreditModal');
            var creditModal = creditModalEl ? new bootstrap.Modal(creditModalEl) : null;
            var creditClinicId = null;

            document.querySelectorAll('.payout-credit-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    creditClinicId = btn.getAttribute('data-clinic-id');
                    document.getElementById('payoutCreditClinicName').textContent =
                        'العيادة: ' + (btn.getAttribute('data-clinic-name') || '');
                    document.getElementById('payoutCreditAmount').value = '';
                    document.getElementById('payoutCreditNotes').value = '';
                    if (creditModal) creditModal.show();
                });
            });

            document.getElementById('payoutCreditSaveBtn').addEventListener('click', function () {
                if (!creditClinicId) return;

                var amount = Number(document.getElementById('payoutCreditAmount').value);
                if (!amount || amount <= 0) {
                    showErrorModal('يرجى إدخال مبلغ أكبر من صفر.');
                    return;
                }

                var btn = this;
                btn.disabled = true;

                postJson('/Admin/Payouts/CreditClinic', {
                    clinicId: creditClinicId,
                    amount: amount,
                    notes: document.getElementById('payoutCreditNotes').value.trim() || null
                })
                    .then(function (result) {
                        if (result.ok && result.data && result.data.success) {
                            if (creditModal) creditModal.hide();
                            showSuccessModal(result.data.message || 'تمت إضافة المستحقات.');
                            setTimeout(function () { window.location.reload(); }, 1500);
                        } else {
                            showErrorModal((result.data && result.data.message) || 'تعذر إضافة المستحقات للعيادة.');
                            btn.disabled = false;
                        }
                    })
                    .catch(function () {
                        showErrorModal('عذراً، حدث خطأ أثناء إضافة المستحقات.');
                        btn.disabled = false;
                    });
            });
        })();
    </script>
}
