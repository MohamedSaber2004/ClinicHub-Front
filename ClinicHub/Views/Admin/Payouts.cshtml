                <p class="text-md" id="payoutConfirmMessage"></p>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="payoutConfirmYes">تأكيد</button>
