@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "ملف الطبيب";
    Layout = "_AdminLayout";
    var doctor = ViewBag.Doctor as DoctorDto;

    string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "؟";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}" : parts[0].Substring(0, 1);
    }

    string FormatTime(string? timeStr)
    {
        if (string.IsNullOrWhiteSpace(timeStr)) return "—";
        var parts = timeStr.Split(':');
        if (parts.Length < 2 || !int.TryParse(parts[0], out var h)) return timeStr;
        var period = h >= 12 ? "م" : "ص";
        var h12 = h % 12;
        if (h12 == 0) h12 = 12;
        return $"{h12}:{parts[1]} {period}";
    }

    string DayName(int d) => d switch
    {
        0 => "الأحد",
        1 => "الإثنين",
        2 => "الثلاثاء",
        3 => "الأربعاء",
        4 => "الخميس",
        5 => "الجمعة",
        6 => "السبت",
        _ => "-"
    };
}

@if (doctor == null)
{
    <div class="table-card">
        <h3 class="table-card-title">تعذّر تحميل بيانات الطبيب</h3>
        <p class="text-muted">@TempData["ErrorMessage"]</p>
        <a href="@ClinicHub.Routes.AdminRoutes.Pages.Doctors()" class="btn btn-outline">العودة للأطباء</a>
    </div>
}
else
{
    <div class="page-header">
        <h2 class="page-title">ملف الطبيب</h2>
        <a href="@ClinicHub.Routes.AdminRoutes.Pages.Doctors()" class="btn btn-outline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
            </svg>
            رجوع
        </a>
    </div>

    <!-- Doctor Profile Header -->
    <div class="user-profile-header">
        <div class="user-profile-avatar-lg">
            @if (!string.IsNullOrWhiteSpace(doctor.ProfilePictureUrl))
            {
                <img src="@doctor.ProfilePictureUrl" alt="@doctor.UserName" class="header-avatar-img" />
            }
            else
            {
                <span>@Initials(doctor.UserName)</span>
            }
        </div>
        <div class="user-profile-info">
            <h2 class="user-profile-name">@doctor.UserName</h2>
            <p class="user-profile-contact">@doctor.UserEmail &middot; @(string.IsNullOrWhiteSpace(doctor.UserPhoneNumber) ? "—" : doctor.UserPhoneNumber)</p>
            <div class="role-list">
                <span class="badge badge-info">طبيب</span>
                <span class="badge badge-primary">@doctor.SpecializationName</span>
                @if (doctor.IsActive)
                {
                    <span class="badge badge-success">نشط</span>
                }
                else
                {
                    <span class="badge badge-danger">غير نشط</span>
                }
            </div>
        </div>
    </div>

    <!-- Info Cards -->
    <div class="reports-analytics-grid">
        <div class="detail-card">
            <h3 class="detail-card-title">البيانات الأساسية</h3>
            <div class="detail-info-list">
                <div class="detail-info-row">
                    <span class="detail-info-label">الاسم الكامل</span>
                    <span class="detail-info-value">@doctor.UserName</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">التخصص</span>
                    <span class="detail-info-value">@doctor.SpecializationName</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">سنوات الخبرة</span>
                    <span class="detail-info-value">@doctor.YearsOfExperience سنة</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">تاريخ الإضافة</span>
                    <span class="detail-info-value">@doctor.CreatedAt.ToString("yyyy-MM-dd")</span>
                </div>
            </div>
        </div>

        <div class="detail-card">
            <h3 class="detail-card-title">بيانات العيادة</h3>
            <div class="detail-info-list">
                <div class="detail-info-row">
                    <span class="detail-info-label">العيادة</span>
                    <span class="detail-info-value">@doctor.ClinicName</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">البريد الإلكتروني</span>
                    <span class="detail-info-value">@doctor.UserEmail</span>
                </div>
                <div class="detail-info-row">
                    <span class="detail-info-label">رقم الهاتف</span>
                    <span class="detail-info-value">@(string.IsNullOrWhiteSpace(doctor.UserPhoneNumber) ? "—" : doctor.UserPhoneNumber)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Bio -->
    <div class="detail-card mb-4">
        <h3 class="detail-card-title">نبذة تعريفية</h3>
        @if (!string.IsNullOrWhiteSpace(doctor.Bio))
        {
            <p class="text-md">@doctor.Bio</p>
        }
        else
        {
            <p class="text-muted">لا توجد نبذة تعريفية مضافة.</p>
        }
    </div>

    <!-- Weekly Availability -->
    <div class="detail-card">
        <h3 class="detail-card-title">جدول العمل الأسبوعي</h3>
        @if (doctor.Availabilities != null && doctor.Availabilities.Count > 0)
        {
            <div class="workload-list">
                @foreach (var av in doctor.Availabilities.OrderBy(a => a.DayOfWeek))
                {
                    <div class="workload-item">
                        <div class="workload-item-header">
                            <span class="workload-day">@DayName(av.DayOfWeek)</span>
                            <span class="workload-count font-data">@FormatTime(av.StartTime) — @FormatTime(av.EndTime)</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">لم يتم تحديد مواعيد عمل بعد.</p>
        }
    </div>
}
