@using ClinicHub.Services.ReponseModels
@using System.Text.Json
@{
    ViewData["Title"] = "إدارة الخطط والاشتراكات";
    Layout = "_AdminLayout";
    var plans = ViewBag.Plans as IEnumerable<PlanDto> ?? new List<PlanDto>();
    var featureLabels = new Dictionary<string, string>
    {
        ["appointments"] = "إدارة المواعيد",
        ["patient_records"] = "السجلات الطبية",
        ["basic_reports"] = "تقارير أساسية",
        ["advanced_reports"] = "تقارير متقدمة",
        ["marketing_tools"] = "أدوات تسويقية",
        ["priority_support"] = "دعم ذو أولوية",
        ["online_booking"] = "الحجز والدفع أونلاين",
        ["staff_management"] = "إدارة الموظفين",
        ["doctor_management"] = "إدارة الأطباء",
    };
}

<div class="page-header">
    <h2 class="page-title">
        <span class="page-title-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm-2 14l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" fill="currentColor"/>
            </svg>
        </span>
        إدارة الخطط والاشتراكات
    </h2>
</div>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

<div class="subscription-plans">
    @if (!plans.Any())
    {
        <div class="text-center text-muted py-5">
            <p class="mb-0">لا توجد باقات متاحة حالياً</p>
        </div>
    }
    else
    {
        var planList = plans.ToList();
        var activePlans = planList.Where(p => p.IsActive).ToList();
        var maxSort = activePlans.Any() ? activePlans.Max(p => p.SortOrder) : -1;

        foreach (var plan in planList.OrderBy(p => p.SortOrder))
        {
            var isTop = plan.IsActive && plan.SortOrder >= maxSort && maxSort >= 0;
            var planClass = isTop ? "plan-premium" : "plan-free";
            var badge = isTop ? "الأفضل" : "";
            var featureList = JsonSerializer.Deserialize<List<string>>(plan.Features ?? "[]") ?? new();

            <div class="plan-card @planClass" id="planCard-@plan.Id">
                @if (!string.IsNullOrEmpty(badge))
                {
                    <span class="plan-badge">@badge</span>
                }
                <div class="plan-header">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge @(plan.IsActive ? "badge-success" : "badge-secondary")">
                            @(plan.IsActive ? "ظاهرة في الصفحة الرئيسية" : "مخفية")
                        </span>
                    </div>
                    <h3 class="plan-name">@(!string.IsNullOrWhiteSpace(plan.NameAr) ? plan.NameAr : plan.Name)</h3>
                    @if (!string.IsNullOrWhiteSpace(plan.DescriptionAr ?? plan.Description))
                    {
                        <p class="text-muted small mb-2">@(plan.DescriptionAr ?? plan.Description)</p>
                    }
                    <p class="plan-price">
                        <span id="displayMonthly-@plan.Id">@plan.PriceMonthly.ToString("N0")</span> <span class="plan-currency">ج.م</span>
                        <span class="small text-muted">/ شهرياً</span>
                    </p>
                    <div class="text-muted small mt-1">
                        <span id="displayYearly-@plan.Id">@plan.PriceYearly.ToString("N0")</span> ج.م / سنوياً
                    </div>
                </div>
                <div class="plan-body">
                    <div class="plan-limits mb-3 text-muted small">
                        <div>@(plan.MaxDoctors.HasValue ? $"حتى {plan.MaxDoctors} أطباء" : "أطباء غير محدود")</div>
                        <div>@(plan.MaxStaff.HasValue ? $"حتى {plan.MaxStaff} موظفين" : "موظفين غير محدود")</div>
                    </div>
                    <ul class="plan-features">
                        @foreach (var feature in featureList)
                        {
                            <li>
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" fill="var(--clr-success)"/>
                                </svg>
                                <span>@(featureLabels.ContainsKey(feature) ? featureLabels[feature] : feature)</span>
                            </li>
                        }
                    </ul>
                </div>
                <div class="plan-footer d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-outline-primary btn-sm edit-plan-btn"
                            data-id="@plan.Id"
                            data-name="@plan.Name"
                            data-namear="@plan.NameAr"
                            data-description="@plan.Description"
                            data-descriptionar="@plan.DescriptionAr"
                            data-monthly="@plan.PriceMonthly"
                            data-yearly="@plan.PriceYearly"
                            data-maxdoctors="@plan.MaxDoctors"
                            data-maxstaff="@plan.MaxStaff"
                            data-features="@plan.Features"
                            data-isactive="@plan.IsActive.ToString().ToLower()"
                            data-sortorder="@plan.SortOrder">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                        </svg>
                        تعديل
                    </button>
                    <button type="button" class="btn @(plan.IsActive ? "btn-outline-danger" : "btn-outline-success") btn-sm toggle-plan-btn"
                            data-id="@plan.Id"
                            data-name="@plan.Name"
                            data-namear="@plan.NameAr"
                            data-description="@plan.Description"
                            data-descriptionar="@plan.DescriptionAr"
                            data-monthly="@plan.PriceMonthly"
                            data-yearly="@plan.PriceYearly"
                            data-maxdoctors="@plan.MaxDoctors"
                            data-maxstaff="@plan.MaxStaff"
                            data-features="@plan.Features"
                            data-isactive="@plan.IsActive.ToString().ToLower()"
                            data-sortorder="@plan.SortOrder">
                        @(plan.IsActive ? "إخفاء من الصفحة" : "إظهار في الصفحة")
                    </button>
                </div>
            </div>
        }
    }
</div>

<!-- Edit Plan Modal -->
<div class="modal fade" id="editPlanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <div class="modal-header-custom">
                <h5 class="modal-title" id="editPlanModalTitle">تعديل باقة الاشتراك</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body-custom">
                <form id="editPlanForm">
                    <input type="hidden" id="editPlanId" />
                    <input type="hidden" id="editPlanName" />
                    <input type="hidden" id="editPlanDescription" />
                    <input type="hidden" id="editPlanMaxDoctors" />
                    <input type="hidden" id="editPlanMaxStaff" />
                    <input type="hidden" id="editPlanFeatures" />
                    <input type="hidden" id="editPlanSortOrder" />

                    <div class="form-group mb-3">
                        <label class="form-label" for="editPlanNameAr">اسم الباقة (عربي)</label>
                        <input type="text" id="editPlanNameAr" class="form-input" required />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label" for="editPlanDescriptionAr">الوصف (عربي)</label>
                        <textarea id="editPlanDescriptionAr" class="form-input" rows="2"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label" for="editPlanMonthly">السعر الشهري (ج.م) <span class="text-danger">*</span></label>
                                <input type="number" id="editPlanMonthly" class="form-input" min="0" step="1" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label" for="editPlanYearly">السعر السنوي (ج.م) <span class="text-danger">*</span></label>
                                <input type="number" id="editPlanYearly" class="form-input" min="0" step="1" required />
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-toggle">
                            <input type="checkbox" id="editPlanIsActive" value="true" />
                            <span class="toggle-track"></span>
                            <span class="toggle-label">ظاهرة في صفحة الاشتراكات (نشطة)</span>
                        </label>
                    </div>
                </form>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="savePlanBtn">حفظ التغييرات</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var errorMsg = '@(ViewBag.ErrorMessage ?? TempData["ErrorMessage"] ?? "")';
        if (errorMsg) { showErrorModal(errorMsg); }
        var successMsg = '@(TempData["SuccessMessage"] ?? "")';
        if (successMsg) { showSuccessModal(successMsg); }
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalEl = document.getElementById('editPlanModal');
            var editPlanModal = new bootstrap.Modal(modalEl);
            var savePlanBtn = document.getElementById('savePlanBtn');

            document.querySelectorAll('.edit-plan-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('editPlanId').value = btn.getAttribute('data-id');
                    document.getElementById('editPlanName').value = btn.getAttribute('data-name');
                    document.getElementById('editPlanNameAr').value = btn.getAttribute('data-namear') || btn.getAttribute('data-name');
                    document.getElementById('editPlanDescription').value = btn.getAttribute('data-description') || '';
                    document.getElementById('editPlanDescriptionAr').value = btn.getAttribute('data-descriptionar') || '';
                    document.getElementById('editPlanMonthly').value = parseFloat(btn.getAttribute('data-monthly')) || 0;
                    document.getElementById('editPlanYearly').value = parseFloat(btn.getAttribute('data-yearly')) || 0;
                    document.getElementById('editPlanMaxDoctors').value = btn.getAttribute('data-maxdoctors') || '';
                    document.getElementById('editPlanMaxStaff').value = btn.getAttribute('data-maxstaff') || '';
                    document.getElementById('editPlanFeatures').value = btn.getAttribute('data-features') || '[]';
                    document.getElementById('editPlanSortOrder').value = btn.getAttribute('data-sortorder') || '0';
                    document.getElementById('editPlanIsActive').checked = btn.getAttribute('data-isactive') === 'true';

                    editPlanModal.show();
                });
            });

            if (savePlanBtn) {
                savePlanBtn.addEventListener('click', function () {
                    var id = document.getElementById('editPlanId').value;
                    var name = document.getElementById('editPlanName').value;
                    var nameAr = document.getElementById('editPlanNameAr').value.trim();
                    var description = document.getElementById('editPlanDescription').value;
                    var descriptionAr = document.getElementById('editPlanDescriptionAr').value.trim();
                    var monthly = parseFloat(document.getElementById('editPlanMonthly').value);
                    var yearly = parseFloat(document.getElementById('editPlanYearly').value);
                    var maxDoctors = document.getElementById('editPlanMaxDoctors').value;
                    var maxStaff = document.getElementById('editPlanMaxStaff').value;
                    var features = document.getElementById('editPlanFeatures').value;
                    var sortOrder = parseInt(document.getElementById('editPlanSortOrder').value) || 0;
                    var isActive = document.getElementById('editPlanIsActive').checked;

                    if (!nameAr) {
                        showErrorModal('يرجى كتابة اسم الباقة');
                        return;
                    }
                    if (isNaN(monthly) || monthly < 0 || isNaN(yearly) || yearly < 0) {
                        showErrorModal('يرجى إدخال أسعار صحيحة للباقة');
                        return;
                    }

                    savePlanBtn.disabled = true;
                    savePlanBtn.textContent = 'جاري الحفظ...';

                    var payload = {
                        id: id,
                        name: name,
                        nameAr: nameAr,
                        description: description,
                        descriptionAr: descriptionAr,
                        priceMonthly: monthly,
                        priceYearly: yearly,
                        maxDoctors: maxDoctors ? parseInt(maxDoctors) : null,
                        maxStaff: maxStaff ? parseInt(maxStaff) : null,
                        features: features,
                        isActive: isActive,
                        sortOrder: sortOrder
                    };

                    fetch('/Admin/Subscriptions/UpdatePlan', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (result) {
                        if (result.success) {
                            editPlanModal.hide();
                            showSuccessModal(result.message || 'تم حفظ تعديلات الباقة بنجاح');
                            setTimeout(function () { location.reload(); }, 1200);
                        } else {
                            savePlanBtn.disabled = false;
                            savePlanBtn.textContent = 'حفظ التغييرات';
                            showErrorModal(result.message || 'حدث خطأ أثناء حفظ الباقة');
                        }
                    })
                    .catch(function () {
                        savePlanBtn.disabled = false;
                        savePlanBtn.textContent = 'حفظ التغييرات';
                        showErrorModal('عذراً، حدث خطأ أثناء حفظ الباقة');
                    });
                });
            }

            document.querySelectorAll('.toggle-plan-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = btn.getAttribute('data-id');
                    var name = btn.getAttribute('data-name');
                    var nameAr = btn.getAttribute('data-namear') || name;
                    var isCurrentlyActive = btn.getAttribute('data-isactive') === 'true';
                    var newActive = !isCurrentlyActive;
                    var actionText = newActive ? 'إظهار' : 'إخفاء';

                    showConfirmModal('هل أنت متأكد من ' + actionText + ' باقة "' + nameAr + '" من صفحة الاشتراكات؟', function (confirmed) {
                        if (!confirmed) return;

                        btn.disabled = true;
                        btn.textContent = 'جاري التحديث...';

                        var payload = {
                            id: id,
                            name: name,
                            nameAr: nameAr,
                            description: btn.getAttribute('data-description') || '',
                            descriptionAr: btn.getAttribute('data-descriptionar') || '',
                            priceMonthly: parseFloat(btn.getAttribute('data-monthly')) || 0,
                            priceYearly: parseFloat(btn.getAttribute('data-yearly')) || 0,
                            maxDoctors: btn.getAttribute('data-maxdoctors') ? parseInt(btn.getAttribute('data-maxdoctors')) : null,
                            maxStaff: btn.getAttribute('data-maxstaff') ? parseInt(btn.getAttribute('data-maxstaff')) : null,
                            features: btn.getAttribute('data-features') || '[]',
                            isActive: newActive,
                            sortOrder: parseInt(btn.getAttribute('data-sortorder')) || 0
                        };

                        fetch('/Admin/Subscriptions/UpdatePlan', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        })
                        .then(function (r) { return r.json(); })
                        .then(function (result) {
                            if (result.success) {
                                showSuccessModal(result.message || 'تم تحديث حالة الباقة بنجاح');
                                setTimeout(function () { location.reload(); }, 1200);
                            } else {
                                btn.disabled = false;
                                btn.textContent = isCurrentlyActive ? 'إخفاء من الصفحة' : 'إظهار في الصفحة';
                                showErrorModal(result.message || 'حدث خطأ أثناء تحديث حالة الباقة');
                            }
                        })
                        .catch(function () {
                            btn.disabled = false;
                            btn.textContent = isCurrentlyActive ? 'إخفاء من الصفحة' : 'إظهار في الصفحة';
                            showErrorModal('عذراً، حدث خطأ أثناء تحديث حالة الباقة');
                        });
                    });
                });
            });
        });
    </script>
}
