@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "إدارة الخطط والاشتراكات";
    Layout = "_AdminLayout";
    var plans = ViewBag.Plans as IEnumerable<PlanDto> ?? new List<PlanDto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold">إدارة الخطط والاشتراكات</h4>
        <p class="text-muted mb-0">عرض وتحديث خطط الاشتراكات الممتازة للعيادات</p>
    </div>
</div>

<div class="row g-4">
    @if (!plans.Any())
    {
        <div class="col-12 text-center py-5 text-muted">
            لا توجد خطط اشتراك متاحة حالياً
        </div>
    }
    else
    {
        @foreach (var plan in plans)
        {
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 p-3">
                    <div class="card-body d-flex flex-column">
                        <h5 class="fw-bold card-title">@plan.Name</h5>
                        <p class="text-muted small">@plan.Description</p>

                        <div class="my-3">
                            <h3 class="fw-bold text-primary mb-0">@plan.PriceMonthly.ToString("N0") <span class="fs-6 text-muted">ج.م / شهرياً</span></h3>
                            <div class="text-muted small">@plan.PriceYearly.ToString("N0") ج.م / سنوياً</div>
                        </div>

                        <div class="mt-auto">
                            <span class="badge @(plan.IsActive ? "bg-success" : "bg-secondary") mb-2">@(plan.IsActive ? "نشط" : "غير نشط")</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
