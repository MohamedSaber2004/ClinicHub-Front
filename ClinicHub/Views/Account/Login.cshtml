@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <!-- Logo -->
        <div class="auth-logo-section">
            <img src="~/logo.png" alt="Doctory" class="brand-logo-img brand-logo-img--auth" />
            <span class="auth-logo-text">Doctory</span>
        </div>

        <h3 class="auth-title">تسجيل الدخول</h3>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center auth-alert">
                @TempData["SuccessMessage"]
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post" data-ajax="true" id="loginForm">
            @if (ViewBag.ReturnUrl != null)
            {
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            }
            <input type="hidden" name="fcmToken" id="fcmToken" />
            <input type="hidden" name="devicePlatform" id="devicePlatform" value="0" />
            <div class="text-danger auth-alert" asp-validation-summary="ModelOnly"></div>

            <!-- Gmail -->
            <div class="auth-input-group">
                <label class="auth-form-label" for="email">البريد الإلكتروني (Gmail)</label>
                <input class="auth-form-control" type="email" id="email" name="email" placeholder="example@gmail.com" required autocomplete="username" />
            </div>

            <!-- Password -->
            <div class="auth-input-group">
                <label class="auth-form-label" for="password">كلمة المرور</label>
                <input class="auth-form-control" type="password" id="password" name="password" placeholder="أدخل كلمة المرور" required autocomplete="current-password" />
            </div>

            <button type="submit" class="auth-btn-primary">تسجيل الدخول</button>
        </form>

        <div class="auth-footer-links">
            <a href="@HomeRoutes.Account.ForgotPassword()" class="auth-link">نسيت كلمة المرور؟</a>
            <a href="@HomeRoutes.Pages.Index()" class="auth-link">العودة للرئيسية</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_FcmConfig" />
    <script src="~/js/fcm.js" asp-append-version="true"></script>
}
