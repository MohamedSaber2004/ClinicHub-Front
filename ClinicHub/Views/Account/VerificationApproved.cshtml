@{
    ViewData["Title"] = "التحقق من الحساب";
}

<div class="auth-wrapper">
    <div class="auth-card text-center">
        <div class="auth-logo-section mb-4">
            <img src="~/logo.png" alt="Doctory" class="brand-logo-img brand-logo-img--auth" />
            <span class="auth-logo-text">Doctory</span>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <h3 class="auth-title text-danger">خطأ في التحقق</h3>
            <div class="alert alert-danger auth-alert">
                @ViewBag.ErrorMessage
            </div>
            <div class="mt-4">
                <a href="@ClinicHub.Routes.HomeRoutes.Account.Login()" class="auth-btn-primary d-inline-block text-decoration-none">الذهاب لتسجيل الدخول</a>
            </div>
        }
        else
        {
            <h3 class="auth-title">تمت التحقق بنجاح</h3>
            <p class="auth-description">جاري إعادة توجيهك إلى صفحة الاشتراكات...</p>
        }
    </div>
</div>
