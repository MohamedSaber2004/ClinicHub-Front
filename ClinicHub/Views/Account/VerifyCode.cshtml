@{
    ViewData["Title"] = "تحقق من الرمز - Doctory";
    var email = TempData["Email"]?.ToString() ?? "البريد الإلكتروني";
    TempData.Keep("Email");
}

<div class="auth-wrapper">
    <div class="auth-card">
        <!-- Logo -->
        <div class="auth-logo-section">
            <img src="~/logo.png" alt="Doctory" class="brand-logo-img brand-logo-img--auth" />
            <span class="auth-logo-text">Doctory</span>
        </div>

        <h3 class="auth-title">رمز التحقق</h3>

        <p class="auth-description">
            تم إرسال رمز التحقق إلى: <br />
            <strong class="auth-email">@email</strong>
        </p>

        <form action="@HomeRoutes.Account.VerifyCode()" method="post" data-ajax="true">
            <div class="text-danger auth-alert" asp-validation-summary="ModelOnly"></div>

            <!-- Hidden input to preserve email -->
            <input type="hidden" name="email" value="@email" />

            <!-- Code Input -->
            <div class="auth-input-group">
                <label class="auth-form-label auth-code-label" for="verificationCode">أدخل رمز التحقق المكون من 6 أرقام</label>
                <input class="auth-form-control auth-code-input" type="text" id="verificationCode" name="verificationCode" placeholder="••••••"
                       required maxlength="6" pattern="\d{6}" autocomplete="off" />
            </div>

            <button type="submit" class="auth-btn-primary">تحقق من الرمز</button>
        </form>

        <div class="auth-footer-links">
            <a href="@HomeRoutes.Account.ForgotPassword()" class="auth-link">تغيير البريد الإلكتروني</a>
            <a href="@HomeRoutes.Account.Login()" class="auth-link">العودة لتسجيل الدخول</a>
        </div>
    </div>
</div>
