@{
    ViewData["Title"] = "نسيت كلمة المرور - Doctory";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <!-- Logo -->
        <div class="auth-logo-section">
            <img src="~/logo.png" alt="Doctory" class="brand-logo-img brand-logo-img--auth" />
            <span class="auth-logo-text">Doctory</span>
        </div>

        <h3 class="auth-title">نسيت كلمة المرور</h3>
        <p class="auth-description">
            أدخل بريدك الإلكتروني المسجل وسنقوم بإرسال رمز تحقق لتتمكن من إعادة تعيين كلمة المرور الخاصة بك.
        </p>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" data-ajax="true">
            <div class="text-danger auth-alert" asp-validation-summary="ModelOnly"></div>
            
            <!-- Email -->
            <div class="auth-input-group">
                <label class="auth-form-label" for="email">البريد الإلكتروني (Gmail)</label>
                <input class="auth-form-control" type="email" id="email" name="email" placeholder="example@gmail.com" required autocomplete="email" />
            </div>

            <button type="submit" class="auth-btn-primary">إرسال رمز التحقق</button>
        </form>

        <div class="auth-footer-links">
            <a href="@HomeRoutes.Account.Login()" class="auth-link">العودة لتسجيل الدخول</a>
        </div>
    </div>
</div>
