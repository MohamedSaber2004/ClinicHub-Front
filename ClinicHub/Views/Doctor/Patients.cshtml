@using ClinicHub.Data
@{
    ViewData["Title"] = "مرضاي";
    Layout = "_DoctorLayout";
    var patients = ViewBag.Patients as List<MockDoctorPatient> ?? new();
}

<h2 class="page-title">
    <span class="page-title-icon">
        <i class="bi bi-people"></i>
    </span>
    قائمة المرضى
</h2>

<div class="table-card">
    <div class="table-card-header">
        <h3 class="table-card-title">مرضاي المسجلون</h3>
    </div>
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>المريض</th>
                    <th>آخر زيارة</th>
                    <th>رقم الهاتف</th>
                    <th>عدد الزيارات</th>
                    <th>الحالة</th>
                    <th>الإجراء</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in patients)
                {
                    <tr>
                        <td>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <div class="sidebar-profile-avatar" style="width: 28px; height: 28px;">
                                    <span style="font-size: 11px;">@patient.Initials</span>
                                </div>
                                @patient.Name
                            </div>
                        </td>
                        <td>@patient.LastVisit</td>
                        <td>@patient.Phone</td>
                        <td>@patient.TotalVisits</td>
                        <td>@patient.Condition</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" href="@DoctorRoutes.Pages.PatientHistory(patient.Id)">
                                <i class="bi bi-clock-history"></i> عرض التاريخ
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
