@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "مواعيدي";

    var appointments = ViewBag.Appointments as IReadOnlyCollection<DoctorAppointmentDto> ?? new List<DoctorAppointmentDto>();

    string StatusLabel(int? s) => s switch
    {
        0 => "قيد الانتظار",
        1 => "مؤكد",
        2 => "ملغى",
        3 => "مكتمل",
        4 => "محجوز مؤقتاً",
        5 => "لم يحضر",
        6 => "بانتظار الدفع",
        7 => "مرفوض",
        _ => "غير معروف"
    };

    string StatusClass(int? s) => s switch
    {
        0 => "badge-warning",
        1 => "badge-success",
        2 => "badge-danger",
        3 => "badge-success",
        4 => "badge-primary",
        5 => "badge-danger",
        6 => "badge-warning",
        7 => "badge-danger",
        _ => "badge-secondary"
    };

    string TypeLabel(int t) => t == 1 ? "منزلي" : "في العيادة";
    string TimeOnly(string? t) => string.IsNullOrEmpty(t) || t.Length < 5 ? "—" : t[..5];
    string Initial(string? name) => string.IsNullOrWhiteSpace(name) ? "م" : name.Trim()[..1];

    var headerProfile = ViewBag.HeaderProfile as UserProfileDto;
    var currentDoctorName = headerProfile?.FullName;
    var hasDoctorInfo = appointments.Any(a => !string.IsNullOrWhiteSpace(a.DoctorName));

    bool SlotStarted(DoctorAppointmentDto app)
    {
        if (!DateTime.TryParse(app.AppointmentDate, out var date)) return false;
        if (!TimeSpan.TryParse(app.StartTime, out var startTime)) return false;
        return date.Date.Add(startTime) <= DateTime.Now;
    }

    var statusChips = new (string Value, string Label)[]
    {
        ("", "جميع الحالات"),
        ("0", "قيد الانتظار"),
        ("6", "بانتظار الدفع"),
        ("1", "مؤكد"),
        ("3", "مكتمل"),
        ("2", "ملغى"),
        ("7", "مرفوض")
    };
}

<div class="page-header">
    <div>
        <h2 class="page-title">
            <span class="page-title-icon">
                <i class="bi bi-calendar3"></i>
            </span>
            جميع المواعيد
        </h2>
    </div>
    <div class="page-header-actions">
        <a class="btn btn-secondary btn-sm" href="@Url.Action("Availability")">
            <i class="bi bi-clock-history"></i>
            أوقات العمل المتاحة
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(currentDoctorName))
{
    <div class="ds-scope-note table-hint appointment-scope-hint">
        <i class="bi bi-person-check"></i>
        تُعرض مواعيد حسابك فقط: د. @currentDoctorName
    </div>
}

<div class="table-card ds-table-card">
    <div class="table-card-header">
        <h3 class="table-card-title">قائمة المواعيد</h3>
    </div>
    <form method="get" action="@Url.Action("Appointments")" class="filter-bar table-filter-bar ds-filter">
        <select name="status" class="form-select ds-sr-field" tabindex="-1" aria-hidden="true">
            <option value="">جميع الحالات</option>
            <option value="0" selected="@(ViewBag.StatusFilter == "0")">قيد الانتظار</option>
            <option value="6" selected="@(ViewBag.StatusFilter == "6")">بانتظار الدفع</option>
            <option value="1" selected="@(ViewBag.StatusFilter == "1")">مؤكد</option>
            <option value="3" selected="@(ViewBag.StatusFilter == "3")">مكتمل</option>
            <option value="2" selected="@(ViewBag.StatusFilter == "2")">ملغى</option>
            <option value="7" selected="@(ViewBag.StatusFilter == "7")">مرفوض</option>
        </select>
        <div class="form-field ds-filter-search">
            <span class="form-field-icon">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
                    <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </span>
            <input type="text" name="searchTerm" aria-label="بحث في المواعيد" class="form-input" placeholder="اسم المريض أو الهاتف..." value="@ViewBag.SearchTerm" />
        </div>
        <div class="segmented ds-date-scope">
            <input type="date" name="startDate" aria-label="من تاريخ" class="form-input" value="@ViewBag.StartDate" title="من تاريخ" />
            <span class="ds-date-sep" aria-hidden="true">—</span>
            <input type="date" name="endDate" aria-label="إلى تاريخ" class="form-input" value="@ViewBag.EndDate" title="إلى تاريخ" />
        </div>
        <button type="submit" class="btn btn-primary btn-sm">بحث</button>
        <a href="@Url.Action("Appointments")" class="btn btn-ghost btn-sm">مسح</a>
    </form>
    <div class="ds-chips">
        <span class="ds-chips-label">الحالة</span>
        @foreach (var chip in statusChips)
        {
            var chipValue = chip.Value;
            var isActiveChip = string.Equals(ViewBag.StatusFilter as string ?? "", chipValue, StringComparison.Ordinal);
            <a class="chip @(isActiveChip ? "active" : "")"
               href="@Url.Action("Appointments", new { status = chipValue, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate, searchTerm = ViewBag.SearchTerm })">@chip.Label</a>
        }
    </div>
    <div class="table-responsive">
        <table class="custom-table ds-table">
            <thead>
                <tr>
                    <th>المريض</th>
                    @if (hasDoctorInfo)
                    {
                        <th>الطبيب</th>
                    }
                    <th>التاريخ</th>
                    <th>الوقت</th>
                    <th>النوع</th>
                    <th>الحالة</th>
                    <th>الإجراء</th>
                </tr>
            </thead>
            <tbody>
                @if (appointments.Count == 0)
                {
                    <tr>
                        <td colspan="@(hasDoctorInfo ? 7 : 6)" class="table-empty">لا توجد مواعيد مطابقة للبحث</td>
                    </tr>
                }
                @foreach (var app in appointments)
                {
                    var patientName = !string.IsNullOrWhiteSpace(app.PatientFullName) ? app.PatientFullName : (app.BookedByUserName ?? "مريض");
                    var patientPhone = !string.IsNullOrWhiteSpace(app.PatientPhoneNumber) ? app.PatientPhoneNumber : app.BookedByUserPhone;
                    <tr data-id="@app.Id">
                        <td>
                            <div class="ds-patient">
                                <span class="avatar">@Initial(patientName)</span>
                                <span class="ds-patient-meta">
                                    <span class="ds-patient-name">@patientName</span>
                                    @if (!string.IsNullOrWhiteSpace(patientPhone))
                                    {
                                        <span class="ds-patient-phone">@patientPhone</span>
                                    }
                                </span>
                            </div>
                        </td>
                        @if (hasDoctorInfo)
                        {
                            <td>@app.DoctorName</td>
                        }
                        <td class="tabular">@app.AppointmentDate</td>
                        <td class="tabular">@TimeOnly(app.StartTime)</td>
                        <td>@TypeLabel(app.AppointmentType)</td>
                        <td class="ds-status-cell"><span class="badge badge--dot @StatusClass(app.Status)">@StatusLabel(app.Status)</span></td>
                        <td>
                            @if (app.Status == 0)
                            {
                                <div class="table-actions">
                                    <button class="btn btn-sm ds-action ds-action--success" onclick="acceptAppointment('@app.Id')">
                                        <i class="bi bi-check-lg"></i> قبول
                                    </button>
                                    <button class="btn btn-sm ds-action ds-action--danger" onclick="updateStatus('@app.Id', 2)">
                                        <i class="bi bi-x-lg"></i> رفض
                                    </button>
                                </div>
                            }
                            else if (app.Status == 6)
                            {
                                <span class="table-hint"><i class="bi bi-hourglass-split"></i> بانتظار دفع المريض</span>
                            }
                            else if (app.Status == 1)
                            {
                                <div class="table-actions">
                                    @if (SlotStarted(app))
                                    {
                                        <button class="btn btn-sm ds-action ds-action--neutral" onclick="updateStatus('@app.Id', 3)">
                                            <i class="bi bi-check2-circle"></i> إكمال
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="table-hint"><i class="bi bi-calendar-clock"></i> لم يحن موعد الزيارة بعد</span>
                                    }
                                    <button class="btn btn-sm ds-action ds-action--danger" onclick="cancelWithRefund('@app.Id')">
                                        <i class="bi bi-x-circle"></i> إلغاء وإرجاع الفلوس
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" />
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/doctor-staff.css?v=20261027_redesign_v2" />
}

@section Scripts {
    <script>
        var _statusLabels = { 2: 'ملغى', 3: 'مكتمل', 6: 'بانتظار الدفع', 7: 'مرفوض' };
        var _statusClasses = { 2: 'badge-danger', 3: 'badge-success', 6: 'badge-warning', 7: 'badge-danger' };

        function updateRowAfterStatus(appointmentId, statusCode) {
            var row = document.querySelector('tr[data-id="' + appointmentId + '"]');
            if (!row) return;
            var statusFilter = document.querySelector('.filter-bar select[name="status"]');
            if (statusFilter && statusFilter.value !== '') {
                row.style.transition = 'opacity .3s';
                row.style.opacity = '0';
                setTimeout(function () { row.remove(); }, 300);
                return;
            }
            var badge = row.querySelector('.badge');
            if (badge) {
                badge.className = 'badge ' + (_statusClasses[statusCode] || 'badge-secondary');
                badge.textContent = _statusLabels[statusCode] || 'غير معروف';
            }
            var actionsCell = row.lastElementChild;
            if (actionsCell) {
                actionsCell.innerHTML = statusCode === 6
                    ? '<span class="table-hint"><i class="bi bi-hourglass-split"></i> بانتظار دفع المريض</span>'
                    : '<span>—</span>';
            }
        }

        window.acceptAppointment = function (appointmentId) {
            if (typeof showConfirmModal === 'function') {
                showConfirmModal('بعد القبول سيتم إرسال رابط الدفع للمريض لإتمام الدفع. هل تريد المتابعة؟', function () {
                    updateStatus(appointmentId, 6);
                });
            } else {
                updateStatus(appointmentId, 6);
            }
        };

        window.cancelWithRefund = function (appointmentId) {
            var message = 'المريض دفع مبلغ الحجز بالفعل. إلغاء الموعد يرد له المبلغ كاملًا ويخرج من قائمة مواعيده. هل تريد المتابعة؟';
            if (typeof showConfirmModal === 'function') {
                showConfirmModal(message, function () {
                    updateStatus(appointmentId, 2, true);
                });
            } else {
                updateStatus(appointmentId, 2, true);
            }
        };

        window.updateStatus = async function (appointmentId, statusCode, isPaidCancellation) {
            let notes = null;
            if (statusCode === 2) {
                notes = prompt('يرجى إدخال سبب الرفض/الإلغاء (اختياري):');
                if (notes === null) return;
            }
            try {
                const res = await fetch('/Doctor/UpdateAppointmentStatus?appointmentId=' + appointmentId, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: statusCode, notes: notes })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) {
                    throw new Error(data.message || ('HTTP ' + res.status));
                }
                const successMessage = isPaidCancellation
                    ? 'تم إلغاء الموعد وسيتم رد مبلغ الحجز للمريض'
                    : (data.message || 'تم تحديث حالة الموعد بنجاح');
                if (typeof showSuccessModal === 'function') {
                    showSuccessModal(successMessage);
                } else {
                    alert(successMessage);
                }
                // A rejected request lands as Rejected (7); a paid one is cancelled (2).
                updateRowAfterStatus(appointmentId, statusCode === 2 && !isPaidCancellation ? 7 : statusCode);
            } catch (err) {
                if (typeof showErrorModal === 'function') {
                    showErrorModal(err.message);
                } else {
                    alert(err.message);
                }
            }
        };
    </script>
}
