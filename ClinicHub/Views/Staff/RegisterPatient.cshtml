@{
    ViewData["Title"] = "تسجيل مريض وافد";
    Layout = "_StaffLayout";
}

<h2 class="page-title">
    <span class="page-title-icon">
        <i class="bi bi-person-plus"></i>
    </span>
    تسجيل مريض وافد
</h2>

<div class="register-patient-card">
    <div class="detail-card">
        <form id="registerForm">
            <div class="form-group">
                <label for="patientName" class="form-label">اسم المريض</label>
                <input type="text" id="patientName" class="form-input" placeholder="أدخل اسم المريض" required />
            </div>
            <div class="form-group">
                <label for="patientPhone" class="form-label">رقم الهاتف</label>
                <input type="tel" id="patientPhone" class="form-input" placeholder="010 xxxxxxxx" required />
            </div>
            <div class="form-group">
                <label for="doctorSelect" class="form-label">اختيار الطبيب</label>
                <select id="doctorSelect" class="form-select" required>
                    <option value="">-- جاري تحميل الأطباء --</option>
                </select>
            </div>
            <div class="form-group">
                <label for="complaint" class="form-label">ملاحظات / الشكوى</label>
                <textarea id="complaint" class="form-textarea" rows="3" placeholder="الشكوى أو ملاحظات إضافية"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> تسجيل المريض
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        StaffDashboardService.getDoctors().then(function (doctors) {
            StaffDashboardService.renderDoctorDropdown(doctors, 'doctorSelect');
        });

        $('#registerForm').on('submit', function (e) {
            e.preventDefault();
            var data = {
                fullName: $('#patientName').val().trim(),
                phoneNumber: $('#patientPhone').val().trim(),
                doctorId: $('#doctorSelect').val(),
                complaint: $('#complaint').val().trim(),
                appointmentDate: new Date().toISOString().split('T')[0] + 'T00:00:00',
                startTime: new Date().toTimeString().slice(0, 5),
                endTime: new Date(Date.now() + 30 * 60 * 1000).toTimeString().slice(0, 5),
                appointmentType: 0,
                clinicId: localStorage.getItem('clinicId') || ''
            };
            if (!data.fullName || !data.phoneNumber || !data.doctorId) {
                showErrorModal('يرجى ملء جميع الحقول المطلوبة');
                return;
            }
            StaffDashboardService.registerPatient(data).then(function () {
                $('#registerForm')[0].reset();
                $('#doctorSelect').html('<option value="">-- اختر الطبيب --</option>');
                StaffDashboardService.getDoctors().then(function (doctors) {
                    StaffDashboardService.renderDoctorDropdown(doctors, 'doctorSelect');
                });
            });
        });
    </script>
}
