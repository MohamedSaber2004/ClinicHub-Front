@{
    ViewData["Title"] = "المواعيد";
    Layout = "_StaffLayout";
}

@using ClinicHub.Services.ReponseModels
@{
    var appointments = ViewBag.Appointments as IReadOnlyCollection<StaffAppointmentDto> ?? new List<StaffAppointmentDto>();
    string Initial(string? name) => string.IsNullOrWhiteSpace(name) ? "م" : name.Trim()[..1];

    var statusChips = new (string Value, string Label)[]
    {
        ("", "كل الحالات"),
        ("pending", "قيد الانتظار"),
        ("accepted", "مقبول - بانتظار الدفع"),
        ("reserved", "محجوز - بانتظار الدفع"),
        ("confirmed", "مؤكد - مدفوع"),
        ("cancelled", "ملغي"),
        ("completed", "منتهي"),
        ("rejected", "مرفوض"),
        ("noshow", "لم يحضر")
    };
}

<div class="page-header">
    <div>
        <h2 class="page-title">
            <span class="page-title-icon">
                <i class="bi bi-calendar3"></i>
            </span>
            إدارة المواعيد
        </h2>
    </div>
    <div class="page-header-actions">
        <a class="btn btn-secondary btn-sm" href="@Url.Action("Queue")">
            <i class="bi bi-list-ol"></i>
            طابور المرضى
        </a>
    </div>
</div>

<div class="table-card ds-table-card">
    <div class="table-card-header">
        <h3 class="table-card-title">
            <span class="subtitle-icon">
                <i class="bi bi-calendar3"></i>
            </span>
            جميع المواعيد
        </h3>
    </div>
    <form method="get" action="@Url.Action("Appointments")" class="filter-bar table-filter-bar ds-filter">
        <select name="status" class="form-select ds-sr-field" tabindex="-1" aria-hidden="true">
            @foreach (var chip in statusChips)
            {
                <option value="@chip.Value" selected="@(ViewBag.StatusFilter == chip.Value)">@chip.Label</option>
            }
        </select>
        <div class="form-field ds-filter-search">
            <span class="form-field-icon">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
                    <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </span>
            <input type="text" name="searchTerm" aria-label="بحث في المواعيد" class="form-input" placeholder="بحث باسم المريض..." value="@ViewBag.SearchTerm" />
        </div>
        <div class="segmented ds-date-scope ds-filter-dates">
            <input type="date" name="date" aria-label="تاريخ الموعد" class="form-input" value="@ViewBag.DateFilter" title="تاريخ الموعد" />
        </div>
        <button type="submit" class="btn btn-primary btn-sm">بحث</button>
        <a href="@Url.Action("Appointments")" class="btn btn-ghost btn-sm">مسح</a>
    </form>
    <div class="ds-chips">
        <span class="ds-chips-label">الحالة</span>
        @foreach (var chip in statusChips)
        {
            var chipValue = chip.Value;
            var isActiveChip = string.Equals(ViewBag.StatusFilter as string ?? "", chipValue, StringComparison.Ordinal);
            <a class="chip @(isActiveChip ? "active" : "")"
               href="@Url.Action("Appointments", new { status = chipValue, date = ViewBag.DateFilter, searchTerm = ViewBag.SearchTerm })">@chip.Label</a>
        }
    </div>
    <div class="table-responsive">
        <table class="custom-table ds-table">
            <thead>
                <tr>
                    <th>المريض</th>
                    <th>الطبيب</th>
                    <th>التخصص</th>
                    <th>التاريخ</th>
                    <th>الوقت</th>
                    <th>الحالة</th>
                    <th>الإجراء</th>
                </tr>
            </thead>
            <tbody id="appointmentsBody">
                @if (appointments.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="table-empty">لا توجد مواعيد</td>
                    </tr>
                }
                @foreach (var app in appointments)
                {
                    <tr data-id="@app.Id">
                        <td>
                            <div class="ds-patient">
                                <span class="avatar">@(string.IsNullOrWhiteSpace(app.Patient?.Initial) ? Initial(app.Patient?.Name) : app.Patient.Initial)</span>
                                <span class="ds-patient-meta">
                                    <span class="ds-patient-name">@app.Patient?.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(app.Phone))
                                    {
                                        <span class="ds-patient-phone">@app.Phone</span>
                                    }
                                </span>
                            </div>
                        </td>
                        <td>@app.Doctor?.Name</td>
                        <td>@app.Specialty</td>
                        <td class="tabular">@app.Date</td>
                        <td class="tabular">@app.Time</td>
                        <td class="ds-status-cell"><span class="badge badge--dot @app.StatusClass">@app.StatusLabel</span></td>
                        <td class="appointment-actions" data-id="@app.Id">
                            @if (app.Status == "pending" || app.Status == "reserved")
                            {
                                <div class="table-actions">
                                    <button class="btn btn-sm btn-outline-success btn-approve ds-action ds-action--success" data-id="@app.Id" title="قبول — سيتم إرسال رابط الدفع للمريض"><i class="bi bi-check-lg"></i></button>
                                    <button class="btn btn-sm btn-outline-danger btn-reject ds-action ds-action--danger" data-id="@app.Id" title="رفض"><i class="bi bi-x-lg"></i></button>
                                </div>
                            }
                            else if (app.Status == "confirmed" || app.Status == "accepted")
                            {
                                <div class="table-actions">
                                    <button class="btn btn-sm btn-outline-primary btn-checkin ds-action" data-id="@app.Id"><i class="bi bi-box-arrow-in-right"></i> تسجيل وصول</button>
                                    @if (app.Status == "accepted")
                                    {
                                        <button class="btn btn-sm btn-outline-danger btn-reject ds-action ds-action--danger" data-id="@app.Id" title="رفض"><i class="bi bi-x-lg"></i></button>
                                    }
                                </div>
                            }
                            else if (app.Status == "awaiting-payment")
                            {
                                <span class="table-hint"><i class="bi bi-hourglass-split"></i> بانتظار دفع المريض</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" />
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/doctor-staff.css?v=20261027_redesign_v2" />
}

@section Scripts {
    <script>
        var _staffStatus = {
            accepted: { cls: 'badge-success', label: 'مقبول - بانتظار الدفع' },
            rejected: { cls: 'badge-danger', label: 'مرفوض' },
            confirmed: { cls: 'badge-success', label: 'مؤكد - مدفوع' }
        };

        function updateStaffRow(id, statusKey, actionsHtml) {
            var row = document.querySelector('tr[data-id="' + id + '"]');
            if (!row) return;
            var statusFilter = document.querySelector('.filter-bar select[name="status"]');
            if (statusFilter && statusFilter.value !== '' && statusFilter.value !== statusKey) {
                row.style.transition = 'opacity .3s';
                row.style.opacity = '0';
                setTimeout(function () { row.remove(); }, 300);
                return;
            }
            var badge = row.querySelector('.badge');
            if (badge && _staffStatus[statusKey]) {
                badge.className = 'badge ' + _staffStatus[statusKey].cls;
                badge.textContent = _staffStatus[statusKey].label;
            }
            var actionsCell = row.querySelector('.appointment-actions');
            if (actionsCell) actionsCell.innerHTML = actionsHtml;
        }

        $(document).on('click', '.btn-approve', function () {
            var id = $(this).data('id');
            if (!id) return;
            showConfirmModal('بعد القبول سيتم إرسال رابط الدفع للمريض لإتمام الدفع. هل تريد المتابعة؟', function () {
                StaffDashboardService.approveAppointment(id).then(function () {
                    showSuccessModal('تم قبول الحجز وتم إرسال رابط الدفع للمريض');
                    updateStaffRow(id, 'accepted', '<span class="table-hint"><i class="bi bi-hourglass-split"></i> بانتظار دفع المريض</span>');
                }).catch(function (err) {
                    showErrorModal((err && err.message) || 'حدث خطأ أثناء القبول');
                });
            });
        });

        $(document).on('click', '.btn-reject', function () {
            var id = $(this).data('id');
            if (!id) return;
            var reason = prompt('يرجى إدخال سبب الرفض (اختياري):');
            if (reason === null) return;
            StaffDashboardService.rejectAppointment(id, reason || '').then(function () {
                showSuccessModal('تم رفض الحجز');
                updateStaffRow(id, 'rejected', '<span>—</span>');
            }).catch(function (err) {
                showErrorModal((err && err.message) || 'حدث خطأ أثناء الرفض');
            });
        });

        $(document).on('click', '.btn-checkin', function () {
            var id = $(this).data('id');
            if (!id) return;
            showConfirmModal('هل تريد تسجيل وصول هذا المريض؟', function () {
                StaffDashboardService.checkInPatient(id)
                    .then(function () {
                        showSuccessModal('تم تسجيل وصول المريض بنجاح');
                        updateStaffRow(id, 'confirmed', '<button class="btn btn-sm btn-outline-primary btn-checkin" data-id="' + id + '"><i class="bi bi-box-arrow-in-right"></i> تسجيل وصول</button>');
                    })
                    .catch(function (err) {
                        showErrorModal((err && err.message) || 'حدث خطأ أثناء تسجيل الوصول');
                    });
            });
        });
    </script>
}
