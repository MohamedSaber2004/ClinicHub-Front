@{
    ViewData["Title"] = "المواعيد";
    Layout = "_StaffLayout";
}

@using ClinicHub.Services.ReponseModels
@{
    var appointments = ViewBag.Appointments as IReadOnlyCollection<StaffAppointmentDto> ?? new List<StaffAppointmentDto>();
    string Initial(string? name) => string.IsNullOrWhiteSpace(name) ? "م" : name.Trim()[..1];
}

<h2 class="page-title">
    <span class="page-title-icon">
        <i class="bi bi-calendar3"></i>
    </span>
    إدارة المواعيد
</h2>

<div class="table-card">
    <div class="table-card-header">
        <h3 class="table-card-title">
            <span class="subtitle-icon">
                <i class="bi bi-calendar3"></i>
            </span>
            جميع المواعيد
        </h3>
    </div>
    <form method="get" action="@Url.Action("Appointments")" class="filter-bar table-filter-bar">
        <select name="status" class="form-select">
            <option value="">كل الحالات</option>
            <option value="pending" selected="@(ViewBag.StatusFilter == "pending")">قيد الانتظار</option>
            <option value="accepted" selected="@(ViewBag.StatusFilter == "accepted")">بانتظار الدفع</option>
            <option value="confirmed" selected="@(ViewBag.StatusFilter == "confirmed")">مؤكد</option>
            <option value="cancelled" selected="@(ViewBag.StatusFilter == "cancelled")">ملغي</option>
            <option value="completed" selected="@(ViewBag.StatusFilter == "completed")">منتهي</option>
        </select>
        <input type="date" name="date" class="form-input" value="@ViewBag.DateFilter" title="تاريخ الموعد" />
        <input type="text" name="searchTerm" class="form-input" placeholder="بحث باسم المريض..." value="@ViewBag.SearchTerm" />
        <button type="submit" class="btn btn-primary btn-sm">بحث</button>
        <a href="@Url.Action("Appointments")" class="btn btn-outline-secondary btn-sm">مسح</a>
    </form>
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>المريض</th>
                    <th>الطبيب</th>
                    <th>التخصص</th>
                    <th>التاريخ</th>
                    <th>الوقت</th>
                    <th>الحالة</th>
                    <th>الإجراء</th>
                </tr>
            </thead>
            <tbody id="appointmentsBody">
                @if (appointments.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="table-empty">لا توجد مواعيد</td>
                    </tr>
                }
                @foreach (var app in appointments)
                {
                    <tr>
                        <td>
                            <div class="table-user">
                                <span class="table-avatar">@(string.IsNullOrWhiteSpace(app.Patient?.Initial) ? Initial(app.Patient?.Name) : app.Patient.Initial)</span>
                                <span class="table-user-name">@app.Patient?.Name</span>
                            </div>
                        </td>
                        <td>@app.Doctor?.Name</td>
                        <td>@app.Specialty</td>
                        <td>@app.Date</td>
                        <td>@app.Time</td>
                        <td><span class="badge @app.StatusClass">@app.StatusLabel</span></td>
                        <td class="appointment-actions" data-id="@app.Id">
                            @if (app.Status == "pending")
                            {
                                <div class="table-actions">
                                    <button class="btn btn-sm btn-outline-success btn-approve" data-id="@app.Id" title="قبول — سيتم إرسال رابط الدفع للمريض"><i class="bi bi-check-lg"></i></button>
                                    <button class="btn btn-sm btn-outline-danger btn-reject" data-id="@app.Id" title="رفض"><i class="bi bi-x-lg"></i></button>
                                </div>
                            }
                            else if (app.Status == "confirmed")
                            {
                                <button class="btn btn-sm btn-outline-primary btn-checkin" data-id="@app.Id"><i class="bi bi-box-arrow-in-right"></i> تسجيل وصول</button>
                            }
                            else if (app.Status == "accepted" || app.Status == "awaiting-payment")
                            {
                                <span class="table-hint"><i class="bi bi-hourglass-split"></i> بانتظار دفع المريض</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" />
</div>

@section Scripts {
    <script>
        $(document).on('click', '.btn-approve', function () {
            var id = $(this).data('id');
            if (!id) return;
            showConfirmModal('بعد القبول سيتم إرسال رابط الدفع للمريض لإتمام الدفع. هل تريد المتابعة؟', function () {
                StaffDashboardService.approveAppointment(id).then(function () {
                    showSuccessModal('تم قبول الحجز وتم إرسال رابط الدفع للمريض');
                    location.reload();
                });
            });
        });

        $(document).on('click', '.btn-reject', function () {
            var id = $(this).data('id');
            if (!id) return;
            var reason = prompt('يرجى إدخال سبب الرفض (اختياري):');
            if (reason === null) return;
            StaffDashboardService.rejectAppointment(id, reason || '').then(function () {
                showSuccessModal('تم رفض الحجز');
                location.reload();
            });
        });

        $(document).on('click', '.btn-checkin', function () {
            var id = $(this).data('id');
            if (!id) return;
            StaffDashboardService.checkInPatient(id).then(function () {
                location.reload();
            });
        });
    </script>
}
