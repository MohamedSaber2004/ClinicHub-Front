@{
    ViewData["Title"] = "جدول الطبيب";
    Layout = "_StaffLayout";
    var doctorId = ViewBag.DoctorId as int? ?? 0;
}

<div class="page-header">
    <div>
        <h2 class="page-title">
            <span class="page-title-icon">
                <i class="bi bi-calendar-week"></i>
            </span>
            جدول مواعيد الطبيب
        </h2>
    </div>
    <div class="page-header-actions">
        <a class="btn btn-secondary btn-sm" href="@Url.Action("Appointments")">
            <i class="bi bi-list-ul"></i>
            كل المواعيد
        </a>
    </div>
</div>

<div class="table-card ds-table-card ds-schedule-card">
    <div class="table-card-header">
        <h3 class="table-card-title">
            <span class="subtitle-icon">
                <i class="bi bi-calendar3"></i>
            </span>
            <span id="scheduleTitle">مواعيد اليوم</span>
        </h3>
    </div>
    <div class="table-responsive">
        <table class="custom-table ds-table ds-schedule-table">
            <thead>
                <tr>
                    <th>المريض</th>
                    <th>التاريخ</th>
                    <th>الوقت</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody id="scheduleBody">
                <tr>
                    <td colspan="4" class="table-empty"><span class="ds-schedule-loading">جاري تحميل البيانات...</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/doctor-staff.css?v=20261027_redesign_v2" />
}

@section Scripts {
    <script>
        var doctorId = @doctorId;

        StaffDashboardService.getDoctorSchedule(doctorId).then(function (data) {
            if (data.doctor && data.doctor.name) {
                $('#scheduleTitle').text('مواعيد ' + data.doctor.name);
            }
            StaffDashboardService.renderDoctorSchedule(data);
        });
    </script>
}
