@inject ClinicHub.Services.Contracts.IAttachmentUrlResolver _attachmentUrlResolver
@inject Microsoft.Extensions.Options.IOptions<ClinicHub.Services.Options.Doctory> _doctoryOptions
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Doctory</title>
    <link rel="icon" type="image/png" href="~/logo.png" />
    <link rel="apple-touch-icon" href="~/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=Reem+Kufi:wght@400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=Reem+Kufi:wght@400;500;600;700&display=swap" /></noscript>
    <link rel="preload" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" /></noscript>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">تخطَّ إلى المحتوى الرئيسي</a>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar" aria-label="القائمة الجانبية">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <img src="~/logo.png" alt="Doctory" class="brand-logo-img" />
                    <span class="logo-text">
                        <span class="logo-brand-ar">Doctory</span>
                    </span>
                </div>
            </div>
            <nav class="sidebar-menu">
                <div class="sidebar-nav-items">
                    @{
                        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
                        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                        bool IsActive(string ctrl, string? action = null) =>
                            currentController == ctrl && (action == null || currentAction == action);
                        var _user = ViewBag.CurrentUser as CurrentUserContext;
                        var _profile = ViewBag.HeaderProfile as UserProfileDto;
                        if (_user != null && _user.Role != UserRole.ClinicOwner && _user.Role != UserRole.ClinicManager && (_profile?.Role == "ClinicOwner" || _profile?.Role == "ClinicManager"))
                        {
                            var _clinicRole = _profile.Role == "ClinicManager" ? UserRole.ClinicManager : UserRole.ClinicOwner;
                            _user = new CurrentUserContext
                            {
                                Id = _user.Id,
                                ClinicId = _user.ClinicId,
                                Role = _clinicRole,
                                Permissions = RolePermissions.For(_clinicRole),
                                PlanFeatures = PlanFeature.ManageAppointments | PlanFeature.ManagePatientRecords | PlanFeature.ManageStaff | PlanFeature.ManageDoctors | PlanFeature.MarketingTools | PlanFeature.PrioritySupport,
                                PlanName = _user.PlanName ?? "الباقة الاحترافية",
                                MaxDoctors = _user.MaxDoctors,
                                MaxStaff = _user.MaxStaff,
                                HasActivePlan = true
                            };
                        }
                        var _profileName = !string.IsNullOrWhiteSpace(_profile?.FullName) ? _profile.FullName : (_user?.Role == UserRole.ClinicOwner ? "عيادة الرحمة" : "عيادة");
                        var _profileRoleLabel = _profile?.Role switch
                        {
                            "SuperAdmin" => "المشرف العام",
                            "ClinicOwner" => "مدير عيادة",
                            "ClinicManager" => "مدير عيادة",
                            "Doctor" => "طبيب",
                            "Staff" => "موظف عيادة",
                            _ => (_user?.Role switch { UserRole.SystemAdmin => "المشرف العام", UserRole.ClinicOwner => "مدير عيادة", UserRole.ClinicManager => "مدير عيادة", UserRole.Doctor => "طبيب", UserRole.ClinicStaff => "موظف عيادة", _ => "مستخدم" })
                        };
                        var _profileInitial = !string.IsNullOrWhiteSpace(_profile?.FullName) ? _profile.FullName.Substring(0, 1) : (_user?.Role switch { UserRole.ClinicOwner => "م", UserRole.ClinicManager => "م", UserRole.Doctor => "ط", UserRole.ClinicStaff => "م", _ => "ع" });
                        var _profilePic = _attachmentUrlResolver.Resolve(_profile?.ProfilePictureUrl);
                    }
                    @if (_user?.Has(Permission.ViewClinicDashboard) == true)
                    {
                        <a class="sidebar-item @(IsActive("Clinic", "Index") ? "active" : "")" href="@ClinicRoutes.Pages.Index()">
                            <i class="bi bi-hospital"></i>
                            <span>لوحة تشغيل العيادات</span>
                        </a>
                    }

                    <div class="sidebar-section">الاشتراك</div>
                    <a class="sidebar-item sidebar-item--sub @(IsActive("Clinic", "MySubscription") ? "active" : "")" href="/Clinic/MySubscription">
                        <i class="bi bi-credit-card"></i>
                        <span>اشتراكي</span>
                    </a>

                    @{
                        bool canShowMedicalRecords = _user?.Has(Permission.ManageMedicalRecords) == true && _user?.HasFeature(PlanFeature.ManagePatientRecords) == true;
                        bool canShowStaff = _user?.Has(Permission.ManageClinicStaff) == true && _user?.HasFeature(PlanFeature.ManageStaff) == true;
                        bool canShowDoctors = _user?.Has(Permission.ManageClinicDoctors) == true && _user?.HasFeature(PlanFeature.ManageDoctors) == true;
                        bool canShowReports = _user?.HasFeature(PlanFeature.AdvancedReports) == true && _user?.HasActivePlan == true;
                        bool canShowMarketing = _user?.HasFeature(PlanFeature.MarketingTools) == true && _user?.HasActivePlan == true;
                    }
                    @if (canShowMedicalRecords || canShowStaff || canShowDoctors || canShowReports || canShowMarketing)
                    {
                        <div class="sidebar-section">الخدمات التشغيلية</div>
                    }

                    @if (canShowMedicalRecords)
                    {
                        <a class="sidebar-item sidebar-item--sub @(IsActive("Clinic", "MedicalRecords") ? "active" : "")" href="@ClinicRoutes.Pages.MedicalRecords()">
                            <i class="bi bi-folder2-open"></i>
                            <span>السجل الطبي الإلكتروني</span>
                        </a>
                    }
                    @if (canShowStaff)
                    {
                        <a class="sidebar-item sidebar-item--sub @(IsActive("Clinic", "Staff") ? "active" : "")" href="@ClinicRoutes.Pages.Staff()">
                            <i class="bi bi-person-badge"></i>
                            <span>إدارة الموظفين</span>
                        </a>
                    }
                    @if (canShowDoctors)
                    {
                        <a class="sidebar-item sidebar-item--sub @(IsActive("Clinic", "Doctors") ? "active" : "")" href="@ClinicRoutes.Pages.Doctors()">
                            <i class="bi bi-person-workspace"></i>
                            <span>إدارة الأطباء</span>
                        </a>
                    }
                    @if (canShowReports)
                    {
                        <a class="sidebar-item sidebar-item--sub @(IsActive("Clinic", "Reports") ? "active" : "")" href="@ClinicRoutes.Pages.Reports()">
                            <i class="bi bi-file-bar-graph"></i>
                            <span>التقارير</span>
                        </a>
                    }
                    @if (canShowMarketing)
                    {
                        <a class="sidebar-item sidebar-item--sub @(IsActive("Clinic", "Marketing") ? "active" : "")" href="@ClinicRoutes.Pages.Marketing()">
                            <i class="bi bi-megaphone"></i>
                            <span>الخدمات الإعلانية</span>
                        </a>
                    }
                    <a class="sidebar-item sidebar-item--sub @(IsActive("Clinic", "Ratings") ? "active" : "")" href="@ClinicRoutes.Pages.Ratings()">
                        <i class="bi bi-star"></i>
                        <span>التقييمات</span>
                    </a>
                    <div class="sidebar-section">لوحة الطبيب</div>
                    <a class="sidebar-item sidebar-item--sub @(IsActive("Clinic", "DoctorAppointments") ? "active" : "")" href="@ClinicRoutes.Pages.DoctorAppointments()">
                        <i class="bi bi-calendar3"></i>
                        <span>مواعيد الأطباء</span>
                    </a>
                    <a class="sidebar-item sidebar-item--sub @(IsActive("Clinic", "DoctorPatients") ? "active" : "")" href="@ClinicRoutes.Pages.DoctorPatients()">
                        <i class="bi bi-people"></i>
                        <span>مرضى العيادة</span>
                    </a>
                    <a class="sidebar-item sidebar-item--sub @(IsActive("Clinic", "DoctorAvailability") ? "active" : "")" href="@ClinicRoutes.Pages.DoctorAvailability()">
                        <i class="bi bi-clock-history"></i>
                        <span>أوقات عمل الأطباء</span>
                    </a>
                    @if (_user?.Has(Permission.ManageClinicSettings) == true)
                    {
                        <div class="sidebar-section">المالية</div>
                        <a class="sidebar-item sidebar-item--sub @(IsActive("Clinic", "AppointmentRevenue") ? "active" : "")" href="@ClinicRoutes.Pages.AppointmentRevenue()">
                            <i class="bi bi-wallet2"></i>
                            <span>إيرادات المواعيد</span>
                        </a>
                        <div class="sidebar-section">الإعدادات</div>
                        <a class="sidebar-item sidebar-item--sub @(IsActive("Clinic", "Settings") ? "active" : "")" href="@ClinicRoutes.Pages.Settings()">
                            <i class="bi bi-gear"></i>
                            <span>إعدادات العيادة</span>
                        </a>
                    }
                </div>
            </nav>
            <div class="sidebar-bottom">
                <a class="sidebar-profile" href="@ClinicRoutes.Pages.Profile()">
                    <div class="sidebar-profile-avatar">
                        @if (!string.IsNullOrWhiteSpace(_profilePic))
                        {
                            <img src="@_profilePic" alt="@_profileName" class="header-avatar-img" />
                        }
                        else
                        {
                            <span>@_profileInitial</span>
                        }
                    </div>
                    <div class="sidebar-profile-info">
                        <span class="sidebar-profile-name">@_profileName</span>
                        <span class="sidebar-profile-role">@_profileRoleLabel</span>
                    </div>
                    @if (!string.IsNullOrEmpty(_user?.PlanName))
                    {
                        <span class="sidebar-plan-badge">@_user.PlanName</span>
                    }
                </a>
                <a href="#" class="sidebar-item" id="logoutBtn">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>تسجيل الخروج</span>
                </a>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="main-content">
            <!-- Top Header -->
            <header class="top-header">
                <button class="sidebar-toggle-mobile" id="sidebarToggleMobile" title="فتح القائمة" type="button" aria-label="فتح القائمة الجانبية" aria-controls="sidebar" aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>
                <button class="sidebar-toggle" id="sidebarToggle" title="تصغير/توسيع القائمة" aria-label="تصغير أو توسيع القائمة الجانبية">
                    <i class="bi bi-chevron-double-right"></i>
                </button>
                <div class="flex-fill"></div>
                <div class="ch-bell" id="chBell">
                    <button class="ch-bell-btn" type="button" title="الإشعارات" aria-label="الإشعارات">
                        <i class="bi bi-bell"></i>
                        @if (ViewBag.UnreadNotificationsCount is int unreadCount && unreadCount > 0)
                        {
                            <span class="ch-bell-badge" id="chBellBadge">@(unreadCount > 99 ? "99+" : unreadCount.ToString())</span>
                        }
                        else
                        {
                            <span class="ch-bell-badge" id="chBellBadge" hidden>0</span>
                        }
                    </button>
                    <div class="ch-bell-dropdown" id="chBellDropdown">
                        <div class="ch-bell-header">الإشعارات</div>
                        <div class="ch-bell-list" id="chBellList">
                            <div class="ch-bell-empty">لا توجد إشعارات</div>
                        </div>
                        <a class="ch-bell-footer" href="@ClinicRoutes.Pages.Notifications()">عرض كل الإشعارات</a>
                    </div>
                </div>
                <a class="header-user" href="@ClinicRoutes.Pages.Profile()">
                    <div class="user-info">
                        <span class="user-name">@_profileName</span>
                        <span class="user-role">@_profileRoleLabel</span>
                    </div>
                    <div class="sidebar-profile-avatar header-avatar">
                        @if (!string.IsNullOrWhiteSpace(_profilePic))
                        {
                            <img src="@_profilePic" alt="@_profileName" class="header-avatar-img" />
                        }
                        else
                        {
                            <span>@_profileInitial</span>
                        }
                    </div>
                </a>
            </header>

            <!-- Main Render Area -->
            <main role="main" class="content-body" id="main-content" tabindex="-1">
                <partial name="_SubscriptionBanner" />
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_ErrorModal" />
    <partial name="_SuccessModal" />
    <partial name="_ConfirmModal" />
    <partial name="_LoadingSpinner" />
    <!-- Toast container -->
    <div id="toast-container" aria-live="polite" aria-atomic="false"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/scroll-animations.js" asp-append-version="true"></script>
    <script src="~/js/loading-service.js" asp-append-version="true"></script>
    <script src="~/js/notification-service.js" asp-append-version="true"></script>
    <partial name="_NotificationsBellScript" />
    <partial name="_FcmConfig" />
    <script src="~/js/fcm.js" asp-append-version="true"></script>
    <script>
        /* ── Toast system override ───────────────────────────────────── */
        (function () {
            var SUCCESS_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
            var ERROR_ICON   = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>';
            var CLOSE_ICON   = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';

            function showToast(message, type, duration) {
                duration = duration || (type === 'error' ? 6000 : 4000);
                var container = document.getElementById('toast-container');
                if (!container) return;

                var title = type === 'success' ? 'تم بنجاح' : (type === 'error' ? 'خطأ' : 'تنبيه');
                var icon  = type === 'success' ? SUCCESS_ICON : ERROR_ICON;

                var toast = document.createElement('div');
                toast.className = 'ch-toast ch-toast--' + type;
                toast.setAttribute('role', type === 'error' ? 'alert' : 'status');
                toast.innerHTML =
                    '<div class="ch-toast-icon">' + icon + '</div>' +
                    '<div class="ch-toast-body">' +
                        '<p class="ch-toast-title">' + title + '</p>' +
                        '<p class="ch-toast-msg">' + message.replace(/\n/g, '<br>') + '</p>' +
                    '</div>' +
                    '<button class="ch-toast-close" aria-label="إغلاق">' + CLOSE_ICON + '</button>' +
                    '<div class="ch-toast-progress" style="animation-duration:' + duration + 'ms"></div>';

                container.appendChild(toast);

                var dismissed = false;

                function dismiss() {
                    if (dismissed) return;
                    dismissed = true;
                    toast.classList.add('toast-hiding');
                    window.setTimeout(function () {
                        if (toast.isConnected) toast.remove();
                    }, 400);
                }

                toast.addEventListener('animationend', function (e) {
                    if (e.animationName === 'toast-out') toast.remove();
                });
                toast.querySelector('.ch-toast-close').addEventListener('click', dismiss);
                setTimeout(dismiss, duration);
            }

            window.showSuccessModal = function (msg) {
                var msgEl = document.getElementById('globalSuccessMsg');
                if (msgEl) msgEl.innerHTML = msg;
                var modalEl = document.getElementById('globalSuccessModal');
                if (!modalEl) return;
                var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modal.show();
            };
            window.showErrorModal   = function (msg) {
                var msgEl = document.getElementById('globalErrorMsg');
                if (msgEl) msgEl.innerHTML = msg;
                var modalEl = document.getElementById('globalErrorModal');
                if (!modalEl) return;
                var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modal.show();
            };
            window.showInfoToast    = function (msg) { showToast(msg, 'info'); };
        })();
        /* ─────────────────────────────────────────────────────────────── */

        document.addEventListener("DOMContentLoaded", function () {
            @if (TempData["SuccessMessage"] != null || ViewBag.SuccessMessage != null)
            {
                var successMsg = TempData["SuccessMessage"] ?? ViewBag.SuccessMessage;
                <text>
                    if (typeof showSuccessModal === 'function') {
                        showSuccessModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMsg.ToString())));
                    }
                </text>
            }
            @if (TempData["ErrorMessage"] != null || ViewBag.ErrorMessage != null)
            {
                var errorMsg = TempData["ErrorMessage"] ?? ViewBag.ErrorMessage;
                <text>
                    if (typeof showErrorModal === 'function') {
                        showErrorModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMsg.ToString())));
                    }
                </text>
            }
        });

        @if (TempData["UserId"] != null)
        {
            <text>
                localStorage.setItem("userId", "@TempData["UserId"]");
                localStorage.setItem("role", "@TempData["Role"]");
                localStorage.setItem("clinicId", "@TempData["ClinicId"]");
                localStorage.setItem("accessToken", "@TempData["AccessToken"]");
                localStorage.setItem("refreshToken", "@TempData["RefreshToken"]");
            </text>
        }

        $('#sidebarToggle').on('click', function () {
            $('.app-container').toggleClass('sidebar-collapsed');
            localStorage.setItem('sidebarCollapsed', $('.app-container').hasClass('sidebar-collapsed') ? 'true' : '');
        });

        $('#sidebarToggleMobile').on('click', function () {
            var open = $('.sidebar').toggleClass('mobile-open').hasClass('mobile-open');
            $(this).attr('aria-expanded', open ? 'true' : 'false');
        });

        $(document).on('click', function (e) {
            if ($(window).width() < 992 && !$(e.target).closest('.sidebar, .sidebar-toggle-mobile').length) {
                $('.sidebar').removeClass('mobile-open');
                $('#sidebarToggleMobile').attr('aria-expanded', 'false');
            }
        });

        if (localStorage.getItem('sidebarCollapsed') === 'true') {
            $('.app-container').addClass('sidebar-collapsed');
        }

        $('#logoutBtn').on('click', function (e) {
            e.preventDefault();
            var token = localStorage.getItem('refreshToken') || '';
            localStorage.removeItem('userId');
            localStorage.removeItem('role');
            localStorage.removeItem('clinicId');
            localStorage.removeItem('accessToken');
            localStorage.removeItem('refreshToken');
            fetch('@HomeRoutes.Account.Logout()', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ refreshToken: token })
            }).then(function (r) { return r.json(); })
              .then(function (d) { if (d.redirectUrl) window.location.href = d.redirectUrl; })
              .catch(function () { window.location.href = '@HomeRoutes.Account.Login()'; });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
