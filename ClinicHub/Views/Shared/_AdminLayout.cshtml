@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery _antiforgery
@inject ClinicHub.Services.Contracts.IAttachmentUrlResolver _attachmentUrlResolver
@inject Microsoft.Extensions.Options.IOptions<ClinicHub.Services.Options.Doctory> _doctoryOptions
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Doctory</title>
    <link rel="icon" type="image/png" href="~/logo.png" />
    <link rel="apple-touch-icon" href="~/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=Reem+Kufi:wght@400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=Reem+Kufi:wght@400;500;600;700&display=swap" /></noscript>
    <link rel="preload" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" /></noscript>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <meta name="csrf-token" content="@_antiforgery.GetAndStoreTokens(Context).RequestToken" />
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <img src="~/logo.png" alt="Doctory" class="brand-logo-img" />
                    <span class="logo-text">
                        <span class="logo-brand-ar">Doctory</span>
                    </span>
                </div>
            </div>
            <nav class="sidebar-menu">
                <div class="sidebar-nav-items">
                    @{
                        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
                        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                        bool IsActive(string ctrl, string? action = null) =>
                            currentController == ctrl && (action == null || currentAction == action);
                        var _user = ViewBag.CurrentUser as CurrentUserContext;
                        var _profile = ViewBag.HeaderProfile as UserProfileDto;
                        var _profileName = !string.IsNullOrWhiteSpace(_profile?.FullName) ? _profile.FullName : (_user?.Role == UserRole.SystemAdmin ? "أحمد" : "مستخدم");
                        var _profileRoleLabel = _profile?.Role switch
                        {
                            "SuperAdmin" => "المشرف العام",
                            "ClinicOwner" => "مالك عيادة",
                            "ClinicManager" => "مدير عيادة",
                            "Doctor" => "طبيب",
                            "Staff" => "موظف عيادة",
                            _ => (_user?.Role switch { UserRole.SystemAdmin => "المشرف العام", UserRole.ClinicOwner => "مالك عيادة", UserRole.ClinicManager => "مدير عيادة", UserRole.Doctor => "طبيب", UserRole.ClinicStaff => "موظف عيادة", _ => "مستخدم" })
                        };
                        var _profileInitial = !string.IsNullOrWhiteSpace(_profile?.FullName) ? _profile.FullName.Substring(0, 1) : (_user?.Role == UserRole.SystemAdmin ? "أ" : "م");
                        var _profilePic = _attachmentUrlResolver.Resolve(_profile?.ProfilePictureUrl);
                    }
                    <a class="sidebar-item @(IsActive("Admin", "Index") ? "active" : "")" href="@AdminRoutes.Pages.Index()">
                        <i class="bi bi-speedometer2"></i>
                        <span>لوحة التحكم</span>
                    </a>
                    <a class="sidebar-item @(IsActive("Admin", "Specializations") ? "active" : "")" href="@AdminRoutes.Pages.Specializations()">
                        <i class="bi bi-tags"></i>
                        <span>التخصصات</span>
                    </a>
                    <a class="sidebar-item @(IsActive("Admin", "Clinics") ? "active" : "")" href="@AdminRoutes.Pages.Clinics()">
                        <i class="bi bi-hospital"></i>
                        <span>العيادات</span>
                    </a>
                    <a class="sidebar-item @(IsActive("Admin", "Support") ? "active" : "")" href="@AdminRoutes.Pages.Support()">
                        <i class="bi bi-headset"></i>
                        <span>الدعم الفني</span>
                    </a>
                    <a class="sidebar-item @(IsActive("Admin", "Users") ? "active" : "")" href="@AdminRoutes.Pages.Users()">
                        <!-- People SVG -->
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 2 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="currentColor"/>
                        </svg>
                        <span>المستخدمين</span>
                    </a>
                    <a class="sidebar-item @(IsActive("Admin", "VerificationCenter") ? "active" : "")" href="@AdminRoutes.Pages.VerificationCenter()">
                        <!-- Shield/Verification SVG -->
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" fill="currentColor"/>
                        </svg>
                        <span>مركز التحقق</span>
                    </a>
                    <div class="sidebar-section">إدارة الاشتراكات</div>
                    <a class="sidebar-item @(IsActive("Admin", "PendingClinics") ? "active" : "")" href="@AdminRoutes.Pages.PendingClinics()">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="currentColor"/></svg>
                        <span>العيادات قيد الانتظار</span>
                    </a>
                    <a class="sidebar-item @(IsActive("Admin", "Subscriptions") ? "active" : "")" href="@AdminRoutes.Pages.Subscriptions()">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm-2 14l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" fill="currentColor"/></svg>
                        <span>الباقات</span>
                    </a>
                    <a class="sidebar-item @(IsActive("Admin", "SubscriptionManagement") ? "active" : "")" href="@AdminRoutes.Pages.SubscriptionManagement()">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 2 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="currentColor"/></svg>
                        <span>جميع الاشتراكات</span>
                    </a>
                    <div class="sidebar-section">المالية</div>
                    <a class="sidebar-item @(IsActive("Admin", "Payments") ? "active" : "")" href="@AdminRoutes.Pages.Payments()">
                        <i class="bi bi-credit-card"></i>
                        <span>المدفوعات</span>
                    </a>
                    <a class="sidebar-item @(IsActive("Admin", "Ads") ? "active" : "")" href="@AdminRoutes.Pages.Ads()">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12zM7 9h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z" fill="currentColor"/></svg>
                        <span>إدارة الإعلانات</span>
                    </a>
                </div>
            </nav>
            <div class="sidebar-bottom">
                <a class="sidebar-profile" href="@AdminRoutes.Pages.Profile()">
                    <div class="sidebar-profile-avatar">
                        @if (!string.IsNullOrWhiteSpace(_profilePic))
                        {
                            <img src="@_profilePic" alt="@_profileName" class="header-avatar-img" />
                        }
                        else
                        {
                            <span>@_profileInitial</span>
                        }
                    </div>
                    <div class="sidebar-profile-info">
                        <span class="sidebar-profile-name">@_profileName</span>
                        <span class="sidebar-profile-role">@_profileRoleLabel</span>
                    </div>
                </a>
                <a href="#" class="sidebar-item" id="logoutBtn">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>تسجيل الخروج</span>
                </a>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="main-content">
            <!-- Top Header -->
            <header class="top-header">
                <button class="sidebar-toggle-mobile" id="sidebarToggleMobile" title="فتح القائمة" type="button">
                    <i class="bi bi-list"></i>
                </button>
                <button class="sidebar-toggle" id="sidebarToggle" title="تصغير/توسيع القائمة">
                    <i class="bi bi-chevron-double-right"></i>
                </button>
                <div class="flex-fill"></div>
                <div class="ch-bell" id="chBell">
                    <button class="ch-bell-btn" type="button" title="الإشعارات" aria-label="الإشعارات">
                        <i class="bi bi-bell"></i>
                        @if (ViewBag.UnreadNotificationsCount is int unreadCount && unreadCount > 0)
                        {
                            <span class="ch-bell-badge" id="chBellBadge">@(unreadCount > 99 ? "99+" : unreadCount.ToString())</span>
                        }
                        else
                        {
                            <span class="ch-bell-badge" id="chBellBadge" hidden>0</span>
                        }
                    </button>
                    <div class="ch-bell-dropdown" id="chBellDropdown">
                        <div class="ch-bell-header">الإشعارات</div>
                        <div class="ch-bell-list" id="chBellList">
                            <div class="ch-bell-empty">لا توجد إشعارات</div>
                        </div>
                        <a class="ch-bell-footer" href="@AdminRoutes.Pages.Notifications()">عرض كل الإشعارات</a>
                    </div>
                </div>
                <a class="header-user" href="@AdminRoutes.Pages.Profile()">
                    <div class="user-info">
                        <span class="user-name">@_profileName</span>
                        <span class="user-role">@_profileRoleLabel</span>
                    </div>
                    <div class="sidebar-profile-avatar header-avatar">
                        @if (!string.IsNullOrWhiteSpace(_profilePic))
                        {
                            <img src="@_profilePic" alt="@_profileName" class="header-avatar-img" />
                        }
                        else
                        {
                            <span>@_profileInitial</span>
                        }
                    </div>
                </a>
            </header>

            <!-- Main Render Area -->
            <main role="main" class="content-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_ErrorModal" />
    <partial name="_SuccessModal" />
    <partial name="_ConfirmModal" />
    <partial name="_LoadingSpinner" />
    <!-- Toast container -->
    <div id="toast-container" aria-live="polite" aria-atomic="false"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/scroll-animations.js" asp-append-version="true"></script>
    <script src="~/js/loading-service.js" asp-append-version="true"></script>
    <script src="~/js/notification-service.js" asp-append-version="true"></script>
    <partial name="_FcmConfig" />
    <script src="~/js/fcm.js" asp-append-version="true"></script>
    <script>
        /* ── Toast system override ───────────────────────────────────── */
        (function () {
            var SUCCESS_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
            var ERROR_ICON   = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>';
            var CLOSE_ICON   = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';

            function showToast(message, type, duration) {
                duration = duration || (type === 'error' ? 6000 : 4000);
                var container = document.getElementById('toast-container');
                if (!container) return;

                var title = type === 'success' ? 'تم بنجاح' : (type === 'error' ? 'خطأ' : 'تنبيه');
                var icon  = type === 'success' ? SUCCESS_ICON : ERROR_ICON;

                var toast = document.createElement('div');
                toast.className = 'ch-toast ch-toast--' + type;
                toast.setAttribute('role', type === 'error' ? 'alert' : 'status');
                toast.innerHTML =
                    '<div class="ch-toast-icon">' + icon + '</div>' +
                    '<div class="ch-toast-body">' +
                        '<p class="ch-toast-title">' + title + '</p>' +
                        '<p class="ch-toast-msg">' + message.replace(/\n/g, '<br>') + '</p>' +
                    '</div>' +
                    '<button class="ch-toast-close" aria-label="إغلاق">' + CLOSE_ICON + '</button>' +
                    '<div class="ch-toast-progress" style="animation-duration:' + duration + 'ms"></div>';

                container.appendChild(toast);

                var dismissed = false;

                function dismiss() {
                    if (dismissed) return;
                    dismissed = true;
                    toast.classList.add('toast-hiding');
                    window.setTimeout(function () {
                        if (toast.isConnected) toast.remove();
                    }, 400);
                }

                toast.addEventListener('animationend', function (e) {
                    if (e.animationName === 'toast-out') toast.remove();
                });
                toast.querySelector('.ch-toast-close').addEventListener('click', dismiss);
                setTimeout(dismiss, duration);
            }

            window.showSuccessModal = function (msg) {
                var msgEl = document.getElementById('globalSuccessMsg');
                if (msgEl) msgEl.innerHTML = msg;
                var modalEl = document.getElementById('globalSuccessModal');
                if (!modalEl) return;
                var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modal.show();
            };
            window.showErrorModal   = function (msg) {
                var msgEl = document.getElementById('globalErrorMsg');
                if (msgEl) msgEl.innerHTML = msg;
                var modalEl = document.getElementById('globalErrorModal');
                if (!modalEl) return;
                var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modal.show();
            };
            window.showInfoToast    = function (msg) { showToast(msg, 'info'); };
        })();
        /* ─────────────────────────────────────────────────────────────── */

        @if (TempData["UserId"] != null)
        {
            <text>
            localStorage.setItem("userId", "@TempData["UserId"]");
            localStorage.setItem("role", "@TempData["Role"]");
            localStorage.setItem("clinicId", "@TempData["ClinicId"]");
            localStorage.setItem("accessToken", "@TempData["AccessToken"]");
            localStorage.setItem("refreshToken", "@TempData["RefreshToken"]");
            </text>
        }

        $('#sidebarToggle').on('click', function () {
            $('.app-container').toggleClass('sidebar-collapsed');
            localStorage.setItem('sidebarCollapsed', $('.app-container').hasClass('sidebar-collapsed') ? 'true' : '');
        });

        $('#sidebarToggleMobile').on('click', function () {
            $('.sidebar').toggleClass('mobile-open');
        });

        $(document).on('click', function (e) {
            if ($(window).width() < 992 && !$(e.target).closest('.sidebar, .sidebar-toggle-mobile').length) {
                $('.sidebar').removeClass('mobile-open');
            }
        });

        if (localStorage.getItem('sidebarCollapsed') === 'true') {
            $('.app-container').addClass('sidebar-collapsed');
        }

        $('#logoutBtn').on('click', function (e) {
            e.preventDefault();
            var token = localStorage.getItem('refreshToken') || '';
            localStorage.removeItem('userId');
            localStorage.removeItem('role');
            localStorage.removeItem('clinicId');
            localStorage.removeItem('accessToken');
            localStorage.removeItem('refreshToken');
            fetch('@HomeRoutes.Account.Logout()', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ refreshToken: token })
            }).then(function (r) { return r.json(); })
              .then(function (d) { if (d.redirectUrl) window.location.href = d.redirectUrl; })
              .catch(function () { window.location.href = '@HomeRoutes.Account.Login()'; });
        });

        document.addEventListener("DOMContentLoaded", function () {
            @if (TempData["SuccessMessage"] != null || ViewBag.SuccessMessage != null)
            {
                var successMsg = TempData["SuccessMessage"] ?? ViewBag.SuccessMessage;
                <text>
                    if (typeof showSuccessModal === 'function') {
                        showSuccessModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMsg.ToString())));
                    }
                </text>
            }
            @if (TempData["ErrorMessage"] != null || ViewBag.ErrorMessage != null)
            {
                var errorMsg = TempData["ErrorMessage"] ?? ViewBag.ErrorMessage;
                <text>
                    if (typeof showErrorModal === 'function') {
                        showErrorModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMsg.ToString())));
                    }
                </text>
            }
        });

        (function() {
            var origFetch = window.fetch;
            function isSameOrigin(input) {
                var u = typeof input === 'string' ? input : (input && input.url ? input.url : '');
                if (!u) return true;
                if (u.indexOf('http://') !== 0 && u.indexOf('https://') !== 0) {
                    return u.indexOf('//') !== 0;
                }
                try {
                    return new URL(u).origin === window.location.origin;
                } catch (e) {
                    return false;
                }
            }
            window.fetch = function(url, init) {
                init = init || {};
                var method = (init.method || 'GET').toUpperCase();
                if (method !== 'GET' && method !== 'HEAD' && isSameOrigin(url)) {
                    var token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
                    if (token) {
                        if (!init.headers) init.headers = {};
                        if (init.headers instanceof Headers) {
                            if (!init.headers.has('RequestVerificationToken')) init.headers.append('RequestVerificationToken', token);
                        } else if (Array.isArray(init.headers)) {
                            if (!init.headers.some(function(h) { return h[0] === 'RequestVerificationToken'; })) init.headers.push(['RequestVerificationToken', token]);
                        } else {
                            if (!init.headers['RequestVerificationToken']) init.headers['RequestVerificationToken'] = token;
                        }
                    }
                }
                return origFetch(url, init);
            };
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
