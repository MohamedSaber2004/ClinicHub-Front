@using Microsoft.AspNetCore.Routing
@{
    var pagination = ViewBag.Pagination;
    int totalCount = pagination?.TotalCount ?? 0;
    int totalPages = pagination?.TotalPages ?? 0;
    int pageNumber = pagination?.PageNumber ?? 1;
    int pageSize = pagination?.PageSize ?? 20;
    bool hasPrev = pagination?.HasPreviousPage ?? false;
    bool hasNext = pagination?.HasNextPage ?? false;
    var currentFilter = ViewBag.CurrentFilter;
    var searchTerm = ViewBag.SearchTerm as string;
    var status = ViewBag.StatusFilter as string;
    var date = ViewBag.DateFilter as string;
    var startDate = ViewBag.StartDate as string;
    var endDate = ViewBag.EndDate as string;
    var patientId = ViewBag.PatientId;
    var patientName = ViewBag.PatientName as string;
    var isUnassigned = ViewBag.IsUnassigned as bool?;
    var paymentType = ViewBag.TypeFilter;
    var paymentMethod = ViewBag.MethodFilter;
    var paymentFromDate = ViewBag.FromDateFilter;
    var paymentToDate = ViewBag.ToDateFilter;
    var paymentMonth = ViewBag.MonthFilter;
    var userTypes = (ViewBag.UserTypesFilter ?? ViewBag.SelectedUserTypes) as string;
    var clinicId = (ViewBag.SelectedClinicId ?? ViewBag.ClinicIdFilter) as Guid?;
    var isActive = ViewBag.CurrentActiveFilter as bool?;
    var planId = ViewBag.PlanIdFilter as Guid?;
    if (pagination == null || totalCount == 0) return;

    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var routeValues = new RouteValueDictionary
    {
        ["pageSize"] = pageSize,
        ["isFamous"] = currentFilter,
        ["searchTerm"] = searchTerm,
        ["status"] = status,
        ["date"] = date,
        ["startDate"] = startDate,
        ["endDate"] = endDate,
        ["patientId"] = patientId,
        ["patientName"] = patientName,
        ["name"] = patientName,
        ["isUnassigned"] = isUnassigned,
        ["type"] = paymentType,
        ["method"] = paymentMethod,
        ["fromDate"] = paymentFromDate,
        ["toDate"] = paymentToDate,
        ["month"] = paymentMonth,
        ["userTypes"] = userTypes,
        ["clinicId"] = clinicId,
        ["isActive"] = isActive,
        ["planId"] = planId
    };

    // Page window: keep pagination compact on small screens
    int windowFrom = Math.Max(1, pageNumber - 2);
    int windowTo = Math.Min(totalPages, pageNumber + 2);
}

<nav class="pagination-nav">
    <ul class="pagination-list">
        @if (hasPrev)
        {
            routeValues["pageNumber"] = pageNumber - 1;
            <li class="pagination-item">
                <a class="pagination-link" href="@Url.Action(action, routeValues)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
                    </svg>
                    <span class="pagination-text">السابق</span>
                </a>
            </li>
        }

        @if (windowFrom > 1)
        {
            routeValues["pageNumber"] = 1;
            <li class="pagination-item">
                <a class="pagination-link @(1 == pageNumber ? "pagination-link--active" : "")" href="@Url.Action(action, routeValues)">1</a>
            </li>
        }

        @if (windowFrom > 2)
        {
            <li class="pagination-item pagination-item--gap" aria-hidden="true">…</li>
        }

        @for (var i = windowFrom; i <= windowTo; i++)
        {
            routeValues["pageNumber"] = i;
            <li class="pagination-item">
                <a class="pagination-link @(i == pageNumber ? "pagination-link--active" : "")" href="@Url.Action(action, routeValues)">@i</a>
            </li>
        }

        @if (windowTo < totalPages - 1)
        {
            <li class="pagination-item pagination-item--gap" aria-hidden="true">…</li>
        }

        @if (windowTo < totalPages)
        {
            routeValues["pageNumber"] = totalPages;
            <li class="pagination-item">
                <a class="pagination-link @(totalPages == pageNumber ? "pagination-link--active" : "")" href="@Url.Action(action, routeValues)">@totalPages</a>
            </li>
        }

        @if (hasNext)
        {
            routeValues["pageNumber"] = pageNumber + 1;
            <li class="pagination-item">
                <a class="pagination-link" href="@Url.Action(action, routeValues)">
                    <span class="pagination-text">التالي</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/>
                    </svg>
                </a>
            </li>
        }
    </ul>
</nav>
