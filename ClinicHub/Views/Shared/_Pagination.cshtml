@using Microsoft.AspNetCore.Routing
@{
    // Two invocation styles must both work:
    //   <partial name="_Pagination" />                  → reads ViewBag.Pagination
    //   <partial name="_Pagination" model="pagination" /> → uses the passed model
    var pagination = Model ?? ViewBag.Pagination;
    int totalCount = pagination?.TotalCount ?? 0;
    int totalPages = pagination?.TotalPages ?? 0;
    int pageNumber = pagination?.PageNumber ?? 1;
    int pageSize = pagination?.PageSize ?? 20;
    bool hasPrev = pagination?.HasPreviousPage ?? false;
    bool hasNext = pagination?.HasNextPage ?? false;
    var currentFilter = ViewBag.CurrentFilter;
    var searchTerm = ViewBag.SearchTerm as string;
    var status = ViewBag.StatusFilter as string;
    var date = ViewBag.DateFilter as string;
    var startDate = ViewBag.StartDate as string;
    var endDate = ViewBag.EndDate as string;
    var patientId = ViewBag.PatientId;
    var patientName = ViewBag.PatientName as string;
    var isUnassigned = ViewBag.IsUnassigned as bool?;
    var paymentType = ViewBag.TypeFilter;
    var paymentMethod = ViewBag.MethodFilter;
    var paymentFromDate = ViewBag.FromDateFilter;
    var paymentToDate = ViewBag.ToDateFilter;
    var paymentMonth = ViewBag.MonthFilter;
    var userTypes = (ViewBag.UserTypesFilter ?? ViewBag.SelectedUserTypes) as string;
    var clinicId = (ViewBag.SelectedClinicId ?? ViewBag.ClinicIdFilter) as Guid?;
    var summarySearch = ViewBag.SummarySearch as string;
    var isActive = ViewBag.CurrentActiveFilter as bool?;
    var planId = ViewBag.PlanIdFilter as Guid?;
    if (pagination == null || totalCount <= 0) return;

    if (pageSize <= 0) pageSize = 20;
    if (pageNumber < 1) pageNumber = 1;
    if (totalPages <= 0) totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);

    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var routeValues = new RouteValueDictionary
    {
        ["pageSize"] = pageSize,
        ["isFamous"] = currentFilter,
        ["searchTerm"] = searchTerm,
        ["status"] = status,
        ["date"] = date,
        ["startDate"] = startDate,
        ["endDate"] = endDate,
        ["patientId"] = patientId,
        ["patientName"] = patientName,
        ["name"] = patientName,
        ["isUnassigned"] = isUnassigned,
        ["type"] = paymentType,
        ["method"] = paymentMethod,
        ["fromDate"] = paymentFromDate,
        ["toDate"] = paymentToDate,
        ["month"] = paymentMonth,
        ["userTypes"] = userTypes,
        ["clinicId"] = clinicId,
        ["summarySearch"] = summarySearch,
        ["isActive"] = isActive,
        ["planId"] = planId
    };

    // Page window: keep pagination compact on small screens
    int windowFrom = Math.Max(1, pageNumber - 2);
    int windowTo = Math.Min(totalPages, pageNumber + 2);

    int rangeStart = (pageNumber - 1) * pageSize + 1;
    int rangeEnd = Math.Min(pageNumber * pageSize, totalCount);
}

<nav class="pagination-nav" aria-label="التنقل بين الصفحات">
    <p class="pagination-summary">
        عرض <strong>@rangeStart–@rangeEnd</strong> من <strong>@totalCount</strong>
        @if (totalPages > 1)
        {
            <span class="pagination-summary-dot" aria-hidden="true">·</span>
            <span class="pagination-summary-pages">الصفحة @pageNumber من @totalPages</span>
        }
    </p>

    @if (totalPages > 1)
    {
        <ul class="pagination-list">
            @if (hasPrev)
            {
                routeValues["pageNumber"] = pageNumber - 1;
                <li class="pagination-item">
                    <a class="pagination-link pagination-link--nav" href="@Url.Action(action, routeValues)" aria-label="الصفحة السابقة">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        <span class="pagination-text">السابق</span>
                    </a>
                </li>
            }

            @if (windowFrom > 1)
            {
                routeValues["pageNumber"] = 1;
                <li class="pagination-item">
                    <a class="pagination-link @(1 == pageNumber ? "pagination-link--active" : "")" href="@Url.Action(action, routeValues)" aria-label="الصفحة 1 من @totalPages">1</a>
                </li>
            }

            @if (windowFrom > 2)
            {
                <li class="pagination-item pagination-item--gap" aria-hidden="true">…</li>
            }

            @for (var i = windowFrom; i <= windowTo; i++)
            {
                routeValues["pageNumber"] = i;
                <li class="pagination-item">
                    <a class="pagination-link @(i == pageNumber ? "pagination-link--active" : "")" href="@Url.Action(action, routeValues)" aria-label="الصفحة @i من @totalPages" @(i == pageNumber ? "aria-current=\"page\"" : "")>@i</a>
                </li>
            }

            @if (windowTo < totalPages - 1)
            {
                <li class="pagination-item pagination-item--gap" aria-hidden="true">…</li>
            }

            @if (windowTo < totalPages)
            {
                routeValues["pageNumber"] = totalPages;
                <li class="pagination-item">
                    <a class="pagination-link @(totalPages == pageNumber ? "pagination-link--active" : "")" href="@Url.Action(action, routeValues)" aria-label="الصفحة @totalPages من @totalPages">@totalPages</a>
                </li>
            }

            @if (hasNext)
            {
                routeValues["pageNumber"] = pageNumber + 1;
                <li class="pagination-item">
                    <a class="pagination-link pagination-link--nav" href="@Url.Action(action, routeValues)" aria-label="الصفحة التالية">
                        <span class="pagination-text">التالي</span>
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </a>
                </li>
            }
        </ul>
    }
</nav>
