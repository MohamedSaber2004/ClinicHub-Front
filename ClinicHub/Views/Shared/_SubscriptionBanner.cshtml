@{
    var _user = ViewBag.CurrentUser as CurrentUserContext;
    var hasSubscription = ViewBag.HasActiveSubscription as bool? ?? true;
}
@if (!hasSubscription)
{
    <div class="subscription-banner" role="status">
        <span class="subscription-banner-icon" aria-hidden="true"><i class="bi bi-stars"></i></span>
        <p class="subscription-banner-text">
            <strong class="subscription-banner-title">لوحة تحكم محدودة</strong>
            <span>اشترك الآن لفتح جميع الميزات والأدوات التشغيلية.</span>
        </p>
        <a href="@HomeRoutes.Pages.Subscriptions()" class="subscription-banner-btn">
            اشترك الآن
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </a>
    </div>
}
else if (_user?.HasActivePlan == false)
{
    <div class="subscription-banner subscription-banner--warning" role="status">
        <span class="subscription-banner-icon" aria-hidden="true"><i class="bi bi-exclamation-triangle-fill"></i></span>
        <p class="subscription-banner-text">
            <strong class="subscription-banner-title">الاشتراك غير نشط</strong>
            <span>يرجى تجديد الاشتراك للاستمرار في استخدام جميع الخدمات.</span>
        </p>
        <a href="@ClinicRoutes.Pages.MySubscription()" class="subscription-banner-btn">
            تجديد الاشتراك
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </a>
    </div>
}
else if (_user != null && _user.MaxDoctors.HasValue)
{
    <div class="subscription-banner subscription-banner--info" role="status">
        <span class="subscription-banner-icon" aria-hidden="true"><i class="bi bi-credit-card-2-front-fill"></i></span>
        <p class="subscription-banner-text">
            <strong class="subscription-banner-title">باقتك الحالية: @_user.PlanName</strong>
            <span>
                الحد الأقصى @_user.MaxDoctors أطباء،
                @(_user.MaxStaff.HasValue ? $"{_user.MaxStaff} موظفين" : "موظفون غير محدودين")
            </span>
        </p>
        <a href="@ClinicRoutes.Pages.MySubscription()" class="subscription-banner-btn">
            تفاصيل الاشتراك
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </a>
    </div>
}
