@using ClinicHub.Services.ReponseModels
@using System.Globalization
@{
    var notifications = ViewBag.Notifications as IReadOnlyCollection<NotificationDto> ?? new List<NotificationDto>();
    var errorMessage = ViewBag.ErrorMessage as string;
}

@functions {
    static string NotificationIcon(int type)
    {
        return type switch
        {
            7 => "bi-hourglass-split",
            9 => "bi-megaphone",
            10 => "bi-exclamation-octagon",
            11 => "bi-clock-history",
            12 => "bi-calendar-plus",
            13 => "bi-building-add",
            14 => "bi-patch-check",
            15 => "bi-x-circle",
            16 => "bi-life-preserver",
            17 => "bi-credit-card",
            18 => "bi-graph-up-arrow",
            19 => "bi-calendar-check",
            _ => "bi-bell"
        };
    }

    static string FormatNotificationDate(DateTime value)
    {
        var local = value.Kind == DateTimeKind.Utc ? value.ToLocalTime() : value;
        return local.ToString("d MMM yyyy - hh:mm tt", CultureInfo.GetCultureInfo("ar-EG"));
    }
}

<div class="notif-page" id="notificationsCenter">
    <h2 class="page-title">
        <span class="page-title-icon">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>
        </span>
        الإشعارات
    </h2>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-warning">
            <p>@errorMessage</p>
        </div>
    }

    <div class="notif-card">
        @if (notifications.Count == 0)
        {
            <div class="notif-empty">لا توجد إشعارات</div>
        }
        else
        {
            <div class="notif-list">
                @foreach (var item in notifications)
                {
                    <div class="notif-item @(!item.IsRead ? "unread" : "")" data-type="@item.Type" role="button" tabindex="0" title="الانتقال إلى الصفحة ذات الصلة">
                        <div class="notif-item-icon"><i class="bi @NotificationIcon(item.Type)"></i></div>
                        <div class="notif-item-content">
                            <div class="notif-item-title">
                                @item.TitleAr
                                @if (!item.IsRead)
                                {
                                    <span class="notif-item-dot"></span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.BodyAr))
                            {
                                <div class="notif-item-body">@item.BodyAr</div>
                            }
                            <div class="notif-item-time">@FormatNotificationDate(item.CreatedAt)</div>
                        </div>
                    </div>
                }
            </div>
            <partial name="_Pagination" />
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var center = document.getElementById('notificationsCenter');
        if (!center) return;

        function navigateFrom(item) {
            if (!item || typeof window.chNavigateByType !== 'function') return;
            var type = item.getAttribute('data-type');
            if (type) window.chNavigateByType(type);
        }

        center.addEventListener('click', function (e) {
            var item = e.target && e.target.closest ? e.target.closest('.notif-item') : null;
            if (item) navigateFrom(item);
        });

        center.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            var item = e.target && e.target.closest ? e.target.closest('.notif-item') : null;
            if (item) {
                e.preventDefault();
                navigateFrom(item);
            }
        });
    });
</script>
