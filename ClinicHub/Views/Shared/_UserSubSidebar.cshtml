@using ClinicHub.Routes
@using ClinicHub.Services.ReponseModels
@{
    var userId = ViewBag.UserId is Guid g ? g : Guid.Empty;
    var currentSection = ViewBag.SubSidebarSection as string ?? "overview";
    bool IsActive(string section) => currentSection == section;

    // Role-based tabs (roles arrive normalized by the controller; empty = patient).
    // Freelance doctors follow no clinic yet → details only.
    var sidebarRoles = (ViewBag.User as AdminUserOverviewDto)?.Roles ?? new List<string>();
    bool isPatient = sidebarRoles.Count == 0;
    bool isFreelanceDoctor = ViewBag.IsFreelanceDoctor is true;
    bool HasRole(params string[] names) => names.Any(n => sidebarRoles.Contains(n));
    bool showVisits = !isFreelanceDoctor && (isPatient || HasRole("Doctor"));
    bool showRequests = !isFreelanceDoctor && HasRole("Doctor", "ClinicStaff", "ClinicOwner", "ClinicManager");
    bool showPayments = !isFreelanceDoctor && (isPatient || HasRole("ClinicOwner", "ClinicManager"));
}

<nav class="sub-sidebar" aria-label="أقسام الملف">
    <div class="sub-sidebar-header">
        <a href="@AdminRoutes.Pages.Users()" class="sub-sidebar-back">
            <i class="bi bi-arrow-right" aria-hidden="true"></i>
            المستخدمون
        </a>
    </div>
    <a class="sub-sidebar-item @(IsActive("overview") ? "active" : "")" href="@AdminRoutes.Pages.UsersOverview(userId)" @(IsActive("overview") ? "aria-current=\"page\"" : "")>
        <i class="bi bi-person-lines-fill" aria-hidden="true"></i>
        نظرة عامة
    </a>
    @if (showVisits)
    {
        <a class="sub-sidebar-item @(IsActive("visits") ? "active" : "")" href="@AdminRoutes.Pages.UsersVisits(userId)" @(IsActive("visits") ? "aria-current=\"page\"" : "")>
            <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
            الزيارات والتقييمات
        </a>
    }
    @if (showRequests)
    {
        <a class="sub-sidebar-item @(IsActive("requests") ? "active" : "")" href="@AdminRoutes.Pages.UsersRequests(userId)" @(IsActive("requests") ? "aria-current=\"page\"" : "")>
            <i class="bi bi-inboxes" aria-hidden="true"></i>
            الطلبات
        </a>
    }
    @if (showPayments)
    {
        <a class="sub-sidebar-item @(IsActive("payments") ? "active" : "")" href="@AdminRoutes.Pages.UsersPayments(userId)" @(IsActive("payments") ? "aria-current=\"page\"" : "")>
            <i class="bi bi-credit-card" aria-hidden="true"></i>
            المدفوعات
        </a>
    }
</nav>
