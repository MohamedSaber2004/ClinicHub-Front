@{
    ViewData["Title"] = "نتيجة الدفع - Doctory";
    var success = ViewBag.PaymentSuccess as bool? ?? false;
    var isAds = (ViewBag.PaymentType as string) == "ads";
    var isBooking = (ViewBag.PaymentType as string) is "booking" or "appointment";
    var verificationStatus = ViewBag.VerificationStatus as string;
    var subscriptionActive = ViewBag.SubscriptionActive as bool? ?? false;
    var subscriptionEndDate = ViewBag.SubscriptionEndDate as DateTime?;
    int.TryParse(Context.Request.Query["retry"], out var retryCount);
    const int MaxAutoRetries = 6;
    var keepRetrying = verificationStatus == "pending" && !subscriptionActive && retryCount < MaxAutoRetries;
}

<section class="payment-result-section">
    <div class="container">
        <div class="payment-result-card">
            <div class="ticket-perf ticket-perf--card-top"></div>
            @if (success)
            {
                <div class="result-icon-circle result-success">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" fill="white"/>
                    </svg>
                </div>
                @if (isAds)
                {
                    <h1 class="text-h1">تم دفع الإعلان بنجاح</h1>
                    <p class="result-desc">
                        شكراً لك! تم تأكيد عملية دفع الإعلان، وسيظهر إعلانك في التطبيق خلال لحظات قليلة.
                    </p>
                }
                else if (isBooking)
                {
                    <h1 class="text-h1">تم دفع الحجز بنجاح</h1>
                    <p class="result-desc">
                        شكراً لك! تم تأكيد عملية دفع الحجز بنجاح.
                    </p>
                }
                else
                {
                    <h1 class="text-h1">تم تفعيل الاشتراك بنجاح</h1>
                    <p class="result-desc">
                        @if (subscriptionActive)
                        {
                            <span>
                                شكراً لك! تم تأكيد عملية الدفع وتفعيل اشتراك عيادتك بنجاح@(subscriptionEndDate.HasValue ? $" حتى {subscriptionEndDate.Value:yyyy-MM-dd}" : ""). يمكنك الآن الاستمتاع بجميع ميزات المنصة.
                            </span>
                        }
                        else if (verificationStatus == "pending")
                        {
                            <span>
                                تم استلام عملية الدفع بنجاح، وجارٍ حالياً تأكيد تفعيل الاشتراك. عادةً تستغرق العملية لحظات قليلة — يمكنك تحديث الحالة أو المحاولة لاحقاً.
                            </span>
                        }
                        else
                        {
                            <span>
                                شكراً لك! تم تأكيد عملية الدفع. إذا لم يظهر الاشتراك مفعّلاً، سيتم تفعيله تلقائياً فور وصول تأكيد بوابة الدفع.
                            </span>
                        }
                    </p>
                }
                <div class="result-redirect-notice">
                    @if (isAds)
                    {
                        <span>سيتم تحويلك إلى صفحة الخدمات الإعلانية تلقائياً خلال <span id="countdownTimer" class="countdown-badge">5</span> ثوانٍ...</span>
                    }
                    else if (keepRetrying)
                    {
                        <span id="pendingAutoRetry">سيتم التحقق تلقائياً من حالة الاشتراك خلال <span id="countdownTimer" class="countdown-badge">5</span> ثوانٍ...</span>
                    }
                    else if (verificationStatus == "pending" && !subscriptionActive)
                    {
                        <span>لم يتم تأكيد العملية بعد — تحقق لاحقاً من صفحة اشتراكك أو تواصل مع الدعم.</span>
                    }
                    else
                    {
                        <span id="successRedirectNotice">سيتم تحويلك إلى صفحتك السابقة تلقائياً خلال <span id="countdownTimer" class="countdown-badge">5</span> ثوانٍ...</span>
                    }
                </div>
                <div class="result-actions">
                    @if (isAds)
                    {
                        <a id="returnActionBtn" href="@(!string.IsNullOrWhiteSpace(ViewBag.PrePaymentUrl as string) ? ViewBag.PrePaymentUrl : ClinicRoutes.Pages.Marketing())" target="_top" class="btn btn-primary btn-lg">العودة للخدمات الإعلانية</a>
                        <a href="/" target="_top" class="btn btn-secondary btn-lg">العودة للرئيسية</a>
                    }
                    else if (isBooking)
                    {
                        <a id="returnActionBtn" href="@(!string.IsNullOrWhiteSpace(ViewBag.PrePaymentUrl as string) ? ViewBag.PrePaymentUrl : "/")" target="_top" class="btn btn-primary btn-lg">العودة للصفحة السابقة</a>
                        <a href="/" target="_top" class="btn btn-secondary btn-lg">العودة للرئيسية</a>
                    }
                    else if (verificationStatus == "pending" && !subscriptionActive)
                    {
                        <a href="@ClinicRoutes.Pages.MySubscription()" target="_top" class="btn btn-primary btn-lg">صفحة اشتراكي</a>
                        <a href="@($"{Context.Request.Path}?success=true&retry={retryCount + 1}")" target="_top" class="btn btn-secondary btn-lg">تحديث الحالة</a>
                    }
                    else
                    {
                        <a id="returnActionBtn" href="@(!string.IsNullOrWhiteSpace(ViewBag.PrePaymentUrl as string) ? ViewBag.PrePaymentUrl : ClinicRoutes.Pages.Index())" target="_top" class="btn btn-primary btn-lg">العودة للصفحة السابقة</a>
                        <a href="@ClinicRoutes.Pages.Index()" target="_top" class="btn btn-secondary btn-lg">الدخول إلى لوحة التحكم</a>
                    }
                </div>
            }
            else
            {
                <div class="result-icon-circle result-fail">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
                        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z" fill="white"/>
                    </svg>
                </div>
                @if (isAds)
                {
                    <h1 class="text-h1">فشلت عملية دفع الإعلان</h1>
                    <p class="result-desc">
                        حدث خطأ أثناء معالجة عملية دفع الإعلان. يمكنك المحاولة مرة أخرى من صفحة الخدمات الإعلانية.
                    </p>
                }
                else if (isBooking)
                {
                    <h1 class="text-h1">فشلت عملية دفع الحجز</h1>
                    <p class="result-desc">
                        حدث خطأ أثناء معالجة عملية دفع الحجز. يرجى المحاولة مرة أخرى.
                    </p>
                }
                else
                {
                    var errorMsg = TempData["ErrorMessage"] as string ?? TempData["Error"] as string;
                    if (subscriptionActive)
                    {
                        <h1 class="text-h1">تم تفعيل الاشتراك بنجاح</h1>
                        <p class="result-desc">
                            تم تأكيد عملية الدفع وتفعيل اشتراك عيادتك بنجاح@(subscriptionEndDate.HasValue ? $" حتى {subscriptionEndDate.Value:yyyy-MM-dd}" : "").
                        </p>
                    }
                    else
                    {
                        <h1 class="text-h1">فشلت عملية الدفع</h1>
                        <p class="result-desc">
                            @(!string.IsNullOrWhiteSpace(errorMsg) ? errorMsg : "حدث خطأ أثناء معالجة عملية الدفع. يرجى المحاولة مرة أخرى أو اختيار باقة مختلفة.")
                        </p>
                    }
                }
                <div class="result-redirect-notice">
                    @if (isAds)
                    {
                        <span>سيتم تحويلك إلى صفحة الخدمات الإعلانية تلقائياً خلال <span id="countdownTimer" class="countdown-badge">5</span> ثوانٍ...</span>
                    }
                    else
                    {
                        <span>سيتم العودة للصفحة السابقة تلقائياً خلال <span id="countdownTimer" class="countdown-badge">5</span> ثوانٍ...</span>
                    }
                </div>
                <div class="result-actions result-actions--row">
                    @if (isAds)
                    {
                        <a id="failReturnBtn" href="@(!string.IsNullOrWhiteSpace(ViewBag.PrePaymentUrl as string) ? ViewBag.PrePaymentUrl : ClinicRoutes.Pages.Marketing())" target="_top" class="btn btn-primary btn-lg">العودة للخدمات الإعلانية</a>
                        <a href="/" target="_top" class="btn btn-secondary btn-lg">العودة للرئيسية</a>
                    }
                    else if (isBooking)
                    {
                        <a id="failReturnBtn" href="@(!string.IsNullOrWhiteSpace(ViewBag.PrePaymentUrl as string) ? ViewBag.PrePaymentUrl : "/")" target="_top" class="btn btn-primary btn-lg">العودة للصفحة السابقة</a>
                        <a href="/" target="_top" class="btn btn-secondary btn-lg">العودة للرئيسية</a>
                    }
                    else
                    {
                        <a id="failReturnBtn" href="@(!string.IsNullOrWhiteSpace(ViewBag.PrePaymentUrl as string) ? ViewBag.PrePaymentUrl : HomeRoutes.Pages.Subscriptions())" target="_top" class="btn btn-primary btn-lg">العودة للصفحة السابقة</a>
                        <a href="/" target="_top" class="btn btn-secondary btn-lg">العودة للرئيسية</a>
                    }
                </div>
            }
            <div class="ticket-perf ticket-perf--card-bottom"></div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function() {
            var seconds = 5;
            var timerEl = document.getElementById('countdownTimer');
            var isAds = @(isAds.ToString().ToLower());
            var isBooking = @(isBooking.ToString().ToLower());
            var isSuccess = @(success.ToString().ToLower());
            var subscriptionActive = @(subscriptionActive.ToString().ToLower());
            var keepRetrying = @(keepRetrying.ToString().ToLower());
            var retryCount = @(retryCount);

            function getPrePaymentUrl() {
                try {
                    var serverUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.PrePaymentUrl as string));
                    var storageUrl = sessionStorage.getItem('prePaymentPage') || localStorage.getItem('prePaymentPage');
                    var cookieMatch = document.cookie.match(/(?:^|;\s*)prePaymentUrl=([^;]+)/);
                    var cookieUrl = cookieMatch ? decodeURIComponent(cookieMatch[1]) : null;
                    var url = storageUrl || cookieUrl || serverUrl;
                    if (url) {
                        if (url.indexOf('/PaymentResult') !== -1 || url.indexOf('/Clinic/Subscribe') !== -1) {
                            return null;
                        }
                        if (url.startsWith('/') || url.startsWith(window.location.origin)) {
                            return url;
                        }
                    }
                } catch (e) {}
                return null;
            }

            function clearPrePaymentData() {
                try {
                    sessionStorage.removeItem('prePaymentPage');
                    localStorage.removeItem('prePaymentPage');
                    document.cookie = "prePaymentUrl=; path=/; max-age=0; SameSite=Lax";
                } catch (e) {}
            }

            var preUrl = getPrePaymentUrl();
            var returnBtn = document.getElementById('returnActionBtn');
            if (returnBtn && preUrl) {
                returnBtn.href = preUrl;
                returnBtn.addEventListener('click', clearPrePaymentData);
            }
            var failReturnBtn = document.getElementById('failReturnBtn');
            if (failReturnBtn && preUrl) {
                failReturnBtn.href = preUrl;
                failReturnBtn.addEventListener('click', clearPrePaymentData);
            }

            function redirectTo() {
                var currentOrigin = window.location.origin;
                if (!currentOrigin) {
                    currentOrigin = window.location.protocol + "//" + window.location.host;
                }
                var baseUrl = currentOrigin + '/';
                var target;

                if (keepRetrying) {
                    target = baseUrl + 'Home/PaymentResult?success=true&retry=' + (retryCount + 1);
                } else if (isAds) {
                    clearPrePaymentData();
                    target = preUrl || (baseUrl + 'Clinic/Marketing');
                } else if (isBooking) {
                    clearPrePaymentData();
                    target = preUrl || baseUrl;
                } else if (isSuccess) {
                    clearPrePaymentData();
                    target = preUrl || (subscriptionActive ? (baseUrl + 'Clinic/MySubscription') : (baseUrl + 'Clinic/Index'));
                } else {
                    clearPrePaymentData();
                    target = preUrl || baseUrl;
                }

                if (window.self !== window.top) {
                    try {
                        window.top.location.href = target;
                    } catch (e) {
                        window.location.href = target;
                    }
                } else {
                    window.location.href = target;
                }
            }

            if (timerEl) {
                var interval = setInterval(function() {
                    seconds--;
                    if (seconds >= 0) {
                        timerEl.textContent = seconds;
                    }
                    if (seconds <= 0) {
                        clearInterval(interval);
                        redirectTo();
                    }
                }, 1000);
            } else {
                setTimeout(redirectTo, 5000);
            }
        })();
    </script>
}

