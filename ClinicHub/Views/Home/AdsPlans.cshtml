@using ClinicHub.Services.ReponseModels
@using ClinicHub.Routes
@{
    ViewData["Title"] = "باقات الإعلانات والترويج - Doctory";
    var adPackages = ViewBag.AdPackages as List<AdPackageDto> ?? new();
    var isAuthenticated = Context.Request.Cookies["AccessToken"] != null;
    var activePackages = adPackages.Where(p => p.IsActive).ToList();
}

<section class="subscription-hero">
    <div class="container text-center">
        <span class="hero-eyebrow">الترويج الرقمي للعيادات</span>
        <h1 class="text-h1">باقات وخدمات الإعلانات الذكية</h1>
        <p class="subscription-hero-desc">روّج لعيادتك واظهر كأول الخيارات لآلاف المرضى على تطبيق Doctory للجوال مع إحصائيات ظهور مؤكدة</p>
    </div>
</section>

<section class="subscription-section">
    <div class="container">
        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
        {
            <div class="alert alert-danger mb-4">@ViewBag.ErrorMessage</div>
        }

        <div class="subscription-plans" id="adPlanCards">
            @if (activePackages.Count == 0)
            {
                <div class="plans-empty text-center py-5">
                    <div class="icon-wrapper icon-wrapper--primary mb-3 mx-auto" style="width:56px;height:56px">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/><circle cx="12" cy="12" r="4"/></svg>
                    </div>
                    <h3 class="text-h3 mb-2">لا توجد باقات إعلانية معروضة حالياً</h3>
                    <p class="text-muted mb-4">تواصل مع إدارة منصة Doctory لمعرفة الحملات الترويجية المخصصة لعيادتك أو تفقد باقات تشغيل العيادات.</p>
                    <a href="@HomeRoutes.Pages.Subscriptions()" class="btn btn-primary">عرض باقات تشغيل العيادات</a>
                </div>
            }
            else
            {
                foreach (var pkg in activePackages)
                {
                    <div class="plan-card plan-premium">
                        <span class="plan-badge">باقة إعلانية</span>
                        <div class="plan-header">
                            <h3 class="plan-name">@(pkg.NameAr ?? pkg.Name)</h3>
                            <p class="plan-desc">@(pkg.DescriptionAr ?? pkg.Description)</p>
                            <p class="plan-price">
                                <span>@pkg.Price.ToString("N0")</span>
                                <span class="plan-currency">ج.م</span>
                            </p>
                            <p class="plan-period-label">
                                <span>لمدة @pkg.DurationDays يوم</span>
                            </p>
                        </div>
                        <div class="plan-body">
                            <div class="plan-limits">
                                <span>@(pkg.MaxAds > 0 ? $"حتى {pkg.MaxAds} إعلانات نشطة" : "إعلانات غير محدودة")</span>
                                <span>@(pkg.MaxImpressions > 0 ? $"{pkg.MaxImpressions:N0} مشاهدة مؤكدة" : "مشاهدات غير محدودة")</span>
                            </div>
                            <ul class="plan-features">
                                <li>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" fill="var(--clr-success)"/></svg>
                                    <span>ظهور مميز وشارة عيادة معتمدة في تطبيق المرضى</span>
                                </li>
                                <li>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" fill="var(--clr-success)"/></svg>
                                    <span>إمكانية رفع شعار وهوية العيادة في الإعلان</span>
                                </li>
                                <li>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" fill="var(--clr-success)"/></svg>
                                    <span>استهداف المرضى حسب التخصص والموقع الجغرافي</span>
                                </li>
                                <li>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" fill="var(--clr-success)"/></svg>
                                    <span>تفعيل فوري وتقارير مشاهدات تفاعلية</span>
                                </li>
                            </ul>
                        </div>
                        <div class="plan-footer">
                            @if (isAuthenticated)
                            {
                                <a href="@ClinicRoutes.Pages.Marketing()" class="btn btn-primary btn-lg plan-cta-full">شراء وتفعيل الإعلان</a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary btn-lg plan-cta-full btn-subscribe-ad" data-ad-package-id="@pkg.Id" data-name="@(pkg.NameAr ?? pkg.Name)" data-price="@pkg.Price" data-duration="@pkg.DurationDays">اشترك في الباقة الإعلانية</button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- Advertising Benefits Section -->
<section class="subscription-benefits">
    <div class="container">
        <h2 class="text-h2 text-center">لماذا تعلن عيادتك على Doctory؟</h2>
        <p class="benefits-subtitle">مزايا حصرية للترويج والوصول المباشر للمرضى الباحثين عن خدماتك الطبية</p>
        <div class="benefits-grid">
            <div class="benefit-card">
                <div class="icon-wrapper icon-wrapper--primary">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="m4.93 4.93 4.24 4.24" stroke="currentColor" stroke-width="2"/><path d="m14.83 9.17 4.24-4.24" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>
                </div>
                <h4 class="benefit-title">استهداف ذكي للمرضى</h4>
                <p class="benefit-desc">يظهر إعلانك للمرضى الذين يبحثون بنشاط عن تخصص عيادتك في منطقتك الجغرافية</p>
            </div>
            <div class="benefit-card">
                <div class="icon-wrapper icon-wrapper--primary icon-wrapper--green">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="currentColor"/></svg>
                </div>
                <h4 class="benefit-title">شارة العيادة المعتمدة</h4>
                <p class="benefit-desc">شارة توثيق تعزز ثقة المرضى وتزيد من معدلات الحجز المؤكد في عيادتك</p>
            </div>
            <div class="benefit-card">
                <div class="icon-wrapper icon-wrapper--primary icon-wrapper--amber">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 2 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="currentColor"/></svg>
                </div>
                <h4 class="benefit-title">تقارير مشاهدات دقيقة</h4>
                <p class="benefit-desc">إحصائيات فورية لعدد مرات ظهور إعلانك والنقرات والحجوزات الناتجة عنه</p>
            </div>
            <div class="benefit-card">
                <div class="icon-wrapper icon-wrapper--primary icon-wrapper--blue">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" fill="currentColor"/></svg>
                </div>
                <h4 class="benefit-title">تفعيل فوري ودعم متواصل</h4>
                <p class="benefit-desc">يتم تفعيل الحملة الإعلانية فور السداد مع إمكانية تحديث الشعار والبيانات في أي وقت</p>
            </div>
        </div>
    </div>
</section>

<!-- Register Required Modal for Unauthenticated Users -->
<div class="modal fade" id="registerRequiredModal" tabindex="-1" aria-labelledby="registerRequiredModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom modal-subscribe-card">
            <div class="modal-card-accent-bar"></div>
            <button type="button" class="modal-close-corner" data-bs-dismiss="modal" aria-label="إغلاق">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
            <div class="modal-subscribe-body text-center">
                <div class="modal-premium-icon-box">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 21h18M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16M9 9h1m4 0h1m-6 4h1m4 0h1M9 17h6"/>
                    </svg>
                </div>
                <h3 class="modal-premium-title" id="registerRequiredModalLabel">إنشاء حساب عيادة لشراء الإعلان</h3>
                <p class="modal-premium-subtitle">
                    لشراء وتفعيل الباقة الإعلانية لعيادتك، يرجى إنشاء حساب عيادة جديد أو تسجيل الدخول إذا كنت تمتلك حساباً بالفعل.
                </p>
                <div class="modal-plan-summary" id="modalPlanSummary" hidden>
                    <div class="plan-summary-info">
                        <span class="plan-summary-tag">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            الباقة المحددة
                        </span>
                        <h4 class="plan-summary-name" id="modalPlanName"></h4>
                    </div>
                    <div class="plan-summary-pricing">
                        <span class="plan-summary-price-num" id="modalPlanPrice"></span>
                        <span class="plan-summary-price-curr">ج.م</span>
                        <span class="plan-summary-price-period" id="modalPlanPeriod"></span>
                    </div>
                </div>
                <div class="modal-action-stack">
                    <a href="@HomeRoutes.Pages.ClinicRegister()" id="registerRequiredModalRegBtn" class="btn btn-primary">
                        <i class="bi bi-building-add me-1"></i> إنشاء حساب عيادة جديد
                    </a>
                    <a href="@HomeRoutes.Account.Login()" id="registerRequiredModalLoginBtn" class="btn btn-outline-primary">
                        <i class="bi bi-box-arrow-in-left me-1"></i> تسجيل الدخول للمتابعة
                    </a>
                    <button type="button" class="btn-modal-dismiss-link" data-bs-dismiss="modal">
                        إلغاء والمتابعة كتصفح
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-subscribe-ad').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var pkgName = this.getAttribute('data-name');
                var pkgPrice = this.getAttribute('data-price');
                var pkgDuration = this.getAttribute('data-duration');

                var summaryEl = document.getElementById('modalPlanSummary');
                var planNameEl = document.getElementById('modalPlanName');
                var planPriceEl = document.getElementById('modalPlanPrice');
                var planPeriodEl = document.getElementById('modalPlanPeriod');
                var regBtn = document.getElementById('registerRequiredModalRegBtn');
                var loginBtn = document.getElementById('registerRequiredModalLoginBtn');

                if (summaryEl && pkgName) {
                    planNameEl.textContent = pkgName;
                    planPriceEl.textContent = pkgPrice || '0';
                    planPeriodEl.textContent = '/ ' + pkgDuration + ' يوم';
                    summaryEl.hidden = false;
                }

                if (regBtn) regBtn.href = '@HomeRoutes.Pages.ClinicRegister()';
                if (loginBtn) loginBtn.href = '@HomeRoutes.Account.Login()' + '?returnUrl=' + encodeURIComponent('@ClinicRoutes.Pages.Marketing()');

                var modalEl = document.getElementById('registerRequiredModal');
                if (modalEl) {
                    var requiredModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    requiredModal.show();
                }
            });
        });
    </script>
}
