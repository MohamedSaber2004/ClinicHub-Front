@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "الرئيسية - Doctory";
    var adPackages = ViewBag.AdPackages as List<AdPackageDto> ?? new();
    var activeAdPackages = adPackages.Where(p => p.IsActive).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/public-home.css?v=20261027_redesign_v2" asp-append-version="false" />
}

<!-- Hero -->
<section class="ph-hero">
    <div class="container">
        <div class="ph-hero-inner stagger">
            <span class="badge badge-primary badge--dot ph-eyebrow">منصة تشغيل العيادات</span>
            <h1 class="ph-hero-title">نظام إدارة وتشغيل العيادات الطبي الموحد</h1>
            <p class="ph-hero-lead">
                أهلاً بكم في منصة Doctory - المنصة التشغيلية والوسيطة المتكاملة لربط مدراء النظام بملاك العيادات. نعمل كحلقة وصل إدارية متقدمة لتنظيم العمل الطبي بكافة تفاصيله.
            </p>
            <div class="ph-hero-cta">
                <a href="@HomeRoutes.Account.Login()" class="btn btn-primary btn-lg">
                    <i class="bi bi-box-arrow-in-left" aria-hidden="true"></i>
                    تسجيل الدخول
                </a>
                <a href="@HomeRoutes.Pages.ClinicRegister()" class="btn btn-secondary btn-lg">
                    <i class="bi bi-hospital" aria-hidden="true"></i>
                    اشترك في الخدمة
                </a>
            </div>
        </div>

        <ul class="ph-trust stagger">
            <li class="ph-trust-item" data-scroll>
                <div class="ph-trust-head">
                    <span class="icon-wrapper icon-wrapper--sm icon-wrapper--primary">
                        <i class="bi bi-shield-lock" aria-hidden="true"></i>
                    </span>
                    <h2 class="ph-trust-title">اتصالات مشفّرة بالكامل</h2>
                </div>
                <p class="ph-trust-sub">HTTPS وتشفير SSL/TLS بين المتصفح والخوادم.</p>
            </li>
            <li class="ph-trust-item ph-trust-item--accent" data-scroll>
                <div class="ph-trust-head">
                    <span class="icon-wrapper icon-wrapper--sm icon-wrapper--brass">
                        <i class="bi bi-layers" aria-hidden="true"></i>
                    </span>
                    <h2 class="ph-trust-title">عزل بيانات كل عيادة</h2>
                </div>
                <p class="ph-trust-sub">نظام عزل صارم يفصل بيانات كل منشأة عن غيرها.</p>
            </li>
            <li class="ph-trust-item" data-scroll>
                <div class="ph-trust-head">
                    <span class="icon-wrapper icon-wrapper--sm icon-wrapper--primary">
                        <i class="bi bi-person-badge" aria-hidden="true"></i>
                    </span>
                    <h2 class="ph-trust-title">صلاحيات مبنية على الأدوار</h2>
                </div>
                <p class="ph-trust-sub">يرى كل مستخدم ما يخص دوره فقط داخل النظام.</p>
            </li>
            <li class="ph-trust-item" data-scroll>
                <div class="ph-trust-head">
                    <span class="icon-wrapper icon-wrapper--sm icon-wrapper--primary">
                        <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                    </span>
                    <h2 class="ph-trust-title">نسخ احتياطي يومي</h2>
                </div>
                <p class="ph-trust-sub">حفظ تلقائي في خوادم مشفرة ومنعزلة جغرافياً.</p>
            </li>
        </ul>
    </div>
</section>

<!-- Services -->
<section id="services" class="ph-band">
    <div class="container">
        <header class="ph-head">
            <span class="badge badge-primary badge--dot ph-eyebrow">خدماتنا</span>
            <h2 class="ph-head-title">الخدمات والحلول الإدارية المتكاملة</h2>
            <p class="ph-head-lead">نظام وسيط ذكي لتسهيل إدارة العيادات وتشغيلها بكفاءة لربط ملاك العيادات بالمدير العام.</p>
        </header>

        <div class="ph-grid ph-grid--services">
            <article class="ph-card" data-scroll>
                <span class="icon-wrapper icon-wrapper--primary ph-card-icon">
                    <i class="bi bi-people" aria-hidden="true"></i>
                </span>
                <h3 class="ph-card-title">إدارة الأطباء والكادر</h3>
                <p class="ph-card-desc">تسجيل ملفات الأطباء، تحديد التخصصات، وإسناد الجداول اليومية للعمل داخل العيادات.</p>
            </article>

            <article class="ph-card" data-scroll>
                <span class="icon-wrapper icon-wrapper--primary ph-card-icon">
                    <i class="bi bi-calendar-check" aria-hidden="true"></i>
                </span>
                <h3 class="ph-card-title">إدارة المواعيد والحجوزات</h3>
                <p class="ph-card-desc">جدولة مواعيد المرضى مع الأطباء، ومتابعة الجدول اليومي للعيادات لحظة بلحظة.</p>
            </article>

            <article class="ph-card" data-scroll>
                <span class="icon-wrapper icon-wrapper--primary ph-card-icon">
                    <i class="bi bi-list-ol" aria-hidden="true"></i>
                </span>
                <h3 class="ph-card-title">إدارة قوائم الانتظار</h3>
                <p class="ph-card-desc">تنظيم حضور المرضى لحظة بلحظة، وترتيب أدوارهم في صالات الانتظار بشكل رقمي بالكامل.</p>
            </article>

            <article class="ph-card" data-scroll>
                <span class="icon-wrapper icon-wrapper--primary ph-card-icon">
                    <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                </span>
                <h3 class="ph-card-title">مراقبة الأداء والتحليل</h3>
                <p class="ph-card-desc">مراقبة الكفاءة التشغيلية، وحساب متوسط فترات الانتظار، واستخراج تقارير إدارية متقدمة.</p>
            </article>
        </div>
    </div>
</section>

@if (activeAdPackages.Count > 0)
{
    <!-- Ad packages -->
    <section id="ads-plans" class="ph-band ph-band--tinted">
        <div class="container">
            <header class="ph-head">
                <span class="badge badge-primary badge--dot ph-eyebrow">
                    <i class="bi bi-megaphone" aria-hidden="true"></i>
                    الترويج والإعلانات
                </span>
                <h2 class="ph-head-title">باقات الإعلانات المتاحة للعيادات</h2>
                <p class="ph-head-lead">روّج لعيادتك واظهر كأول الخيارات للمرضى في تطبيق Doctory للجوال لزيادة عدد الحجوزات</p>
            </header>

            <div class="ph-grid ph-grid--plans">
                @foreach (var pkg in activeAdPackages)
                {
                    <article class="ph-card ph-plan" data-scroll>
                        <span class="ph-plan-badge">باقة إعلانية</span>
                        <div class="ph-plan-head">
                            <h3 class="ph-plan-name">@(pkg.NameAr ?? pkg.Name)</h3>
                            <p class="ph-plan-desc">@(pkg.DescriptionAr ?? pkg.Description)</p>
                            <p class="ph-plan-price">
                                <span class="ph-plan-amount">@pkg.Price.ToString("N0")</span>
                                <span class="ph-plan-currency">ج.م</span>
                            </p>
                            <p class="ph-plan-period">
                                <i class="bi bi-clock" aria-hidden="true"></i>
                                <span>لمدة @pkg.DurationDays يوم</span>
                            </p>
                        </div>
                        <div class="ph-plan-body">
                            <div class="ph-plan-limits">
                                <span class="ph-plan-limit">@(pkg.MaxAds > 0 ? $"حتى {pkg.MaxAds} إعلانات نشطة" : "إعلانات غير محدودة")</span>
                                <span class="ph-plan-limit">@(pkg.MaxImpressions > 0 ? $"{pkg.MaxImpressions:N0} مشاهدة مؤكدة" : "مشاهدات غير محدودة")</span>
                            </div>
                            <ul class="ph-plan-features">
                                <li class="ph-plan-feature">
                                    <i class="bi bi-check2" aria-hidden="true"></i>
                                    <span>ظهور مميز وشارة عيادة معتمدة في تطبيق المرضى</span>
                                </li>
                                <li class="ph-plan-feature">
                                    <i class="bi bi-check2" aria-hidden="true"></i>
                                    <span>استهداف المرضى حسب التخصص والموقع الجغرافي</span>
                                </li>
                                <li class="ph-plan-feature">
                                    <i class="bi bi-check2" aria-hidden="true"></i>
                                    <span>تقارير مشاهدات تفاعلية وتفعيل فوري</span>
                                </li>
                            </ul>
                        </div>
                        <div class="ph-plan-footer">
                            <a href="@HomeRoutes.Pages.AdsPlans()" class="btn btn-primary btn-lg ph-plan-cta">تفاصيل الباقة والاشتراك</a>
                        </div>
                    </article>
                }
            </div>

            <div class="ph-plans-more">
                <a href="@HomeRoutes.Pages.AdsPlans()" class="btn btn-outline">
                    عرض جميع باقات وتفاصيل الإعلانات
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>
}

<!-- Why Doctory -->
<section id="about" class="ph-band">
    <div class="container">
        <div class="ph-why-grid">
            <div class="ph-split-copy">
                <span class="badge badge-primary badge--dot ph-eyebrow">لماذا Doctory؟</span>
                <h2 class="ph-head-title ph-head-title--start">لماذا تختار منصة Doctory؟</h2>
                <p class="ph-why-lead">
                    نحن لسنا بوابة للمرضى؛ بل نمثل النظام الإداري الوسيط والذكي الأنسب للمنشآت والعيادات الطبية المتعددة. نمكن المشرفين الإداريين وملاك العيادات من التعاون معاً في مساحة رقمية واحدة لتنظيم وتشغيل العيادات بكفاءة غير مسبوقة.
                </p>
                <ul class="ph-checks">
                    <li class="ph-check">
                        <span class="ph-check-icon">
                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        </span>
                        <p class="ph-check-text">إدارة شاملة لملفات وتفاصيل الأطباء والممرضين والموظفين.</p>
                    </li>
                    <li class="ph-check">
                        <span class="ph-check-icon">
                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        </span>
                        <p class="ph-check-text">سجلات طبية رقمية ومتابعة فورية لملفات المرضى داخل العيادة.</p>
                    </li>
                    <li class="ph-check">
                        <span class="ph-check-icon">
                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        </span>
                        <p class="ph-check-text">بوابة وسيطة تربط المشرفين بملاك العيادات وإداراتهم الطبية.</p>
                    </li>
                </ul>
            </div>

            <aside class="ph-portal" data-scroll>
                <span class="icon-wrapper icon-wrapper--lg icon-wrapper--solid">
                    <i class="bi bi-speedometer2" aria-hidden="true"></i>
                </span>
                <h3 class="ph-portal-title">بوابة الإدارة الرقمية</h3>
                <p class="ph-portal-desc">يمكنك الدخول إلى حسابك للبدء في إدارة تشغيل العيادات والموظفين فوراً.</p>
                <div class="ph-portal-actions">
                    <a href="@HomeRoutes.Account.Login()" class="btn btn-primary btn-block">تسجيل الدخول</a>
                </div>
            </aside>
        </div>
    </div>
</section>
