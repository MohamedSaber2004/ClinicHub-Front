@using ClinicHub.Routes
@{
    ViewData["Title"] = "اشتراك مطلوب - Doctory";
}

<section class="subscription-required-section">
    <div class="container">
        <div class="subscription-required-card">
            <div class="ticket-perf ticket-perf--card-top"></div>
            <div class="required-icon-circle">
                <i class="bi bi-credit-card-2-front-fill" aria-hidden="true"></i>
            </div>
            <h1 class="text-h1">اشتراك مطلوب</h1>
            <p class="required-desc">
                عيادتك تحتاج إلى اشتراك نشط للوصول إلى لوحة التحكم الكاملة وجميع الميزات الحصرية. اشترك الآن لتفعيل جميع الخدمات.
            </p>
            <div class="required-plan-info">
                <span class="required-plan-label">الباقة الحالية:</span>
                <span class="required-plan-value">لا توجد باقة نشطة</span>
            </div>
            <div class="required-actions">
                <a href="@HomeRoutes.Pages.Subscriptions()" class="btn btn-primary btn-lg">عرض الباقات والاشتراك</a>
                <a href="@HomeRoutes.Pages.Index()" class="btn btn-secondary">العودة للرئيسية</a>
            </div>
            <div class="ticket-perf ticket-perf--card-bottom"></div>
        </div>
    </div>
</section>
