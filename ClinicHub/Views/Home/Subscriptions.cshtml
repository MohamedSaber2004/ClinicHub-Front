@using ClinicHub.Services.ReponseModels
@using System.Text.Json
@using ClinicHub.Routes
@{
    ViewData["Title"] = "الباقات والاشتراكات - Doctory";
    var plans = ViewBag.Plans as List<PlanDto> ?? new();
    var isAuthenticated = Context.Request.Cookies["AccessToken"] != null;
    var featureLabels = new Dictionary<string, string>
    {
        ["appointments"] = "إدارة المواعيد والحجوزات",
        ["patient_records"] = "السجلات والملفات الطبية",
        ["basic_reports"] = "تقارير تشغيلية أساسية",
        ["advanced_reports"] = "تقارير مالية وإحصائية متقدمة",
        ["marketing_tools"] = "ميزة نشر الإعلانات والترويج بالتطبيق",
        ["priority_support"] = "دعم فني ذو أولوية 24/7",
        ["online_booking"] = "الحجز والدفع الإلكتروني أونلاين",
        ["staff_management"] = "إدارة طاقم العمل والموظفين",
        ["doctor_management"] = "إدارة الأطباء والجداول",
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/public-plans.css?v=20261027_redesign_v2" asp-append-version="false" />
}

<section class="subscription-hero plans-hero">
    <div class="container text-center">
        <h1 class="text-h1">اختر باقة الاشتراك المناسبة لعيادتك</h1>
        <p class="subscription-hero-desc">اشترك الآن في الباقة التي تناسب حجم عيادتك، واستفد من ميزات الإدارة والتشغيل والترويج الإعلاني</p>
    </div>
</section>

<section class="subscription-section plans-section">
    <div class="container">
        <div class="plans-toolbar" data-scroll>
            <div class="ads-search-wrap plans-search">
                <i class="bi bi-search ads-search-icon" aria-hidden="true"></i>
                <input type="text" id="planSearch" aria-label="بحث في الباقات" class="form-input ads-global-input" placeholder="بحث في الباقات والمميزات..." autocomplete="off" />
            </div>

            <div class="pricing-toggle segmented">
                <span class="toggle-label segmented-item">شهرياً</span>
                <label class="form-toggle">
                    <input type="checkbox" id="periodToggle" aria-label="تبديل فترة التسعير بين شهرياً وسنوياً" />
                    <span class="toggle-track"></span>
                </label>
                <span class="toggle-label segmented-item">سنوياً</span>
            </div>
        </div>

        <div class="subscription-plans" id="planCards">
            @if (plans.Where(p => p.IsActive).Count() == 0)
            {
                <div class="plans-empty">
                    <p>لا توجد باقات متاحة حالياً</p>
                </div>
            }
            else
            {
                foreach (var plan in plans.Where(p => p.IsActive).OrderBy(p => p.SortOrder))
                {
                    var maxSort = plans.Where(p => p.IsActive).Max(p => p.SortOrder);
                    var isTop = plan.SortOrder >= maxSort;
                    var planClass = isTop ? "plan-premium plan-featured" : "plan-free";
                    var featureList = JsonSerializer.Deserialize<List<string>>(plan.Features) ?? new();
                    var includesAds = featureList.Contains("marketing_tools");
                    var badge = isTop ? "الأفضل والأشمل" : (includesAds ? "تشمل ميزة الإعلانات" : "");

                    <div class="plan-card @planClass">
                        @if (!string.IsNullOrEmpty(badge))
                        {
                            <span class="plan-badge">@badge</span>
                        }
                        <div class="plan-header">
                            <h2 class="plan-name">@plan.NameAr</h2>
                            <p class="plan-desc">@plan.DescriptionAr</p>
                            <p class="plan-price">
                                <span class="price-monthly">@plan.PriceMonthly.ToString("N0")</span>
                                <span class="price-yearly d-none">@plan.PriceYearly.ToString("N0")</span>
                                <span class="plan-currency">ج.م</span>
                            </p>
                            <p class="plan-period-label">
                                <span class="period-monthly">شهرياً</span>
                                <span class="period-yearly d-none">سنوياً</span>
                            </p>
                        </div>
                        <div class="plan-body">
                            <div class="plan-limits">
                                <span>@(plan.MaxDoctors.HasValue ? $"حتى {plan.MaxDoctors} أطباء" : "أطباء غير محدود")</span>
                                <span>@(plan.MaxStaff.HasValue ? $"حتى {plan.MaxStaff} موظف" : "موظفين غير محدود")</span>
                            </div>
                            <p class="plan-features-title">المميزات</p>
                            <ul class="plan-features">
                                @foreach (var feature in featureList)
                                {
                                    <li>
                                        <i class="bi bi-check-lg plan-feature-icon" aria-hidden="true"></i>
                                        <span>@(featureLabels.ContainsKey(feature) ? featureLabels[feature] : feature)</span>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="plan-footer">
                            <button type="button" class="btn btn-primary btn-lg plan-cta-full btn-subscribe" data-plan-id="@plan.Id">اشترك في الباقة</button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<section class="subscription-benefits">
    <div class="container">
        <h2 class="text-h2 text-center">مزايا الاشتراكات</h2>
        <p class="benefits-subtitle">كل ما تحتاجه لإدارة عيادتك بكفاءة واحترافية والوصول إلى المزيد من المرضى</p>
        <div class="benefits-grid">
            <div class="benefit-card">
                <div class="icon-wrapper icon-wrapper--primary">
                    <i class="bi bi-window-dock" aria-hidden="true"></i>
                </div>
                <h3 class="benefit-title">لوحة تحكم متكاملة</h3>
                <p class="benefit-desc">تابع جميع عمليات عيادتك من خلال لوحة تحكم ذكية وسهلة الاستخدام</p>
            </div>
            <div class="benefit-card">
                <div class="icon-wrapper icon-wrapper--primary icon-wrapper--green">
                    <i class="bi bi-calendar2-check" aria-hidden="true"></i>
                </div>
                <h3 class="benefit-title">إدارة الأطباء والمواعيد</h3>
                <p class="benefit-desc">أدر جداول الأطباء والمواعيد بسهولة مع إشعارات تلقائية للمرضى</p>
            </div>
            <div class="benefit-card">
                <div class="icon-wrapper icon-wrapper--primary icon-wrapper--amber">
                    <i class="bi bi-megaphone" aria-hidden="true"></i>
                </div>
                <h3 class="benefit-title">ميزة الإعلانات والترويج</h3>
                <p class="benefit-desc">الظهور في تطبيق المرضى بشعار مميز وشارة عيادة معتمدة لزيادة الحجوزات</p>
            </div>
            <div class="benefit-card">
                <div class="icon-wrapper icon-wrapper--primary icon-wrapper--blue">
                    <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                </div>
                <h3 class="benefit-title">تقارير وإحصائيات فورية</h3>
                <p class="benefit-desc">تقارير مفصلة عن أداء عيادتك والإيرادات ونسبة الحجوزات اليومية والشهرية</p>
            </div>
            <div class="benefit-card">
                <div class="icon-wrapper icon-wrapper--primary icon-wrapper--green">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                </div>
                <h3 class="benefit-title">دعم فني مستمر</h3>
                <p class="benefit-desc">فريق الدعم الفني متاح لمساعدتك في إعداد حسابك وتهيئة الأطباء والخدمات</p>
            </div>
            <div class="benefit-card">
                <div class="icon-wrapper icon-wrapper--primary icon-wrapper--blue">
                    <i class="bi bi-bell" aria-hidden="true"></i>
                </div>
                <h3 class="benefit-title">إشعارات ذكية</h3>
                <p class="benefit-desc">إشعارات وتنبيهات فورية للمرضى والعيادة لتنظيم سير العمل بدون تأخير</p>
            </div>
        </div>
    </div>
</section>

<section class="subscription-cta-section plans-cta-band">
    <div class="container">
        <div class="plans-cta-panel">
            <h2 class="text-h2">انضم إلى منصة Doctory</h2>
            <p class="subscription-cta-desc">أدرج عيادتك اليوم، اختر باقتك، وابدأ في إدارة أعمالك باحترافية</p>
            <a href="@HomeRoutes.Pages.ClinicRegister()" class="btn btn-primary btn-lg">ابدأ الآن</a>
        </div>
    </div>
</section>

<!-- Payment Method Selection Modal -->
<div class="modal fade" id="paymentMethodModal" tabindex="-1" aria-labelledby="paymentMethodModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom modal-subscribe-card">
            <div class="modal-card-accent-bar"></div>
            <button type="button" class="modal-close-corner" data-bs-dismiss="modal" aria-label="إغلاق">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
            <div class="modal-subscribe-body text-center">
                <div class="modal-premium-icon-box">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 21h18M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16M9 9h1m4 0h1m-6 4h1m4 0h1M9 17h6"/>
                    </svg>
                </div>
                <h3 class="modal-premium-title" id="paymentMethodModalLabel">اختر طريقة الدفع</h3>
                <p class="modal-premium-subtitle" id="paymentMethodModalSubtitle"></p>

                <div class="payment-methods-grid">
                    <label class="payment-method-card selected" id="methodWalletCard">
                        <input type="radio" name="paymentMethod" value="PaymobWallet" checked>
                        <div class="payment-method-icon payment-method-icon--wallet">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.66 0 3-4.03 3-9s-1.34-9-3-9m0 18c-1.66 0-3-4.03-3-9s1.34-9 3-9m-9 9a9 9 0 019-9"/>
                            </svg>
                        </div>
                        <div class="payment-method-info">
                            <p class="payment-method-title">محفظة Paymob</p>
                            <p class="payment-method-desc">الدفع عبر المحفظة الإلكترونية</p>
                        </div>
                        <span class="payment-method-check">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                        </span>
                    </label>

                    <label class="payment-method-card" id="methodCardCard">
                        <input type="radio" name="paymentMethod" value="PaymobCreditCard">
                        <div class="payment-method-icon payment-method-icon--card">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                                <line x1="1" y1="10" x2="23" y2="10"/>
                            </svg>
                        </div>
                        <div class="payment-method-info">
                            <p class="payment-method-title">بطاقة ائتمانية</p>
                            <p class="payment-method-desc">الدفع ببطاقة بنكية عبر Paymob</p>
                        </div>
                        <span class="payment-method-check">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                        </span>
                    </label>
                </div>

                <div id="walletPhoneBox" class="mt-3 text-start">
                    <label for="walletPhoneInput" class="form-label text-muted small mb-1">
                        <i class="bi bi-phone me-1"></i> رقم المحفظة (فودافون كاش / اتصالات / أورنج / وي):
                    </label>
                    <input type="tel" id="walletPhoneInput" class="form-control" placeholder="01xxxxxxxxx" dir="ltr" maxlength="11">
                    <small class="form-hint">(للتجربة في بيئة الاختبار يمكنك استخدام: 01010101010)</small>
                </div>

                <div class="modal-action-stack mt-4">
                    <button type="button" class="btn btn-primary" id="confirmPaymentMethodBtn">
                        <i class="bi bi-lock-fill me-1"></i> متابعة للدفع
                    </button>
                    <button type="button" class="btn-modal-dismiss-link" data-bs-dismiss="modal">
                        إلغاء
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Register-Required Modal (unauthenticated subscribe attempt) -->
<div class="modal fade" id="registerRequiredModal" tabindex="-1" aria-labelledby="registerRequiredModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom modal-subscribe-card">
            <div class="modal-card-accent-bar"></div>
            <button type="button" class="modal-close-corner" data-bs-dismiss="modal" aria-label="إغلاق">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
            <div class="modal-subscribe-body text-center">
                <div class="modal-premium-icon-box">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 21h18M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16M9 9h1m4 0h1m-6 4h1m4 0h1M9 17h6"/>
                    </svg>
                </div>
                <h3 class="modal-premium-title" id="registerRequiredModalLabel">إنشاء حساب عيادة للاشتراك</h3>
                <p class="modal-premium-subtitle">
                    للاشتراك وتفعيل باقة عيادتك، يمكنك إنشاء حساب عيادة جديد أو تسجيل الدخول إذا كنت تمتلك حساباً بالفعل.
                </p>
                <div class="modal-plan-summary" id="modalPlanSummary" hidden>
                    <div class="plan-summary-info">
                        <span class="plan-summary-tag">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            الباقة المحددة
                        </span>
                        <h4 class="plan-summary-name" id="modalPlanName"></h4>
                    </div>
                    <div class="plan-summary-pricing">
                        <span class="plan-summary-price-num" id="modalPlanPrice"></span>
                        <span class="plan-summary-price-curr">ج.م</span>
                        <span class="plan-summary-price-period" id="modalPlanPeriod">/ شهرياً</span>
                    </div>
                </div>
                <div class="modal-action-stack">
                    <a href="@HomeRoutes.Pages.ClinicRegister()" id="registerRequiredModalRegBtn" class="btn btn-primary">
                        <i class="bi bi-building-add me-1"></i> إنشاء حساب عيادة جديد
                    </a>
                    <a href="@HomeRoutes.Account.Login()" id="registerRequiredModalLoginBtn" class="btn btn-outline-primary">
                        <i class="bi bi-box-arrow-in-left me-1"></i> تسجيل الدخول للمتابعة
                    </a>
                    <button type="button" class="btn-modal-dismiss-link" data-bs-dismiss="modal">
                        إلغاء والمتابعة كتصفح
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var walletPhoneBox = document.getElementById('walletPhoneBox');
            document.querySelectorAll('input[name="paymentMethod"]').forEach(function(radio){
                radio.addEventListener('change', function(){
                    document.querySelectorAll('#paymentMethodModal .payment-method-card').forEach(function(c){ c.classList.remove('selected'); });
                    this.closest('.payment-method-card')?.classList.add('selected');
                    if (walletPhoneBox) {
                        walletPhoneBox.style.display = this.value === 'PaymobWallet' ? 'block' : 'none';
                    }
                });
            });
            document.querySelectorAll('#paymentMethodModal .payment-method-card').forEach(function(card){
                card.addEventListener('click', function(e){
                    if(e.target.closest('input')) return;
                    var r = this.querySelector('input[type="radio"]');
                    if(r && !r.checked){ r.checked = true; r.dispatchEvent(new Event('change', {bubbles:true})); }
                });
            });

            var toggle = document.getElementById('periodToggle');
            if (toggle) {
                toggle.addEventListener('change', function() {
                    var isYearly = this.checked;
                    document.querySelectorAll('#planCards .plan-card').forEach(function(card) {
                        var monthlyPrice = card.querySelector('.price-monthly');
                        var yearlyPrice = card.querySelector('.price-yearly');
                        var monthlyPeriod = card.querySelector('.period-monthly');
                        var yearlyPeriod = card.querySelector('.period-yearly');
                        if (monthlyPrice) monthlyPrice.classList.toggle('d-none', isYearly);
                        if (yearlyPrice) yearlyPrice.classList.toggle('d-none', !isYearly);
                        if (monthlyPeriod) monthlyPeriod.classList.toggle('d-none', isYearly);
                        if (yearlyPeriod) yearlyPeriod.classList.toggle('d-none', !isYearly);
                    });
                });
            }

            document.querySelectorAll('.btn-subscribe').forEach(function(btn) {
                btn.addEventListener('click', async function() {
                    var isAuthenticated = @(isAuthenticated ? "true" : "false");
                    var card = this.closest('.plan-card');
                    var planId = this.getAttribute('data-plan-id');
                    if (!planId && card) {
                        var select = card.querySelector('.plan-hidden-id');
                        planId = select ? select.value : '';
                    }
                    if (!planId) return;

                    var period = toggle && toggle.checked ? 1 : 0;
                    var planName = card ? (card.querySelector('.plan-name') ? card.querySelector('.plan-name').textContent.trim() : '') : '';
                    var priceMonthly = card && card.querySelector('.price-monthly') ? card.querySelector('.price-monthly').textContent.trim() : '';
                    var priceYearly = card && card.querySelector('.price-yearly') ? card.querySelector('.price-yearly').textContent.trim() : '';
                    var currentPrice = period === 1 ? (priceYearly || priceMonthly) : priceMonthly;
                    var periodLabel = period === 1 ? '/ سنوياً' : '/ شهرياً';

                    if (!isAuthenticated) {
                        var summaryEl = document.getElementById('modalPlanSummary');
                        var planNameEl = document.getElementById('modalPlanName');
                        var planPriceEl = document.getElementById('modalPlanPrice');
                        var planPeriodEl = document.getElementById('modalPlanPeriod');
                        var regBtn = document.getElementById('registerRequiredModalRegBtn');
                        var loginBtn = document.getElementById('registerRequiredModalLoginBtn');

                        if (summaryEl && planName) {
                            planNameEl.textContent = planName;
                            planPriceEl.textContent = currentPrice || '0';
                            planPeriodEl.textContent = periodLabel;
                            summaryEl.hidden = false;
                        }

                        try {
                            sessionStorage.setItem('clinic_register_plan', JSON.stringify({
                                id: planId,
                                name: planName,
                                period: period
                            }));
                        } catch (e) {}

                        if (regBtn) regBtn.href = '@HomeRoutes.Pages.ClinicRegister()';
                        if (loginBtn) loginBtn.href = '@HomeRoutes.Account.Login()' + '?returnUrl=' + encodeURIComponent('@ClinicRoutes.Pages.MySubscription()');

                        var modalEl = document.getElementById('registerRequiredModal');
                        if (modalEl) {
                            var requiredModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                            requiredModal.show();
                        }
                        return;
                    }

                    var planIdDisplay = planName || 'الباقة المختارة';
                    var subtitleEl = document.getElementById('paymentMethodModalSubtitle');
                    if (subtitleEl) {
                        subtitleEl.textContent = 'باقة ' + planIdDisplay + ' — ' + currentPrice + ' ج.م' + periodLabel;
                    }

                    var pmModalEl = document.getElementById('paymentMethodModal');
                    if (pmModalEl) {
                        var pmModal = bootstrap.Modal.getInstance(pmModalEl) || new bootstrap.Modal(pmModalEl);
                        pmModal.show();
                    }

                    var confirmBtn = document.getElementById('confirmPaymentMethodBtn');
                    if (confirmBtn && !confirmBtn.dataset.bound) {
                        confirmBtn.dataset.bound = '1';
                        confirmBtn.addEventListener('click', async function() {
                            var activePlanId = confirmBtn.dataset.planId || planId;
                            var activePeriod = parseInt(confirmBtn.dataset.period || period);
                            this.disabled = true;
                            this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>جارٍ التحويل للدفع...';
                            var selectedMethod = document.querySelector('input[name="paymentMethod"]:checked')?.value || 'PaymobWallet';
                            var walletPhone = document.getElementById('walletPhoneInput')?.value?.trim() || '';
                            if (selectedMethod === 'PaymobWallet' && !walletPhone) {
                                alert('يرجى إدخال رقم المحفظة الإلكترونية للمتابعة (للتجربة: 01010101010)');
                                this.disabled = false;
                                this.innerHTML = '<i class="bi bi-lock-fill me-1"></i> متابعة للدفع';
                                return;
                            }
                            try {
                                var currentUrl = window.location.href;
                                sessionStorage.setItem('prePaymentPage', currentUrl);
                                localStorage.setItem('prePaymentPage', currentUrl);
                                document.cookie = "prePaymentUrl=" + encodeURIComponent(currentUrl) + "; path=/; max-age=3600; SameSite=Lax";
                            } catch (e) {}
                            try {
                                var csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
                                var response = await fetch('/Clinic/InitiatePayment', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
                                    body: JSON.stringify({ planId: activePlanId, period: activePeriod, paymentMethod: selectedMethod, walletPhoneNumber: walletPhone })
                                });
                                var result = await response.json();
                                if (result && result.success && result.targetUrl) { window.location.href = result.targetUrl; }
                                else if (result && result.message) { alert(result.message); this.disabled = false; this.innerHTML = '<i class="bi bi-lock-fill me-1"></i> متابعة للدفع'; }
                                else { window.location.href = '@ClinicRoutes.Pages.Subscribe()' + '?planId=' + encodeURIComponent(activePlanId) + '&period=' + activePeriod + '&paymentMethod=' + encodeURIComponent(selectedMethod) + '&walletPhoneNumber=' + encodeURIComponent(walletPhone); }
                            } catch (err) {
                                window.location.href = '@ClinicRoutes.Pages.Subscribe()' + '?planId=' + encodeURIComponent(activePlanId) + '&period=' + activePeriod + '&paymentMethod=' + encodeURIComponent(selectedMethod) + '&walletPhoneNumber=' + encodeURIComponent(walletPhone);
                            }
                        });
                    }
                    if (confirmBtn) { confirmBtn.dataset.planId = planId; confirmBtn.dataset.period = period; }
                });
            });

            // Local search for plans
            var planSearch = document.getElementById('planSearch');
            if (planSearch) {
                planSearch.addEventListener('input', function() {
                    var q = this.value.toLowerCase().trim();
                    document.querySelectorAll('#planCards .plan-card').forEach(function(card) {
                        var txt = card.textContent.toLowerCase();
                        card.style.display = !q || txt.indexOf(q) !== -1 ? '' : 'none';
                    });
                });
            }
        })();
    </script>
}
