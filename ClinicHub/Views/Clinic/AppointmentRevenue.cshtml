@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "إيرادات المواعيد - Doctory";
    Layout = "_ClinicLayout";

    var revenues = ViewBag.Revenues as IReadOnlyCollection<AppointmentPaymentDto> ?? new List<AppointmentPaymentDto>();
    var stats = ViewBag.Stats as AppointmentRevenueStatsDto ?? new AppointmentRevenueStatsDto();

    int? statusFilter = ViewBag.StatusFilter;
    int? methodFilter = ViewBag.MethodFilter;

    string StatusLabel(int s) => s switch
    {
        0 => "معلقة",
        1 => "مدفوعة",
        2 => "فاشلة",
        3 => "مستردة",
        _ => "غير معروفة"
    };
    string StatusClass(int s) => s switch
    {
        0 => "badge-warning",
        1 => "badge-success",
        2 => "badge-danger",
        3 => "badge-secondary",
        _ => "badge-info"
    };
    string MethodLabel(int m) => m switch
    {
        0 => "نقداً",
        1 => "محفظة إلكترونية",
        2 => "بطاقة ائتمانية",
        _ => "غير معروفة"
    };
    string MethodClass(int m) => m switch { 0 => "badge-primary", 1 => "badge-warning", 2 => "badge-info", _ => "badge-secondary" };
}

<div class="page-header">
    <h2 class="page-title">
        <span class="page-title-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" fill="currentColor"/>
            </svg>
        </span>
        إيرادات المواعيد
    </h2>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-value">@stats.TodayRevenue.ToString("N0") ج.م</span>
            <span class="stat-label">إيرادات اليوم</span>
        </div>
        <div class="icon-wrapper icon-wrapper--green">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-value">@stats.MonthRevenue.ToString("N0") ج.م</span>
            <span class="stat-label">إيرادات الشهر</span>
        </div>
        <div class="icon-wrapper icon-wrapper--primary">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.55-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
            </svg>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-value">@stats.PaidTotal.ToString("N0") ج.م</span>
            <span class="stat-label">مدفوعات محصلة</span>
        </div>
        <div class="icon-wrapper icon-wrapper--blue">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
            </svg>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-value">@stats.PendingTotal.ToString("N0") ج.م</span>
            <span class="stat-label">مدفوعات معلقة</span>
        </div>
        <div class="icon-wrapper icon-wrapper--amber">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
            </svg>
        </div>
    </div>
</div>

<form method="get" action="@Url.Action("AppointmentRevenue")" class="filter-bar table-filter-bar">
    <select class="form-select" name="status" onchange="this.form.submit()">
        <option value="">جميع الحالات</option>
        <option value="0" selected="@(statusFilter == 0)">معلقة</option>
        <option value="1" selected="@(statusFilter == 1)">مدفوعة</option>
        <option value="3" selected="@(statusFilter == 3)">مستردة</option>
    </select>
    <select class="form-select" name="method" onchange="this.form.submit()">
        <option value="">جميع طرق الدفع</option>
        <option value="0" selected="@(methodFilter == 0)">نقداً</option>
        <option value="1" selected="@(methodFilter == 1)">محفظة إلكترونية</option>
        <option value="2" selected="@(methodFilter == 2)">بطاقة ائتمانية</option>
    </select>
    <a href="@Url.Action("AppointmentRevenue")" class="btn btn-outline-secondary btn-sm">مسح</a>
</form>

<div class="table-card">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>المريض</th>
                    <th>الطبيب</th>
                    <th>التاريخ</th>
                    <th>الوقت</th>
                    <th>المبلغ</th>
                    <th>طريقة الدفع</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody>
                @if (revenues.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-md text-center">لا توجد إيرادات مطابقة للفلاتر المحددة</td>
                    </tr>
                }
                @foreach (var rev in revenues)
                {
                    <tr>
                        <td class="text-md-medium">@rev.PatientName</td>
                        <td class="text-md">@rev.DoctorName</td>
                        <td class="text-md">@(rev.AppointmentDate.Year > 2000 ? rev.AppointmentDate.ToString("yyyy-MM-dd") : "—")</td>
                        <td class="text-md">@rev.StartTime</td>
                        <td class="text-md-medium">@rev.Amount.ToString("N0") ج.م</td>
                        <td><span class="badge @MethodClass(rev.Method)">@MethodLabel(rev.Method)</span></td>
                        <td><span class="badge @StatusClass(rev.Status)">@StatusLabel(rev.Status)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" />
</div>
