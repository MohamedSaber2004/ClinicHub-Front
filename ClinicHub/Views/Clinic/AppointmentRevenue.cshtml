@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "إيرادات المواعيد - Doctory";
    Layout = "_ClinicLayout";

    var revenues = ViewBag.Revenues as IReadOnlyCollection<AppointmentPaymentDto> ?? new List<AppointmentPaymentDto>();
    var stats = ViewBag.Stats as AppointmentRevenueStatsDto ?? new AppointmentRevenueStatsDto();

    int? statusFilter = ViewBag.StatusFilter;
    int? methodFilter = ViewBag.MethodFilter;

    string StatusLabel(int s) => s switch
    {
        0 => "معلقة",
        1 => "مدفوعة",
        2 => "فاشلة",
        3 => "مستردة",
        _ => "غير معروفة"
    };
    string StatusClass(int s) => s switch
    {
        0 => "badge-warning",
        1 => "badge-success",
        2 => "badge-danger",
        3 => "badge-secondary",
        _ => "badge-info"
    };
    string MethodLabel(int m) => m switch
    {
        0 => "نقداً",
        1 => "محفظة إلكترونية",
        2 => "بطاقة ائتمانية",
        _ => "غير معروفة"
    };
    string MethodClass(int m) => m switch { 0 => "badge-primary", 1 => "badge-warning", 2 => "badge-info", _ => "badge-secondary" };

    // Split-bar step chosen from the real gross/fee values delivered by the
    // backend. Widths are utility classes (cm-split-00 … cm-split-50) so the
    // view never emits an inline style.
    string SplitStep(decimal gross, decimal fee)
    {
        if (gross <= 0 || fee <= 0) return "cm-split-00";
        var pct = (int)Math.Round(fee * 100m / gross, MidpointRounding.AwayFromZero);
        if (pct <= 0) return "cm-split-00";
        if (pct >= 50) return "cm-split-50";
        var step = (int)Math.Round(pct / 5m, MidpointRounding.AwayFromZero) * 5;
        if (step < 5) step = 5;
        return "cm-split-" + step.ToString("00");
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/clinic-money.css?v=20261027_redesign_v2" />
}

<div class="page-header cm-page-head">
    <div>
        <h2 class="page-title">
            <span class="page-title-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" fill="currentColor"/>
                </svg>
            </span>
            إيرادات المواعيد
        </h2>
        <p class="page-header-subtitle">جميع المبالغ المعروضة هي صافي العيادة فقط من الحجوزات (بدون رسوم المنصة).</p>
    </div>
    <div class="page-header-actions">
        <a href="@Url.Action("Payouts")" class="btn btn-secondary btn-sm">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
            </svg>
            مستحقاتي والتحويلات
        </a>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card stat-card--info">
        <div class="stat-info">
            <span class="stat-value cm-money">@stats.TodayNet.ToString("N0") ج.م</span>
            <span class="stat-label">صافي إيرادات اليوم</span>
            @if (stats.TodayPlatformFees is > 0)
            {
                <span class="stat-subtext cm-money cm-stat-sub">رسوم المنصة: @stats.TodayPlatformFees.Value.ToString("N0") ج.م</span>
            }
        </div>
        <div class="icon-wrapper icon-wrapper--green">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
        </div>
    </div>
    <div class="stat-card stat-card--info">
        <div class="stat-info">
            <span class="stat-value cm-money">@stats.MonthNet.ToString("N0") ج.م</span>
            <span class="stat-label">صافي إيرادات الشهر</span>
            @if (stats.MonthPlatformFees is > 0)
            {
                <span class="stat-subtext cm-money cm-stat-sub">رسوم المنصة: @stats.MonthPlatformFees.Value.ToString("N0") ج.م</span>
            }
        </div>
        <div class="icon-wrapper icon-wrapper--primary">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.55-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
            </svg>
        </div>
    </div>
    <div class="stat-card stat-card--brass">
        <div class="stat-info">
            <span class="stat-value cm-money">@stats.PaidNet.ToString("N0") ج.م</span>
            <span class="stat-label">صافي مدفوعات محصلة</span>
            @if (stats.PaidPlatformFees is > 0)
            {
                <span class="stat-subtext cm-money cm-stat-sub">رسوم المنصة: @stats.PaidPlatformFees.Value.ToString("N0") ج.م</span>
            }
        </div>
        <div class="icon-wrapper icon-wrapper--brass">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
            </svg>
        </div>
    </div>
    <div class="stat-card stat-card--warning">
        <div class="stat-info">
            <span class="stat-value cm-money">@stats.PendingNet.ToString("N0") ج.م</span>
            <span class="stat-label">صافي مدفوعات معلقة</span>
            @if (stats.PendingPlatformFees is > 0)
            {
                <span class="stat-subtext cm-money cm-stat-sub">رسوم المنصة: @stats.PendingPlatformFees.Value.ToString("N0") ج.م</span>
            }
        </div>
        <div class="icon-wrapper icon-wrapper--amber">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
            </svg>
        </div>
    </div>
</div>

<form method="get" action="@Url.Action("AppointmentRevenue")" class="filter-bar table-filter-bar">
    <select class="form-select" name="status" onchange="this.form.submit()">
        <option value="">جميع الحالات</option>
        <option value="0" selected="@(statusFilter == 0)">معلقة</option>
        <option value="1" selected="@(statusFilter == 1)">مدفوعة</option>
        <option value="3" selected="@(statusFilter == 3)">مستردة</option>
    </select>
    <select class="form-select" name="method" onchange="this.form.submit()">
        <option value="">جميع طرق الدفع</option>
        <option value="0" selected="@(methodFilter == 0)">نقداً</option>
        <option value="1" selected="@(methodFilter == 1)">محفظة إلكترونية</option>
        <option value="2" selected="@(methodFilter == 2)">بطاقة ائتمانية</option>
    </select>
    <a href="@Url.Action("AppointmentRevenue")" class="btn btn-outline-secondary btn-sm">مسح</a>
</form>

<div class="table-card cm-list-card">
    <div class="table-card-header cm-ledger-head">
        <h3 class="table-card-title">كشف إيرادات الحجوزات</h3>
        <div class="table-card-actions">
            @if (revenues.Count > 0)
            {
                <span class="badge badge-info">@revenues.Count سجل</span>
            }
            else
            {
                <span class="badge badge-secondary">—</span>
            }
        </div>
    </div>
    <div class="table-responsive">
        <table class="custom-table cm-ledger">
            <thead>
                <tr>
                    <th>المريض</th>
                    <th>الطبيب</th>
                    <th>التاريخ</th>
                    <th>الوقت</th>
                    <th>صافي العيادة</th>
                    <th>طريقة الدفع</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody>
                @if (revenues.Count == 0)
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state cm-empty-row">
                                <p>لا توجد إيرادات مطابقة للفلاتر المحددة</p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var rev in revenues)
                {
                    var fee = rev.PlatformFee ?? 0;
                    var showSplit = rev.PlatformFee.HasValue && rev.PlatformFee.Value > 0 && rev.Amount > 0;
                    <tr>
                        <td class="text-md-medium">@rev.PatientName</td>
                        <td class="text-md">@rev.DoctorName</td>
                        <td class="text-md cm-money">@(rev.AppointmentDate.Year > 2000 ? rev.AppointmentDate.ToString("yyyy-MM-dd") : "—")</td>
                        <td class="text-md cm-money">@rev.StartTime</td>
                        <td class="text-md-medium">
                            <span class="cm-money">@rev.NetAmount.ToString("N0") ج.م</span>
                            @if (showSplit)
                            {
                                <div class="cm-split @SplitStep(rev.Amount, fee)">
                                    <div class="cm-split-bar" role="img"
                                         aria-label="الإجمالي @rev.Amount.ToString("N0") ج.م، صافي العيادة @rev.NetAmount.ToString("N0") ج.م، رسوم المنصة @fee.ToString("N0") ج.م">
                                        <span class="cm-split-seg cm-split-seg--net"></span>
                                        <span class="cm-split-seg cm-split-seg--fee"></span>
                                    </div>
                                    <div class="cm-split-legend">
                                        <span class="cm-split-key cm-split-key--net">صافي العيادة <span class="cm-money cm-money--sm">@rev.NetAmount.ToString("N0")</span></span>
                                        <span class="cm-split-key cm-split-key--fee">رسوم المنصة <span class="cm-money cm-money--sm">@fee.ToString("N0")</span></span>
                                        <span class="cm-split-key cm-split-key--gross">الإجمالي <span class="cm-money cm-money--sm">@rev.Amount.ToString("N0")</span></span>
                                    </div>
                                </div>
                            }
                        </td>
                        <td><span class="badge badge--dot @MethodClass(rev.Method)">@MethodLabel(rev.Method)</span></td>
                        <td><span class="badge badge--dot @StatusClass(rev.Status)">@StatusLabel(rev.Status)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" />
</div>

<p class="cm-foot-note">ملاحظة: المبلغ في كل صف هو صافي مستحقات العيادة من الحجز فقط، ولا يشمل رسوم المنصة الخاصة بالإدارة.</p>
