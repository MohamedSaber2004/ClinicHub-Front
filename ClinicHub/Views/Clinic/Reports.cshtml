@{
    ViewData["Title"] = "التقارير التشغيلية - Doctory";
    Layout = "_ClinicLayout";

    var selectedPeriod = ViewBag.SelectedPeriod as string ?? "week";
    var selectedDoctorId = ViewBag.SelectedDoctorId as Guid?;
    var report = ViewBag.Report as ClinicOperationalReportDto ?? new ClinicOperationalReportDto();
    var clinicDoctors = ViewBag.ClinicDoctors as List<DoctorDto> ?? new List<DoctorDto>();

    string StatusLabel(int s) => s switch
    {
        0 => "معلق",
        1 => "مؤكد",
        2 => "ملغي",
        3 => "مكتمل",
        4 => "محجوز",
        5 => "لم يحضر",
        6 => "مقبول",
        7 => "مرفوض",
        _ => "-"
    };

    string StatusClass(int s) => s switch
    {
        3 => "badge-success",
        2 or 7 or 5 => "badge-danger",
        0 or 1 or 4 or 6 => "badge-info",
        _ => "badge-subtle"
    };

    int Nearest5(double v) => Math.Clamp((int)Math.Round(v / 5.0) * 5, 5, 100);
}

<div class="page-header">
    <h2 class="page-title">
        <span class="page-title-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
            </svg>
        </span>
        التقارير التشغيلية ومؤشرات الأداء
    </h2>
    <div class="reports-header-actions print-hide">
        <button type="button" class="btn btn-outline" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> طباعة التقرير
        </button>
    </div>
</div>

<!-- Quick Period & Filter Toolbar -->
<div class="period-pills-bar print-hide">
    <div class="period-pills">
        <a href="/Clinic/Reports?period=today" class="period-pill @(selectedPeriod == "today" ? "active" : "")">
            <i class="bi bi-calendar-event"></i> اليوم
        </a>
        <a href="/Clinic/Reports?period=week" class="period-pill @(selectedPeriod == "week" ? "active" : "")">
            <i class="bi bi-calendar-week"></i> هذا الأسبوع
        </a>
        <a href="/Clinic/Reports?period=month" class="period-pill @(selectedPeriod == "month" ? "active" : "")">
            <i class="bi bi-calendar-month"></i> هذا الشهر
        </a>
        <a href="/Clinic/Reports?period=last30" class="period-pill @(selectedPeriod == "last30" ? "active" : "")">
            <i class="bi bi-clock-history"></i> آخر 30 يوم
        </a>
    </div>

    @if (clinicDoctors.Count > 0)
    {
        <div class="reports-filters-group">
            <select class="form-select" onchange="window.location = '/Clinic/Reports?period=@selectedPeriod' + (this.value ? '&doctorId=' + this.value : '')">
                <option value="">جميع الأطباء</option>
                @foreach (var d in clinicDoctors)
                {
                    <option value="@d.Id" selected="@(selectedDoctorId == d.Id)">@d.UserName (@d.SpecializationName)</option>
                }
            </select>
        </div>
    }
</div>

<!-- Operational KPI Statistics Grid -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-value">@report.TotalAppointments</span>
            <span class="stat-label">إجمالي المواعيد المحجوزة</span>
            <div class="stat-subtext">
                <span class="badge badge-info"><i class="bi bi-calendar-check me-1"></i>فترة التقرير</span>
            </div>
        </div>
        <div class="icon-wrapper icon-wrapper--blue">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM9 14H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2zm-8 4H7v-2h2v2zm4 4h-2v-2h2v2zm4 0h-2v-2h2v2z"/>
            </svg>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-value">@report.CompletedVisits</span>
            <span class="stat-label">الزيارات المكتملة</span>
            <div class="stat-subtext">
                <span class="badge badge-success"><i class="bi bi-check-circle me-1"></i>@report.CompletionRate% معدل الإنجاز</span>
            </div>
        </div>
        <div class="icon-wrapper icon-wrapper--green">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-value">@report.CancelledVisits</span>
            <span class="stat-label">الإلغاءات وعدم الحضور</span>
            <div class="stat-subtext">
                <span class="badge badge-warning">@report.CancelledVisits ملغى (@report.CancellationRate%)</span>
                <span class="badge badge-danger">@report.NoShowVisits غياب (@report.NoShowRate%)</span>
            </div>
        </div>
        <div class="icon-wrapper icon-wrapper--amber">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
            </svg>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-value">@report.PeriodRevenue.ToString("N0") ج.م</span>
            <span class="stat-label">إيرادات الفترة</span>
            <div class="stat-subtext">
                <span class="badge badge-primary"><i class="bi bi-cash-stack me-1"></i>مدفوعات محصّلة</span>
            </div>
        </div>
        <div class="icon-wrapper icon-wrapper--primary">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
            </svg>
        </div>
    </div>
</div>

<!-- Visual Analytics Grid (Pure CSS Visualization) -->
<div class="reports-analytics-grid">
    <!-- Card 1: Attendance & Compliance -->
    <div class="analytics-card">
        <div class="analytics-card-header">
            <h3 class="analytics-card-title">
                <i class="bi bi-pie-chart text-success"></i>
                معدلات الحضور والالتزام
            </h3>
            <span class="badge badge-success analytics-card-badge">نسب التوزيع</span>
        </div>
        <p class="text-muted mb-2 fs-sm">توزيع حالات المواعيد المحجوزة خلال الفترة المحددة</p>

        @{
            var completedCls = Nearest5(report.CompletionRate);
            var cancelledCls = Nearest5(report.CancellationRate);
            var noShowRaw = Math.Max(0, 100 - report.CompletionRate - report.CancellationRate);
            var noShowCls = Nearest5(noShowRaw);
        }
        <div class="metric-bar-wrapper">
            <div class="metric-bar-track">
                @if (report.CompletionRate > 0)
                {
                    <div class="metric-bar-segment metric-bar-segment--success w-pct-@completedCls" title="مكتملة: @report.CompletionRate%"></div>
                }
                @if (report.CancellationRate > 0)
                {
                    <div class="metric-bar-segment metric-bar-segment--warning w-pct-@cancelledCls" title="ملغاة: @report.CancellationRate%"></div>
                }
                @if (noShowRaw > 0)
                {
                    <div class="metric-bar-segment metric-bar-segment--danger w-pct-@noShowCls" title="عدم حضور: @report.NoShowRate%"></div>
                }
            </div>
        </div>

        <div class="metric-legend">
            <div class="metric-legend-item">
                <div class="metric-legend-info">
                    <span class="metric-legend-dot metric-legend-dot--success"></span>
                    <span>حضور وزيارات مكتملة</span>
                </div>
                <span class="metric-legend-val">@report.CompletedVisits زيارة (@report.CompletionRate%)</span>
            </div>
            <div class="metric-legend-item">
                <div class="metric-legend-info">
                    <span class="metric-legend-dot metric-legend-dot--warning"></span>
                    <span>مواعيد ملغاة مسبقاً</span>
                </div>
                <span class="metric-legend-val">@report.CancelledVisits موعد (@report.CancellationRate%)</span>
            </div>
            <div class="metric-legend-item">
                <div class="metric-legend-info">
                    <span class="metric-legend-dot metric-legend-dot--danger"></span>
                    <span>غياب دون إخطار (No-Show)</span>
                </div>
                <span class="metric-legend-val">@report.NoShowVisits موعد (@report.NoShowRate%)</span>
            </div>
        </div>
    </div>

    <!-- Card 2: Peak Hours & Hourly Volume -->
    <div class="analytics-card">
        <div class="analytics-card-header">
            <h3 class="analytics-card-title">
                <i class="bi bi-bar-chart-line text-primary"></i>
                ساعات الذروة وكثافة الزيارات
            </h3>
            <span class="badge badge-primary analytics-card-badge">الذروة: @report.PeakTimeSlot</span>
        </div>
        <p class="text-muted mb-2 fs-sm">توزيع تدفق المرضى على الفترات الزمنية للعيادة</p>

        <div class="css-bar-chart">
            @foreach (var slot in report.HourlyTraffic)
            {
                var hPct = Nearest5(slot.HeightPercentage);

                <div class="css-bar-column @(slot.IsPeak ? "is-peak" : "")">
                    @if (slot.IsPeak)
                    {
                        <span class="peak-indicator">ذروة</span>
                    }
                    <span class="css-bar-value">@slot.AppointmentCount</span>
                    <div class="css-bar-track">
                        @if (slot.AppointmentCount > 0)
                        {
                            <div class="css-bar-fill h-pct-@hPct" title="@slot.SlotLabel: @slot.AppointmentCount موعد"></div>
                        }
                    </div>
                    <span class="css-bar-label">@slot.SlotLabel</span>
                </div>
            }
        </div>
    </div>

    <!-- Card 3: Weekly Workload & Capacity -->
    <div class="analytics-card">
        <div class="analytics-card-header">
            <h3 class="analytics-card-title">
                <i class="bi bi-calendar-check text-amber"></i>
                توزيع الأحمال اليومية
            </h3>
            <span class="badge badge-warning analytics-card-badge">اليوم الأكثر إشغالاً: @report.BusiestDayName</span>
        </div>
        <p class="text-muted mb-3 fs-sm">نسب الإشغال والتشغيل عبر أيام الأسبوع</p>

        <div class="workload-list">
            @foreach (var day in report.WeeklyWorkload)
            {
                var wPct = Nearest5(day.CapacityPercentage);
                var wVariant = day.CapacityPercentage >= 90 ? "workload-bar-fill--peak"
                    : day.CapacityPercentage >= 70 ? "workload-bar-fill--high"
                    : "workload-bar-fill--normal";
                var statusText = day.CapacityPercentage >= 90 ? "مزدحم" : day.CapacityPercentage >= 70 ? "متوازن" : "هادئ";
                var statusClass = day.CapacityPercentage >= 90 ? "badge-danger" : day.CapacityPercentage >= 70 ? "badge-success" : "badge-info";

                <div class="workload-item">
                    <div class="workload-item-header">
                        <span class="workload-day">@day.DayName</span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="workload-count">@day.CompletedVisits من @day.TotalAppointments موعد</span>
                            <span class="badge @statusClass">@statusText</span>
                        </div>
                    </div>
                    <div class="workload-bar-track">
                        <div class="workload-bar-fill @wVariant w-pct-@wPct"></div>
                    </div>
                </div>
            }
            @if (report.WeeklyWorkload.Count == 0)
            {
                <p class="text-muted">لا توجد مواعيد في هذه الفترة.</p>
            }
        </div>
    </div>
</div>

<!-- Doctor Operational Performance Table -->
<div class="table-card mb-5">
    <div class="analytics-card-header">
        <h3 class="analytics-card-title">
            <i class="bi bi-person-workspace text-primary"></i>
            تقرير إنتاجية وأداء أطباء العيادة
        </h3>
        <span class="text-muted fs-sm">إجمالي @report.Doctors.Count أطباء نشطين</span>
    </div>

    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>الطبيب</th>
                    <th>التخصص</th>
                    <th>إجمالي المواعيد</th>
                    <th>الزيارات المكتملة</th>
                    <th>الملغاة / غياب</th>
                    <th>التقييم</th>
                    <th>حالة التشغيل</th>
                </tr>
            </thead>
            <tbody>
                @{ var rowIndex = 0; }
                @foreach (var doc in report.Doctors.OrderByDescending(d => d.TotalAppointments))
                {
                    rowIndex++;
                    var progPct = Nearest5(doc.CompletionPercentage);
                    var workloadStatus = doc.TotalAppointments == 0 ? "خامل"
                        : doc.CompletionPercentage >= 80 ? "متميز"
                        : doc.CompletionPercentage >= 50 ? "نشط"
                        : "يحتاج متابعة";
                    var workloadBadge = doc.TotalAppointments == 0 ? "badge-subtle"
                        : doc.CompletionPercentage >= 80 ? "badge-success"
                        : doc.CompletionPercentage >= 50 ? "badge-info"
                        : "badge-warning";

                    <tr>
                        <td>@rowIndex</td>
                        <td>
                            <div class="user-avatar-cell">
                                <div class="avatar avatar--sm bg-primary text-white">@doc.Name.Substring(0, 1)</div>
                                <span class="user-name">@doc.Name</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge badge-info">@doc.Specialty</span>
                        </td>
                        <td>
                            <span class="fw-bold font-data">@doc.TotalAppointments</span>
                        </td>
                        <td>
                            <div class="table-progress">
                                <span class="table-progress-val">@doc.CompletedVisits</span>
                                <div class="table-progress-track">
                                    <div class="table-progress-fill w-pct-@progPct"></div>
                                </div>
                                <span class="text-muted fs-sm font-data">@doc.CompletionPercentage%</span>
                            </div>
                        </td>
                        <td>
                            <span class="text-warning font-data">@doc.CancelledCount ملغى</span> /
                            <span class="text-danger font-data">@doc.NoShowCount غياب</span>
                        </td>
                        <td>
                            @if (doc.ReviewCount > 0)
                            {
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-star-fill text-amber fs-sm"></i>
                                    <span class="fw-bold font-data">@doc.Rating.ToString("0.0")</span>
                                    <span class="text-muted fs-sm">(@doc.ReviewCount)</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fs-sm">-</span>
                            }
                        </td>
                        <td>
                            <span class="badge @workloadBadge">@workloadStatus</span>
                        </td>
                    </tr>
                }
                @if (report.Doctors.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted">لا يوجد أطباء لعرضهم.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Operational Flow & Traffic Log -->
<div class="table-card">
    <div class="analytics-card-header">
        <h3 class="analytics-card-title">
            <i class="bi bi-card-checklist text-primary"></i>
            سجل حركة الزيارات خلال فترة التقرير
        </h3>
        <span class="text-muted fs-sm"><i class="bi bi-clock me-1"></i>@report.RecentVisits.Count حركة</span>
    </div>

    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>المريض</th>
                    <th>الطبيب المعالج</th>
                    <th>التخصص</th>
                    <th>موعد الحجز</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody>
                @{ var logIndex = 0; }
                @foreach (var log in report.RecentVisits)
                {
                    logIndex++;
                    <tr>
                        <td>@logIndex</td>
                        <td>
                            <div class="user-avatar-cell">
                                <div class="avatar avatar--sm bg-secondary text-white">@(log.PatientName.Length > 0 ? log.PatientName.Substring(0, 1) : "-")</div>
                                <span class="user-name">@log.PatientName</span>
                            </div>
                        </td>
                        <td>
                            <span class="fw-semibold">@log.DoctorName</span>
                        </td>
                        <td>
                            <span class="badge badge-subtle">@log.Specialty</span>
                        </td>
                        <td>
                            <span class="font-data">@log.AppointmentDate.ToString("yyyy-MM-dd") - @log.StartTime.ToString(@"hh\:mm")</span>
                        </td>
                        <td>
                            <span class="badge @StatusClass((int)log.Status)">@StatusLabel((int)log.Status)</span>
                        </td>
                    </tr>
                }
                @if (report.RecentVisits.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted">لا توجد زيارات مسجلة في هذه الفترة.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
