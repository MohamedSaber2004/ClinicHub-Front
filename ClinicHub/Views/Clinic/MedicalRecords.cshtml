                    <td>
                        <div class="table-actions">
                            <button class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i> عرض
                            </button>
                            <button class="btn btn-sm btn-primary">
                                <i class="bi bi-pencil me-1"></i> تعديل
                            </button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>#EMR-1754</td>
                    <td><strong>سارة أحمد</strong></td>
                    <td>26 سنة</td>
                    <td>أمس</td>
                    <td>حساسية جلدية شديدة</td>
                    <td><span class="badge badge-success"><i class="bi bi-file-earmark-check me-1"></i> نشطة - 3 أدوية</span></td>
                    <td>
                        <div class="table-actions">
                            <button class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i> عرض
                            </button>
                            <button class="btn btn-sm btn-primary">
                                <i class="bi bi-pencil me-1"></i> تعديل
                            </button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
