@{
    ViewData["Title"] = "السجل الطبي الإلكتروني (EMR) - Doctory";
    Layout = "_ClinicLayout";
}

<div class="page-header">
    <h2 class="page-title mb-0">السجل الطبي الإلكتروني (EMR)</h2>
    <button class="btn btn-primary">
        <i class="bi bi-file-earmark-medical me-1"></i> إنشاء سجل جديد
    </button>
</div>

<!-- Search Panel -->
<div class="table-card p-4 mb-4">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">بحث عن مريض (بالاسم، الرقم القومي، أو رقم الموبايل)</label>
            <input type="text" class="form-input form-input-sm w-100" placeholder="أدخل اسم المريض للبحث..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">العيادة</label>
            <select class="form-select form-input-sm w-100">
                <option value="">جميع العيادات</option>
                <option>عيادة القلب</option>
                <option>عيادة الأعصاب</option>
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-secondary w-100">
                <i class="bi bi-funnel me-1"></i> تصفية النتائج
            </button>
        </div>
    </div>
</div>

<!-- EMR Patients List -->
<div class="table-card p-5">
    <div class="table-card-header">
        <h3 class="table-card-title">سجلات المرضى النشطة</h3>
    </div>

    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>رقم السجل</th>
                    <th>المريض</th>
                    <th>العمر</th>
                    <th>آخر زيارة</th>
                    <th>التشخيص الأخير</th>
                    <th>الروشتة الإلكترونية (e-Rx)</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>#EMR-2041</td>
                    <td><strong>عزير بن محمد</strong></td>
                    <td>45 سنة</td>
                    <td>اليوم، 10:00 ص</td>
                    <td>ارتفاع طفيف في ضغط الدم</td>
                    <td><span class="badge badge-success"><i class="bi bi-file-earmark-check me-1"></i> نشطة - 2 دواء</span></td>
                    <td>
                        <div class="table-actions">
                            <button class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i> عرض
                            </button>
                            <button class="btn btn-sm btn-primary">
                                <i class="bi bi-pencil me-1"></i> تعديل
                            </button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>#EMR-1985</td>
                    <td><strong>حارس عبد الكريم</strong></td>
                    <td>34 سنة</td>
                    <td>اليوم، 11:30 ص</td>
                    <td>صداع نصفي متكرر</td>
                    <td><span class="badge badge-success"><i class="bi bi-file-earmark-check me-1"></i> نشطة - 1 دواء</span></td>
                    <td>
                        <div class="table-actions">
                            <button class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i> عرض
                            </button>
                            <button class="btn btn-sm btn-primary">
                                <i class="bi bi-pencil me-1"></i> تعديل
                            </button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>#EMR-1892</td>
                    <td><strong>حمزة الرفاعي</strong></td>
                    <td>29 سنة</td>
                    <td>اليوم، 12:15 م</td>
                    <td>متابعة دورية</td>
