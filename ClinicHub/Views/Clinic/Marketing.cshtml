@using ClinicHub.Data
@using ClinicHub.Services.ReponseModels
@using ClinicHub.Services.Options
@inject Microsoft.Extensions.Options.IOptions<Doctory> _doctoryOptions
@{
    ViewData["Title"] = "الخدمات الإعلانية - Doctory";
    Layout = "_ClinicLayout";
    var attachmentBaseUrl = _doctoryOptions.Value.BaseUrl.TrimEnd('/');
    var ads = ViewBag.Ads as IReadOnlyCollection<AdDto> ?? new List<AdDto>();
    var packages = ViewBag.Packages as IReadOnlyCollection<AdPackageDto> ?? new List<AdPackageDto>();
    var currentUser = ViewBag.CurrentUser as CurrentUserContext;

    string GetStatusText(int status) => status switch
    {
        0 => "معلق الدفع",
        1 => "نشط",
        2 => "منتهي",
        3 => "معطل",
        _ => "غير معروف"
    };

    string GetStatusClass(int status) => status switch
    {
        0 => "badge-warning",
        1 => "badge-success",
        2 => "badge-info",
        3 => "badge-danger",
        _ => "badge-info"
    };
}

<div class="page-header">
    <h2 class="page-title">
        <span class="page-title-icon">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12zM7 9h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z"/>
            </svg>
        </span>
        الخدمات الإعلانية
    </h2>
    <div class="page-header-actions">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#buyAdModal">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
            </svg>
            شراء إعلان جديد
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

@if (packages.Count > 0)
{
    <div class="packages-row">
        @foreach (var pkg in packages)
        {
            <div class="package-mini-card">
                <div class="package-mini-name">@(pkg.NameAr ?? pkg.Name)</div>
                <div class="package-mini-desc">@(pkg.DescriptionAr ?? pkg.Description)</div>
                <div class="package-mini-price">@pkg.Price.ToString("N2") ج.م / @pkg.DurationDays يوم</div>
            </div>
        }
    </div>
}

<!-- Patient App Preview -->
<div class="table-card ad-preview-card">
    <div class="table-card-header">
        <h3 class="table-card-title">
            <span class="subtitle-icon">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"/>
                </svg>
            </span>
            معاينة الإعلان في تطبيق المرضى
        </h3>
        <p class="ad-preview-hint">هكذا يظهر إعلانك للمرضى في تطبيق الجوال (كصورة أو شارة). الإعلانات النشطة فقط تظهر للجميع.</p>
    </div>

    @{
        var activeAds = ads.Where(a => a.Status == 1).ToList();
    }
    <div id="adsPreviewContainer">
    @if (activeAds.Count == 0)
    {
        <div class="ad-preview-empty">
            <p>لا توجد إعلانات نشطة حالياً. بمجرد شراء إعلان وتأكيد الدفع سيظهر هنا وفي تطبيق المرضى.</p>
        </div>
    }
    else
    {
        <div class="ad-preview-grid">
            @foreach (var ad in activeAds)
            {
                <div class="ad-preview-item">
                    <div class="ad-preview-visual">
                        @if (!string.IsNullOrWhiteSpace(ad.ImageUrl))
                        {
                            <img class="ad-preview-img" src="@(attachmentBaseUrl)/files/@ad.ImageUrl" alt="@ad.ClinicName" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <span class="ad-preview-initial">@(string.IsNullOrWhiteSpace(ad.ClinicName) ? "ع" : ad.ClinicName.Substring(0, 1))</span>
                        }
                    </div>
                    <div class="ad-preview-body">
                        <span class="ad-preview-name">@ad.ClinicName</span>
                        <span class="ad-preview-meta">@ad.PackageNameAr</span>
                        <span class="ad-preview-period">@(ad.StartDate?.ToString("yyyy-MM-dd") ?? "-") → @(ad.EndDate?.ToString("yyyy-MM-dd") ?? "-")</span>
                    </div>
                    <span class="badge badge-success">نشط</span>
                </div>
            }
        </div>
    }
    </div>
</div>

<!-- My Ads -->
<div class="table-card">
    <div class="table-card-header">
        <h3 class="table-card-title">
            <span class="subtitle-icon">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
                </svg>
            </span>
            إعلاناتي
        </h3>
        <div class="table-card-actions" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <div class="ads-search-wrap" style="min-width:180px;flex:1;max-width:280px">
                <svg class="ads-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" id="marketingAdsSearch" class="form-input form-input-sm" placeholder="بحث في إعلاناتي..." style="padding-right:32px" />
            </div>
            <button type="button" class="btn btn-secondary btn-sm" id="refreshAdsBtn" onclick="refreshAds()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.65 6.35A7.95 7.95 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                </svg>
                تحديث الحالة
            </button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>الباقة</th>
                    <th>المدة</th>
                    <th>المبلغ</th>
                    <th>بداية</th>
                    <th>نهاية</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody id="adsTableBody">
                @if (ads.Count == 0)
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <p>لا توجد إعلانات بعد. ابدأ بشراء إعلانك الأول لظهور عيادتك في التطبيق.</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var ad in ads)
                    {
                        <tr>
                            <td class="text-md-medium">@ad.PackageNameAr</td>
                            <td class="text-md">@ad.DurationDays يوم</td>
                            <td class="text-md">@ad.Amount.ToString("N2") ج.م</td>
                            <td class="text-md">@(ad.StartDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td class="text-md">@(ad.EndDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td><span class="badge @GetStatusClass(ad.Status)">@GetStatusText(ad.Status)</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Buy Ad Modal -->
<!-- Payment Method Selection Modal (Ads) -->
<div class="modal fade" id="paymentMethodAdModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <div class="modal-header-custom">
                <h5 class="modal-title">اختر طريقة الدفع</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body-custom">
                <div class="payment-methods-grid">
                    <label class="payment-method-card selected" id="adMethodWalletCard">
                        <input type="radio" name="adPaymentMethod" value="PaymobWallet" checked>
                        <div class="payment-method-icon payment-method-icon--wallet">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.66 0 3-4.03 3-9s-1.34-9-3-9m0 18c-1.66 0-3-4.03-3-9s1.34-9 3-9m-9 9a9 9 0 019-9"/>
                            </svg>
                        </div>
                        <div class="payment-method-info">
                            <p class="payment-method-title">محفظة Paymob</p>
                            <p class="payment-method-desc">الدفع عبر المحفظة الإلكترونية</p>
                        </div>
                        <span class="payment-method-check">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                        </span>
                    </label>

                    <label class="payment-method-card" id="adMethodCardCard">
                        <input type="radio" name="adPaymentMethod" value="PaymobCreditCard">
                        <div class="payment-method-icon payment-method-icon--card">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                                <line x1="1" y1="10" x2="23" y2="10"/>
                            </svg>
                        </div>
                        <div class="payment-method-info">
                            <p class="payment-method-title">بطاقة ائتمانية</p>
                            <p class="payment-method-desc">الدفع ببطاقة بنكية عبر Paymob</p>
                        </div>
                        <span class="payment-method-check">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                        </span>
                    </label>
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="adConfirmPaymentMethodBtn">متابعة للدفع</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="buyAdModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-content-custom">
            <div class="modal-header-custom">
                <h5 class="modal-title">شراء إعلان جديد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body-custom">
                @if (packages.Count == 0)
                {
                    <div class="empty-state"><p>لا توجد باقات متاحة حالياً. حاول لاحقاً.</p></div>
                }
                else
                {
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">الباقة</label>
                                <select id="buyPackage" class="form-select" onchange="onBuyPackageChange()">
                                    <option value="">اختر الباقة</option>
                                    @foreach (var pkg in packages)
                                    {
                                        <option value="@pkg.Id" data-duration="@pkg.DurationDays" data-price="@pkg.Price">@(pkg.NameAr ?? pkg.Name) (@pkg.DurationDays يوم)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">المدة (أيام)</label>
                                <select id="buyDuration" class="form-select" onchange="updateBuyPrice()" disabled>
                                    <option value="">اختر المدة</option>
                                </select>
                                <p class="form-hint">المدة تكون مضاعفاً صحيحاً لمدة الباقة.</p>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">السعر المقدر</label>
                        <input type="text" id="buyPrice" class="form-input" readonly placeholder="0.00 ج.م" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">شعار الإعلان <span class="text-muted">(اختياري)</span></label>
                        <div class="ad-logo-upload">
                            <label class="btn btn-secondary btn-sm" for="adLogoInput">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                                </svg>
                                اختيار شعار
                            </label>
                            <input type="file" id="adLogoInput" class="d-none" accept="image/*" onchange="onAdLogoChange()" />
                            <img id="adLogoPreview" class="ad-logo-preview d-none" alt="شعار الإعلان" />
                            <button type="button" class="btn btn-sm btn-danger d-none" id="adLogoRemoveBtn" onclick="onAdLogoRemove()">إزالة</button>
                            <span id="adLogoStatus" class="form-hint"></span>
                        </div>
                        <p class="form-hint">الشعار سيظهر داخل إعلانك في تطبيق المرضى. إذا لم ترفع شعاراً سيظهر اسم العيادة بدلاً منه.</p>
                    </div>
                    <p class="form-hint">يتم الدفع عبر بوابة Paymob، ويظهر إعلانك فور اكتمال الدفع.</p>
                }
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="buySubmitBtn">إتمام الطلب والدفع</button>
            </div>
        </div>
    </div>
</div>

    @section Scripts {
    <script>
        // Fix: wallet/credit toggle visual feedback
        document.querySelectorAll('input[name="adPaymentMethod"]').forEach(function(radio){
            radio.addEventListener('change', function(){
                document.querySelectorAll('#paymentMethodAdModal .payment-method-card').forEach(function(c){ c.classList.remove('selected'); });
                this.closest('.payment-method-card')?.classList.add('selected');
            });
        });
        document.querySelectorAll('#paymentMethodAdModal .payment-method-card').forEach(function(card){
            card.addEventListener('click', function(e){
                if(e.target.closest('input')) return;
                var r = this.querySelector('input[type="radio"]');
                if(r && !r.checked){ r.checked = true; r.dispatchEvent(new Event('change', {bubbles:true})); }
            });
        });

        var MAX_DURATION_MULTIPLES = 12;

        function fillDurationOptions(opt) {
            var durationSelect = document.getElementById('buyDuration');
            durationSelect.innerHTML = '';
            if (!opt || !opt.value) {
                durationSelect.disabled = true;
                document.getElementById('buyPrice').value = '';
                return;
            }
            var baseDays = parseInt(opt.getAttribute('data-duration'));
            for (var i = 1; i <= MAX_DURATION_MULTIPLES; i++) {
                var days = baseDays * i;
                var option = document.createElement('option');
                option.value = days;
                option.textContent = days + ' يوم';
                if (i === 1) option.selected = true;
                durationSelect.appendChild(option);
            }
            durationSelect.disabled = false;
            updateBuyPrice();
        }

        function onBuyPackageChange() {
            var select = document.getElementById('buyPackage');
            fillDurationOptions(select.options[select.selectedIndex]);
        }

        function updateBuyPrice() {
            var select = document.getElementById('buyPackage');
            var opt = select.options[select.selectedIndex];
            var duration = parseInt(document.getElementById('buyDuration').value);
            if (opt && opt.value && duration > 0) {
                var baseDays = parseInt(opt.getAttribute('data-duration'));
                var price = parseFloat(opt.getAttribute('data-price'));
                var amount = price * (duration / baseDays);
                document.getElementById('buyPrice').value = amount.toFixed(2) + ' ج.م';
            } else {
                document.getElementById('buyPrice').value = '';
            }
        }

        var STATUS_TEXT = ['معلق الدفع', 'نشط', 'منتهي', 'معطل'];
        var STATUS_CLASS = ['badge-warning', 'badge-success', 'badge-info', 'badge-danger'];
        var attachmentBaseUrl = '@attachmentBaseUrl';
        var adLogoUrl = '';

        function getStatusText(s) { return STATUS_TEXT[s] || 'غير معروف'; }
        function getStatusClass(s) { return STATUS_CLASS[s] || 'badge-info'; }

        function formatDate(v) { return v ? v.substring(0, 10) : '-'; }

        function renderAdVisual(ad) {
            if (ad.imageUrl) {
                return '<div class="ad-preview-visual"><img class="ad-preview-img" src="' + attachmentBaseUrl + '/files/' + ad.imageUrl + '" alt="' + (ad.clinicName || '') + '" /></div>';
            }
            var initial = (ad.clinicName || 'ع').substring(0, 1);
            return '<div class="ad-preview-visual"><span class="ad-preview-initial">' + initial + '</span></div>';
        }

        function renderAds(ads) {
            ads = ads || [];
            var activeAds = ads.filter(function (a) { return a.status === 1; });

            var preview = document.getElementById('adsPreviewContainer');
            if (preview) {
                if (activeAds.length === 0) {
                    preview.innerHTML = '<div class="ad-preview-empty"><p>لا توجد إعلانات نشطة حالياً. بمجرد شراء إعلان وتأكيد الدفع سيظهر هنا وفي تطبيق المرضى.</p></div>';
                } else {
                    var html = '<div class="ad-preview-grid">';
                    activeAds.forEach(function (ad) {
                        html += '<div class="ad-preview-item">'
                            + renderAdVisual(ad)
                            + '<div class="ad-preview-body">'
                            + '<span class="ad-preview-name">' + (ad.clinicName || '') + '</span>'
                            + '<span class="ad-preview-meta">' + (ad.packageNameAr || '') + '</span>'
                            + '<span class="ad-preview-period">' + formatDate(ad.startDate) + ' → ' + formatDate(ad.endDate) + '</span>'
                            + '</div>'
                            + '<span class="badge badge-success">نشط</span>'
                            + '</div>';
                    });
                    html += '</div>';
                    preview.innerHTML = html;
                }
            }

            var tbody = document.getElementById('adsTableBody');
            if (tbody) {
                if (ads.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6"><div class="empty-state"><p>لا توجد إعلانات بعد. ابدأ بشراء إعلانك الأول لظهور عيادتك في التطبيق.</p></div></td></tr>';
                } else {
                    var rows = '';
                    ads.forEach(function (ad) {
                        rows += '<tr>'
                            + '<td class="text-md-medium">' + (ad.packageNameAr || '') + '</td>'
                            + '<td class="text-md">' + ad.durationDays + ' يوم</td>'
                            + '<td class="text-md">' + Number(ad.amount || 0).toFixed(2) + ' ج.م</td>'
                            + '<td class="text-md">' + formatDate(ad.startDate) + '</td>'
                            + '<td class="text-md">' + formatDate(ad.endDate) + '</td>'
                            + '<td><span class="badge ' + getStatusClass(ad.status) + '">' + getStatusText(ad.status) + '</span></td>'
                            + '</tr>';
                    });
                    tbody.innerHTML = rows;
                }
            }
        }

        function onAdLogoChange() {
            var input = document.getElementById('adLogoInput');
            var file = input.files && input.files[0];
            if (!file) return;
            var status = document.getElementById('adLogoStatus');
            var formData = new FormData();
            formData.append('file', file);
            status.textContent = 'جاري رفع الشعار...';
            fetch('/Home/UploadAttachment?place=5', { method: 'POST', body: formData })
            .then(function (r) { return r.json(); })
            .then(function (result) {
                if (result.success && result.url) {
                    adLogoUrl = result.url;
                    var preview = document.getElementById('adLogoPreview');
                    preview.src = attachmentBaseUrl + '/files/' + result.url;
                    preview.classList.remove('d-none');
                    document.getElementById('adLogoRemoveBtn').classList.remove('d-none');
                    status.textContent = 'تم رفع الشعار بنجاح.';
                } else {
                    status.textContent = result.error || 'فشل رفع الشعار';
                }
            })
            .catch(function () { status.textContent = 'حدث خطأ أثناء رفع الشعار'; });
        }

        function onAdLogoRemove() {
            adLogoUrl = '';
            document.getElementById('adLogoInput').value = '';
            document.getElementById('adLogoPreview').classList.add('d-none');
            document.getElementById('adLogoRemoveBtn').classList.add('d-none');
            document.getElementById('adLogoStatus').textContent = '';
        }

        function refreshAds() {
            var btn = document.getElementById('refreshAdsBtn');
            if (btn) btn.disabled = true;
            fetch('/Clinic/GetMyAdsJson', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(function (r) { return r.json(); })
            .then(function (result) {
                if (!result.success || !result.data) {
                    showErrorModal(result.message || 'حدث خطأ أثناء تحديث الحالة');
                    return;
                }
                renderAds(result.data);
                showSuccessModal('تم تحديث حالة إعلاناتك.');
            })
            .catch(function () {
                showErrorModal('عذراً، حدث خطأ أثناء تحديث الحالة');
            })
            .finally(function () {
                if (btn) btn.disabled = false;
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            var durationSelect = document.getElementById('buyDuration');
            if (durationSelect) {
                var packageSelect = document.getElementById('buyPackage');
                if (packageSelect.options.length > 1) {
                    fillDurationOptions(packageSelect.options[packageSelect.selectedIndex]);
                }
            }

            var buyBtn = document.getElementById('buySubmitBtn');
            var adConfirmBtn = document.getElementById('adConfirmPaymentMethodBtn');
            // Store pending ad order data between modals
            var pendingAdOrder = null;
            if (buyBtn) {
                buyBtn.addEventListener('click', function () {
                    var packageSelect = document.getElementById('buyPackage');
                    var opt = packageSelect.options[packageSelect.selectedIndex];
                    var packageId = opt ? opt.value : '';
                    var duration = parseInt(document.getElementById('buyDuration').value);

                    if (!packageId) { showErrorModal('يرجى اختيار الباقة'); return; }
                    if (!duration || duration <= 0) { showErrorModal('يرجى اختيار المدة بالأيام'); return; }
                    var baseDays = parseInt(opt.getAttribute('data-duration'));
                    if (duration % baseDays !== 0) { showErrorModal('المدة يجب أن تكون مضاعفاً صحيحاً لمدة الباقة'); return; }

                    pendingAdOrder = { packageId: packageId, duration: duration };
                    // Show payment method selection before creating order
                    var pmModalEl = document.getElementById('paymentMethodAdModal');
                    if(pmModalEl){
                        var pmModal = bootstrap.Modal.getInstance(pmModalEl) || new bootstrap.Modal(pmModalEl);
                        // hide buy modal first if open
                        var buyModalEl = document.getElementById('buyAdModal');
                        var buyModal = bootstrap.Modal.getInstance(buyModalEl);
                        if(buyModal) buyModal.hide();
                        pmModal.show();
                    }
                });
            }
            if(adConfirmBtn){
                adConfirmBtn.addEventListener('click', function(){
                    if(!pendingAdOrder){ showErrorModal('يرجى اختيار الباقة والمدة أولاً'); return; }
                    var selectedMethod = document.querySelector('input[name="adPaymentMethod"]:checked')?.value || 'PaymobWallet';
                    adConfirmBtn.disabled = true;
                    adConfirmBtn.textContent = 'جارٍ إنشاء الطلب...';
                    // also disable buyBtn for feedback
                    if(buyBtn){ buyBtn.disabled = true; buyBtn.textContent = 'جارٍ إنشاء الطلب...'; }
                    fetch('/Clinic/CreateAdOrder', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            adPackageId: pendingAdOrder.packageId,
                            durationDays: pendingAdOrder.duration,
                            logoImageUrl: adLogoUrl || null,
                            paymentMethod: selectedMethod
                        })
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (result) {
                        // hide payment modal
                        var pmModalEl = document.getElementById('paymentMethodAdModal');
                        var pmModal = bootstrap.Modal.getInstance(pmModalEl);
                        if(pmModal) pmModal.hide();
                        if (result.success && result.data && result.data.paymobRedirectUrl) {
                            showSuccessModal('تم إنشاء الطلب بنجاح، أكمل الدفع في نافذة Paymob ثم اضغط "تحديث الحالة" لتأكيد التفعيل.');
                            window.open(result.data.paymobRedirectUrl, '_blank');
                        } else if (result.success) {
                            showSuccessModal(result.message || 'تم إنشاء الطلب بنجاح');
                        } else {
                            showErrorModal(result.message || 'حدث خطأ أثناء إنشاء الطلب');
                        }
                    })
                    .catch(function () {
                        showErrorModal('عذراً، حدث خطأ أثناء إنشاء الطلب');
                    })
                    .finally(function(){
                        adConfirmBtn.disabled = false;
                        adConfirmBtn.textContent = 'متابعة للدفع';
                        if(buyBtn){ buyBtn.disabled = false; buyBtn.textContent = 'إتمام الطلب والدفع'; }
                        pendingAdOrder = null;
                    });
                });
            }
            // local search for my ads
            var mSearch = document.getElementById('marketingAdsSearch');
            if(mSearch){
                mSearch.addEventListener('input', function(){
                    var q = this.value.toLowerCase().trim();
                    document.querySelectorAll('#adsTableBody tr').forEach(function(tr){
                        if(tr.querySelector('td[colspan]')) return;
                        var txt = tr.textContent.toLowerCase();
                        tr.style.display = !q || txt.indexOf(q)!==-1 ? '' : 'none';
                    });
                });
            }
        });
    </script>
}
