@using ClinicHub.Data
@using ClinicHub.Services.ReponseModels
@using ClinicHub.Services.Options
@inject Microsoft.Extensions.Options.IOptions<Doctory> _doctoryOptions
@{
    ViewData["Title"] = "الخدمات الإعلانية - Doctory";
    Layout = "_ClinicLayout";
    var attachmentBaseUrl = _doctoryOptions.Value.BaseUrl.TrimEnd('/');
    var ads = ViewBag.Ads as IReadOnlyCollection<AdDto> ?? new List<AdDto>();
    var packages = ViewBag.Packages as IReadOnlyCollection<AdPackageDto> ?? new List<AdPackageDto>();
    var currentUser = ViewBag.CurrentUser as CurrentUserContext;

    string GetStatusText(int status) => status switch
    {
        0 => "معلق الدفع",
        1 => "نشط",
        2 => "منتهي",
        3 => "معطل",
        _ => "غير معروف"
    };

    string GetStatusClass(int status) => status switch
    {
        0 => "badge-warning",
        1 => "badge-success",
        2 => "badge-info",
        3 => "badge-danger",
        _ => "badge-info"
    };

    List<string> GetImagesList(string? imgUrl)
    {
        if (string.IsNullOrWhiteSpace(imgUrl)) return new List<string>();
        return imgUrl.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
    }

    var activeAdsCount = ads.Count(a => a.Status == 1);
    var pendingAdsCount = ads.Count(a => a.Status == 0);
    var endedAdsCount = ads.Count(a => a.Status == 2);
    var totalAdSpend = ads.Sum(a => a.Amount);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/clinic-money.css?v=20261027_redesign_v2" />
}

<div class="page-header cm-page-head">
    <div>
        <h2 class="page-title">
            <span class="page-title-icon">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12zM7 9h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z"/>
                </svg>
            </span>
            الخدمات الإعلانية والترويج
        </h2>
        <p class="page-header-subtitle">إدارة باقات وبرامج الترويج لظهور عيادتك داخل تطبيق المرضى.</p>
    </div>
    <div class="page-header-actions">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#buyAdModal">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
            </svg>
            شراء وتفعيل إعلان
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

@if (ads.Count > 0)
{
    <div class="stats-grid cm-ad-metrics">
        <div class="stat-card stat-card--brass">
            <div class="stat-info">
                <span class="stat-value cm-money">@activeAdsCount.ToString("N0")</span>
                <span class="stat-label">إعلانات نشطة</span>
                <span class="stat-subtext cm-stat-sub">تظهر الآن في تطبيق المرضى</span>
            </div>
            <div class="icon-wrapper icon-wrapper--green">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            </div>
        </div>
        <div class="stat-card stat-card--warning">
            <div class="stat-info">
                <span class="stat-value cm-money">@pendingAdsCount.ToString("N0")</span>
                <span class="stat-label">بانتظار الدفع</span>
                <span class="stat-subtext cm-stat-sub">لم يبدأ عرضها بعد</span>
            </div>
            <div class="icon-wrapper icon-wrapper--amber">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
            </div>
        </div>
        <div class="stat-card stat-card--neutral">
            <div class="stat-info">
                <span class="stat-value cm-money">@endedAdsCount.ToString("N0")</span>
                <span class="stat-label">إعلانات منتهية</span>
                <span class="stat-subtext cm-stat-sub">انتهت مدتها</span>
            </div>
            <div class="icon-wrapper icon-wrapper--primary">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 3a9 9 0 0 0-9 9H1l3.9 3.9.1.1L9 13H6a7 7 0 1 1 7 7v2a9 9 0 0 0 0-18zm-1 5v5l4 2.3-.7 1.2-4.8-2.9V8H12z"/></svg>
            </div>
        </div>
        <div class="stat-card stat-card--info">
            <div class="stat-info">
                <span class="stat-value cm-money cm-money--lg">@totalAdSpend.ToString("N2")</span>
                <span class="stat-label">إجمالي الإنفاق الإعلاني (ج.م)</span>
                <span class="stat-subtext cm-stat-sub">من كل الطلبات</span>
            </div>
            <div class="icon-wrapper icon-wrapper--blue">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.77 0 2.48.85 2.5 2.1h2.21c-.05-1.95-1.17-3.28-3-3.74V3h-3.4v2.21c-2.9.51-4.8 2.58-4.8 5.33 0 3.48 2.91 4.68 6 5.41 1.73.4 2.5 1.13 2.5 2.19 0 1.21-1.04 1.96-2.9 1.96-2.03 0-2.87-.99-2.9-2.24H6.1c.04 2.36 1.89 3.81 4.1 4.27V24h3.4v-2.16c2.94-.52 4.9-2.45 4.9-5.34 0-4.2-3.4-5.48-6.7-6.2z"/></svg>
            </div>
        </div>
    </div>
}

@if (packages.Count > 0)
{
    <div class="packages-row cm-package-row">
        @foreach (var pkg in packages)
        {
            <div class="package-mini-card cm-package-card">
                <div class="package-mini-name cm-package-name">@(pkg.NameAr ?? pkg.Name)</div>
                <div class="package-mini-desc cm-package-desc">@(pkg.DescriptionAr ?? pkg.Description)</div>
                <div class="package-mini-price cm-package-price">@pkg.Price.ToString("N0") ج.م / @pkg.DurationDays يوم</div>
                <div class="package-mini-meta cm-package-meta">
                    <div><i class="bi bi-megaphone" aria-hidden="true"></i>@(pkg.MaxAds > 0 ? $"حتى {pkg.MaxAds} إعلانات نشطة" : "إعلانات غير محدودة")</div>
                    <div><i class="bi bi-eye" aria-hidden="true"></i>@(pkg.MaxImpressions > 0 ? $"{pkg.MaxImpressions:N0} مشاهدة مؤكدة" : "مشاهدات غير محدودة")</div>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm cm-package-cta" onclick="selectPackageAndOpenModal('@pkg.Id')">
                    شراء هذه الباقة
                </button>
            </div>
        }
    </div>
}

<!-- Patient App Preview -->
<div class="table-card ad-preview-card cm-list-card">
    <div class="table-card-header cm-ledger-head">
        <h3 class="table-card-title">
            <span class="subtitle-icon">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"/>
                </svg>
            </span>
            معاينة الإعلان في تطبيق المرضى
        </h3>
        <p class="ad-preview-hint cm-ad-preview-hint">هكذا يظهر إعلانك للمرضى في تطبيق الجوال (بالشعارات والصور المرفوعة). الإعلانات النشطة فقط تظهر للجميع.</p>
    </div>

    @{
        var activeAds = ads.Where(a => a.Status == 1).ToList();
    }
    <div id="adsPreviewContainer" class="cm-preview-wrap">
    @if (activeAds.Count == 0)
    {
        <div class="ad-preview-empty cm-preview-empty">
            <p>لا توجد إعلانات نشطة حالياً. بمجرد شراء إعلان وتأكيد الدفع سيظهر هنا وفي تطبيق المرضى.</p>
        </div>
    }
    else
    {
        <div class="ad-preview-grid">
            @foreach (var ad in activeAds)
            {
                var adImgs = GetImagesList(ad.ImageUrl);
                <div class="ad-preview-item">
                    <div class="ad-preview-visual">
                        @if (adImgs.Count > 0)
                        {
                            <div class="ad-preview-visuals-row">
                                @foreach (var img in adImgs.Take(3))
                                {
                                    <img class="ad-preview-visual-thumb" src="@(attachmentBaseUrl)/files/@img" alt="@ad.ClinicName" loading="lazy" decoding="async" />
                                }
                                @if (adImgs.Count > 3)
                                {
                                    <span class="badge badge-primary">+@(adImgs.Count - 3)</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="ad-preview-initial">@(string.IsNullOrWhiteSpace(ad.ClinicName) ? "ع" : ad.ClinicName.Substring(0, 1))</span>
                        }
                    </div>
                    <div class="ad-preview-body">
                        <span class="ad-preview-name">@ad.ClinicName</span>
                        <span class="ad-preview-meta">@ad.PackageNameAr @(adImgs.Count > 1 ? $"({adImgs.Count} صور)" : "")</span>
                        <span class="ad-preview-period">@(ad.StartDate?.ToString("yyyy-MM-dd") ?? "-") → @(ad.EndDate?.ToString("yyyy-MM-dd") ?? "-")</span>
                    </div>
                    <span class="badge badge-success">نشط</span>
                </div>
            }
        </div>
    }
    </div>
</div>

<div class="table-card cm-list-card">
    <div class="table-card-header cm-ledger-head">
        <h3 class="table-card-title">
            <span class="subtitle-icon">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
                </svg>
            </span>
            إعلاناتي
        </h3>
        <div class="table-card-actions cm-ad-toolbar">
            <div class="ads-search-wrap cm-ad-search">
                <svg class="ads-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" id="marketingAdsSearch" aria-label="بحث في الإعلانات" class="form-input form-input-sm cm-ad-search-input cm-money-input" placeholder="بحث في إعلاناتي..." />
            </div>
            <button type="button" class="btn btn-secondary btn-sm" id="refreshAdsBtn" onclick="refreshAds()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.65 6.35A7.95 7.95 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                </svg>
                تحديث الحالة
            </button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="custom-table cm-ledger">
            <thead>
                <tr>
                    <th>الباقة</th>
                    <th>الصور والشعارات</th>
                    <th>المدة</th>
                    <th>المبلغ</th>
                    <th>بداية</th>
                    <th>نهاية</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody id="adsTableBody">
                @if (ads.Count == 0)
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state cm-empty-row">
                                <p>لا توجد إعلانات بعد. ابدأ بشراء إعلانك الأول لظهور عيادتك في التطبيق.</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var ad in ads)
                    {
                        var adImgs = GetImagesList(ad.ImageUrl);
                        <tr>
                            <td class="text-md-medium cm-package-name-cell">@ad.PackageNameAr</td>
                            <td>
                                @if (adImgs.Count > 0)
                                {
                                    <div class="ad-preview-visuals-row">
                                        @foreach (var img in adImgs.Take(2))
                                        {
                                            <img class="ad-preview-visual-thumb" src="@(attachmentBaseUrl)/files/@img" alt="@ad.ClinicName" loading="lazy" decoding="async" />
                                        }
                                        @if (adImgs.Count > 2)
                                        {
                                            <span class="badge badge-info cm-badge-inline">+@(adImgs.Count - 2)</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">الاسم فقط</span>
                                }
                            </td>
                            <td class="text-md cm-money">@ad.DurationDays يوم</td>
                            <td class="text-md cm-money">@ad.Amount.ToString("N2") ج.م</td>
                            <td class="text-md cm-money">@(ad.StartDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td class="text-md cm-money">@(ad.EndDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td class="cm-status-cell"><span class="badge badge--dot @GetStatusClass(ad.Status)">@GetStatusText(ad.Status)</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Payment Method Selection Modal (Ads) -->
<div class="modal fade" id="paymentMethodAdModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <div class="modal-header-custom">
                <h5 class="modal-title">اختر طريقة الدفع</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body-custom">
                <div class="payment-methods-grid cm-methods">
                    <label class="payment-method-card selected cm-pay-method" id="adMethodWalletCard">
                        <input type="radio" name="adPaymentMethod" value="PaymobWallet" checked>
                        <div class="payment-method-icon payment-method-icon--wallet">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.66 0 3-4.03 3-9s-1.34-9-3-9m0 18c-1.66 0-3-4.03-3-9s1.34-9 3-9m-9 9a9 9 0 019-9"/>
                            </svg>
                        </div>
                        <div class="payment-method-info">
                            <p class="payment-method-title">محفظة Paymob</p>
                            <p class="payment-method-desc">الدفع عبر المحفظة الإلكترونية</p>
                        </div>
                        <span class="payment-method-check">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                        </span>
                    </label>

                    <label class="payment-method-card cm-pay-method" id="adMethodCardCard">
                        <input type="radio" name="adPaymentMethod" value="PaymobCreditCard">
                        <div class="payment-method-icon payment-method-icon--card">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                                <line x1="1" y1="10" x2="23" y2="10"/>
                            </svg>
                        </div>
                        <div class="payment-method-info">
                            <p class="payment-method-title">بطاقة ائتمانية</p>
                            <p class="payment-method-desc">الدفع ببطاقة بنكية عبر Paymob</p>
                        </div>
                        <span class="payment-method-check">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                        </span>
                    </label>
                </div>

                <div id="adWalletPhoneBox" class="cm-wallet-box">
                    <label for="adWalletPhoneInput" class="form-label cm-wallet-label">
                        <i class="bi bi-phone" aria-hidden="true"></i> رقم المحفظة (فودافون كاش / اتصالات / أورنج / وي):
                    </label>
                    <input type="tel" id="adWalletPhoneInput" class="form-control cm-money-input" placeholder="01xxxxxxxxx" dir="ltr" maxlength="11">
                    <small class="cm-wallet-hint">(للتجربة في بيئة الاختبار يمكنك استخدام: 01010101010)</small>
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="adConfirmPaymentMethodBtn">متابعة للدفع</button>
            </div>
        </div>
    </div>
</div>

<!-- Buy Ad Modal -->
<div class="modal fade" id="buyAdModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-content-custom">
            <div class="modal-header-custom">
                <h5 class="modal-title">شراء وتفعيل إعلان جديد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body-custom">
                @if (packages.Count == 0)
                {
                    <div class="empty-state"><p>لا توجد باقات متاحة حالياً. حاول لاحقاً.</p></div>
                }
                else
                {
                    <div class="row cm-form-grid">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="buyPackage">الباقة الإعلانية</label>
                                <select id="buyPackage" class="form-select" onchange="onBuyPackageChange()">
                                    <option value="">اختر الباقة</option>
                                    @foreach (var pkg in packages)
                                    {
                                        <option value="@pkg.Id" data-duration="@pkg.DurationDays" data-price="@pkg.Price" data-max-ads="@pkg.MaxAds">
                                            @(pkg.NameAr ?? pkg.Name) (@pkg.DurationDays يوم - @pkg.Price ج.م@(pkg.MaxAds > 0 ? $" - حتى {pkg.MaxAds} صور/شعارات" : ""))
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="buyDuration">المدة (أيام)</label>
                                <select id="buyDuration" class="form-select" onchange="updateBuyPrice()" disabled>
                                    <option value="">اختر المدة</option>
                                </select>
                                <p class="form-hint">المدة تكون مضاعفاً صحيحاً لمدة الباقة.</p>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="buyPrice">السعر الإجمالي</label>
                        <input type="text" id="buyPrice" class="form-input cm-money cm-money-input" readonly placeholder="0.00 ج.م" />
                    </div>
                    <div class="form-group">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label mb-0">شعارات وصور الإعلان <span class="text-muted">(حسب الحد المسموح في الباقة)</span></label>
                            <span class="badge badge-info" id="adLogoCountBadge">0 / 5 صور</span>
                        </div>
                        <div class="ad-multi-logo-container">
                            <div class="ad-logo-grid" id="adLogoGrid"></div>
                            <div class="ad-logo-upload-box" id="adLogoUploadBox">
                                <label class="ad-logo-dropzone" for="adLogoInput">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                        <polyline points="17 8 12 3 7 8"/>
                                        <line x1="12" y1="3" x2="12" y2="15"/>
                                    </svg>
                                    <span class="dropzone-text">+ إضافة شعار / صورة</span>
                                </label>
                                <input type="file" id="adLogoInput" class="d-none" accept="image/*" multiple onchange="onAdLogosSelected(this)" />
                            </div>
                        </div>
                        <div id="adLogoStatus" class="form-hint mt-1"></div>
                        <p class="form-hint" id="adLogoLimitHint">الشعارات والصور ستظهر داخل إعلانك في تطبيق المرضى وفقاً للحد الأقصى للباقة المحددة.</p>
                    </div>
                    <p class="form-hint">يتم الدفع عبر بوابة Paymob، ويظهر إعلانك فور اكتمال الدفع.</p>
                }
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="buySubmitBtn">إتمام الطلب والدفع</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var adWalletPhoneBox = document.getElementById('adWalletPhoneBox');
        document.querySelectorAll('input[name="adPaymentMethod"]').forEach(function(radio){
            radio.addEventListener('change', function(){
                document.querySelectorAll('#paymentMethodAdModal .payment-method-card').forEach(function(c){ c.classList.remove('selected'); });
                this.closest('.payment-method-card')?.classList.add('selected');
                if (adWalletPhoneBox) {
                    adWalletPhoneBox.classList.toggle('cm-hidden', this.value !== 'PaymobWallet');
                }
            });
        });
        document.querySelectorAll('#paymentMethodAdModal .payment-method-card').forEach(function(card){
            card.addEventListener('click', function(e){
                if(e.target.closest('input')) return;
                var r = this.querySelector('input[type="radio"]');
                if(r && !r.checked){ r.checked = true; r.dispatchEvent(new Event('change', {bubbles:true})); }
            });
        });

        var MAX_DURATION_MULTIPLES = 12;
        var currentPackageMaxLogos = 5;

        function fillDurationOptions(opt) {
            var durationSelect = document.getElementById('buyDuration');
            durationSelect.innerHTML = '';
            if (!opt || !opt.value) {
                durationSelect.disabled = true;
                document.getElementById('buyPrice').value = '';
                return;
            }
            var baseDays = parseInt(opt.getAttribute('data-duration'));
            for (var i = 1; i <= MAX_DURATION_MULTIPLES; i++) {
                var days = baseDays * i;
                var option = document.createElement('option');
                option.value = days;
                option.textContent = days + ' يوم';
                if (i === 1) option.selected = true;
                durationSelect.appendChild(option);
            }
            durationSelect.disabled = false;
            updateBuyPrice();
        }

        function updatePackageLogoLimit() {
            var select = document.getElementById('buyPackage');
            var opt = select ? select.options[select.selectedIndex] : null;
            if (opt && opt.value) {
                var maxAds = parseInt(opt.getAttribute('data-max-ads') || '0');
                currentPackageMaxLogos = maxAds > 0 ? maxAds : 5;
            } else {
                currentPackageMaxLogos = 5;
            }

            var hintEl = document.getElementById('adLogoLimitHint');
            if (hintEl) {
                hintEl.textContent = 'تسمح هذه الباقة برفع حتى ' + currentPackageMaxLogos + ' صور/شعارات كحد أقصى تظهر للمرضى في تطبيق Doctory.';
            }

            if (uploadedAdLogos.length > currentPackageMaxLogos) {
                uploadedAdLogos = uploadedAdLogos.slice(0, currentPackageMaxLogos);
            }
            renderAdLogosGrid();
        }

        function selectPackageAndOpenModal(packageId) {
            var select = document.getElementById('buyPackage');
            if (select) {
                select.value = packageId;
                onBuyPackageChange();
            }
            var modalEl = document.getElementById('buyAdModal');
            if (modalEl) {
                var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modal.show();
            }
        }

        function onBuyPackageChange() {
            var select = document.getElementById('buyPackage');
            fillDurationOptions(select.options[select.selectedIndex]);
            updatePackageLogoLimit();
        }

        function updateBuyPrice() {
            var select = document.getElementById('buyPackage');
            var opt = select.options[select.selectedIndex];
            var duration = parseInt(document.getElementById('buyDuration').value);
            if (opt && opt.value && duration > 0) {
                var baseDays = parseInt(opt.getAttribute('data-duration'));
                var price = parseFloat(opt.getAttribute('data-price'));
                var amount = price * (duration / baseDays);
                document.getElementById('buyPrice').value = amount.toFixed(2) + ' ج.م';
            } else {
                document.getElementById('buyPrice').value = '';
            }
        }

        var STATUS_TEXT = ['معلق الدفع', 'نشط', 'منتهي', 'معطل'];
        var STATUS_CLASS = ['badge-warning', 'badge-success', 'badge-info', 'badge-danger'];
        var attachmentBaseUrl = '@attachmentBaseUrl';
        var uploadedAdLogos = [];

        function getStatusText(s) { return STATUS_TEXT[s] || 'غير معروف'; }
        function getStatusClass(s) { return STATUS_CLASS[s] || 'badge-info'; }

        function formatDate(v) { return v ? v.substring(0, 10) : '-'; }

        function getAdImages(imageUrl) {
            if (!imageUrl) return [];
            return imageUrl.split(',').map(function(s){ return s.trim(); }).filter(function(s){ return s.length > 0; });
        }

        function renderAdVisual(ad) {
            var imgs = getAdImages(ad.imageUrl);
            if (imgs.length > 1) {
                var html = '<div class="ad-preview-visuals-row">';
                for (var i = 0; i < Math.min(imgs.length, 3); i++) {
                    html += '<img class="ad-preview-visual-thumb" src="' + attachmentBaseUrl + '/files/' + imgs[i] + '" alt="' + (ad.clinicName || '') + '" />';
                }
                if (imgs.length > 3) {
                    html += '<span class="badge badge-primary">+' + (imgs.length - 3) + '</span>';
                }
                html += '</div>';
                return html;
            } else if (imgs.length === 1) {
                return '<div class="ad-preview-visual"><img class="ad-preview-img" src="' + attachmentBaseUrl + '/files/' + imgs[0] + '" alt="' + (ad.clinicName || '') + '" /></div>';
            }
            var initial = (ad.clinicName || 'ع').substring(0, 1);
            return '<div class="ad-preview-visual"><span class="ad-preview-initial">' + initial + '</span></div>';
        }

        function renderAdLogosGrid() {
            var grid = document.getElementById('adLogoGrid');
            var countBadge = document.getElementById('adLogoCountBadge');
            var uploadBox = document.getElementById('adLogoUploadBox');
            if (!grid) return;

            grid.innerHTML = '';
            if (countBadge) countBadge.textContent = uploadedAdLogos.length + ' / ' + currentPackageMaxLogos + ' صور';

            uploadedAdLogos.forEach(function(url, idx) {
                var card = document.createElement('div');
                card.className = 'ad-logo-card';
                card.innerHTML = '<img src="' + attachmentBaseUrl + '/files/' + url + '" class="ad-logo-card-img" alt="شعار ' + (idx + 1) + '" />' +
                    '<button type="button" class="ad-logo-card-del" title="حذف الشعار" onclick="removeAdLogo(' + idx + ')">' +
                    '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>' +
                    '</button>';
                grid.appendChild(card);
            });

            if (uploadBox) {
                uploadBox.classList.toggle('cm-hidden', uploadedAdLogos.length >= currentPackageMaxLogos);
            }
        }

        function removeAdLogo(index) {
            if (index >= 0 && index < uploadedAdLogos.length) {
                uploadedAdLogos.splice(index, 1);
                renderAdLogosGrid();
                var statusEl = document.getElementById('adLogoStatus');
                if (statusEl) statusEl.textContent = '';
            }
        }

        function onAdLogosSelected(input) {
            if (!input.files || input.files.length === 0) return;
            var files = Array.from(input.files);
            var statusEl = document.getElementById('adLogoStatus');

            if (uploadedAdLogos.length + files.length > currentPackageMaxLogos) {
                var availableSlots = currentPackageMaxLogos - uploadedAdLogos.length;
                if (availableSlots <= 0) {
                    showErrorModal('لقد بلغت الحد الأقصى للشعارات والصور المسموح بها في هذه الباقة (' + currentPackageMaxLogos + ' صور)');
                    input.value = '';
                    return;
                }
                showErrorModal('هذه الباقة تسمح بإضافة ' + availableSlots + ' صور إضافية فقط كحد أقصى (الإجمالي ' + currentPackageMaxLogos + ' صور)');
                files = files.slice(0, availableSlots);
            }

            statusEl.textContent = 'جارٍ رفع ' + files.length + ' شعار/صورة...';
            var uploadPromises = files.map(function(file) {
                var formData = new FormData();
                formData.append('file', file);
                return fetch('/Clinic/UploadAttachment', {
                    method: 'POST',
                    body: formData
                }).then(function(r) { return r.json(); });
            });

            Promise.all(uploadPromises)
                .then(function(results) {
                    var successCount = 0;
                    results.forEach(function(res) {
                        if (res.success && (res.url || (res.data && res.data.url))) {
                            var finalUrl = res.url || (res.data && res.data.url);
                            uploadedAdLogos.push(finalUrl);
                            successCount++;
                        }
                    });
                    input.value = '';
                    renderAdLogosGrid();
                    statusEl.textContent = 'تم رفع ' + successCount + ' صورة/شعار بنجاح';
                })
                .catch(function() {
                    input.value = '';
                    statusEl.textContent = 'عذراً، حدث خطأ أثناء رفع بعض الصور';
                });
        }

        function refreshAds() {
            var btn = document.getElementById('refreshAdsBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>جارٍ التحديث...';

            fetch('/Clinic/GetMyAdsJson')
                .then(function (r) { return r.json(); })
                .then(function (result) {
                    btn.disabled = false;
                    btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.65 6.35A7.95 7.95 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg> تحديث الحالة';
                    if (!result.success) {
                        showErrorModal(result.message || 'تعذر تحديث البيانات');
                        return;
                    }
                    var adsList = result.data || [];
                    renderAdsTable(adsList);
                    renderAdsPreview(adsList);
                    showSuccessModal('تم تحديث قائمة الإعلانات بنجاح');
                })
                .catch(function () {
                    btn.disabled = false;
                    btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.65 6.35A7.95 7.95 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg> تحديث الحالة';
                    showErrorModal('عذراً، حدث خطأ أثناء تحديث البيانات');
                });
        }

        function renderAdsTable(adsList) {
            var tbody = document.getElementById('adsTableBody');
            if (!tbody) return;
            if (adsList.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7"><div class="empty-state"><p>لا توجد إعلانات بعد. ابدأ بشراء إعلانك الأول لظهور عيادتك في التطبيق.</p></div></td></tr>';
                return;
            }
            var html = '';
            for (var i = 0; i < adsList.length; i++) {
                var ad = adsList[i];
                var adImgs = getAdImages(ad.imageUrl);
                var imgsHtml = '<span class="text-muted">الاسم فقط</span>';
                if (adImgs.length > 0) {
                    imgsHtml = '<div class="ad-preview-visuals-row">';
                    for (var j = 0; j < Math.min(adImgs.length, 2); j++) {
                        imgsHtml += '<img class="ad-preview-visual-thumb" src="' + attachmentBaseUrl + '/files/' + adImgs[j] + '" alt="' + (ad.clinicName || '') + '" />';
                    }
                    if (adImgs.length > 2) {
                        imgsHtml += '<span class="badge badge-info">+' + (adImgs.length - 2) + '</span>';
                    }
                    imgsHtml += '</div>';
                }

                html += '<tr>' +
                    '<td class="text-md-medium">' + (ad.packageNameAr || '') + '</td>' +
                    '<td>' + imgsHtml + '</td>' +
                    '<td class="text-md">' + ad.durationDays + ' يوم</td>' +
                    '<td class="text-md">' + parseFloat(ad.amount).toFixed(2) + ' ج.م</td>' +
                    '<td class="text-md">' + formatDate(ad.startDate) + '</td>' +
                    '<td class="text-md">' + formatDate(ad.endDate) + '</td>' +
                    '<td><span class="badge ' + getStatusClass(ad.status) + '">' + getStatusText(ad.status) + '</span></td>' +
                    '</tr>';
            }
            tbody.innerHTML = html;
        }

        function renderAdsPreview(adsList) {
            var container = document.getElementById('adsPreviewContainer');
            if (!container) return;
            var active = adsList.filter(function (a) { return a.status === 1; });
            if (active.length === 0) {
                container.innerHTML = '<div class="ad-preview-empty"><p>لا توجد إعلانات نشطة حالياً. بمجرد شراء إعلان وتأكيد الدفع سيظهر هنا وفي تطبيق المرضى.</p></div>';
                return;
            }
            var html = '<div class="ad-preview-grid">';
            for (var i = 0; i < active.length; i++) {
                var ad = active[i];
                var imgs = getAdImages(ad.imageUrl);
                html += '<div class="ad-preview-item">' +
                    renderAdVisual(ad) +
                    '<div class="ad-preview-body">' +
                    '<span class="ad-preview-name">' + (ad.clinicName || '') + '</span>' +
                    '<span class="ad-preview-meta">' + (ad.packageNameAr || '') + (imgs.length > 1 ? ' (' + imgs.length + ' صور/شعارات)' : '') + '</span>' +
                    '<span class="ad-preview-period">' + formatDate(ad.startDate) + ' → ' + formatDate(ad.endDate) + '</span>' +
                    '</div>' +
                    '<span class="badge badge-success">نشط</span>' +
                    '</div>';
            }
            html += '</div>';
            container.innerHTML = html;
        }

        var pendingAdOrder = null;

        document.addEventListener('DOMContentLoaded', function () {
            renderAdLogosGrid();

            var buyBtn = document.getElementById('buySubmitBtn');
            if (buyBtn) {
                buyBtn.addEventListener('click', function () {
                    var pkgId = document.getElementById('buyPackage').value;
                    var duration = parseInt(document.getElementById('buyDuration').value);
                    if (!pkgId) { showErrorModal('يرجى اختيار باقة الإعلان'); return; }
                    if (!duration || duration <= 0) { showErrorModal('يرجى اختيار مدة صحيحة'); return; }

                    pendingAdOrder = { packageId: pkgId, duration: duration };

                    var buyModalEl = document.getElementById('buyAdModal');
                    var buyModal = bootstrap.Modal.getInstance(buyModalEl);
                    if (buyModal) buyModal.hide();

                    var pmModal = new bootstrap.Modal(document.getElementById('paymentMethodAdModal'));
                    pmModal.show();
                });
            }

            var adConfirmBtn = document.getElementById('adConfirmPaymentMethodBtn');
            if (adConfirmBtn) {
                adConfirmBtn.addEventListener('click', function () {
                    if (!pendingAdOrder) return;
                    var selectedMethod = document.querySelector('input[name="adPaymentMethod"]:checked')?.value || 'PaymobWallet';
                    var walletPhone = document.getElementById('adWalletPhoneInput')?.value?.trim() || '';
                    if (selectedMethod === 'PaymobWallet' && !walletPhone) {
                        alert('يرجى إدخال رقم المحفظة الإلكترونية للمتابعة (للتجربة: 01010101010)');
                        return;
                    }

                    adConfirmBtn.disabled = true;
                    adConfirmBtn.textContent = 'جارٍ التحويل للدفع...';

                    if (buyBtn) { buyBtn.disabled = true; buyBtn.textContent = 'جارٍ إنشاء الطلب...'; }

                    try {
                        var currentUrl = window.location.href;
                        sessionStorage.setItem('prePaymentPage', currentUrl);
                        localStorage.setItem('prePaymentPage', currentUrl);
                        document.cookie = "prePaymentUrl=" + encodeURIComponent(currentUrl) + "; path=/; max-age=3600; SameSite=Lax";
                    } catch (e) {}

                    fetch('/Clinic/CreateAdOrder', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            adPackageId: pendingAdOrder.packageId,
                            durationDays: pendingAdOrder.duration,
                            logoImageUrl: uploadedAdLogos.length > 0 ? uploadedAdLogos.join(',') : null,
                            paymentMethod: selectedMethod,
                            walletPhoneNumber: walletPhone
                        })
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (result) {
                        var pmModalEl = document.getElementById('paymentMethodAdModal');
                        var pmModal = bootstrap.Modal.getInstance(pmModalEl);
                        if (pmModal) pmModal.hide();
                        if (result.success && result.data && result.data.paymobRedirectUrl) {
                            window.location.href = result.data.paymobRedirectUrl;
                        } else if (result.success) {
                            showSuccessModal(result.message || 'تم إنشاء الطلب بنجاح');
                        } else {
                            showErrorModal(result.message || 'حدث خطأ أثناء إنشاء الطلب');
                        }
                    })
                    .catch(function () {
                        showErrorModal('عذراً، حدث خطأ أثناء إنشاء الطلب');
                    })
                    .finally(function(){
                        adConfirmBtn.disabled = false;
                        adConfirmBtn.textContent = 'متابعة للدفع';
                        if (buyBtn) { buyBtn.disabled = false; buyBtn.textContent = 'إتمام الطلب والدفع'; }
                        pendingAdOrder = null;
                    });
                });
            }

            var mSearch = document.getElementById('marketingAdsSearch');
            if (mSearch) {
                mSearch.addEventListener('input', function(){
                    var q = this.value.toLowerCase().trim();
                    document.querySelectorAll('#adsTableBody tr').forEach(function(tr){
                        if (tr.querySelector('td[colspan]')) return;
                        var txt = tr.textContent.toLowerCase();
                        tr.classList.toggle('cm-hidden', !!q && txt.indexOf(q) === -1);
                    });
                });
            }
        });
    </script>
}
