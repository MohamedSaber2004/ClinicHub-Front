@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "أوقات عمل العيادة - Doctory";
    Layout = "_ClinicLayout";

    var clinic = ViewBag.Clinic as ClinicManagmentDto;
    var workingDays = ViewBag.WorkingDays as List<int> ?? new List<int> { 6, 0, 1, 2, 3, 4 };
    var startHours = ViewBag.WorkingHoursStart as string ?? "09:00";
    var endHours = ViewBag.WorkingHoursEnd as string ?? "21:00";
    var hoursText = ViewBag.WorkingHoursText as string ?? "السبت - الخميس: 9:00 ص - 9:00 م | الجمعة: عطلة";
    var clinicName = ViewBag.ClinicName as string ?? "العيادة";
    var hasError = !string.IsNullOrEmpty(ViewBag.ErrorMessage as string);

    var daysDef = new (int id, string name, string shortName)[]
    {
        (6, "السبت", "سبت"),
        (0, "الأحد", "أحد"),
        (1, "الإثنين", "إثنين"),
        (2, "الثلاثاء", "ثلاثاء"),
        (3, "الأربعاء", "أربعاء"),
        (4, "الخميس", "خميس"),
        (5, "الجمعة", "جمعة")
    };

    string FormatTime12Razor(string timeStr)
    {
        if (string.IsNullOrEmpty(timeStr)) return "—";
        var parts = timeStr.Split(':');
        if (parts.Length < 2) return timeStr;
        if (!int.TryParse(parts[0], out var h)) return timeStr;
        var m = parts[1];
        var isAm = h < 12;
        var period = isAm ? "ص" : "م";
        var desc = isAm ? "صباحاً" : "مساءً";
        var h12 = h % 12;
        if (h12 == 0) h12 = 12;
        return $"{h12}:{m} {period} ({desc})";
    }

    bool IsAmRazor(string timeStr)
    {
        if (string.IsNullOrEmpty(timeStr)) return true;
        var parts = timeStr.Split(':');
        if (int.TryParse(parts[0], out var h))
        {
            return h < 12;
        }
        return true;
    }
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h2 class="page-title mb-1">
            <span class="page-title-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
                    <path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </span>
            أوقات عمل العيادة
        </h2>
        <p class="text-muted mb-0">إدارة مواعيد وأيام عمل @clinicName وجدول الفتح والإغلاق الأسبوعي</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge badge-success" id="clinicOpenStatusBadge">مفتوح الآن</span>
        <span class="text-muted text-sm" id="clinicLiveClock"></span>
    </div>
</div>

@if (hasError)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ErrorMessage
    </div>
}

<!-- Stats Grid -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-value" id="statActiveDays">@workingDays.Count أيام</span>
            <span class="stat-label">أيام العمل الأسبوعية</span>
        </div>
        <div class="icon-wrapper icon-wrapper--green">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm-8 4H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/>
            </svg>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-value" id="statDailyHours">—</span>
            <span class="stat-label">فترة الدوام القياسية</span>
        </div>
        <div class="icon-wrapper icon-wrapper--blue">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/>
            </svg>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-value" id="statTotalWeeklyHours">—</span>
            <span class="stat-label">إجمالي الساعات الأسبوعية</span>
        </div>
        <div class="icon-wrapper icon-wrapper--primary">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M15 1H9v2h6V1zm-4 13h2V8h-2v6zm8.03-6.61l1.42-1.42c-.43-.51-.9-.99-1.41-1.41l-1.42 1.42C16.07 4.74 14.12 4 12 4c-4.97 0-9 4.03-9 9s4.02 9 9 9 9-4.03 9-9c0-2.12-.74-4.07-1.97-5.61zM12 20c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z"/>
            </svg>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-value">30 دقيقة</span>
            <span class="stat-label">مدة الموعد (ثابتة)</span>
        </div>
        <div class="icon-wrapper icon-wrapper--amber">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
            </svg>
        </div>
    </div>
</div>

<!-- Main Availability Editor -->
<div class="detail-card">
    <div class="detail-section-header flex-wrap gap-2">
        <div>
            <h5>الجدول الأسبوعي لمواعيد العيادة</h5>
            <p class="form-hint mb-0">حدد أيام عمل العيادة وساعات الفتح والإغلاق لكل يوم من أيام الأسبوع.</p>
        </div>
        <div class="schedule-quick-actions">
            <button type="button" class="btn btn-sm btn-outline-primary" id="presetSatThuBtn">
                <i class="bi bi-calendar-check"></i> السبت - الخميس
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary" id="presetAllDaysBtn">
                <i class="bi bi-calendar-week"></i> طوال الأسبوع
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="presetFullShiftBtn" title="دوام كامل: من 9:00 ص حتى 9:00 م">
                <i class="bi bi-clock"></i> دوام كامل (9 ص - 9 م)
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="presetMorningShiftBtn" title="دوام صباحي: من 8:00 ص حتى 2:00 م">
                <i class="bi bi-sun"></i> صباحي (8 ص - 2 م)
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="presetEveningShiftBtn" title="دوام مسائي: من 4:00 م حتى 10:00 م">
                <i class="bi bi-moon-stars"></i> مسائي (4 م - 10 م)
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="applyTimesToAllBtn" title="تطبيق مواعيد السبت على كافة الأيام">
                <i class="bi bi-arrow-down-square"></i> تطبيق توقيت السبت على الكل
            </button>
        </div>
    </div>

    <!-- AM / PM Distinction Legend & Tips -->
    <div class="schedule-legend-bar mb-3">
        <div class="legend-periods">
            <span class="legend-period-item legend-period--am">
                <span class="period-pill period-pill--am"><i class="bi bi-sun-fill"></i> ص</span>
                <span class="period-title">صباحاً (AM):</span>
                <span class="period-desc">من 12:00 منتصف الليل حتى 11:59 ظهراً</span>
            </span>
            <span class="legend-period-item legend-period--pm">
                <span class="period-pill period-pill--pm"><i class="bi bi-moon-stars-fill"></i> م</span>
                <span class="period-title">مساءً (PM):</span>
                <span class="period-desc">من 12:00 ظهراً حتى 11:59 مساءً</span>
            </span>
        </div>
        <div class="legend-tip">
            <i class="bi bi-info-circle text-primary"></i>
            <span>اضغط مباشرة على زري <strong>ص</strong> أو <strong>م</strong> للتحويل الفوري، أو اختر وردية جاهزة لكل يوم.</span>
        </div>
    </div>

    <!-- Weekly Schedule Overview Ribbon -->
    @{
        var todayDow = (int)DateTime.Now.DayOfWeek;
    }
    <div class="schedule-week-ribbon" id="scheduleWeekRibbon">
        @foreach (var day in daysDef)
        {
            var isDayActive = workingDays.Contains(day.id);
            var isToday = (day.id == todayDow);
            <a href="javascript:void(0)" class="week-ribbon-day @(isDayActive ? "" : "is-off") @(isToday ? "is-today" : "")" data-day-id="@day.id" id="ribbonDay_@day.id" title="الانتقال السريع إلى يوم @day.name">
                @if (isToday)
                {
                    <span class="week-ribbon-today-tag">اليوم</span>
                }
                <span class="week-ribbon-name">@day.name</span>
                <span class="week-ribbon-status-dot" id="ribbonDot_@day.id"></span>
                <span class="week-ribbon-hours" id="ribbonHours_@day.id">@(isDayActive ? "9:00 ص - 9:00 م" : "عطلة")</span>
            </a>
        }
    </div>

    <!-- Cards Container for Days -->
    <div class="schedule-days-container" id="clinicScheduleList">
        @foreach (var day in daysDef)
        {
            var isDayActive = workingDays.Contains(day.id);
            var isToday = (day.id == todayDow);
            var isStartAm = IsAmRazor(startHours);
            var isEndAm = IsAmRazor(endHours);
            <div class="schedule-day-card @(isDayActive ? "is-active" : "is-off")" data-day-id="@day.id" id="scheduleCard_@day.id">
                <div class="schedule-day-header">
                    <div class="schedule-day-main-info">
                        <label class="form-toggle mb-0" title="@(isDayActive ? "تعطيل هذا اليوم" : "تفعيل هذا اليوم")">
                            <input type="checkbox" class="day-active-toggle" data-day-id="@day.id" @(isDayActive ? "checked" : "") />
                            <span class="toggle-track"></span>
                        </label>
                        <div class="schedule-day-title-box">
                            <h6 class="schedule-day-title">@day.name</h6>
                            @if (isToday)
                            {
                                <span class="schedule-today-pill"><i class="bi bi-clock"></i> اليوم</span>
                            }
                            <span class="badge @(isDayActive ? "badge-success" : "badge-secondary") day-status-badge" id="statusBadge_@day.id">
                                @(isDayActive ? "يوم عمل" : "عطلة أسبوعية")
                            </span>
                        </div>
                    </div>

                    <div class="schedule-day-header-actions">
                        <span class="badge badge-info day-hours-badge" id="hoursBadge_@day.id">12 ساعة</span>
                        <button type="button" class="schedule-copy-btn" title="نسخ توقيت @day.name إلى باقي الأيام" data-day-id="@day.id">
                            <i class="bi bi-copy"></i>
                            <span>نسخ للكل</span>
                        </button>
                    </div>
                </div>

                <!-- Active Working Body -->
                <div class="schedule-day-body is-working-body">
                    <div class="schedule-time-row">
                        <div class="schedule-time-box" data-time-type="start">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label class="schedule-time-sublabel mb-0" for="startTime_@day.id">من الساعة (البدء)</label>
                                <span class="schedule-period-badge @(isStartAm ? "badge-am" : "badge-pm")" id="startPeriodBadge_@day.id">
                                    <i class="bi @(isStartAm ? "bi-sun-fill" : "bi-moon-stars-fill")"></i>
                                    <span>@(isStartAm ? "صباحاً" : "مساءً")</span>
                                </span>
                            </div>
                            <div class="schedule-time-picker-box">
                                <input type="time" class="schedule-time-input day-start-time" id="startTime_@day.id" data-day-id="@day.id" value="@startHours" @(isDayActive ? "" : "disabled") />
                                <div class="time-period-switcher" role="group" aria-label="تحديد صباحاً أو مساءً">
                                    <button type="button" class="time-period-btn period-btn--am @(isStartAm ? "is-active" : "")" data-day-id="@day.id" data-type="start" data-period="am" title="صباحاً (ص / AM)" @(isDayActive ? "" : "disabled")>
                                        <i class="bi bi-sun-fill"></i> ص
                                    </button>
                                    <button type="button" class="time-period-btn period-btn--pm @(!isStartAm ? "is-active" : "")" data-day-id="@day.id" data-type="start" data-period="pm" title="مساءً (م / PM)" @(isDayActive ? "" : "disabled")>
                                        <i class="bi bi-moon-stars-fill"></i> م
                                    </button>
                                </div>
                            </div>
                            <div class="schedule-time-preview" id="startPreview_@day.id">
                                <span class="preview-12h">@FormatTime12Razor(startHours)</span>
                            </div>
                        </div>

                        <div class="schedule-time-separator-wrap">
                            <span class="schedule-time-separator">إلى</span>
                            <i class="bi bi-arrow-left schedule-time-arrow"></i>
                        </div>

                        <div class="schedule-time-box" data-time-type="end">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label class="schedule-time-sublabel mb-0" for="endTime_@day.id">إلى الساعة (الإغلاق)</label>
                                <span class="schedule-period-badge @(isEndAm ? "badge-am" : "badge-pm")" id="endPeriodBadge_@day.id">
                                    <i class="bi @(isEndAm ? "bi-sun-fill" : "bi-moon-stars-fill")"></i>
                                    <span>@(isEndAm ? "صباحاً" : "مساءً")</span>
                                </span>
                            </div>
                            <div class="schedule-time-picker-box">
                                <input type="time" class="schedule-time-input day-end-time" id="endTime_@day.id" data-day-id="@day.id" value="@endHours" @(isDayActive ? "" : "disabled") />
                                <div class="time-period-switcher" role="group" aria-label="تحديد صباحاً أو مساءً">
                                    <button type="button" class="time-period-btn period-btn--am @(isEndAm ? "is-active" : "")" data-day-id="@day.id" data-type="end" data-period="am" title="صباحاً (ص / AM)" @(isDayActive ? "" : "disabled")>
                                        <i class="bi bi-sun-fill"></i> ص
                                    </button>
                                    <button type="button" class="time-period-btn period-btn--pm @(!isEndAm ? "is-active" : "")" data-day-id="@day.id" data-type="end" data-period="pm" title="مساءً (م / PM)" @(isDayActive ? "" : "disabled")>
                                        <i class="bi bi-moon-stars-fill"></i> م
                                    </button>
                                </div>
                            </div>
                            <div class="schedule-time-preview" id="endPreview_@day.id">
                                <span class="preview-12h">@FormatTime12Razor(endHours)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Inline warning if end time is before start time -->
                    <div class="schedule-time-warning" id="timeWarning_@day.id">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>تنبيه: وقت الإغلاق يجب أن يكون بعد وقت البدء. تأكد من تحديد (م) لوقت الإغلاق إذا كان مسائياً.</span>
                    </div>

                    <!-- Per-Day Quick Shift Chips -->
                    <div class="schedule-day-shifts">
                        <span class="schedule-shift-label"><i class="bi bi-lightning-charge"></i> ورديات سريعة:</span>
                        <button type="button" class="schedule-shift-chip" data-day-id="@day.id" data-start="09:00" data-end="21:00" title="9:00 ص إلى 9:00 م">
                            9:00 ص - 9:00 م (كامل)
                        </button>
                        <button type="button" class="schedule-shift-chip" data-day-id="@day.id" data-start="08:00" data-end="14:00" title="8:00 ص إلى 2:00 م">
                            8:00 ص - 2:00 م (صباحي)
                        </button>
                        <button type="button" class="schedule-shift-chip" data-day-id="@day.id" data-start="16:00" data-end="22:00" title="4:00 م إلى 10:00 م">
                            4:00 م - 10:00 م (مسائي)
                        </button>
                    </div>
                </div>

                <!-- Off Day Body -->
                <div class="schedule-day-body is-off-body">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-x text-muted"></i>
                        <span>العيادة مغلقة طوال هذا اليوم (عطلة رسمية). لا يمكن حجز مواعيد للمرضى.</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary enable-day-btn" data-day-id="@day.id">
                        <i class="bi bi-check-circle"></i> تفعيل يوم العمل
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- General Working Hours Summary & Patient Simulator Section -->
    <div class="mt-4 pt-3 border-top">
        <div class="row g-3">
            <div class="col-lg-7">
                <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                    <div>
                        <h6 class="mb-1">النص التعريفي لأوقات العمل العامة</h6>
                        <p class="form-hint mb-0">هذا النص يظهر في بطاقة العيادة ونتائج البحث لتقديم نبذة سريعة للمرضى.</p>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="autoGenerateSummaryBtn">
                        <i class="bi bi-magic"></i> توليد ذكي من الجدول
                    </button>
                </div>
                <div class="form-group mb-0">
                    <input type="text" class="form-input" id="workingHoursSummaryInput" value="@hoursText" placeholder="مثال: السبت - الخميس: 9:00 ص - 9:00 م | الجمعة: عطلة" />
                </div>
            </div>

            <div class="col-lg-5">
                <div class="patient-simulator-card">
                    <div class="simulator-header">
                        <span class="simulator-header-title">
                            <i class="bi bi-eye"></i> معاينة بطاقة المريض
                        </span>
                        <span class="badge badge-success" id="simulatorStatusBadge">مفتوح الآن</span>
                    </div>
                    <div class="simulator-body">
                        <div class="simulator-clinic-row">
                            <span class="simulator-clinic-name">@clinicName</span>
                            <span class="badge badge-primary">معتمد</span>
                        </div>
                        <div class="simulator-hours-pill">
                            <i class="bi bi-clock me-1 text-primary"></i>
                            <span id="summaryPreviewText">@hoursText</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sticky Floating Action Bar -->
    <div class="schedule-sticky-bar">
        <div class="schedule-sticky-info">
            <span class="unsaved-badge" id="unsavedChangesBadge">
                <span class="unsaved-dot"></span>
                <span>تعديلات غير محفوظة</span>
            </span>
            <span class="schedule-sticky-summary" id="scheduleStickySummary">
                الجدول: @workingDays.Count أيام عمل • — ساعة أسبوعياً
            </span>
        </div>
        <div class="schedule-sticky-btns">
            <button type="button" class="btn btn-secondary" id="resetClinicAvailabilityBtn">
                <i class="bi bi-arrow-counterclockwise"></i> إلغاء التغييرات
            </button>
            <button type="button" class="btn btn-primary" id="saveClinicAvailabilityBtn">
                <i class="bi bi-check2"></i> حفظ أوقات عمل العيادة
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var DAYS_DEF = [
                { id: 6, name: 'السبت', shortName: 'سبت' },
                { id: 0, name: 'الأحد', shortName: 'أحد' },
                { id: 1, name: 'الإثنين', shortName: 'إثنين' },
                { id: 2, name: 'الثلاثاء', shortName: 'ثلاثاء' },
                { id: 3, name: 'الأربعاء', shortName: 'أربعاء' },
                { id: 4, name: 'الخميس', shortName: 'خميس' },
                { id: 5, name: 'الجمعة', shortName: 'جمعة' }
            ];

            var hasUnsavedChanges = false;

            function markDirty() {
                hasUnsavedChanges = true;
                var badge = document.getElementById('unsavedChangesBadge');
                if (badge) badge.classList.add('is-visible');
            }

            function markClean() {
                hasUnsavedChanges = false;
                var badge = document.getElementById('unsavedChangesBadge');
                if (badge) badge.classList.remove('is-visible');
            }

            window.addEventListener('beforeunload', function(e) {
                if (hasUnsavedChanges) {
                    e.preventDefault();
                    e.returnValue = '';
                }
            });

            function parseTimeToMinutes(t) {
                if (!t) return 0;
                var parts = t.split(':');
                var h = parseInt(parts[0], 10) || 0;
                var m = parseInt(parts[1], 10) || 0;
                return h * 60 + m;
            }

            function formatDurationText(minutes) {
                if (minutes <= 0) return '0 ساعة';
                var hours = Math.floor(minutes / 60);
                var mins = minutes % 60;
                if (mins === 0) return hours + ' ساعة';
                return hours + ' س و ' + mins + ' د';
            }

            function formatTime12(t, full) {
                if (!t) return '';
                var parts = t.split(':');
                var h = parseInt(parts[0], 10) || 0;
                var m = parts[1] || '00';
                var isAm = h < 12;
                var period = isAm ? 'ص' : 'م';
                var fullPeriod = isAm ? 'صباحاً' : 'مساءً';
                var h12 = h % 12;
                if (h12 === 0) h12 = 12;
                if (full) {
                    return h12 + ':' + m + ' ' + fullPeriod;
                }
                return h12 + ':' + m + ' ' + period;
            }

            function updateInputPeriodUI(input) {
                if (!input) return;
                var dayId = input.getAttribute('data-day-id');
                var isStart = input.classList.contains('day-start-time');
                var val = input.value || (isStart ? '09:00' : '21:00');
                var parts = val.split(':');
                var h = parseInt(parts[0], 10) || 0;
                var m = parts[1] || '00';
                var isAm = h < 12;

                var card = document.getElementById('scheduleCard_' + dayId);
                if (!card) return;

                var group = isStart ? card.querySelector('[data-time-type="start"]') : card.querySelector('[data-time-type="end"]');
                if (!group) return;

                // Update Switcher Buttons
                var amBtn = group.querySelector('.period-btn--am');
                var pmBtn = group.querySelector('.period-btn--pm');
                if (amBtn && pmBtn) {
                    if (isAm) {
                        amBtn.classList.add('is-active');
                        pmBtn.classList.remove('is-active');
                    } else {
                        pmBtn.classList.add('is-active');
                        amBtn.classList.remove('is-active');
                    }
                }

                // Update Header Tag
                var tag = group.querySelector('.schedule-period-badge');
                if (tag) {
                    if (isAm) {
                        tag.className = 'schedule-period-badge badge-am';
                        tag.innerHTML = '<i class="bi bi-sun-fill"></i> <span>صباحاً</span>';
                    } else {
                        tag.className = 'schedule-period-badge badge-pm';
                        tag.innerHTML = '<i class="bi bi-moon-stars-fill"></i> <span>مساءً</span>';
                    }
                }

                // Update 12-Hour Preview
                var preview = group.querySelector('.schedule-time-preview');
                if (preview) {
                    var h12 = h % 12;
                    if (h12 === 0) h12 = 12;
                    var chip = isAm ? 'ص' : 'م';
                    var desc = isAm ? 'صباحاً' : 'مساءً';
                    preview.innerHTML = '<span class="preview-12h">' + h12 + ':' + m + ' ' + chip + ' (' + desc + ')</span>';
                }
            }

            function setTimePeriod(input, targetPeriod) {
                if (!input || input.disabled) return;
                var val = input.value || '09:00';
                var parts = val.split(':');
                var h = parseInt(parts[0], 10) || 0;
                var m = parts[1] || '00';

                if (targetPeriod === 'am') {
                    if (h >= 12) {
                        h = h - 12;
                    }
                } else if (targetPeriod === 'pm') {
                    if (h < 12) {
                        h = h + 12;
                    }
                }

                var hStr = String(h).padStart(2, '0');
                input.value = hStr + ':' + m;

                updateInputPeriodUI(input);
                markDirty();
                recalculateStats();
            }

            function updateAllDaysTimeUI() {
                DAYS_DEF.forEach(function(day) {
                    var card = document.getElementById('scheduleCard_' + day.id);
                    if (!card) return;
                    var startInput = card.querySelector('.day-start-time');
                    var endInput = card.querySelector('.day-end-time');
                    if (startInput) updateInputPeriodUI(startInput);
                    if (endInput) updateInputPeriodUI(endInput);
                });
            }

            function recalculateStats() {
                var activeDaysCount = 0;
                var totalMinutesWeek = 0;
                var firstStart = null;
                var firstEnd = null;

                DAYS_DEF.forEach(function(day) {
                    var card = document.getElementById('scheduleCard_' + day.id);
                    var ribbonDay = document.getElementById('ribbonDay_' + day.id);
                    var ribbonHours = document.getElementById('ribbonHours_' + day.id);
                    if (!card) return;

                    var toggle = card.querySelector('.day-active-toggle');
                    var startInput = card.querySelector('.day-start-time');
                    var endInput = card.querySelector('.day-end-time');
                    var hoursBadge = card.querySelector('.day-hours-badge');
                    var statusBadge = card.querySelector('.day-status-badge');
                    var periodBtns = card.querySelectorAll('.time-period-btn');
                    var warningBox = document.getElementById('timeWarning_' + day.id);

                    if (toggle && toggle.checked) {
                        activeDaysCount++;
                        card.classList.add('is-active');
                        card.classList.remove('is-off');
                        if (ribbonDay) ribbonDay.classList.remove('is-off');

                        if (startInput) startInput.disabled = false;
                        if (endInput) endInput.disabled = false;
                        periodBtns.forEach(function(b) { b.disabled = false; });

                        if (statusBadge) {
                            statusBadge.className = 'badge badge-success day-status-badge';
                            statusBadge.textContent = 'يوم عمل';
                        }

                        var sMin = parseTimeToMinutes(startInput ? startInput.value : '09:00');
                        var eMin = parseTimeToMinutes(endInput ? endInput.value : '21:00');
                        var diff = 0;

                        if (eMin > sMin) {
                            diff = eMin - sMin;
                            if (warningBox) warningBox.classList.remove('is-visible');
                            if (hoursBadge) {
                                hoursBadge.className = 'badge badge-info day-hours-badge';
                                hoursBadge.textContent = formatDurationText(diff);
                            }
                        } else {
                            // Invalid interval: start >= end
                            diff = 0;
                            if (warningBox) warningBox.classList.add('is-visible');
                            if (hoursBadge) {
                                hoursBadge.className = 'badge badge-warning day-hours-badge';
                                hoursBadge.textContent = 'تنبيه في التوقيت';
                            }
                        }

                        totalMinutesWeek += diff;

                        if (ribbonHours && startInput && endInput) {
                            ribbonHours.textContent = formatTime12(startInput.value) + ' - ' + formatTime12(endInput.value);
                        }

                        if (!firstStart && startInput) firstStart = startInput.value;
                        if (!firstEnd && endInput) firstEnd = endInput.value;
                    } else {
                        card.classList.remove('is-active');
                        card.classList.add('is-off');
                        if (ribbonDay) ribbonDay.classList.add('is-off');

                        if (startInput) startInput.disabled = true;
                        if (endInput) endInput.disabled = true;
                        periodBtns.forEach(function(b) { b.disabled = true; });

                        if (statusBadge) {
                            statusBadge.className = 'badge badge-secondary day-status-badge';
                            statusBadge.textContent = 'عطلة أسبوعية';
                        }
                        if (hoursBadge) {
                            hoursBadge.className = 'badge badge-secondary day-hours-badge';
                            hoursBadge.textContent = 'عطلة';
                        }
                        if (warningBox) {
                            warningBox.classList.remove('is-visible');
                        }
                        if (ribbonHours) {
                            ribbonHours.textContent = 'عطلة';
                        }
                    }
                });

                var statActiveDaysEl = document.getElementById('statActiveDays');
                if (statActiveDaysEl) {
                    statActiveDaysEl.textContent = activeDaysCount + ' أيام / أسبوع';
                }

                var statDailyHoursEl = document.getElementById('statDailyHours');
                if (statDailyHoursEl) {
                    if (firstStart && firstEnd) {
                        statDailyHoursEl.textContent = formatTime12(firstStart, true) + ' - ' + formatTime12(firstEnd, true);
                    } else {
                        statDailyHoursEl.textContent = 'مغلق';
                    }
                }

                var statTotalWeeklyHoursEl = document.getElementById('statTotalWeeklyHours');
                if (statTotalWeeklyHoursEl) {
                    statTotalWeeklyHoursEl.textContent = (totalMinutesWeek / 60).toFixed(1) + ' ساعة';
                }

                var stickySummaryEl = document.getElementById('scheduleStickySummary');
                if (stickySummaryEl) {
                    stickySummaryEl.textContent = 'الجدول: ' + activeDaysCount + ' أيام عمل • ' + (totalMinutesWeek / 60).toFixed(1) + ' ساعة أسبوعياً';
                }

                updateLiveStatusBadge();
            }

            function updateLiveStatusBadge() {
                var now = new Date();
                var currentDay = now.getDay();
                var currentMinutes = now.getHours() * 60 + now.getMinutes();

                var statusBadge = document.getElementById('clinicOpenStatusBadge');
                var simulatorBadge = document.getElementById('simulatorStatusBadge');
                var liveClock = document.getElementById('clinicLiveClock');

                if (liveClock) {
                    var hours = now.getHours();
                    var mins = String(now.getMinutes()).padStart(2, '0');
                    var period = hours >= 12 ? 'مساءً' : 'صباحاً';
                    var h12 = hours % 12 || 12;
                    liveClock.textContent = 'الوقت الآن: ' + h12 + ':' + mins + ' ' + period;
                }

                var todayCard = document.getElementById('scheduleCard_' + currentDay);
                if (!todayCard) return;

                var toggle = todayCard.querySelector('.day-active-toggle');
                var startInput = todayCard.querySelector('.day-start-time');
                var endInput = todayCard.querySelector('.day-end-time');

                var isOpen = false;
                if (toggle && toggle.checked && startInput && endInput) {
                    var sMin = parseTimeToMinutes(startInput.value);
                    var eMin = parseTimeToMinutes(endInput.value);
                    if (eMin > sMin) {
                        isOpen = (currentMinutes >= sMin && currentMinutes < eMin);
                    }
                }

                var statusClass = isOpen ? 'badge badge-success' : 'badge badge-danger';
                var statusText = isOpen ? 'مفتوح الآن' : 'مغلق الآن';

                if (statusBadge) {
                    statusBadge.className = statusClass;
                    statusBadge.textContent = statusText;
                }
                if (simulatorBadge) {
                    simulatorBadge.className = statusClass;
                    simulatorBadge.textContent = statusText;
                }
            }

            function generateAutoSummary() {
                var activeDays = [];
                var inactiveDays = [];
                var commonStart = null;
                var commonEnd = null;
                var isUniform = true;

                DAYS_DEF.forEach(function(day) {
                    var card = document.getElementById('scheduleCard_' + day.id);
                    if (!card) return;
                    var toggle = card.querySelector('.day-active-toggle');
                    var startInput = card.querySelector('.day-start-time');
                    var endInput = card.querySelector('.day-end-time');

                    if (toggle && toggle.checked) {
                        activeDays.push(day);
                        var s = startInput ? startInput.value : '';
                        var e = endInput ? endInput.value : '';
                        if (!commonStart && !commonEnd) {
                            commonStart = s;
                            commonEnd = e;
                        } else if (commonStart !== s || commonEnd !== e) {
                            isUniform = false;
                        }
                    } else {
                        inactiveDays.push(day);
                    }
                });

                if (activeDays.length === 0) {
                    return 'العيادة مغلقة مؤقتاً';
                }

                var summary = '';
                if (activeDays.length === 7) {
                    summary = 'طوال أيام الأسبوع';
                } else if (activeDays.length === 6 && inactiveDays.length === 1) {
                    summary = 'السبت - الخميس';
                } else {
                    summary = activeDays.map(function(d) { return d.name; }).join('، ');
                }

                if (commonStart && commonEnd && isUniform) {
                    summary += ': من ' + formatTime12(commonStart, true) + ' حتى ' + formatTime12(commonEnd, true);
                } else {
                    summary += ' (حسب الجدول اليومي)';
                }

                if (inactiveDays.length > 0 && activeDays.length < 7) {
                    summary += ' | ' + inactiveDays.map(function(d) { return d.name; }).join(' و ') + ': عطلة';
                }

                return summary;
            }

            // Ribbon Scroll Navigation with highlight
            document.querySelectorAll('.week-ribbon-day').forEach(function(ribbonItem) {
                ribbonItem.addEventListener('click', function(e) {
                    e.preventDefault();
                    var dayId = this.getAttribute('data-day-id');
                    var card = document.getElementById('scheduleCard_' + dayId);
                    if (card) {
                        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        card.classList.remove('is-highlighted');
                        void card.offsetWidth; // Force reflow
                        card.classList.add('is-highlighted');
                        setTimeout(function() {
                            card.classList.remove('is-highlighted');
                        }, 1600);
                    }
                });
            });

            // Day active toggle change
            document.querySelectorAll('.day-active-toggle').forEach(function(t) {
                t.addEventListener('change', function() {
                    markDirty();
                    recalculateStats();
                });
            });

            // Enable day button in off-body
            document.querySelectorAll('.enable-day-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var dayId = this.getAttribute('data-day-id');
                    var card = document.getElementById('scheduleCard_' + dayId);
                    if (!card) return;
                    var toggle = card.querySelector('.day-active-toggle');
                    if (toggle) {
                        toggle.checked = true;
                        markDirty();
                        recalculateStats();
                    }
                });
            });

            // Inputs change
            document.querySelectorAll('.schedule-time-input').forEach(function(input) {
                input.addEventListener('input', function() {
                    updateInputPeriodUI(this);
                    markDirty();
                    recalculateStats();
                });
                input.addEventListener('change', function() {
                    updateInputPeriodUI(this);
                    markDirty();
                    recalculateStats();
                });
            });

            // AM / PM Switcher buttons
            document.querySelectorAll('.time-period-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    var dayId = this.getAttribute('data-day-id');
                    var type = this.getAttribute('data-type');
                    var period = this.getAttribute('data-period');
                    var card = document.getElementById('scheduleCard_' + dayId);
                    if (!card) return;

                    var input = type === 'start' ? card.querySelector('.day-start-time') : card.querySelector('.day-end-time');
                    if (input && !input.disabled) {
                        setTimePeriod(input, period);
                    }
                });
            });

            // Per-day quick shift chips
            document.querySelectorAll('.schedule-shift-chip').forEach(function(chip) {
                chip.addEventListener('click', function() {
                    var dayId = this.getAttribute('data-day-id');
                    var start = this.getAttribute('data-start');
                    var end = this.getAttribute('data-end');
                    var card = document.getElementById('scheduleCard_' + dayId);
                    if (!card) return;

                    var startInput = card.querySelector('.day-start-time');
                    var endInput = card.querySelector('.day-end-time');
                    if (startInput) startInput.value = start;
                    if (endInput) endInput.value = end;

                    updateInputPeriodUI(startInput);
                    updateInputPeriodUI(endInput);
                    markDirty();
                    recalculateStats();
                });
            });

            // Copy to other days button
            document.querySelectorAll('.schedule-copy-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var dayId = this.getAttribute('data-day-id');
                    var card = document.getElementById('scheduleCard_' + dayId);
                    if (!card) return;
                    var startVal = card.querySelector('.day-start-time').value;
                    var endVal = card.querySelector('.day-end-time').value;

                    document.querySelectorAll('.schedule-day-card').forEach(function(otherCard) {
                        var otherId = otherCard.getAttribute('data-day-id');
                        if (otherId !== dayId) {
                            var otherStart = otherCard.querySelector('.day-start-time');
                            var otherEnd = otherCard.querySelector('.day-end-time');
                            if (otherStart) otherStart.value = startVal;
                            if (otherEnd) otherEnd.value = endVal;
                        }
                    });

                    updateAllDaysTimeUI();
                    markDirty();
                    recalculateStats();
                    if (window.showInfoToast) window.showInfoToast('تم نسخ التوقيت إلى جميع الأيام');
                });
            });

            // Presets: Sat - Thu
            var presetSatThu = document.getElementById('presetSatThuBtn');
            if (presetSatThu) {
                presetSatThu.addEventListener('click', function() {
                    DAYS_DEF.forEach(function(day) {
                        var card = document.getElementById('scheduleCard_' + day.id);
                        if (!card) return;
                        var toggle = card.querySelector('.day-active-toggle');
                        if (toggle) {
                            toggle.checked = (day.id !== 5);
                        }
                    });
                    markDirty();
                    recalculateStats();
                });
            }

            // Presets: All Days
            var presetAllDays = document.getElementById('presetAllDaysBtn');
            if (presetAllDays) {
                presetAllDays.addEventListener('click', function() {
                    DAYS_DEF.forEach(function(day) {
                        var card = document.getElementById('scheduleCard_' + day.id);
                        if (!card) return;
                        var toggle = card.querySelector('.day-active-toggle');
                        if (toggle) toggle.checked = true;
                    });
                    markDirty();
                    recalculateStats();
                });
            }

            // Global Shift Presets
            function applyShiftToAllActiveDays(startTime, endTime, label) {
                DAYS_DEF.forEach(function(day) {
                    var card = document.getElementById('scheduleCard_' + day.id);
                    if (!card) return;
                    var toggle = card.querySelector('.day-active-toggle');
                    if (toggle && toggle.checked) {
                        var startInput = card.querySelector('.day-start-time');
                        var endInput = card.querySelector('.day-end-time');
                        if (startInput) startInput.value = startTime;
                        if (endInput) endInput.value = endTime;
                    }
                });
                updateAllDaysTimeUI();
                markDirty();
                recalculateStats();
                if (window.showInfoToast) window.showInfoToast('تم تطبيق ' + label + ' على أيام العمل');
            }

            var presetFullShift = document.getElementById('presetFullShiftBtn');
            if (presetFullShift) {
                presetFullShift.addEventListener('click', function() {
                    applyShiftToAllActiveDays('09:00', '21:00', 'الدوام الكامل (9:00 ص - 9:00 م)');
                });
            }

            var presetMorningShift = document.getElementById('presetMorningShiftBtn');
            if (presetMorningShift) {
                presetMorningShift.addEventListener('click', function() {
                    applyShiftToAllActiveDays('08:00', '14:00', 'الدوام الصباحي (8:00 ص - 2:00 م)');
                });
            }

            var presetEveningShift = document.getElementById('presetEveningShiftBtn');
            if (presetEveningShift) {
                presetEveningShift.addEventListener('click', function() {
                    applyShiftToAllActiveDays('16:00', '22:00', 'الدوام المسائي (4:00 م - 10:00 م)');
                });
            }

            var applyTimesAll = document.getElementById('applyTimesToAllBtn');
            if (applyTimesAll) {
                applyTimesAll.addEventListener('click', function() {
                    var satCard = document.getElementById('scheduleCard_6');
                    if (!satCard) return;
                    var sVal = satCard.querySelector('.day-start-time').value;
                    var eVal = satCard.querySelector('.day-end-time').value;

                    document.querySelectorAll('.day-start-time').forEach(function(i) { i.value = sVal; });
                    document.querySelectorAll('.day-end-time').forEach(function(i) { i.value = eVal; });
                    updateAllDaysTimeUI();
                    markDirty();
                    recalculateStats();
                    if (window.showInfoToast) window.showInfoToast('تم تطبيق مواعيد السبت على جميع الأيام');
                });
            }

            // Summary auto-generate
            var autoGenBtn = document.getElementById('autoGenerateSummaryBtn');
            var summaryInput = document.getElementById('workingHoursSummaryInput');
            var previewText = document.getElementById('summaryPreviewText');

            if (autoGenBtn && summaryInput) {
                autoGenBtn.addEventListener('click', function() {
                    var gen = generateAutoSummary();
                    summaryInput.value = gen;
                    if (previewText) previewText.textContent = gen;
                    markDirty();
                    if (window.showInfoToast) window.showInfoToast('تم توليد النص التعريفي بنجاح');
                });
            }

            if (summaryInput && previewText) {
                summaryInput.addEventListener('input', function() {
                    previewText.textContent = this.value || '—';
                    markDirty();
                });
            }

            // Initial UI sync
            updateAllDaysTimeUI();

            // Save Availability
            var saveBtn = document.getElementById('saveClinicAvailabilityBtn');
            if (saveBtn) {
                saveBtn.addEventListener('click', function() {
                    var activeDayIds = [];
                    var primaryStart = null;
                    var primaryEnd = null;

                    DAYS_DEF.forEach(function(day) {
                        var card = document.getElementById('scheduleCard_' + day.id);
                        if (!card) return;
                        var toggle = card.querySelector('.day-active-toggle');
                        var startInput = card.querySelector('.day-start-time');
                        var endInput = card.querySelector('.day-end-time');

                        if (toggle && toggle.checked) {
                            activeDayIds.push(day.id);
                            if (!primaryStart && startInput) primaryStart = startInput.value;
                            if (!primaryEnd && endInput) primaryEnd = endInput.value;
                        }
                    });

                    var summaryVal = summaryInput ? summaryInput.value.trim() : '';
                    if (!summaryVal) {
                        summaryVal = generateAutoSummary();
                    }

                    saveBtn.disabled = true;
                    var originalHtml = saveBtn.innerHTML;
                    saveBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> جارٍ الحفظ...';

                    var payload = {
                        workingHoursStart: (primaryStart ? primaryStart + ':00' : '09:00:00'),
                        workingHoursEnd: (primaryEnd ? primaryEnd + ':00' : '21:00:00'),
                        workingDays: activeDayIds,
                        workingHours: summaryVal
                    };

                    var token = localStorage.getItem('accessToken') || '';
                    if (!token) {
                        var match = document.cookie.match(new RegExp('(^|;\\s*)([aA]ccess[tT]oken)=([^;]+)'));
                        if (match) {
                            token = decodeURIComponent(match[3]);
                        }
                    }

                    var reqHeaders = {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    };
                    if (token) {
                        reqHeaders['Authorization'] = 'Bearer ' + token;
                    }

                    if (window.showLoader) {
                        window.showLoader('جارٍ حفظ أوقات عمل العيادة...');
                    }

                    fetch('/Clinic/SaveClinicAvailability', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: reqHeaders,
                        body: JSON.stringify(payload)
                    })
                    .then(function(r) {
                        if (r.status === 401) {
                            throw new Error('انتهت صلاحية الجلسة، يرجى تسجيل الدخول مجدداً.');
                        }
                        if (r.status === 403) {
                            throw new Error('غير مصرح لك بتعديل بيانات العيادة أو انتهى اشتراكك.');
                        }
                        return r.json();
                    })
                    .then(function(res) {
                        if (window.hideLoader) {
                            window.hideLoader();
                        }
                        saveBtn.disabled = false;
                        saveBtn.innerHTML = originalHtml;
                        if (res.success) {
                            markClean();
                            if (window.showSuccessModal) {
                                window.showSuccessModal(res.message || 'تم حفظ أوقات عمل العيادة بنجاح');
                            } else if (window.showSuccessToast) {
                                window.showSuccessToast(res.message || 'تم حفظ أوقات عمل العيادة بنجاح');
                            } else {
                                alert(res.message || 'تم حفظ أوقات عمل العيادة بنجاح');
                            }
                        } else {
                            if (window.showErrorModal) {
                                window.showErrorModal(res.message || 'فشل في حفظ أوقات العمل');
                            } else {
                                alert(res.message || 'فشل في حفظ أوقات العمل');
                            }
                        }
                    })
                    .catch(function(err) {
                        if (window.hideLoader) {
                            window.hideLoader(true);
                        }
                        saveBtn.disabled = false;
                        saveBtn.innerHTML = originalHtml;
                        var msg = err && err.message ? err.message : 'عذراً، حدث خطأ غير متوقع أثناء الحفظ.';
                        if (window.showErrorModal) {
                            window.showErrorModal(msg);
                        } else {
                            alert(msg);
                        }
                    });
                });
            }

            // Reset
            var resetBtn = document.getElementById('resetClinicAvailabilityBtn');
            if (resetBtn) {
                resetBtn.addEventListener('click', function() {
                    if (hasUnsavedChanges) {
                        if (!confirm('هل أنت متأكد من إلغاء كافة التغييرات وإعادة تعيين الجدول؟')) {
                            return;
                        }
                    }
                    markClean();
                    window.location.reload();
                });
            }

            // Initial calculate
            recalculateStats();
            setInterval(updateLiveStatusBadge, 30000);
        })();
    </script>
}
