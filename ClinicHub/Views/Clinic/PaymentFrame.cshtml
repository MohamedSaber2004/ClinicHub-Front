@{
    ViewData["Title"] = "بوابة الدفع - Doctory";
    var paymentUrl = ViewBag.PaymentUrl as string ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/clinic-money.css?v=20261027_redesign_v2" />
}

<section class="payment-frame-section cm-frame">
    <div class="container">
        <div class="cm-frame-card">
            <div class="cm-frame-bar">
                <h2 class="cm-frame-title">
                    <span class="page-title-icon">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
                        </svg>
                    </span>
                    صفحة الدفع الإلكتروني
                </h2>
                <a href="/" class="btn btn-secondary btn-sm">العودة للرئيسية</a>
            </div>
            <div class="cm-frame-body">
                <div class="cm-frame-skeleton" aria-hidden="true">
                    <span class="skeleton-bar-shimmer cm-skeleton-line cm-skeleton-line--title"></span>
                    <span class="skeleton-bar-shimmer cm-skeleton-line cm-skeleton-line--sub"></span>
                    <span class="skeleton-bar-shimmer cm-skeleton-line cm-skeleton-line--field"></span>
                    <span class="skeleton-bar-shimmer cm-skeleton-line cm-skeleton-line--field"></span>
                    <span class="skeleton-bar-shimmer cm-skeleton-line cm-skeleton-line--cta"></span>
                </div>
                <iframe id="paymentFrame" src="@paymentUrl" class="payment-frame-iframe"></iframe>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function() {
            var iframe = document.getElementById('paymentFrame');
            if (!iframe) return;

            var checkTimer = setInterval(function() {
                try {
                    var frameUrl = iframe.contentWindow.location.href;
                    if (frameUrl && frameUrl.indexOf('result.html') !== -1) {
                        clearInterval(checkTimer);
                        var isSuccess = frameUrl.indexOf('success=True') !== -1 || frameUrl.indexOf('success=true') !== -1;
                        setTimeout(function() {
                            window.location.href = '/Home/PaymentResult?success=' + (isSuccess ? 'true' : 'false');
                        }, 2500);
                    }
                } catch (e) {
                    // Cross-origin iframe navigation check fallback
                }
            }, 500);

            iframe.addEventListener('load', function() {
                try {
                    var frameUrl = iframe.contentWindow.location.href;
                    if (frameUrl && frameUrl.indexOf('result.html') !== -1) {
                        clearInterval(checkTimer);
                        var isSuccess = frameUrl.indexOf('success=True') !== -1 || frameUrl.indexOf('success=true') !== -1;
                        setTimeout(function() {
                            window.location.href = '/Home/PaymentResult?success=' + (isSuccess ? 'true' : 'false');
                        }, 2500);
                    }
                } catch (e) {
                    // Ignored cross-origin security error when on third-party domain
                }
            });
        })();
    </script>
}
