@using ClinicHub.Data
@using ClinicHub.Services.ReponseModels
@using ClinicHub.Services.Options
@inject ClinicHub.Services.Contracts.IAttachmentUrlResolver _attachmentUrlResolver
@{
    ViewData["Title"] = "إدارة الأطباء - Doctory";
    Layout = "_ClinicLayout";
    var _user = ViewBag.CurrentUser as CurrentUserContext;
    var doctors = ViewBag.DoctorsList as IReadOnlyCollection<DoctorDto> ?? new List<DoctorDto>();
    var pagination = ViewBag.Pagination as PagginatedResult<DoctorDto>;
    var specializations = ViewBag.Specializations as IReadOnlyCollection<SpecializationDto> ?? new List<SpecializationDto>();
    var searchTerm = ViewBag.SearchTerm as string;
    var selectedSpecId = ViewBag.SelectedSpecializationId as Guid?;
    var attachmentBaseUrl = _attachmentUrlResolver.Resolve("x").Replace("/files/x", "");
}

<div class="page-header">
    <h2 class="page-title mb-0">إدارة الأطباء</h2>
    <button class="btn btn-primary" id="addDoctorBtn">
        <i class="bi bi-person-plus me-1"></i> إضافة طبيب
    </button>
</div>

@if (_user?.MaxDoctors.HasValue == true)
{
    <div class="plan-info-bar">
        <div class="plan-info-item">
            <span class="plan-info-label">الحد الأقصى للأطباء في باقتك</span>
            <span class="plan-info-value">@_user.MaxDoctors طبيب</span>
        </div>
        <span class="small text-muted">لزيادة الحد الأقصى، قم بترقية باقتك.</span>
        <a href="/Clinic/MySubscription" class="plan-info-link">ترقية الباقة <i class="bi bi-arrow-left"></i></a>
    </div>
}

<div class="table-card p-4 mb-4">
    <form method="get" action="@Url.Action("Doctors")" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label">بحث</label>
            <input type="text" name="searchTerm" class="form-input form-input-sm w-100" placeholder="ابحث باسم الطبيب أو البريد الإلكتروني..." value="@searchTerm" />
        </div>
        <div class="col-md-4">
            <label class="form-label">التخصص</label>
            <select name="specializationId" class="form-select form-input-sm w-100">
                <option value="">جميع التخصصات</option>
                @foreach (var spec in specializations)
                {
                    <option value="@spec.Id" selected="@(selectedSpecId == spec.Id)">@spec.ArName</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search me-1"></i> بحث
            </button>
        </div>
    </form>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="table-card p-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">قائمة الأطباء</h4>
        @if (pagination != null)
        {
            <span class="text-md">إجمالي: @pagination.TotalCount طبيب</span>
        }
    </div>

    @if (doctors.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-people empty-state-icon"></i>
            <p class="empty-desc">لا يوجد أطباء مسجلون في العيادة</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>الصورة</th>
                        <th>الاسم</th>
                        <th>البريد الإلكتروني</th>
                        <th>التخصص</th>
                        <th>سنوات الخبرة</th>
                        <th>الحالة</th>
                        <th>تاريخ الإضافة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doctor in doctors)
                    {
                        var imgUrl = !string.IsNullOrEmpty(doctor.ProfilePictureUrl)
                            ? _attachmentUrlResolver.Resolve(doctor.ProfilePictureUrl)
                            : null;
                        <tr>
                            <td>
                                @if (imgUrl != null)
                                {
                                    <img src="@imgUrl" alt="صورة" class="table-avatar table-avatar--md" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <div class="table-avatar table-avatar--md">
                                        <i class="bi bi-person"></i>
                                    </div>
                                }
                            </td>
                            <td><strong>@doctor.UserName</strong></td>
                            <td class="text-md">@doctor.UserEmail</td>
                            <td><span class="badge badge-info">@doctor.SpecializationName</span></td>
                            <td>@doctor.YearsOfExperience سنة</td>
                            <td>
                                @if (doctor.IsActive)
                                {
                                    <span class="badge badge-success">نشط</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">غير نشط</span>
                                }
                            </td>
                            <td class="text-md">@doctor.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                <div class="table-actions">
                                    <button class="btn btn-sm btn-secondary view-doctor-btn"
                                            data-id="@doctor.Id"
                                            title="عرض التفاصيل">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary edit-doctor-btn"
                                            data-id="@doctor.Id"
                                            title="تعديل">
                                        <i class="bi bi-pencil me-1"></i> تعديل
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary change-password-doctor-btn"
                                            data-id="@doctor.Id"
                                            data-userid="@doctor.UserId"
                                            data-name="@doctor.UserName"
                                            title="تغيير كلمة المرور">
                                        <i class="bi bi-key me-1"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger delete-doctor-btn"
                                            data-id="@doctor.Id"
                                            data-name="@doctor.UserName">
                                        <i class="bi bi-trash me-1"></i> حذف
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        if (pagination != null && pagination.TotalPages > 1)
        {
            <nav class="pagination-nav mt-4">
                <ul class="pagination-list">
                    @if (pagination.HasPreviousPage)
                    {
                        <li class="pagination-item">
                            <a class="pagination-link" href="@Url.Action("Doctors", new { pageNumber = pagination.PageNumber - 1, pageSize = pagination.PageSize, searchTerm, specializationId = selectedSpecId })">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg> السابق
                            </a>
                        </li>
                    }
                    @for (var i = 1; i <= pagination.TotalPages; i++)
                    {
                        <li class="pagination-item">
                            <a class="pagination-link @(i == pagination.PageNumber ? "pagination-link--active" : "")"
                               href="@Url.Action("Doctors", new { pageNumber = i, pageSize = pagination.PageSize, searchTerm, specializationId = selectedSpecId })">@i</a>
                        </li>
                    }
                    @if (pagination.HasNextPage)
                    {
                        <li class="pagination-item">
                            <a class="pagination-link" href="@Url.Action("Doctors", new { pageNumber = pagination.PageNumber + 1, pageSize = pagination.PageSize, searchTerm, specializationId = selectedSpecId })">
                                التالي <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/></svg>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>

<div class="modal fade" id="createDoctorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-content-custom">
            <div class="modal-header modal-header-custom">
                <h5 class="modal-title">إضافة طبيب جديد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body modal-body-custom">
                <form id="createDoctorForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">الاسم الكامل <span class="text-danger">*</span></label>
                            <input type="text" class="form-input form-input-sm w-100" id="createDoctorFullName" required placeholder="مثال: أحمد علي" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">البريد الإلكتروني <span class="text-danger">*</span></label>
                            <input type="email" class="form-input form-input-sm w-100" id="createDoctorEmail" required placeholder="example@domain.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">رقم الهاتف <span class="text-danger">*</span></label>
                            <input type="text" class="form-input form-input-sm w-100" id="createDoctorPhone" required placeholder="+201234567890" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">كلمة المرور <span class="text-danger">*</span></label>
                            <input type="password" class="form-input form-input-sm w-100" id="createDoctorPassword" required minlength="6" placeholder="********" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">الجنس <span class="text-danger">*</span></label>
                            <select class="form-select form-input-sm w-100" id="createDoctorGender" required>
                                <option value="1">ذكر</option>
                                <option value="2">أنثى</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">تاريخ الميلاد</label>
                            <input type="date" class="form-input form-input-sm w-100" id="createDoctorBirthDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">التخصص <span class="text-danger">*</span></label>
                            <select class="form-select form-input-sm w-100" id="createDoctorSpecializationId" required>
                                <option value="">اختر التخصص</option>
                                @foreach (var spec in specializations)
                                {
                                    <option value="@spec.Id">@spec.ArName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">سنوات الخبرة</label>
                            <input type="number" class="form-input form-input-sm w-100" id="createDoctorExperience" value="0" min="0" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">صورة الطبيب (اختياري)</label>
                            <div class="file-upload-wrapper">
                                <input type="file" id="createDoctorImageInput" accept="image/*" class="form-input form-input-sm w-100" />
                                <input type="hidden" id="createDoctorImage" />
                                <div id="createDoctorImageStatus" class="upload-status-badge d-none align-items-center gap-2 mt-2">
                                    <img id="createDoctorImagePreview" src="" alt="صورة الطبيب" class="avatar-preview" />
                                    <span class="badge badge-success"><i class="bi bi-check-circle"></i> <span id="createDoctorImageFileName"></span></span>
                                    <button type="button" class="btn btn-sm p-0 border-0 bg-transparent text-danger" id="removeDoctorImageBtn" title="إزالة الصورة">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">السيرة الذاتية (اختياري)</label>
                            <textarea class="form-input form-input-sm w-100" id="createDoctorBio" rows="3" placeholder="نبذة عن الطبيب..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">أوقات العمل (اختياري)</label>
                            <div id="availabilityContainer">
                                <div class="availability-row" data-index="0">
                                    <select class="availability-day form-select auth-form-control">
                                        <option value="">اليوم</option>
                                        <option value="0">الأحد</option>
                                        <option value="1">الإثنين</option>
                                        <option value="2">الثلاثاء</option>
                                        <option value="3">الأربعاء</option>
                                        <option value="4">الخميس</option>
                                        <option value="5">الجمعة</option>
                                        <option value="6">السبت</option>
                                    </select>
                                    <select class="availability-from-hour form-select auth-form-control">
                                        <option value="">—</option>
                                        @for (var i = 1; i <= 12; i++)
                                        {
                                            <option value="@i" selected="@(i == 9)">@i</option>
                                        }
                                    </select>
                                    <select class="availability-from-minute form-select auth-form-control">
                                        @for (var i = 0; i <= 59; i++)
                                        {
                                            var mm = i.ToString("00");
                                            <option value="@mm" selected="@(i == 0)">@mm</option>
                                        }
                                    </select>
                                    <select class="availability-from-period form-select auth-form-control">
                                        <option value="AM" selected>صباحاً</option>
                                        <option value="PM">مساءً</option>
                                    </select>
                                    <span class="availability-sep">إلى</span>
                                    <select class="availability-to-hour form-select auth-form-control">
                                        <option value="">—</option>
                                        @for (var i = 1; i <= 12; i++)
                                        {
                                            <option value="@i" selected="@(i == 5)">@i</option>
                                        }
                                    </select>
                                    <select class="availability-to-minute form-select auth-form-control">
                                        @for (var i = 0; i <= 59; i++)
                                        {
                                            var mm = i.ToString("00");
                                            <option value="@mm" selected="@(i == 0)">@mm</option>
                                        }
                                    </select>
                                    <select class="availability-to-period form-select auth-form-control">
                                        <option value="AM">صباحاً</option>
                                        <option value="PM" selected>مساءً</option>
                                    </select>
                                    <button type="button" class="availability-remove-btn" title="حذف"><i class="bi bi-x-circle"></i></button>
                                </div>
                            </div>
                            <button type="button" id="addAvailabilityBtn" class="btn btn-sm add-availability-btn">
                                <i class="bi bi-plus-circle"></i> إضافة يوم
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="createDoctorSubmitBtn">إضافة</button>
            </div>
        </div>
    </div>
</div>

