                        <div class="col-12">
                            <label class="form-label" style="font-weight: 600; font-size: 13px;">أوقات العمل (اختياري)</label>
                            <div id="editAvailabilityContainer">
                            </div>
                            <button type="button" id="addEditAvailabilityBtn" class="btn btn-sm add-availability-btn">
                                <i class="bi bi-plus-circle"></i> إضافة يوم
                            </button>
