                <button type="button" class="btn" id="editDoctorSubmitBtn" style="min-width: 100px; padding: 10px 24px; background-color: var(--clr-primary); color: #FFFFFF; border: none; border-radius: var(--radius-sm); font-weight: 600;">حفظ التغييرات</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="viewDoctorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <div class="modal-header modal-header-custom">
                <h5 class="modal-title">تفاصيل الطبيب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body modal-body-custom" id="viewDoctorBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">جاري التحميل...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="changePasswordDoctorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <div class="modal-header modal-header-custom">
                <h5 class="modal-title">تغيير كلمة مرور الطبيب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body modal-body-custom">
                <form id="changePasswordDoctorForm">
                    <input type="hidden" id="changePasswordDoctorId" />
                    <div class="form-group mb-3">
                        <label class="form-label">الطبيب</label>
                        <p class="fw-bold" id="changePasswordDoctorName" style="margin: 0;"></p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">كلمة المرور الجديدة</label>
                        <input type="password" class="form-input form-input-sm w-100" id="changePasswordDoctorNew" placeholder="كلمة المرور الجديدة" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">تأكيد كلمة المرور</label>
                        <input type="password" class="form-input form-input-sm w-100" id="changePasswordDoctorConfirm" placeholder="تأكيد كلمة المرور" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="changePasswordDoctorSubmitBtn">حفظ كلمة المرور</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function escapeHtml(text) {
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(text));
            return div.innerHTML;
        }

        function formatDate(dateStr) {
            if (!dateStr) return '-';
            var d = new Date(dateStr);
            return d.toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' })
                + ' ' + d.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
        }

        function setButtonLoading(btn, isLoading) {
            if (isLoading) {
                btn.data('original-html', btn.html());
                btn.prop('disabled', true);
                btn.html('<span class="spinner-border spinner-border-sm me-1"></span> جاري...');
            } else {
                btn.prop('disabled', false);
                btn.html(btn.data('original-html'));
            }
        }

        function renderDoctorDetail(doctor) {
            var statusHtml = doctor.isActive
                ? '<span class="badge badge-success">نشط</span>'
                : '<span class="badge badge-danger">غير نشط</span>';
            var imgHtml = doctor.profilePictureUrl
                ? '<img src="' + attachmentBaseUrl + '/files/' + doctor.profilePictureUrl.replace(/^files\//, '') + '" alt="صورة الطبيب" class="rounded" style="width: 80px; height: 80px; object-fit: cover; border: 1px solid var(--clr-border);" />'
                : '<div class="rounded d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; background: var(--clr-surface-secondary); color: var(--clr-text-secondary); font-size: 28px;"><i class="bi bi-person"></i></div>';
            var availHtml = '';
            if (doctor.availabilities && doctor.availabilities.length > 0) {
                availHtml = '<div class="detail-item" style="grid-column: 1 / -1;"><span class="detail-label">أوقات العمل</span><span class="detail-value">';
                doctor.availabilities.forEach(function (a) {
                    var dayName = DAY_NAMES[a.dayOfWeek] || 'اليوم ' + a.dayOfWeek;
                    availHtml += '<div style="font-size: 13px; margin-bottom: 4px;">' + dayName + ': ' + a.startTime.slice(0, 5) + ' - ' + a.endTime.slice(0, 5) + ' (30 دقيقة ثابتة)</div>';
                });
                availHtml += '</span></div>';
            }
            return '<div style="display: flex; gap: 16px; margin-bottom: 16px;">' + imgHtml
                + '<div><h5 style="margin: 0 0 4px;">' + escapeHtml(doctor.userName) + '</h5>'
                + '<span style="color: var(--clr-text-secondary); font-size: 13px;">' + escapeHtml(doctor.userEmail) + '</span></div></div>'
                + '<div class="detail-grid">'
                + '<div class="detail-item"><span class="detail-label">رقم الهاتف</span><span class="detail-value">' + escapeHtml(doctor.userPhoneNumber || '-') + '</span></div>'
                + '<div class="detail-item"><span class="detail-label">التخصص</span><span class="detail-value">' + escapeHtml(doctor.specializationName) + '</span></div>'
                + '<div class="detail-item"><span class="detail-label">سنوات الخبرة</span><span class="detail-value">' + doctor.yearsOfExperience + ' سنة</span></div>'
                + '<div class="detail-item"><span class="detail-label">الحالة</span><span class="detail-value">' + statusHtml + '</span></div>'
                + (doctor.bio ? '<div class="detail-item" style="grid-column: 1 / -1;"><span class="detail-label">السيرة الذاتية</span><span class="detail-value">' + escapeHtml(doctor.bio) + '</span></div>' : '')
                + '<div class="detail-item"><span class="detail-label">تاريخ الإضافة</span><span class="detail-value">' + formatDate(doctor.createdAt) + '</span></div>'
                + availHtml
                + '</div>';
        }

        $('.view-doctor-btn').on('click', function () {
            var id = $(this).data('id');
            $('#viewDoctorBody').html('<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">جاري التحميل...</span></div></div>');
            $('#viewDoctorModal').modal('show');

            $.ajax({
                url: '@Url.Action("GetDoctorById")/' + id,
                type: 'GET',
                success: function (res) {
                    if (res.success && res.data) {
                        $('#viewDoctorBody').html(renderDoctorDetail(res.data));
                    } else {
                        $('#viewDoctorBody').html('<div class="text-center py-4 text-muted">' + (res.message || 'تعذر تحميل بيانات الطبيب') + '</div>');
                    }
                },
                error: function (xhr) {
                    var msg = 'تعذر تحميل بيانات الطبيب';
                    try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch (e) { }
                    $('#viewDoctorBody').html('<div class="text-center py-4 text-muted">' + msg + '</div>');
                }
            });
        });

        var DAY_NAMES = ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];
        var attachmentBaseUrl = '@attachmentBaseUrl';

        function addAvailabilityRow(day, fromTime, toTime, slotMin) {
            var container = $('#availabilityContainer');
            var index = container.children('.availability-row').length;
            var row = $(
                '<div class="availability-row" data-index="' + index + '">' +
                    '<select class="availability-day form-select auth-form-control">' +
                        '<option value="">اليوم</option>' +
                        DAY_NAMES.map(function (name, i) {
                            return '<option value="' + i + '"' + (day === i ? ' selected' : '') + '>' + name + '</option>';
                        }).join('') +
                    '</select>' +
                    '<input type="time" class="availability-from form-control auth-form-control" value="' + (fromTime || '09:00') + '" />' +
                    '<span class="availability-sep">إلى</span>' +
                    '<input type="time" class="availability-to form-control auth-form-control" value="' + (toTime || '17:00') + '" />' +
                    '<button type="button" class="availability-remove-btn" title="حذف"><i class="bi bi-x-circle"></i></button>' +
                '</div>'
            );
            row.find('.availability-remove-btn').on('click', function () {
                row.remove();
            });
            container.append(row);
        }

        $('#addAvailabilityBtn').on('click', function () {
            addAvailabilityRow();
        });

        $(document).on('click', '.availability-remove-btn', function () {
            $(this).closest('.availability-row').remove();
        });

        function resetCreateDoctorModal() {
            $('#createDoctorFullName').val('');
            $('#createDoctorEmail').val('');
            $('#createDoctorPhone').val('');
            $('#createDoctorPassword').val('');
            $('#createDoctorGender').val('1');
            $('#createDoctorBirthDate').val('');
            $('#createDoctorSpecializationId').val('');
            $('#createDoctorExperience').val(0);
            $('#createDoctorImageInput').val('');
            $('#createDoctorImage').val('');
            $('#createDoctorImagePreview').attr('src', '');
            $('#createDoctorImageStatus').addClass('d-none').css('display', '');
            $('#createDoctorBio').val('');
            $('#availabilityContainer').empty();
            addAvailabilityRow();
        }

        $('#addDoctorBtn').on('click', function () {
            resetCreateDoctorModal();
            $('#createDoctorModal').modal('show');
            setTimeout(function () { $('#createDoctorFullName').focus(); }, 500);
        });

        // Doctor image upload
        $('#createDoctorImageInput').on('change', function () {
            var file = this.files[0];
            if (!file) return;

            // Show local preview immediately
            var reader = new FileReader();
            reader.onload = function (e) {
                $('#createDoctorImagePreview').attr('src', e.target.result);
            };
            reader.readAsDataURL(file);

            var csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

            var formData = new FormData();
            formData.append('file', file);

            $.ajax({
                url: '/Home/UploadDoctorImage',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: csrfToken ? { 'RequestVerificationToken': csrfToken } : {},
                success: function (res) {
                    if (res.success && res.message) {
                        $('#createDoctorImage').val(res.message);
                        $('#createDoctorImageFileName').text(res.message);
                        var fullUrl = attachmentBaseUrl + '/files/' + res.message;
                        $('#createDoctorImagePreview').attr('src', fullUrl);
                        $('#createDoctorImageStatus').removeClass('d-none').css('display', 'flex');
                    } else {
                        showErrorModal(res.message || 'حدث خطأ أثناء رفع الصورة');
                    }
                },
                error: function (xhr) {
                    var msg = 'حدث خطأ في الاتصال أثناء رفع الصورة';
                    try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch (e) { }
                    showErrorModal(msg);
                }
            });
        });

        // Remove uploaded image
        $('#removeDoctorImageBtn').on('click', function () {
            $('#createDoctorImageInput').val('');
            $('#createDoctorImage').val('');
            $('#createDoctorImagePreview').attr('src', '');
            $('#createDoctorImageStatus').addClass('d-none').css('display', '');
        });

        $('#createDoctorSubmitBtn').on('click', function () {
            var fullName = $('#createDoctorFullName').val().trim();
            var email = $('#createDoctorEmail').val().trim();
            var phoneNumber = $('#createDoctorPhone').val().trim();
            var password = $('#createDoctorPassword').val();
            var gender = parseInt($('#createDoctorGender').val());
            var birthDate = $('#createDoctorBirthDate').val() || null;
            var specializationId = $('#createDoctorSpecializationId').val();
            var experience = parseInt($('#createDoctorExperience').val()) || 0;
            var doctorImage = $('#createDoctorImage').val().trim() || null;
            var bio = $('#createDoctorBio').val().trim() || null;

            if (!fullName) { showErrorModal('يرجى إدخال الاسم الكامل'); return; }
            if (!email) { showErrorModal('يرجى إدخال البريد الإلكتروني'); return; }
            if (!phoneNumber) { showErrorModal('يرجى إدخال رقم الهاتف'); return; }
            if (!password || password.length < 6) { showErrorModal('كلمة المرور يجب أن تكون 6 أحرف على الأقل'); return; }
            if (!specializationId) { showErrorModal('يرجى اختيار التخصص'); return; }

            var availabilities = [];
            $('.availability-row').each(function () {
                var row = $(this);
                var day = parseInt(row.find('.availability-day').val());
                var fromTime = row.find('.availability-from').val();
                var toTime = row.find('.availability-to').val();

                if (!isNaN(day) && day >= 0 && fromTime && toTime) {
                    availabilities.push({
                        dayOfWeek: day,
                        startTime: fromTime + ':00',
                        endTime: toTime + ':00',
                        slotDurationMinutes: 30
                    });
                }
            });

            var payload = {
                fullName: fullName,
                email: email,
                phoneNumber: phoneNumber,
                password: password,
                gender: gender,
                specializationId: specializationId,
                yearsOfExperience: experience
            };
            if (birthDate) payload.birthDate = birthDate;
            if (doctorImage) payload.doctorImage = doctorImage;
            if (bio) payload.bio = bio;
            if (availabilities.length > 0) payload.availabilities = availabilities;

            $.ajax({
                url: '@Url.Action("CreateDoctor")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        $('#createDoctorModal').modal('hide');
                        showSuccessModal('تم إضافة الطبيب بنجاح');
                        setTimeout(function () { location.reload(); }, 1500);
                    } else {
                        showErrorModal(res.message);
                    }
                },
                error: function (xhr) {
                    var msg = 'حدث خطأ أثناء إضافة الطبيب';
                    try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch (e) { }
                    showErrorModal(msg);
                }
            });
        });

        // Edit doctor - fetch full data (user + doctor + availabilities)
        var _editOriginals = {};
        $('.edit-doctor-btn').on('click', function () {
            var id = $(this).data('id');
            $('#editDoctorId').val(id);

            // Reset form
            $('#editDoctorFullName').val('');
            $('#editDoctorEmail').val('');
            $('#editDoctorPhone').val('');
            $('#editDoctorBirthDate').val('');
            $('#editDoctorGender').val('');
            $('#editDoctorSpecializationId').val('');
            $('#editDoctorExperience').val('');
            $('#editDoctorActive').prop('checked', true);
            $('#editDoctorBio').val('');
            $('#editDoctorImageInput').val('');
            $('#editDoctorImage').val('');
            $('#editDoctorImagePreview').attr('src', '');
            $('#editDoctorImageStatus').addClass('d-none').css('display', '');
            $('#editAvailabilityContainer').empty();

            $.ajax({
                url: '@Url.Action("GetDoctorById")/' + id,
                type: 'GET',
                success: function (res) {
                    if (res.success && res.data) {
                        var d = res.data;
                        $('#editDoctorFullName').val(d.userName || '');
                        $('#editDoctorEmail').val(d.userEmail || '');
                        $('#editDoctorPhone').val(d.userPhoneNumber || '');
                        if (d.birthDate) {
                            $('#editDoctorBirthDate').val(d.birthDate.slice(0, 10));
                        }
                        $('#editDoctorGender').val(d.gender != null ? String(d.gender) : '');
                        $('#editDoctorSpecializationId').val(d.specializationId || '');
                        $('#editDoctorExperience').val(d.yearsOfExperience || 0);
                        $('#editDoctorActive').prop('checked', d.isActive !== false);
                        $('#editDoctorBio').val(d.bio || '');

                        var originalImage = '';
                        if (d.profilePictureUrl) {
                            var clean = d.profilePictureUrl.replace(/^files\//, '');
                            originalImage = clean;
                            $('#editDoctorImage').val(clean);
                            $('#editDoctorImagePreview').attr('src', d.profilePictureUrl.startsWith('http') ? d.profilePictureUrl : attachmentBaseUrl + '/files/' + clean);
                            $('#editDoctorImageStatus').removeClass('d-none').css('display', 'flex');
                        }

                        // Store original availabilities as serialized string for comparison
                        var originalAvail = [];
                        if (d.availabilities && d.availabilities.length > 0) {
                            d.availabilities.forEach(function (a) {
                                addEditAvailabilityRow(a.dayOfWeek, (a.startTime || '').slice(0, 5), (a.endTime || '').slice(0, 5));
                                originalAvail.push({ dayOfWeek: a.dayOfWeek, startTime: (a.startTime || '').slice(0, 5), endTime: (a.endTime || '').slice(0, 5), slotDurationMinutes: 30 });
                            });
                        }

                        _editOriginals = {
                            fullName: d.userName || '',
                            email: d.userEmail || '',
                            phone: d.userPhoneNumber || '',
                            birthDate: d.birthDate ? d.birthDate.slice(0, 10) : '',
                            gender: d.gender != null ? String(d.gender) : '',
                            experience: d.yearsOfExperience || 0,
                            isActive: d.isActive !== false,
                            bio: d.bio || '',
                            doctorImage: originalImage,
                            availabilities: JSON.stringify(originalAvail)
                        };

                        $('#editDoctorModal').modal('show');
                    } else {
                        showErrorModal(res.message || 'تعذر تحميل بيانات الطبيب');
                    }
                },
                error: function (xhr) {
                    var msg = 'تعذر تحميل بيانات الطبيب';
                    try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch (e) {}
                    showErrorModal(msg);
                }
            });
        });

        function addEditAvailabilityRow(day, fromTime, toTime, slotMin) {
            var container = $('#editAvailabilityContainer');
            var index = container.children('.availability-row').length;
            var row = $(
                '<div class="availability-row" data-index="' + index + '">' +
                    '<select class="availability-day form-select auth-form-control">' +
                        '<option value="">اليوم</option>' +
                        DAY_NAMES.map(function (name, i) {
                            return '<option value="' + i + '"' + (day === i ? ' selected' : '') + '>' + name + '</option>';
                        }).join('') +
                    '</select>' +
                    '<input type="time" class="availability-from form-control auth-form-control" value="' + (fromTime || '09:00') + '" />' +
                    '<span class="availability-sep">إلى</span>' +
                    '<input type="time" class="availability-to form-control auth-form-control" value="' + (toTime || '17:00') + '" />' +
                    '<button type="button" class="availability-remove-btn" title="حذف"><i class="bi bi-x-circle"></i></button>' +
                '</div>'
            );
            row.find('.availability-remove-btn').on('click', function () {
                row.remove();
            });
            container.append(row);
        }

        $('#addEditAvailabilityBtn').on('click', function () {
            addEditAvailabilityRow();
        });

        // Edit doctor image upload
        $('#editDoctorImageInput').on('change', function () {
            var file = this.files[0];
            if (!file) return;

            var reader = new FileReader();
            reader.onload = function (e) {
                $('#editDoctorImagePreview').attr('src', e.target.result);
            };
            reader.readAsDataURL(file);

            var csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
            var formData = new FormData();
            formData.append('file', file);

            $.ajax({
                url: '/Home/UploadDoctorImage',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: csrfToken ? { 'RequestVerificationToken': csrfToken } : {},
                success: function (res) {
                    if (res.success && res.message) {
                        $('#editDoctorImage').val(res.message);
                        var fullUrl = attachmentBaseUrl + '/files/' + res.message;
                        $('#editDoctorImagePreview').attr('src', fullUrl);
                        $('#editDoctorImageStatus').removeClass('d-none').css('display', 'flex');
                    } else {
                        showErrorModal(res.message || 'حدث خطأ أثناء رفع الصورة');
                    }
                },
                error: function (xhr) {
                    var msg = 'حدث خطأ في الاتصال أثناء رفع الصورة';
                    try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch (e) { }
                    showErrorModal(msg);
                }
            });
        });

        // Remove edited image
        $('#editRemoveDoctorImageBtn').on('click', function () {
            $('#editDoctorImageInput').val('');
            $('#editDoctorImage').val('');
            $('#editDoctorImagePreview').attr('src', '');
            $('#editDoctorImageStatus').addClass('d-none').css('display', '');
        });

        // Submit edit - only send changed fields
        $('#editDoctorSubmitBtn').on('click', function () {
            var id = $('#editDoctorId').val();
            var btn = $(this);
            setButtonLoading(btn, true);

            var payload = {};
            var orig = _editOriginals;

            var fullName = $('#editDoctorFullName').val().trim();
            if (fullName !== orig.fullName) payload.fullName = fullName;

            var email = $('#editDoctorEmail').val().trim();
            if (email !== orig.email) payload.email = email;

            var phone = $('#editDoctorPhone').val().trim();
            if (phone !== orig.phone) payload.phoneNumber = phone;

            var birthDate = $('#editDoctorBirthDate').val();
            if (birthDate !== orig.birthDate) payload.birthDate = birthDate;

            var gender = $('#editDoctorGender').val();
            if (gender !== orig.gender) payload.gender = parseInt(gender);

            var experience = $('#editDoctorExperience').val();
            var expNum = experience ? parseInt(experience) : 0;
            if (expNum !== orig.experience) payload.yearsOfExperience = expNum;

            var isActive = $('#editDoctorActive').is(':checked');
            if (isActive !== orig.isActive) payload.isActive = isActive;

            var bio = $('#editDoctorBio').val().trim();
            if (bio !== orig.bio) payload.bio = bio;

            var doctorImage = $('#editDoctorImage').val().trim();
            if (doctorImage !== orig.doctorImage) payload.doctorImage = doctorImage;

            // Availabilities
            var availRows = [];
            $('#editAvailabilityContainer .availability-row').each(function () {
                var row = $(this);
                var day = parseInt(row.find('.availability-day').val());
                var fromTime = row.find('.availability-from').val();
                var toTime = row.find('.availability-to').val();
                if (!isNaN(day) && day >= 0 && fromTime && toTime) {
                    availRows.push({
                        dayOfWeek: day,
                        startTime: fromTime + ':00',
                        endTime: toTime + ':00',
                        slotDurationMinutes: 30
                    });
                }
            });
            var availStr = JSON.stringify(availRows);
            if (availStr !== orig.availabilities) payload.availabilities = availRows;

            $.ajax({
                url: '@Url.Action("UpdateDoctor")/' + id,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    setButtonLoading(btn, false);
                    if (res.success) {
                        $('#editDoctorModal').modal('hide');
                        showSuccessModal('تم تحديث بيانات الطبيب بنجاح');
                        setTimeout(function () { location.reload(); }, 1500);
                    } else {
                        showErrorModal(res.message);
                    }
                },
                error: function (xhr) {
                    setButtonLoading(btn, false);
                    var msg = 'حدث خطأ أثناء تحديث الطبيب';
                    try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch (e) { }
                    showErrorModal(msg);
                }
            });
        });

        $('.change-password-doctor-btn').on('click', function () {
            var btn = $(this);
            $('#changePasswordDoctorId').val(btn.attr('data-userid'));
            $('#changePasswordDoctorName').text(btn.attr('data-name'));
            $('#changePasswordDoctorNew').val('');
            $('#changePasswordDoctorConfirm').val('');
            $('#changePasswordDoctorModal').modal('show');
        });

        $('#changePasswordDoctorSubmitBtn').on('click', function () {
            var btn = $(this);
            var id = $('#changePasswordDoctorId').val();
            var newPassword = $('#changePasswordDoctorNew').val();
            var confirmPassword = $('#changePasswordDoctorConfirm').val();

            if (!newPassword) { showErrorModal('يرجى إدخال كلمة المرور الجديدة'); return; }
            if (!confirmPassword) { showErrorModal('يرجى تأكيد كلمة المرور'); return; }
            if (newPassword !== confirmPassword) { showErrorModal('كلمة المرور غير متطابقة'); return; }
            if (newPassword.length < 8) { showErrorModal('كلمة المرور يجب أن تكون 8 أحرف على الأقل'); return; }

            setButtonLoading(btn, true);

            $.ajax({
                url: '@Url.Action("ChangeDoctorPassword")/' + id,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    newPassword: newPassword,
                    confirmPassword: confirmPassword
                }),
                success: function (res) {
                    setButtonLoading(btn, false);
                    if (res.success && res.data) {
                        $('#changePasswordDoctorModal').modal('hide');
                        showSuccessModal('تم تغيير كلمة المرور بنجاح');
                        setTimeout(function () { location.reload(); }, 1500);
                    } else {
                        showErrorModal(res.message || 'حدث خطأ أثناء تغيير كلمة المرور');
                    }
                },
                error: function (xhr) {
                    setButtonLoading(btn, false);
                    var msg = 'حدث خطأ أثناء تغيير كلمة المرور';
                    try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch (e) { }
                    showErrorModal(msg);
                }
            });
        });

        $('.delete-doctor-btn').on('click', function () {
            var btn = $(this);
            var id = btn.data('id');
            var name = btn.attr('data-name');
            showConfirmModal('هل أنت متأكد من حذف الطبيب <strong>' + name + '</strong>؟', function (confirmed) {
                if (confirmed) {
                    $.ajax({
                        url: '@Url.Action("DeleteDoctor")/' + id,
                        type: 'POST',
                        success: function (res) {
                            if (res.success) {
                                showSuccessModal('تم حذف الطبيب بنجاح');
                                setTimeout(function () { location.reload(); }, 1500);
                            } else {
                                showErrorModal(res.message);
                            }
                        },
                        error: function (xhr) {
                            var msg = 'حدث خطأ أثناء حذف الطبيب';
                            try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch (e) { }
                            showErrorModal(msg);
                        }
                    });
                }
            });
        });
    </script>
}