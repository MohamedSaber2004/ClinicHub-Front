@using ClinicHub.Data
@using ClinicHub.Services.ReponseModels
@{
    ViewData["Title"] = "إدارة الأطباء - Doctory";
    Layout = "_ClinicLayout";
    var _user = ViewBag.CurrentUser as CurrentUserContext;
    var doctors = ViewBag.DoctorsList as IReadOnlyCollection<DoctorDto> ?? new List<DoctorDto>();
    var pagination = ViewBag.Pagination as PagginatedResult<DoctorDto>;
    var specializations = ViewBag.Specializations as IReadOnlyCollection<SpecializationDto> ?? new List<SpecializationDto>();
    var searchTerm = ViewBag.SearchTerm as string;
    var selectedSpecId = ViewBag.SelectedSpecializationId as Guid?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title mb-0">إدارة الأطباء</h2>
    <button class="btn" id="addDoctorBtn" style="background-color: var(--primary-color); color: white; font-weight: 600; padding: 10px 20px; border-radius: 5px;">
        <i class="bi bi-person-plus me-1"></i> إضافة طبيب
    </button>
</div>

@if (_user?.MaxDoctors.HasValue == true)
{
    <div class="plan-info-bar" style="margin-bottom: 20px;">
        <div class="plan-info-item">
            <span class="plan-info-label">الحد الأقصى للأطباء في باقتك</span>
            <span class="plan-info-value">@_user.MaxDoctors طبيب</span>
        </div>
        <span style="font-size: 12px; color: var(--clr-text-secondary);">لزيادة الحد الأقصى، قم بترقية باقتك.</span>
        <a href="/Clinic/MySubscription" class="plan-info-link">ترقية الباقة <i class="bi bi-arrow-left"></i></a>
    </div>
}

<div class="table-card" style="padding: 20px; margin-bottom: 24px;">
    <form method="get" action="@Url.Action("Doctors")" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label" style="font-weight: 600; font-size: 13px;">بحث</label>
            <input type="text" name="searchTerm" class="form-control auth-form-control" style="padding: 8px 12px; font-size: 13px;" placeholder="ابحث باسم الطبيب أو البريد الإلكتروني..." value="@searchTerm" />
        </div>
        <div class="col-md-4">
            <label class="form-label" style="font-weight: 600; font-size: 13px;">التخصص</label>
            <select name="specializationId" class="form-select auth-form-control" style="padding: 8px 12px; font-size: 13px;">
                <option value="">جميع التخصصات</option>
                @foreach (var spec in specializations)
                {
                    <option value="@spec.Id" selected="@(selectedSpecId == spec.Id)">@spec.ArName</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn" style="background-color: var(--primary-color); color: white; font-weight: 600; padding: 8px 20px; border-radius: 5px; font-size: 13px; width: 100%;">
                <i class="bi bi-search me-1"></i> بحث
            </button>
        </div>
    </form>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="table-card" style="padding: 24px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 style="font-weight: 700; margin: 0;">قائمة الأطباء</h4>
        @if (pagination != null)
        {
            <span style="font-size: 13px; color: var(--clr-text-secondary);">إجمالي: @pagination.TotalCount طبيب</span>
        }
    </div>

    @if (doctors.Count == 0)
    {
        <div style="text-align: center; padding: 40px 20px; color: var(--clr-text-secondary);">
            <i class="bi bi-people" style="font-size: 48px; display: block; margin-bottom: 16px; opacity: 0.3;"></i>
            <p style="font-size: 16px;">لا يوجد أطباء مسجلون في العيادة</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>الاسم</th>
                        <th>البريد الإلكتروني</th>
                        <th>التخصص</th>
                        <th>سنوات الخبرة</th>
                        <th>الحالة</th>
                        <th>تاريخ الإضافة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doctor in doctors)
                    {
                        <tr>
                            <td><strong>@doctor.UserName</strong></td>
                            <td style="font-size: 13px; color: var(--clr-text-secondary);">@doctor.UserEmail</td>
                            <td><span class="badge badge-info">@doctor.SpecializationName</span></td>
                            <td>@doctor.YearsOfExperience سنة</td>
                            <td>
                                @if (doctor.IsActive)
                                {
                                    <span class="badge badge-success">نشط</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">غير نشط</span>
                                }
                            </td>
                            <td style="font-size: 13px; color: var(--clr-text-secondary);">@doctor.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                <div class="table-actions">
                                    <button class="btn btn-sm btn-secondary view-doctor-btn"
                                            data-id="@doctor.Id"
                                            title="عرض التفاصيل">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-sm edit-doctor-btn"
                                            data-id="@doctor.Id"
                                            data-userid="@doctor.UserId"
                                            data-name="@doctor.UserName"
                                            data-email="@doctor.UserEmail"
                                            data-specializationid="@doctor.SpecializationId"
                                            data-bio="@doctor.Bio"
                                            data-experience="@doctor.YearsOfExperience"
                                            data-active="@doctor.IsActive.ToString().ToLower()"
                                            style="font-size: 11px; border: 1px solid var(--clr-border); background: transparent; padding: 4px 10px; border-radius: 4px; color: var(--clr-primary);">
                                        <i class="bi bi-pencil me-1"></i> تعديل
                                    </button>
                                    <button class="btn btn-sm change-password-doctor-btn"
                                            data-id="@doctor.Id"
                                            data-userid="@doctor.UserId"
                                            data-name="@doctor.UserName"
                                            title="تغيير كلمة المرور"
                                            style="font-size: 11px; border: 1px solid var(--clr-border); background: transparent; padding: 4px 10px; border-radius: 4px; color: var(--clr-primary);">
                                        <i class="bi bi-key me-1"></i>
                                    </button>
                                    <button class="btn btn-sm delete-doctor-btn"
                                            data-id="@doctor.Id"
                                            data-name="@doctor.UserName"
                                            style="font-size: 11px; border: 1px solid var(--clr-border); background: transparent; padding: 4px 10px; border-radius: 4px; color: var(--clr-danger);">
                                        <i class="bi bi-trash me-1"></i> حذف
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        if (pagination != null && pagination.TotalPages > 1)
        {
            <nav class="pagination-nav" style="margin-top: 20px;">
                <ul class="pagination-list">
                    @if (pagination.HasPreviousPage)
                    {
                        <li class="pagination-item">
                            <a class="pagination-link" href="@Url.Action("Doctors", new { pageNumber = pagination.PageNumber - 1, pageSize = pagination.PageSize, searchTerm, specializationId = selectedSpecId })">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg> السابق
                            </a>
                        </li>
                    }
                    @for (var i = 1; i <= pagination.TotalPages; i++)
                    {
                        <li class="pagination-item">
                            <a class="pagination-link @(i == pagination.PageNumber ? "pagination-link--active" : "")"
                               href="@Url.Action("Doctors", new { pageNumber = i, pageSize = pagination.PageSize, searchTerm, specializationId = selectedSpecId })">@i</a>
                        </li>
                    }
                    @if (pagination.HasNextPage)
                    {
                        <li class="pagination-item">
                            <a class="pagination-link" href="@Url.Action("Doctors", new { pageNumber = pagination.PageNumber + 1, pageSize = pagination.PageSize, searchTerm, specializationId = selectedSpecId })">
                                التالي <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/></svg>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>

<div class="modal fade" id="createDoctorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border: none; border-radius: var(--radius-md); box-shadow: var(--shadow-lg);">
            <div class="modal-header" style="border-bottom: 1px solid var(--clr-border); padding: var(--space-5) var(--space-6);">
                <h5 class="modal-title" style="font-weight: 700;">إضافة طبيب جديد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: var(--space-6);">
                <form id="createDoctorForm">
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; font-size: 13px;">المستخدم</label>
                        <div class="user-search-wrapper">
                            <input type="text" class="form-control auth-form-control" id="createDoctorUserSearch" placeholder="ابحث باسم المستخدم أو البريد الإلكتروني..." style="padding: 8px 12px; font-size: 13px;" autocomplete="off" />
                            <input type="hidden" id="createDoctorUserId" />
                            <div class="user-search-results" id="createDoctorUserResults"></div>
                        </div>
                        <div class="selected-user-info" id="createDoctorUserSelected" style="display: none;">
                            <span class="selected-user-name" id="createDoctorUserSelectedName"></span>
                            <button type="button" id="createDoctorUserChangeBtn" class="user-change-btn">تغيير</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; font-size: 13px;">التخصص</label>
                        <select class="form-select auth-form-control" id="createDoctorSpecializationId" required style="padding: 8px 12px; font-size: 13px;">
                            <option value="">اختر التخصص</option>
                            @foreach (var spec in specializations)
                            {
                                <option value="@spec.Id">@spec.ArName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; font-size: 13px;">سنوات الخبرة</label>
                        <input type="number" class="form-control auth-form-control" id="createDoctorExperience" value="0" min="0" required style="padding: 8px 12px; font-size: 13px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; font-size: 13px;">السيرة الذاتية (اختياري)</label>
                        <textarea class="form-control auth-form-control" id="createDoctorBio" rows="3" style="padding: 8px 12px; font-size: 13px;" placeholder="نبذة عن الطبيب..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; font-size: 13px;">أوقات العمل (اختياري)</label>
                        <div id="availabilityContainer">
                            <div class="availability-row" data-index="0">
                                <select class="availability-day form-select auth-form-control">
                                    <option value="">اليوم</option>
                                    <option value="0">الأحد</option>
                                    <option value="1">الإثنين</option>
                                    <option value="2">الثلاثاء</option>
                                    <option value="3">الأربعاء</option>
                                    <option value="4">الخميس</option>
                                    <option value="5">الجمعة</option>
                                    <option value="6">السبت</option>
                                </select>
                                <input type="time" class="availability-from form-control auth-form-control" value="09:00" />
                                <span class="availability-sep">إلى</span>
                                <input type="time" class="availability-to form-control auth-form-control" value="17:00" />
                                <input type="number" class="availability-slot form-control auth-form-control" value="30" min="1" max="480" placeholder="دقيقة" />
                                <button type="button" class="availability-remove-btn" title="حذف"><i class="bi bi-x-circle"></i></button>
                            </div>
                        </div>
                        <button type="button" id="addAvailabilityBtn" class="btn btn-sm add-availability-btn">
                            <i class="bi bi-plus-circle"></i> إضافة يوم
                        </button>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--clr-border); padding: var(--space-4) var(--space-6);">
                <button type="button" class="btn" data-bs-dismiss="modal" style="min-width: 100px; padding: 10px 24px; background-color: var(--clr-surface-secondary); color: var(--clr-text); border: 1px solid var(--clr-border); border-radius: var(--radius-sm); font-weight: 600;">إلغاء</button>
                <button type="button" class="btn" id="createDoctorSubmitBtn" style="min-width: 100px; padding: 10px 24px; background-color: var(--clr-primary); color: #FFFFFF; border: none; border-radius: var(--radius-sm); font-weight: 600;">إضافة</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editDoctorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border: none; border-radius: var(--radius-md); box-shadow: var(--shadow-lg);">
            <div class="modal-header" style="border-bottom: 1px solid var(--clr-border); padding: var(--space-5) var(--space-6);">
                <h5 class="modal-title" style="font-weight: 700;">تعديل بيانات الطبيب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: var(--space-6);">
                <form id="editDoctorForm">
                    <input type="hidden" id="editDoctorId" />
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; font-size: 13px;">الاسم</label>
                        <input type="text" class="form-control auth-form-control" id="editDoctorName" readonly style="padding: 8px 12px; font-size: 13px; background: var(--clr-table-header);" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; font-size: 13px;">البريد الإلكتروني</label>
                        <input type="email" class="form-control auth-form-control" id="editDoctorEmail" readonly style="padding: 8px 12px; font-size: 13px; background: var(--clr-table-header);" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; font-size: 13px;">الحالة</label>
                        <div class="form-check form-switch" style="padding-top: 6px;">
                            <input class="form-check-input" type="checkbox" id="editDoctorActive" style="transform: scale(1.2);">
                            <label class="form-check-label" for="editDoctorActive" style="font-size: 13px; margin-right: 8px;">نشط</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; font-size: 13px;">سنوات الخبرة</label>
                        <input type="number" class="form-control auth-form-control" id="editDoctorExperience" min="0" style="padding: 8px 12px; font-size: 13px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; font-size: 13px;">السيرة الذاتية</label>
                        <textarea class="form-control auth-form-control" id="editDoctorBio" rows="3" style="padding: 8px 12px; font-size: 13px;"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--clr-border); padding: var(--space-4) var(--space-6);">
                <button type="button" class="btn" data-bs-dismiss="modal" style="min-width: 100px; padding: 10px 24px; background-color: var(--clr-surface-secondary); color: var(--clr-text); border: 1px solid var(--clr-border); border-radius: var(--radius-sm); font-weight: 600;">إلغاء</button>
                <button type="button" class="btn" id="editDoctorSubmitBtn" style="min-width: 100px; padding: 10px 24px; background-color: var(--clr-primary); color: #FFFFFF; border: none; border-radius: var(--radius-sm); font-weight: 600;">حفظ التغييرات</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="viewDoctorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <div class="modal-header modal-header-custom">
                <h5 class="modal-title">تفاصيل الطبيب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body modal-body-custom" id="viewDoctorBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">جاري التحميل...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="changePasswordDoctorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <div class="modal-header modal-header-custom">
                <h5 class="modal-title">تغيير كلمة مرور الطبيب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body modal-body-custom">
                <form id="changePasswordDoctorForm">
                    <input type="hidden" id="changePasswordDoctorId" />
                    <div class="form-group mb-3">
                        <label class="form-label">الطبيب</label>
                        <p class="fw-bold" id="changePasswordDoctorName" style="margin: 0;"></p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">كلمة المرور الجديدة</label>
                        <input type="password" class="form-input form-input-sm w-100" id="changePasswordDoctorNew" placeholder="كلمة المرور الجديدة" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">تأكيد كلمة المرور</label>
                        <input type="password" class="form-input form-input-sm w-100" id="changePasswordDoctorConfirm" placeholder="تأكيد كلمة المرور" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="changePasswordDoctorSubmitBtn">حفظ كلمة المرور</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function escapeHtml(text) {
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(text));
            return div.innerHTML;
        }

        function formatDate(dateStr) {
            if (!dateStr) return '-';
            var d = new Date(dateStr);
            return d.toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' })
                + ' ' + d.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
        }

        function setButtonLoading(btn, isLoading) {
            if (isLoading) {
                btn.data('original-html', btn.html());
                btn.prop('disabled', true);
                btn.html('<span class="spinner-border spinner-border-sm me-1"></span> جاري...');
            } else {
                btn.prop('disabled', false);
                btn.html(btn.data('original-html'));
            }
        }

        function renderDoctorDetail(doctor) {
            var statusHtml = doctor.isActive
                ? '<span class="badge badge-success">نشط</span>'
                : '<span class="badge badge-danger">غير نشط</span>';
            return '<div class="detail-grid">'
                + '<div class="detail-item"><span class="detail-label">الاسم الكامل</span><span class="detail-value">' + escapeHtml(doctor.userName) + '</span></div>'
                + '<div class="detail-item"><span class="detail-label">البريد الإلكتروني</span><span class="detail-value">' + escapeHtml(doctor.userEmail) + '</span></div>'
                + '<div class="detail-item"><span class="detail-label">التخصص</span><span class="detail-value">' + escapeHtml(doctor.specializationName) + '</span></div>'
                + '<div class="detail-item"><span class="detail-label">سنوات الخبرة</span><span class="detail-value">' + doctor.yearsOfExperience + ' سنة</span></div>'
                + '<div class="detail-item"><span class="detail-label">الحالة</span><span class="detail-value">' + statusHtml + '</span></div>'
                + (doctor.bio ? '<div class="detail-item" style="grid-column: 1 / -1;"><span class="detail-label">السيرة الذاتية</span><span class="detail-value">' + escapeHtml(doctor.bio) + '</span></div>' : '')
                + '<div class="detail-item"><span class="detail-label">تاريخ الإضافة</span><span class="detail-value">' + formatDate(doctor.createdAt) + '</span></div>'
                + '</div>';
        }

        $('.view-doctor-btn').on('click', function () {
            var id = $(this).data('id');
            $('#viewDoctorBody').html('<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">جاري التحميل...</span></div></div>');
            $('#viewDoctorModal').modal('show');

            $.ajax({
                url: '@Url.Action("GetDoctorById")/' + id,
                type: 'GET',
                success: function (res) {
                    if (res.success && res.data) {
                        $('#viewDoctorBody').html(renderDoctorDetail(res.data));
                    } else {
                        $('#viewDoctorBody').html('<div class="text-center py-4 text-muted">' + (res.message || 'تعذر تحميل بيانات الطبيب') + '</div>');
                    }
                },
                error: function (xhr) {
                    var msg = 'تعذر تحميل بيانات الطبيب';
                    try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch (e) { }
                    $('#viewDoctorBody').html('<div class="text-center py-4 text-muted">' + msg + '</div>');
                }
            });
        });

        var searchTimeout = null;
        var selectedUserId = null;
        var selectedUserName = null;

        var DAY_NAMES = ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];

        function addAvailabilityRow(day, fromTime, toTime, slotMin) {
            var container = $('#availabilityContainer');
            var index = container.children('.availability-row').length;
            var row = $(
                '<div class="availability-row" data-index="' + index + '">' +
                    '<select class="availability-day form-select auth-form-control">' +
                        '<option value="">اليوم</option>' +
                        DAY_NAMES.map(function (name, i) {
                            return '<option value="' + i + '"' + (day === i ? ' selected' : '') + '>' + name + '</option>';
                        }).join('') +
                    '</select>' +
                    '<input type="time" class="availability-from form-control auth-form-control" value="' + (fromTime || '09:00') + '" />' +
                    '<span class="availability-sep">إلى</span>' +
                    '<input type="time" class="availability-to form-control auth-form-control" value="' + (toTime || '17:00') + '" />' +
                    '<input type="number" class="availability-slot form-control auth-form-control" value="' + (slotMin || '30') + '" min="1" max="480" placeholder="دقيقة" />' +
                    '<button type="button" class="availability-remove-btn" title="حذف"><i class="bi bi-x-circle"></i></button>' +
                '</div>'
            );
            row.find('.availability-remove-btn').on('click', function () {
                row.remove();
            });
            container.append(row);
        }

        $('#addAvailabilityBtn').on('click', function () {
            addAvailabilityRow();
        });

        $(document).on('click', '.availability-remove-btn', function () {
            $(this).closest('.availability-row').remove();
        });

        function resetCreateDoctorModal() {
            $('#createDoctorUserSearch').val('').show();
            $('#createDoctorUserId').val('');
            $('#createDoctorUserSelected').hide();
            $('#createDoctorUserResults').hide().empty();
            selectedUserId = null;
            selectedUserName = null;
            $('#createDoctorSpecializationId').val('');
            $('#createDoctorExperience').val(0);
            $('#createDoctorBio').val('');
            $('#availabilityContainer').empty();
            addAvailabilityRow();
        }

        $('#addDoctorBtn').on('click', function () {
            resetCreateDoctorModal();
            $('#createDoctorModal').modal('show');
            setTimeout(function () { $('#createDoctorUserSearch').focus(); }, 500);
        });

        $('#createDoctorUserSearch').on('input', function () {
            var term = $(this).val().trim();
            var resultsEl = $('#createDoctorUserResults');

            if (searchTimeout) clearTimeout(searchTimeout);

            if (term.length < 2) {
                resultsEl.hide().empty();
                return;
            }

            searchTimeout = setTimeout(function () {
                $.ajax({
                    url: '@Url.Action("SearchUsers")',
                    type: 'GET',
                    data: { term: term },
                    success: function (res) {
                        if (res.success && res.items.length > 0) {
                            resultsEl.empty();
                            res.items.forEach(function (u) {
                                resultsEl.append(
                                    '<div class="user-search-item" data-id="' + u.id + '" data-name="' + escapeHtml(u.fullName) + '" data-email="' + escapeHtml(u.email) + '">' +
                                        '<span class="user-search-item-name">' + escapeHtml(u.fullName) + '</span>' +
                                        '<span class="user-search-item-email">' + escapeHtml(u.email) + '</span>' +
                                    '</div>'
                                );
                            });
                            resultsEl.show();
                        } else {
                            resultsEl.html('<div class="user-search-empty">لا توجد نتائج</div>').show();
                        }
                    },
                    error: function () {
                        resultsEl.html('<div class="user-search-empty">حدث خطأ أثناء البحث</div>').show();
                    }
                });
            }, 300);
        });

        $(document).on('click', '.user-search-item', function () {
            var item = $(this);
            selectedUserId = item.data('id');
            selectedUserName = item.data('name');
            $('#createDoctorUserId').val(selectedUserId);
            $('#createDoctorUserSearch').hide();
            $('#createDoctorUserResults').hide().empty();
            $('#createDoctorUserSelectedName').text(item.data('name') + ' (' + item.data('email') + ')');
            $('#createDoctorUserSelected').show();
        });

        $('#createDoctorUserChangeBtn').on('click', function () {
            selectedUserId = null;
            selectedUserName = null;
            $('#createDoctorUserId').val('');
            $('#createDoctorUserSearch').val('').show().focus();
            $('#createDoctorUserSelected').hide();
            $('#createDoctorUserResults').hide().empty();
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('.user-search-wrapper').length) {
                $('#createDoctorUserResults').hide();
            }
        });

        $('#createDoctorSubmitBtn').on('click', function () {
            var userId = $('#createDoctorUserId').val();
            var specializationId = $('#createDoctorSpecializationId').val();
            var experience = parseInt($('#createDoctorExperience').val()) || 0;
            var bio = $('#createDoctorBio').val().trim();

            if (!userId) { showErrorModal('يرجى اختيار مستخدم'); return; }
            if (!specializationId) { showErrorModal('يرجى اختيار التخصص'); return; }

            var availabilities = [];
            $('.availability-row').each(function () {
                var row = $(this);
                var day = parseInt(row.find('.availability-day').val());
                var fromTime = row.find('.availability-from').val();
                var toTime = row.find('.availability-to').val();
                var slot = parseInt(row.find('.availability-slot').val()) || 30;

                if (!isNaN(day) && day >= 0 && fromTime && toTime) {
                    availabilities.push({
                        dayOfWeek: day,
                        startTime: fromTime + ':00',
                        endTime: toTime + ':00',
                        slotDurationMinutes: slot
                    });
                }
            });

            $.ajax({
                url: '@Url.Action("CreateDoctor")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    userId: userId,
                    specializationId: specializationId,
                    yearsOfExperience: experience,
                    bio: bio || null,
                    availabilities: availabilities.length > 0 ? availabilities : undefined
                }),
                success: function (res) {
                    if (res.success) {
                        $('#createDoctorModal').modal('hide');
                        showSuccessModal('تم إضافة الطبيب بنجاح');
                        setTimeout(function () { location.reload(); }, 1500);
                    } else {
                        showErrorModal(res.message);
                    }
                },
                error: function (xhr) {
                    var msg = 'حدث خطأ أثناء إضافة الطبيب';
                    try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch (e) { }
                    showErrorModal(msg);
                }
            });
        });

        $('.edit-doctor-btn').on('click', function () {
            var btn = $(this);
            $('#editDoctorId').val(btn.data('id'));
            $('#editDoctorName').val(btn.attr('data-name'));
            $('#editDoctorEmail').val(btn.attr('data-email'));
            $('#editDoctorActive').prop('checked', btn.data('active') === true || btn.data('active') === 'true');
            $('#editDoctorExperience').val(btn.data('experience'));
            $('#editDoctorBio').val(btn.data('bio') || '');
            $('#editDoctorModal').modal('show');
        });

        $('#editDoctorSubmitBtn').on('click', function () {
            var id = $('#editDoctorId').val();
            var isActive = $('#editDoctorActive').is(':checked');
            var experience = parseInt($('#editDoctorExperience').val()) || 0;
            var bio = $('#editDoctorBio').val().trim();

            $.ajax({
                url: '@Url.Action("UpdateDoctor")/' + id,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    isActive: isActive,
                    bio: bio || null,
                    yearsOfExperience: experience || null
                }),
                success: function (res) {
                    if (res.success) {
                        $('#editDoctorModal').modal('hide');
                        showSuccessModal('تم تحديث بيانات الطبيب بنجاح');
                        setTimeout(function () { location.reload(); }, 1500);
                    } else {
                        showErrorModal(res.message);
                    }
                },
                error: function (xhr) {
                    var msg = 'حدث خطأ أثناء تحديث الطبيب';
                    try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch (e) { }
                    showErrorModal(msg);
                }
            });
        });

        $('.change-password-doctor-btn').on('click', function () {
            var btn = $(this);
            $('#changePasswordDoctorId').val(btn.attr('data-userid'));
            $('#changePasswordDoctorName').text(btn.attr('data-name'));
            $('#changePasswordDoctorNew').val('');
            $('#changePasswordDoctorConfirm').val('');
            $('#changePasswordDoctorModal').modal('show');
        });

        $('#changePasswordDoctorSubmitBtn').on('click', function () {
            var btn = $(this);
            var id = $('#changePasswordDoctorId').val();
            var newPassword = $('#changePasswordDoctorNew').val();
            var confirmPassword = $('#changePasswordDoctorConfirm').val();

            if (!newPassword) { showErrorModal('يرجى إدخال كلمة المرور الجديدة'); return; }
            if (!confirmPassword) { showErrorModal('يرجى تأكيد كلمة المرور'); return; }
            if (newPassword !== confirmPassword) { showErrorModal('كلمة المرور غير متطابقة'); return; }
            if (newPassword.length < 8) { showErrorModal('كلمة المرور يجب أن تكون 8 أحرف على الأقل'); return; }

            setButtonLoading(btn, true);

            $.ajax({
                url: '@Url.Action("ChangeDoctorPassword")/' + id,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    newPassword: newPassword,
                    confirmPassword: confirmPassword
                }),
                success: function (res) {
                    setButtonLoading(btn, false);
                    if (res.success && res.data) {
                        $('#changePasswordDoctorModal').modal('hide');
                        showSuccessModal('تم تغيير كلمة المرور بنجاح');
                        setTimeout(function () { location.reload(); }, 1500);
                    } else {
                        showErrorModal(res.message || 'حدث خطأ أثناء تغيير كلمة المرور');
                    }
                },
                error: function (xhr) {
                    setButtonLoading(btn, false);
                    var msg = 'حدث خطأ أثناء تغيير كلمة المرور';
                    try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch (e) { }
                    showErrorModal(msg);
                }
            });
        });

        $('.delete-doctor-btn').on('click', function () {
            var btn = $(this);
            var id = btn.data('id');
            var name = btn.attr('data-name');
            showConfirmModal('هل أنت متأكد من حذف الطبيب <strong>' + name + '</strong>؟', function (confirmed) {
                if (confirmed) {
                    $.ajax({
                        url: '@Url.Action("DeleteDoctor")/' + id,
                        type: 'POST',
                        success: function (res) {
                            if (res.success) {
                                showSuccessModal('تم حذف الطبيب بنجاح');
                                setTimeout(function () { location.reload(); }, 1500);
                            } else {
                                showErrorModal(res.message);
                            }
                        },
                        error: function (xhr) {
                            var msg = 'حدث خطأ أثناء حذف الطبيب';
                            try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch (e) { }
                            showErrorModal(msg);
                        }
                    });
                }
            });
        });
    </script>
}