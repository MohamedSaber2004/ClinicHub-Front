                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-weight: 600; font-size: 13px;">الحالة</label>
                            <div class="form-check form-switch" style="padding-top: 8px;">
                                <input class="form-check-input" type="checkbox" id="editDoctorActive" style="transform: scale(1.2);">
                                <label class="form-check-label" for="editDoctorActive" style="font-size: 13px; margin-right: 8px;">نشط</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label" style="font-weight: 600; font-size: 13px;">صورة الطبيب</label>
                            <div class="file-upload-wrapper">
                                <input type="file" id="editDoctorImageInput" accept="image/*" class="form-control auth-form-control" style="padding: 8px 12px; font-size: 13px;" />
