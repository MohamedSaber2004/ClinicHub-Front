                            <label class="form-label" style="font-weight: 600; font-size: 13px;">رقم الهاتف</label>
                            <input type="text" class="form-control auth-form-control" id="editDoctorPhone" style="padding: 8px 12px; font-size: 13px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-weight: 600; font-size: 13px;">تاريخ الميلاد</label>
                            <input type="date" class="form-control auth-form-control" id="editDoctorBirthDate" style="padding: 8px 12px; font-size: 13px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-weight: 600; font-size: 13px;">الجنس</label>
                            <select class="form-select auth-form-control" id="editDoctorGender" style="padding: 8px 12px; font-size: 13px;">
