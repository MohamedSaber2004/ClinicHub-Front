                                <div id="editDoctorImageStatus" class="upload-status-badge d-none align-items-center gap-2 mt-2">
                                    <img id="editDoctorImagePreview" src="" alt="صورة الطبيب" class="rounded" style="width: 60px; height: 60px; object-fit: cover; border: 1px solid var(--clr-border);" />
                                    <button type="button" class="btn btn-sm p-0 border-0 bg-transparent" id="editRemoveDoctorImageBtn" style="color: var(--clr-danger); font-size: 12px; line-height: 1;" title="إزالة الصورة">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
