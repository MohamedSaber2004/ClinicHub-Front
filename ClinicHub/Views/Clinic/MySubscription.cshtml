@using ClinicHub.Services.ReponseModels
@{
    Layout = "_ClinicLayout";
    ViewData["Title"] = "اشتراكي - Doctory";
    var subscription = ViewBag.Subscription as SubscriptionDto;
    var plans = ViewBag.Plans as List<PlanDto> ?? new();
}

<div class="page-header">
    <h2 class="page-title">
        <span class="page-title-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm-2 14l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" fill="currentColor"/>
            </svg>
        </span>
        اشتراكي
    </h2>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-warning">
        <p>@ViewBag.ErrorMessage</p>
        <a href="@HomeRoutes.Pages.Subscriptions()" class="btn btn-primary">عرض الباقات والاشتراك</a>
    </div>
}
else if (subscription == null)
{
    <div class="subscription-empty-state">
        <div class="empty-state-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="var(--clr-success)"/>
            </svg>
        </div>
        <h3>ليس لديك اشتراك نشط</h3>
        <p>اشترك الآن للاستفادة من جميع ميزات المنصة لإدارة عيادتك بكفاءة.</p>
        <a href="@HomeRoutes.Pages.Subscriptions()" class="btn btn-primary btn-lg">عرض الباقات والاشتراك</a>
    </div>
}
else
{
    var statusText = subscription.Status switch { 0 => "نشط", 1 => "ملغي", 2 => "منتهي", 3 => "ملغي من الإدارة", _ => "غير معروف" };
    var statusClass = subscription.Status switch { 0 => "badge-success", 1 => "badge-warning", 2 => "badge-danger", 3 => "badge-danger", _ => "badge-info" };
    var periodText = subscription.Period == 0 ? "شهري" : "سنوي";
    var currentPlan = plans.FirstOrDefault(p => p.Id == subscription.PlanId);
    var planNameText = !string.IsNullOrWhiteSpace(currentPlan?.NameAr) ? currentPlan.NameAr : subscription.PlanName;

    <div class="subscription-status-card">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="subs-detail-card">
                    <div class="subs-detail-header">
                        <span class="badge @statusClass badge-lg">@statusText</span>
                    </div>
                    <div class="subs-detail-body">
                        <div class="subs-detail-row">
                            <span class="subs-detail-label">الباقة</span>
                            <span class="subs-detail-value">@planNameText</span>
                        </div>
                        <div class="subs-detail-row">
                            <span class="subs-detail-label">المدة</span>
                            <span class="subs-detail-value">@periodText</span>
                        </div>
                        <div class="subs-detail-row">
                            <span class="subs-detail-label">المبلغ</span>
                            <span class="subs-detail-value">@subscription.Amount.ToString("N0") ج.م</span>
                        </div>
                        <div class="subs-detail-row">
                            <span class="subs-detail-label">تاريخ البداية</span>
                            <span class="subs-detail-value">@subscription.StartDate.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div class="subs-detail-row">
                            <span class="subs-detail-label">تاريخ النهاية</span>
                            <span class="subs-detail-value">@subscription.EndDate.ToString("yyyy-MM-dd")</span>
                        </div>
                        @if (subscription.PaidAt.HasValue)
                        {
                            <div class="subs-detail-row">
                                <span class="subs-detail-label">تاريخ الدفع</span>
                                <span class="subs-detail-value">@subscription.PaidAt.Value.ToString("yyyy-MM-dd")</span>
                            </div>
                        }
                    </div>
                    @if (subscription.IsActive)
                    {
                        <div class="subs-detail-footer">
                            <button class="btn btn-danger" onclick="cancelSubscription()">إلغاء الاشتراك</button>
                        </div>
                    }
                    else
                    {
                        <div class="subs-detail-footer">
                            <div class="renew-alert">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" fill="currentColor"/></svg>
                                <span>اشتراكك منتهٍ أو غير نشط. يرجى التجديد للاستمرار في استخدام لوحة التحكم.</span>
                            </div>
                            <button type="button"
                               class="btn btn-primary btn-renew js-subscribe-open"
                               data-plan-id="@subscription.PlanId"
                               data-period="@subscription.Period"
                               data-plan-name="@planNameText">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z" fill="currentColor"/></svg>
                                تجديد الاشتراك — @planNameText
                            </button>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="subs-plans-preview">
                    <h4>@(subscription.IsActive ? "الباقات المتاحة" : "اختر باقة للتجديد")</h4>
                    <div class="subscription-plans">
                        @foreach (var plan in plans.Where(p => p.IsActive).OrderBy(p => p.SortOrder))
                        {
                            var maxSort = plans.Where(p => p.IsActive).Max(p => p.SortOrder);
                            var isTop = plan.SortOrder >= maxSort;
                            var planClass = isTop ? "plan-premium" : "plan-free";
                            var isCurrent = plan.Id.ToString() == subscription.PlanId.ToString();
                            <div class="plan-card @planClass">
                                <div class="plan-header">
                                    <h3 class="plan-name">@plan.NameAr</h3>
                                    <p class="plan-price">@plan.PriceMonthly.ToString("N0") <span class="plan-currency">ج.م</span></p>
                                </div>
                                <div class="plan-footer">
                                    @if (subscription.IsActive)
                                    {
                                        <span class="plan-current">@(isCurrent ? "الباقة الحالية" : "")</span>
                                    }
                                    else
                                    {
                                        <button type="button"
                                           class="btn btn-sm @(isCurrent ? "btn-primary" : "btn-secondary") btn-plan-subscribe js-subscribe-open"
                                           data-plan-id="@plan.Id"
                                           data-period="@subscription.Period"
                                           data-plan-name="@plan.NameAr">
                                            @(isCurrent ? "تجديد هذه الباقة" : "اشترك بهذه الباقة")
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="paymentMethodSubModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <div class="modal-header-custom">
                <h5 class="modal-title">اختر طريقة الدفع</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body-custom">
                <p class="modal-premium-subtitle" id="paymentMethodSubModalSubtitle"></p>
                <div class="payment-methods-grid">
                    <label class="payment-method-card selected">
                        <input type="radio" name="subPaymentMethod" value="PaymobWallet" checked>
                        <div class="payment-method-icon payment-method-icon--wallet">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.66 0 3-4.03 3-9s-1.34-9-3-9m0 18c-1.66 0-3-4.03-3-9s1.34-9 3-9m-9 9a9 9 0 019-9"/>
                            </svg>
                        </div>
                        <div class="payment-method-info">
                            <p class="payment-method-title">محفظة Paymob</p>
                            <p class="payment-method-desc">الدفع عبر المحفظة الإلكترونية</p>
                        </div>
                        <span class="payment-method-check">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                        </span>
                    </label>
                    <label class="payment-method-card">
                        <input type="radio" name="subPaymentMethod" value="PaymobCreditCard">
                        <div class="payment-method-icon payment-method-icon--card">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                                <line x1="1" y1="10" x2="23" y2="10"/>
                            </svg>
                        </div>
                        <div class="payment-method-info">
                            <p class="payment-method-title">بطاقة ائتمانية</p>
                            <p class="payment-method-desc">الدفع ببطاقة بنكية عبر Paymob</p>
                        </div>
                        <span class="payment-method-check">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                        </span>
                    </label>
                </div>
                <div id="subWalletPhoneBox" class="mt-3 text-start">
                    <label for="subWalletPhoneInput" class="form-label text-muted small mb-1">
                        <i class="bi bi-phone me-1"></i> رقم المحفظة (فودافون كاش / اتصالات / أورنج / وي):
                    </label>
                    <input type="tel" id="subWalletPhoneInput" class="form-control" placeholder="01xxxxxxxxx" dir="ltr" maxlength="11">
                    <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">(للتجربة في بيئة الاختبار يمكنك استخدام: 01010101010)</small>
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="subConfirmPaymentMethodBtn">متابعة للدفع</button>
            </div>
        </div>
    </div>
</div>

<style>
    .subscription-empty-state {
        text-align: center;
        padding: var(--space-10) var(--space-5);
    }
    .empty-state-icon {
        margin-bottom: var(--space-5);
    }
    .subscription-empty-state h3 {
        font-size: var(--fs-xl);
        font-weight: var(--fw-semibold);
        margin-bottom: var(--space-3);
    }
    .subscription-empty-state p {
        color: var(--clr-text-secondary);
        margin-bottom: var(--space-6);
        max-width: 400px;
        margin-left: auto;
        margin-right: auto;
    }
    .subscription-status-card {
        padding: var(--space-5) 0;
    }
    .subs-detail-card {
        background: var(--clr-surface);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }
    .subs-detail-header {
        padding: var(--space-4) var(--space-5);
        border-bottom: 1px solid var(--clr-border);
    }
    .subs-detail-body {
        padding: var(--space-4) var(--space-5);
    }
    .subs-detail-row {
        display: flex;
        justify-content: space-between;
        padding: var(--space-2) 0;
        border-bottom: 1px solid var(--clr-bg);
    }
    .subs-detail-row:last-child {
        border-bottom: none;
    }
    .subs-detail-label {
        font-size: var(--fs-sm);
        color: var(--clr-text-secondary);
    }
    .subs-detail-value {
        font-size: var(--fs-sm);
        font-weight: var(--fw-semibold);
        color: var(--clr-text);
    }
    .subs-detail-footer {
        padding: var(--space-4) var(--space-5);
        border-top: 1px solid var(--clr-border);
    }
    .subs-plans-preview h4 {
        font-size: var(--fs-lg);
        font-weight: var(--fw-semibold);
        margin-bottom: var(--space-4);
    }
    .subs-plans-preview .subscription-plans {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }
    .subs-plans-preview .plan-card {
        padding: var(--space-3) var(--space-4);
    }
    /* Renew subscription styles */
    .renew-alert {
        display: flex;
        align-items: flex-start;
        gap: var(--space-2);
        padding: var(--space-3);
        background: color-mix(in srgb, var(--clr-warning) 12%, transparent);
        border: 1px solid color-mix(in srgb, var(--clr-warning) 40%, transparent);
        border-radius: var(--radius-md);
        color: var(--clr-text);
        font-size: var(--fs-sm);
        margin-bottom: var(--space-3);
    }
    .renew-alert svg {
        flex-shrink: 0;
        color: var(--clr-warning);
        margin-top: 1px;
    }
    .btn-renew {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        width: 100%;
        justify-content: center;
    }
    .btn-plan-subscribe {
        width: 100%;
        text-align: center;
    }
    .subs-plans-preview .plan-footer {
        padding-top: var(--space-2);
    }
</style>

@section Scripts {
    <script>
        function cancelSubscription() {
            showConfirmModal('هل أنت متأكد من إلغاء الاشتراك؟ لن يتم استرداد المبلغ المدفوع.', function(confirmed) {
                if (!confirmed) return;
                fetch('@ClinicRoutes.Pages.CancelSubscription()', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                }).then(function(r) { return r.json(); })
                  .then(function(data) {
                      if (data.success) {
                          localStorage.removeItem('accessToken');
                          localStorage.removeItem('refreshToken');
                          localStorage.removeItem('userId');
                          localStorage.removeItem('role');
                          localStorage.removeItem('clinicId');
                          window.location.href = '@HomeRoutes.Pages.SubscriptionRequired()';
                      } else {
                          showBackendErrors(JSON.stringify(data));
                      }
                  }).catch(function() {
                      showBackendErrors(null);
                  });
            });
        }

        (function () {
            var pendingSub = null;
            var subWalletPhoneBox = document.getElementById('subWalletPhoneBox');

            document.querySelectorAll('#paymentMethodSubModal input[name="subPaymentMethod"]').forEach(function (radio) {
                radio.addEventListener('change', function () {
                    document.querySelectorAll('#paymentMethodSubModal .payment-method-card').forEach(function (c) { c.classList.remove('selected'); });
                    this.closest('.payment-method-card')?.classList.add('selected');
                    if (subWalletPhoneBox) {
                        subWalletPhoneBox.style.display = this.value === 'PaymobWallet' ? 'block' : 'none';
                    }
                });
            });
            document.querySelectorAll('#paymentMethodSubModal .payment-method-card').forEach(function (card) {
                card.addEventListener('click', function (e) {
                    if (e.target.closest('input')) return;
                    var r = this.querySelector('input[type="radio"]');
                    if (r && !r.checked) { r.checked = true; r.dispatchEvent(new Event('change', { bubbles: true })); }
                });
            });

            document.querySelectorAll('.js-subscribe-open').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    pendingSub = {
                        planId: this.getAttribute('data-plan-id'),
                        period: this.getAttribute('data-period'),
                        planName: this.getAttribute('data-plan-name') || 'الباقة المختارة'
                    };
                    if (!pendingSub.planId) return;
                    var subtitleEl = document.getElementById('paymentMethodSubModalSubtitle');
                    if (subtitleEl) {
                        subtitleEl.textContent = 'باقة ' + pendingSub.planName;
                    }
                    var modalEl = document.getElementById('paymentMethodSubModal');
                    if (modalEl) {
                        var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                        modal.show();
                    }
                });
            });

            var confirmBtn = document.getElementById('subConfirmPaymentMethodBtn');
            if (confirmBtn) {
                confirmBtn.addEventListener('click', function () {
                    if (!pendingSub || !pendingSub.planId) return;
                    var selectedMethod = document.querySelector('input[name="subPaymentMethod"]:checked')?.value || 'PaymobWallet';
                    var walletPhone = document.getElementById('subWalletPhoneInput')?.value?.trim() || '';
                    if (selectedMethod === 'PaymobWallet' && !walletPhone) {
                        alert('يرجى إدخال رقم المحفظة الإلكترونية للمتابعة (للتجربة: 01010101010)');
                        return;
                    }
                    var periodInt = parseInt(pendingSub.period, 10);
                    if (isNaN(periodInt)) periodInt = 0;
                    confirmBtn.disabled = true;
                    confirmBtn.textContent = 'جارٍ التحويل للدفع...';

                    try {
                        var currentUrl = window.location.href;
                        sessionStorage.setItem('prePaymentPage', currentUrl);
                        localStorage.setItem('prePaymentPage', currentUrl);
                        document.cookie = "prePaymentUrl=" + encodeURIComponent(currentUrl) + "; path=/; max-age=3600; SameSite=Lax";
                    } catch (e) {}

                    fetch('/Clinic/InitiatePayment', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ planId: pendingSub.planId, period: periodInt, paymentMethod: selectedMethod, walletPhoneNumber: walletPhone })
                    }).then(function (r) { return r.json(); })
                      .then(function (result) {
                          if (result && result.success && result.targetUrl) {
                              window.location.href = result.targetUrl;
                          } else if (result && result.message) {
                              if (typeof showErrorModal === 'function') showErrorModal(result.message);
                              else alert(result.message);
                          } else {
                              window.location.href = '@ClinicRoutes.Pages.Subscribe()' + '?planId=' + encodeURIComponent(pendingSub.planId) + '&period=' + encodeURIComponent(periodInt) + '&paymentMethod=' + encodeURIComponent(selectedMethod) + '&walletPhoneNumber=' + encodeURIComponent(walletPhone);
                          }
                      }).catch(function () {
                          window.location.href = '@ClinicRoutes.Pages.Subscribe()' + '?planId=' + encodeURIComponent(pendingSub.planId) + '&period=' + encodeURIComponent(periodInt) + '&paymentMethod=' + encodeURIComponent(selectedMethod) + '&walletPhoneNumber=' + encodeURIComponent(walletPhone);
                      }).finally(function () {
                          confirmBtn.disabled = false;
                          confirmBtn.textContent = 'متابعة للدفع';
                      });
                });
            }
        })();
    </script>
}
