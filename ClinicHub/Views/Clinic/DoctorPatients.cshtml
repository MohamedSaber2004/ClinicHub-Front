@using ClinicHub.Services.ReponseModels
@{
    Layout = "_ClinicLayout";
    ViewData["Title"] = "مرضى العيادة";

    var patients = ViewBag.Patients as IReadOnlyCollection<DoctorPatientDto> ?? new List<DoctorPatientDto>();

    string GenderLabel(int? g) => g == 0 ? "ذكر" : g == 1 ? "أنثى" : "غير محدد";
    string AgeLabel(int? age) => age.HasValue ? $"{age} سنة" : "غير محدد";
    string LastVisitLabel(DateTime d) => d.Year > 2000 ? d.ToString("yyyy-MM-dd") : "—";
    string Initial(string? name) => string.IsNullOrWhiteSpace(name) ? "م" : name.Trim()[..1];
}

<h2 class="page-title">
    <span class="page-title-icon">
        <i class="bi bi-people"></i>
    </span>
    مرضى العيادة
</h2>

<div class="table-card">
    <div class="table-card-header">
        <h3 class="table-card-title">قائمة المرضى</h3>
    </div>
    <form method="get" action="@Url.Action("DoctorPatients")" class="filter-bar table-filter-bar">
        <input type="text" name="searchTerm" class="form-input" placeholder="بحث بالاسم أو الهاتف..." value="@ViewBag.SearchTerm" />
        <button type="submit" class="btn btn-primary btn-sm">بحث</button>
        <a href="@Url.Action("DoctorPatients")" class="btn btn-outline-secondary btn-sm">مسح</a>
    </form>
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>المريض</th>
                    <th>العمر / الجنس</th>
                    <th>عدد الزيارات</th>
                    <th>آخر زيارة</th>
                    <th>الإجراء</th>
                </tr>
            </thead>
            <tbody>
                @if (patients.Count == 0)
                {
                    <tr>
                    <td colspan="5" class="table-empty">لا يوجد مرضى مطابقون للبحث</td>
                    </tr>
                }
                @foreach (var p in patients)
                {
                    <tr>
                        <td>
                            <div class="table-user">
                                <span class="table-avatar">@Initial(p.FullName)</span>
                                <span class="table-user-name">@p.FullName</span>
                            </div>
                        </td>
                        <td>@AgeLabel(p.Age) / @GenderLabel(p.Gender)</td>
                        <td><span class="badge badge-info">@p.TotalVisits</span></td>
                        <td>@LastVisitLabel(p.LastVisitDate)</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("DoctorPatientHistory", new { patientId = p.UserId, name = p.FullName })">
                                <i class="bi bi-clock-history"></i> عرض التاريخ
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" />
</div>
